{
  "name": "minicloud-queue-spec",
  "private": true,
  "description": "Quint model of minicloud's queue, checked with TLC",
  "devDependencies": {
    "@informalsystems/quint": "0.33.0"
  },
  "scripts": {
    "setup": "quint verify --max-steps=1 --invariant=inv_true sanity/toy.qnt",
    "typecheck": "quint typecheck queue.qnt && quint typecheck checks.qnt",

    "sanity:inv-false": "quint verify --backend=tlc --invariant=inv_false sanity/toy.qnt",
    "sanity:inv-true": "quint verify --backend=tlc --invariant=inv_true sanity/toy.qnt",
    "sanity:live-nofair": "quint verify --backend=tlc --temporal=reach3 sanity/toy.qnt",
    "sanity:live-fair": "quint verify --backend=tlc --temporal=reach3Fair sanity/toy.qnt",
    "sanity:live-false": "quint verify --backend=tlc --temporal=reach4Fair sanity/toy.qnt",

    "s5:impl": "tools/check.sh s5_impl s5_impl --tlc-config=tlc-bfs1.json --invariant=S5,NoOverflow",
    "s5:race": "tools/check.sh s5_race_impl s5_race_impl --tlc-config=tlc-bfs1.json --invariant=S5,NoOverflow",
    "s5:f1": "tools/check.sh s5_f1_impl s5_f1_impl --tlc-config=tlc-bfs1.json --invariant=S5,NoOverflow",
    "s5:fixed": "tools/check.sh s5_fixed s5_fixed --tlc-config=tlc-all.json --invariant=S5,NoOverflow",
    "s5:strict-fixed": "tools/check.sh s5strict_fixed s5_fixed --tlc-config=tlc-bfs1.json --invariant=S5strict,NoOverflow"
  }
}
