use std.web
use auth
use fetch

/// `/check`: 200 if the request's `Authorization` presents the secret
/// `key`, 401 if not. `/fetch?url=`: what a `GET` of the URL answers — with
/// whatever header the host adds for that origin.
export fn handle(request: web.Request) -> web.Response {
  if request.path == "/check" {
    if presents(request.headers.get("authorization").unwrapOr("")) {
      return answer(200, "in")
    }
    return answer(401, "out")
  }
  if request.path == "/fetch" {
    return match fetch.request("GET", request.query.get("url").unwrapOr(""), Map.of(), "") {
      Ok(got) => answer(got.status, got.body)
      Err(error) => answer(502, error.message)
    }
  }
  answer(404, "no such path")
}

fn presents(authorization: String) -> Bool {
  auth.check("key", authorization)
}

fn answer(status: Int, body: String) -> web.Response {
  web.Response(status: status, headers: Map.of(), body: "{body}\n")
}

/// Runs under `minicloud test` without the real secret: the host gives
/// `key` a placeholder, which a wrong token does not present.
test fn aWrongTokenIsNotTheSecret() -> Result<Unit, Error> {
  assert(!presents("Bearer certainly-not-the-secret"))?
  Ok(())
}
