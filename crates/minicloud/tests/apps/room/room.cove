use web
use keyed
use kv
use log
use timer
use time

/// A counter per room, written the unsafe way on purpose.
///
/// `/bump?room=` reads, waits, and writes back: two runs that interleave
/// would lose one of the two, which is what `[keyed]` is for. `/count` and
/// `/woke` read what is there. `/set-alarm?room=&in=` asks to be woken,
/// `/alarm` is where the host wakes it, and `/alarm-at` says when.
export fn handle(request: web.Request) -> web.Response {
  let room = request.query.get("room").unwrapOr("")
  if request.path == "/count" {
    return answer(200, kv.get("count:{room}").unwrapOr("0"))
  }
  if request.path == "/woke" {
    return answer(200, kv.get("woke:{room}").unwrapOr("0"))
  }
  if request.path == "/bump" {
    let was = Int.parse(kv.get("count:{room}").unwrapOr("0")).unwrapOr(0)
    // The window: without a turn of its own, another run reads the same
    // number here and both write the same one back.
    timer.sleep(30)
    return match kv.put("count:{room}", "{was + 1}") {
      Ok(_) => answer(200, "{was + 1}")
      Err(error) => answer(507, error.message)
    }
  }
  if request.path == "/set-alarm" {
    let ms = Int.parse(request.query.get("in").unwrapOr("50")).unwrapOr(50)
    return match keyed.alarm(room, time.nowMillis() + ms) {
      Ok(_) => answer(202, "set")
      Err(error) => answer(400, error.message)
    }
  }
  if request.path == "/alarm-at" {
    return match keyed.alarmAt(room) {
      Ok(at) => answer(200, "{at}")
      Err(error) => answer(400, error.message)
    }
  }
  if request.path == "/clear-alarm" {
    return match keyed.clearAlarm(room) {
      Ok(was) => answer(200, "{was}")
      Err(error) => answer(400, error.message)
    }
  }
  if request.path == "/alarm" {
    if request.headers.get("x-minicloud-alarm").isNone() {
      return answer(403, "not the host")
    }
    let was = Int.parse(kv.get("woke:{room}").unwrapOr("0")).unwrapOr(0)
    log.info("woke for {room}")
    return match kv.put("woke:{room}", "{was + 1}") {
      Ok(_) => answer(200, "woke")
      Err(error) => answer(507, error.message)
    }
  }
  answer(404, "no such path")
}

fn answer(status: Int, body: String) -> web.Response {
  web.Response(status: status, headers: Map.of(), body: "{body}\n")
}
