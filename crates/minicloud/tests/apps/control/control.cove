use web
use host

/// Each path is one operation of the `host` module (capability `admin`),
/// its arguments in the query, its answer as text: `/apps`,
/// `/capabilities`, `/selfVersion`, `/history?n=`, `/kv?app=&prefix=&after=&n=`,
/// `/kvValue?app=&key=`, `/logs?app=&n=`, `/code?app=&n=`,
/// `/codeFile?app=&file=`, `/codePieces?app=&file=`,
/// `/sqlTables?app=`, `/sqlQuery?app=&q=`,
/// `/queues?app=`, `/queueMessages?app=&n=`, `/queueDead?app=&n=`,
/// `/queueMessage?app=&id=`, `/series?app=&over=`,
/// `/enable?app=&on=`,
/// `/configure?app=&grant=&allow=&hostcalls=&…` and `/reset?app=`; and `/origin`,
/// what the app is told of how it was reached.
export fn handle(request: web.Request) -> web.Response {
  let query = request.query
  let app = query.get("app").unwrapOr("")
  let who = query.get("who").unwrapOr("test")
  if request.path == "/apps" {
    var lines = Vector.of()
    for info in host.apps() {
      lines.push(describe(info))
    }
    return answer(200, "\n".join(lines.freeze()))
  }
  if request.path == "/origin" {
    let scheme = request.headers.get("x-forwarded-proto").unwrapOr("")
    let host = request.headers.get("host").unwrapOr("")
    return answer(200, "{scheme}://{host} prefix={request.headers.get("x-forwarded-prefix").unwrapOr("")} path={request.path}")
  }
  if request.path == "/capabilities" {
    return answer(200, ",".join(host.capabilities()))
  }
  if request.path == "/selfVersion" {
    return answer(200, host.selfVersion())
  }
  if request.path == "/history" {
    var lines = Vector.of()
    for change in host.history(Int.parse(query.get("n").unwrapOr("50")).unwrapOr(50)) {
      lines.push("{change.who} | {change.app} | {change.action} | {change.outcome}")
    }
    return answer(200, "\n".join(lines.freeze()))
  }
  if request.path == "/kv" {
    var lines = Vector.of()
    let n = Int.parse(query.get("n").unwrapOr("100")).unwrapOr(100)
    for entry in host.kv(app, query.get("prefix").unwrapOr(""), query.get("after").unwrapOr(""), n) {
      lines.push("{entry.key} | {entry.value} | {entry.bytes} | {entry.cut}")
    }
    return answer(200, "\n".join(lines.freeze()))
  }
  if request.path == "/kvValue" {
    return match host.kvValue(app, query.get("key").unwrapOr("")) {
      Ok(entry) => answer(200, "{entry.key} | {entry.value} | {entry.bytes} | {entry.cut}")
      Err(error) => answer(404, error.message)
    }
  }
  if request.path == "/code" {
    var lines = Vector.of()
    let n = Int.parse(query.get("n").unwrapOr("100")).unwrapOr(100)
    for file in host.code(app, n) {
      lines.push("{file.name} | {file.kind} | {file.bytes} | {file.isText} | {file.onDisk} | {file.depth} | {file.label}")
    }
    return answer(200, "\n".join(lines.freeze()))
  }
  if request.path == "/codeFile" {
    return match host.codeFile(app, query.get("file").unwrapOr("")) {
      Ok(file) => answer(200, "{file.name} | {file.bytes} | {file.isText} | {file.cut} | {file.onDisk}\n{file.text}")
      Err(error) => answer(404, error.message)
    }
  }
  // The pieces one file's text is coloured by, in a form a test can take
  // apart and put back together: each is `kind`, a NUL, its text, a NUL, so
  // that a piece holding a newline or a `|` is still one piece.
  if request.path == "/codePieces" {
    return match host.codeFile(app, query.get("file").unwrapOr("")) {
      Ok(file) => {
        var out = Vector.of()
        out.push("{file.plain} | {file.pieces.length()}\n")
        for piece in file.pieces {
          out.push("{piece.kind}\0{piece.text}\0")
        }
        answer(200, "".join(out.freeze()))
      }
      Err(error) => answer(404, error.message)
    }
  }
  if request.path == "/sqlTables" {
    var lines = Vector.of()
    for table in host.sqlTables(app) {
      lines.push("{table.name} | {table.rows} | {table.counted}")
    }
    return answer(200, "\n".join(lines.freeze()))
  }
  if request.path == "/sqlQuery" {
    return match host.sqlQuery(app, query.get("q").unwrapOr("")) {
      Ok(got) => {
        var out = Vector.of()
        out.push("|".join(got.columns))
        for row in got.rows {
          var cells = Vector.of()
          for value in row.values {
            // A NULL is not an empty string, so the two are not printed
            // alike: the text is quoted and a NULL is not.
            match value {
              Some(said) => cells.push("'{said}'")
              None => cells.push("NULL")
            }
          }
          out.push("|".join(cells.freeze()))
        }
        answer(200, "\n".join(out.freeze()))
      }
      Err(error) => answer(404, error.message)
    }
  }
  if request.path == "/series" {
    var lines = Vector.of()
    for row in host.series(app, query.get("over").unwrapOr("hour")) {
      lines.push("{row.atUnix} | served={row.served} ok={row.ok} errors={row.errors} rejected={row.rejected} workerMs={row.workerMs} | p50={row.p50Us} p99={row.p99Us}")
    }
    return answer(200, "\n".join(lines.freeze()))
  }
  if request.path == "/queues" {
    var lines = Vector.of()
    for queue in host.queues(app) {
      lines.push(
        "{queue.name} | {queue.path} | due={queue.due} held={queue.held} dead={queue.dead} | declared={queue.declared} | depth={queue.maxDepth} attempts={queue.maxAttempts} retry={queue.retryMs} lease={queue.leaseMs} batch={queue.batch} body={queue.maxBodyBytes}",
      )
    }
    return answer(200, "\n".join(lines.freeze()))
  }
  if request.path == "/queueMessages" {
    var lines = Vector.of()
    for one in host.queueMessages(app, Int.parse(query.get("n").unwrapOr("50")).unwrapOr(50)) {
      lines.push(queued(one))
    }
    return answer(200, "\n".join(lines.freeze()))
  }
  if request.path == "/queueDead" {
    var lines = Vector.of()
    for one in host.queueDead(app, Int.parse(query.get("n").unwrapOr("50")).unwrapOr(50)) {
      lines.push(queued(one))
    }
    return answer(200, "\n".join(lines.freeze()))
  }
  if request.path == "/queueMessage" {
    return match host.queueMessage(app, Int.parse(query.get("id").unwrapOr("0")).unwrapOr(0)) {
      Ok(one) => answer(200, queued(one))
      Err(error) => answer(404, error.message)
    }
  }
  if request.path == "/logs" {
    var lines = Vector.of()
    for line in host.logs(app, Int.parse(query.get("n").unwrapOr("50")).unwrapOr(50)) {
      lines.push("{line.atMs} | {line.level} | {line.text}")
    }
    return answer(200, "\n".join(lines.freeze()))
  }
  if request.path == "/enable" {
    return changed(host.setEnabled(app, query.get("on").unwrapOr("true") == "true", who))
  }
  if request.path == "/reset" {
    return changed(host.reset(app, who))
  }
  if request.path == "/configure" {
    return match find(app) {
      Some(info) => changed(host.configure(app, settings(query, info), who))
      None => answer(404, "no app `{app}`")
    }
  }
  answer(404, "no such operation")
}

/// One message of a queue, waiting or buried: the same line either way, so
/// a test can see that `why` is empty for one that is still waiting.
fn queued(one: host.QueueMessage) -> String {
  "{one.id} | {one.queue} | {one.state} | attempts={one.attempts} | {one.body} | bytes={one.bytes} cut={one.cut} | due={one.dueMs} sent={one.sentMs} buried={one.buriedMs} | {one.why}"
}

fn describe(info: host.App) -> String {
  let reason = info.reason.split("\n").get(0).unwrapOr("")
  "{info.name} {info.state} version={info.version} granted=[{",".join(info.granted)}] required=[{",".join(info.required)}] added=[{",".join(info.grantAdded)}] removed=[{",".join(info.grantRemoved)}] allow=[{",".join(info.fetchAllow)}] hostcalls={info.limits.maxHostCalls} deadline={info.limits.deadlineMs} inflight={info.limits.maxInFlight} changed=[{",".join(info.limitsChanged)}] admin={info.isAdmin} hosts=[{",".join(info.hosts)}] kv={info.kvKeys} reason={reason}"
}

fn find(name: String) -> Option<host.App> {
  for info in host.apps() {
    if info.name == name {
      return Some(info)
    }
  }
  None
}

/// The app's settings with what the query changes.
fn settings(query: Map<String, String>, info: host.App) -> host.Settings {
  let limits = info.limits
  host.Settings(
    grant: list(query, "grant", info.granted),
    fetchAllow: list(query, "allow", info.fetchAllow),
    limits: host.Limits(
      maxHostCalls: number(query, "hostcalls", limits.maxHostCalls),
      deadlineMs: number(query, "deadline", limits.deadlineMs),
      maxHeapWords: number(query, "heap", limits.maxHeapWords),
      maxInFlight: number(query, "inflight", limits.maxInFlight),
      maxQueued: number(query, "queued", limits.maxQueued),
      maxRequestBytes: number(query, "request", limits.maxRequestBytes),
      maxResponseBytes: number(query, "response", limits.maxResponseBytes),
    ),
  )
}

fn list(query: Map<String, String>, key: String, current: Array<String>) -> Array<String> {
  match query.get(key) {
    Some("") => Vector.of().freeze()
    Some(text) => text.split(",")
    None => current
  }
}

fn number(query: Map<String, String>, key: String, current: Int) -> Int {
  match query.get(key) {
    Some(text) => Int.parse(text).unwrapOr(current)
    None => current
  }
}

fn changed(result: Result<String, Error>) -> web.Response {
  match result {
    Ok(message) => answer(200, message)
    Err(error) => answer(422, error.message)
  }
}

fn answer(status: Int, body: String) -> web.Response {
  web.Response(status: status, headers: Map.of(), body: "{body}\n")
}
