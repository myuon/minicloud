use web
use host
use text

// The pages. Every value that came from the host — an app's name, a reason,
// an error message, a history entry — and every value echoed from a form
// goes through `h` before it is part of a page; the page's own markup is
// the only markup in it. There is no script at all: what the pages do on a
// narrow screen, they do in CSS (`assets/style.css`).

/// `value`, escaped for HTML.
fn h(value: String) -> String {
  text.escapeHtml(value)
}

/// The headers every answer carries: no script, nothing but this site's
/// forms, no framing, no sniffing, no caching, no referrer to another site.
/// The stylesheet and the icon are files the host serves from `assets/`, so
/// `style-src 'self'` and `img-src 'self'` are all the page needs: there is no
/// inline style left that `'unsafe-inline'` would have had to allow.
fn pageHeaders(contentType: String) -> Map<String, String> {
  Map.of(
    MapEntry(key: "content-type", value: contentType),
    MapEntry(
      key: "content-security-policy",
      value: "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
    ),
    MapEntry(key: "x-content-type-options", value: "nosniff"),
    MapEntry(key: "x-frame-options", value: "DENY"),
    MapEntry(key: "referrer-policy", value: "same-origin"),
    MapEntry(key: "cache-control", value: "no-store"),
  )
}

fn htmlResponse(status: Int, page: String) -> web.Response {
  web.Response(status: status, headers: pageHeaders("text/html; charset=utf-8"), body: page)
}

fn textResponse(status: Int, body: String) -> web.Response {
  web.Response(status: status, headers: pageHeaders("text/plain; charset=utf-8"), body: body)
}

/// A `303 See Other` to `location`.
fn redirect(location: String) -> web.Response {
  web.Response(
    status: 303,
    headers: Map.of(
      MapEntry(key: "location", value: location),
      MapEntry(key: "cache-control", value: "no-store"),
    ),
    body: "",
  )
}

/// The navigation, with the page one is on marked.
fn nav(base: String, here: String) -> String {
  var out = Vector.of()
  for item in Vector.of(
    MapEntry(key: "apps", value: "/"),
    MapEntry(key: "secrets", value: "/secrets"),
    MapEntry(key: "history", value: "/history"),
  )
    .freeze() {
    let mark = if item.key == here { " aria-current=page" } else { "" }
    out.push("<a href=\"{h(base)}{h(item.value)}\"{mark}>{h(item.key)}</a>")
  }
  "<nav>{"".join(out.freeze())}</nav>"
}

/// The page around `content`. `here` is the navigation entry it belongs to.
fn layout(base: String, here: String, title: String, content: String) -> String {
  "<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>{h(title)} · minicloud admin</title><link rel=stylesheet href=\"{h(base)}/style.css\"><link rel=icon href=\"{h(base)}/favicon.svg\" type=\"image/svg+xml\"><link rel=icon href=\"{h(base)}/favicon.ico\" sizes=\"16x16 32x32\"></head><body><header><a class=brand href=\"{h(base)}/\">minicloud admin</a>{nav(base, here)}</header><main>{content}</main></body></html>"
}

fn badge(state: String) -> String {
  "<span class=\"state {h(state)}\">{h(state)}</span>"
}

/// A list of names, or a dash.
fn names(items: Array<String>) -> String {
  if items.length() == 0 {
    return "<span class=muted>–</span>"
  }
  var out = Vector.of()
  for item in items {
    out.push("<code>{h(item)}</code>")
  }
  " ".join(out.freeze())
}

/// The grant, with what the admin added and what it took away marked.
fn grantList(app: host.App) -> String {
  var out = Vector.of()
  for capability in app.granted {
    if app.grantAdded.contains(capability) {
      out.push("<code class=added title=\"granted here, not in app.toml\">+{h(capability)}</code>")
    } else {
      out.push("<code>{h(capability)}</code>")
    }
  }
  for capability in app.grantRemoved {
    out.push("<code class=taken title=\"in app.toml, taken away here\">{h(capability)}</code>")
  }
  if out.length() == 0 {
    return "<span class=muted>–</span>"
  }
  " ".join(out.freeze())
}

/// The first line of `reason`.
fn firstLine(reason: String) -> String {
  reason.split("\n").get(0).unwrapOr("")
}

/// What the overview says above the table: how many apps there are, how
/// they are, and what they have served between them.
fn overviewLead(apps: Array<host.App>) -> String {
  var serving = 0
  var served = 0
  var errors = 0
  var away = Vector.of()
  for app in apps {
    served = served + app.served
    errors = errors + app.errors
    if app.state == "serving" {
      serving = serving + 1
    } else {
      away.push("{app.name} {app.state}")
    }
  }
  let rest = if away.length() == 0 {
    "all serving"
  } else {
    "{serving} serving, {", ".join(away.freeze())}"
  }
  "<p class=lead>{apps.length()} apps — {h(rest)} — {served} requests served, {errors} errors. A change to an app is a re-check: the host loads the app again with it and serves the new version only if it loads. Taking away a capability the code needs leaves that app refused — and no other. Changes are kept in the host's data directory and survive restarts and releases.</p>"
}

/// Every app, one row each.
fn overviewPage(base: String, apps: Array<host.App>) -> String {
  var rows = Vector.of()
  for app in apps {
    let reason = if app.reason == "" {
      ""
    } else {
      "<div class=muted>{h(firstLine(app.reason))}</div>"
    }
    let reached = if app.hosts.length() > 0 {
      "{names(app.hosts)}"
    } else {
      "<code>/{h(app.name)}/</code>"
    }
    let required = if app.requiredOpen { "{names(app.required)} <span class=muted>(at least)</span>" } else { names(app.required) }
    let store = if app.kvKeys < 0 { "<span class=muted>–</span>" } else { "{app.kvKeys} keys, {text.bytes(app.kvBytes)}" }
    rows.push(
      "<tr><td class=title data-label=app><a href=\"{h(base)}/apps/{h(app.name)}\"><b>{h(app.name)}</b></a>{if app.isAdmin { " <span class=muted>(this app)</span>" } else { "" }}</td><td data-label=state>{badge(app.state)}{reason}</td><td data-label=version><code>{h(app.version)}</code> <span class=muted>{h(app.tier)}</span></td><td data-label=reached>{reached}</td><td data-label=\"code requires\">{required}</td><td data-label=granted>{grantList(app)}</td><td class=nums data-label=\"served / ok / errors / rejected\">{app.served} / {app.ok} / {app.errors} / {app.rejected}</td><td class=nums data-label=\"in flight / queued\">{app.inFlight} / {app.queued}</td><td data-label=store>{store}</td></tr>",
    )
  }
  let table = "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>app</th><th>state</th><th>version</th><th>reached</th><th>code requires</th><th>granted</th><th>served / ok / errors / rejected</th><th>in flight / queued</th><th>store</th></tr>{"".join(rows.freeze())}</table></div>"
  layout(base, "apps", "apps", "<h1>Apps</h1>{overviewLead(apps)}{table}")
}

/// One app: what it is, the forms that change it, its recent errors.
/// `notice` is said above everything; `posted` is a form to show again as it
/// was posted, instead of the app's current settings.
fn appPage(
  base: String,
  app: host.App,
  capabilities: Array<String>,
  notice: String,
  posted: Option<Map<String, String>>,
) -> String {
  let at = "{base}/apps/{app.name}"
  let reason = if app.reason == "" { "" } else { "<pre>{h(app.reason)}</pre>" }
  var limitRows = Vector.of()
  for field in limitFields() {
    let changed = if app.limitsChanged.contains(limitKey(field.name)) { " <span class=added title=\"set here, not in app.toml\">(changed)</span>" } else { "" }
    limitRows.push("<tr><th>{h(field.label)}</th><td class=nums>{limitValue(app.limits, field.name)}{changed}</td></tr>")
  }
  let held = if app.kvKeys < 0 { "<span class=muted>–</span>" } else { "{app.kvKeys} keys, {text.bytes(app.kvBytes)}" }
  let store = if app.granted.contains("kv") { "{held} · <a href=\"{h(at)}/kv\">browse</a>" } else { held }
  let facts = "<div class=\"scroll narrow\"><table class=facts><tr><th>state</th><td>{badge(app.state)}</td></tr><tr><th>version</th><td><code>{h(app.version)}</code> <span class=muted>{h(app.tier)}</span> · <a href=\"{h(at)}/code\">what it is</a></td></tr><tr><th>entry</th><td><code>{h(app.entry)}</code></td></tr><tr><th>reached</th><td>{if app.hosts.length() > 0 { "by hostname {names(app.hosts)} only" } else { "<code>/{h(app.name)}/</code>" }}</td></tr><tr><th>code requires</th><td>{names(app.required)}{if app.requiredOpen { " <span class=muted>(at least: it makes a call the checker cannot follow)</span>" } else { "" }}</td></tr><tr><th>granted</th><td>{grantList(app)}</td></tr><tr><th>fetch allowlist</th><td>{names(app.fetchAllow)}</td></tr><tr><th>requests</th><td>{app.served} served, {app.ok} ok, {app.errors} errors, {app.rejected} rejected; {app.inFlight} in flight, {app.queued} queued</td></tr><tr><th>store</th><td>{store}</td></tr></table></div><h2>Limits</h2><div class=\"scroll narrow\"><table class=facts>{"".join(limitRows.freeze())}</table></div>"
  layout(
    base,
    "apps",
    app.name,
    "<h1>{h(app.name)} {badge(app.state)}</h1>{notice}{reason}{facts}{enableForm(at, app)}{configureForm(at, app, capabilities, posted)}{resetForm(at)}{errorsTable(app.recentErrors)}{logSection(at, app)}",
  )
}

/// The `[limits]` key a form field changes, as the host names it.
fn limitKey(field: String) -> String {
  if field == "maxHostCalls" {
    "max_host_calls"
  } else if field == "deadlineMs" {
    "deadline"
  } else if field == "maxHeapWords" {
    "max_heap_words"
  } else if field == "maxInFlight" {
    "max_in_flight"
  } else if field == "maxQueued" {
    "max_queued"
  } else if field == "maxRequestBytes" {
    "max_request_bytes"
  } else {
    "max_response_bytes"
  }
}

fn enableForm(at: String, app: host.App) -> String {
  if app.isAdmin {
    return "<h2>Routing</h2><div class=panel><p class=muted>The admin app cannot disable itself. On the machine, <code>minicloud disable admin</code> can.</p></div>"
  }
  if app.state == "disabled" {
    return "<h2>Routing</h2><div class=panel><form method=post action=\"{h(at)}/enable\"><p>Disabled: requests are answered 503, and its data is kept.</p><div class=actions><button class=primary>Enable</button></div></form></div>"
  }
  if app.state == "removed" {
    return ""
  }
  "<h2>Routing</h2><div class=panel><form method=post action=\"{h(at)}/disable\"><p>Disabling stops routing to it — requests are answered 503 — and keeps its data; requests in flight finish.</p><div class=actions><button class=danger>Disable</button></div></form></div>"
}

/// The grant, the allowlist and the limits, as a form: the app's current
/// settings, or `posted` as it was posted.
fn configureForm(
  at: String,
  app: host.App,
  capabilities: Array<String>,
  posted: Option<Map<String, String>>,
) -> String {
  if app.state == "removed" {
    return ""
  }
  var boxes = Vector.of()
  for capability in capabilities {
    let checked = match posted {
      Some(form) => form.contains("cap.{capability}")
      None => app.granted.contains(capability)
    }
    let needed = if app.required.contains(capability) { " <span class=note>the code uses it</span>" } else { "" }
    if !app.isAdmin && capability == "admin" {
      // Only the admin app may hold it; the host refuses it to any other.
      continue
    }
    if app.isAdmin && capability == "admin" {
      // Not the admin app's to give up: sent whatever the box says.
      boxes.push("<label class=cap><input type=hidden name=\"cap.admin\" value=on><input type=checkbox checked disabled> <code>admin</code>{needed}</label>")
    } else {
      boxes.push(
        "<label class=cap><input type=checkbox name=\"cap.{h(capability)}\"{if checked { " checked" } else { "" }}> <code>{h(capability)}</code>{needed}</label>",
      )
    }
  }
  let allow = match posted {
    Some(form) => form.get("allow").unwrapOr("")
    None => "\n".join(app.fetchAllow)
  }
  var inputs = Vector.of()
  for field in limitFields() {
    let value = match posted {
      Some(form) => form.get(field.name).unwrapOr("")
      None => "{limitValue(app.limits, field.name)}"
    }
    inputs.push(
      "<div class=field><label for=\"{h(field.name)}\">{h(field.label)}</label><input id=\"{h(field.name)}\" name=\"{h(field.name)}\" value=\"{h(value)}\" inputmode=numeric required></div>",
    )
  }
  "<h2>Configuration</h2><div class=panel><form method=post action=\"{h(at)}/configure\"><fieldset><legend>Grant</legend><div class=caps>{"".join(boxes.freeze())}</div></fieldset><fieldset><legend>Fetch allowlist</legend><p class=muted>One per line: <code>https://host</code>, <code>http://host:port</code> or <code>http://host:*</code>.</p><textarea name=allow rows=5>{h(allow)}</textarea></fieldset><fieldset><legend>Limits</legend><div class=fields>{"".join(inputs.freeze())}</div></fieldset><div class=actions><button class=primary>Check and apply</button><span class=muted>The host reloads the app with these settings; a change that does not work is not kept.</span></div></form></div>"
}

fn resetForm(at: String) -> String {
  "<form method=post action=\"{h(at)}/reset\"><div class=actions><button>Reset to app.toml</button><span class=muted>Drops every change made here to the grant, the allowlist and the limits.</span></div></form>"
}

fn errorsTable(errors: Array<host.Failure>) -> String {
  if errors.length() == 0 {
    return "<h2>Recent errors</h2><p class=muted>None.</p>"
  }
  var rows = Vector.of()
  for error in errors {
    rows.push(
      "<tr><td class=\"title when\" data-label=\"at (UTC)\">{text.isoTime(error.atMs)}</td><td data-label=kind><code>{h(error.kind)}</code></td><td data-label=status>{error.status}</td><td data-label=version><code>{h(error.version)}</code></td><td class=block data-label=message><pre>{h(error.message)}</pre></td></tr>",
    )
  }
  "<h2>Recent errors</h2><div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>at (UTC)</th><th>kind</th><th>status</th><th>version</th><th>message</th></tr>{"".join(rows.freeze())}</table></div>"
}

// ------------------------------------------- an app's store and its log

/// How many keys a page of the store shows.
fn storePageSize() -> Int {
  50
}

/// The path of an app's pages.
fn appAt(base: String, app: host.App) -> String {
  "{base}/apps/{app.name}"
}

/// Where the page is, above its heading.
fn crumb(base: String, app: host.App, here: String) -> String {
  "<p class=crumb><a href=\"{h(base)}/\">apps</a> / <a href=\"{h(appAt(base, app))}\">{h(app.name)}</a> / {h(here)}</p>"
}

/// The time of day of `millis`, the whole stamp as its title.
fn atTime(millis: Int) -> String {
  let stamp = text.isoTime(millis)
  let clock = stamp.sliceBytes(11, 23).unwrapOr(stamp)
  "<span title=\"{h(stamp)}\">{h(clock)}</span>"
}

/// One app's store: a page of its keys, or — with `?key=` — one key whole.
/// Reading only: the admin app has no way to write to another app's store,
/// and the host gives it none.
fn storePage(base: String, app: host.App, request: web.Request) -> String {
  let key = request.query.get("key").unwrapOr("")
  if key != "" {
    return storeKeyPage(base, app, key)
  }
  let at = appAt(base, app)
  let prefix = request.query.get("prefix").unwrapOr("")
  let after = request.query.get("after").unwrapOr("")
  if !app.granted.contains("kv") {
    return layout(
      base,
      "apps",
      "{app.name} store",
      "{crumb(base, app, "store")}<h1>{h(app.name)} <span class=muted>store</span></h1><p class=lead><code>{h(app.name)}</code> is not granted <code>kv</code>: it has no store, and the host keeps no file for it.</p>",
    )
  }
  // One more than the page, to know whether there is another page.
  let size = storePageSize()
  let found = host.kv(app.name, prefix, after, size + 1)
  var rows = Vector.of()
  var at_ = 0
  var last = ""
  for entry in found {
    if at_ < size {
      let link = "{at}/kv?key={text.urlEncode(entry.key)}"
      // The host cut at its own length; a row of a table wants less again.
      let preview = text.truncateBytes(entry.value, 140)
      let cut = entry.cut || preview.byteLength() < entry.value.byteLength()
      let shown = if cut { "{h(preview)}<span class=muted>…</span>" } else { h(preview) }
      rows.push(
        "<tr><td class=title data-label=key><a href=\"{h(link)}\"><code>{h(entry.key)}</code></a></td><td class=\"value block\" data-label=value><code>{shown}</code></td><td class=nums data-label=size>{text.bytes(entry.bytes)}</td></tr>",
      )
      last = entry.key
    }
    at_ = at_ + 1
  }
  let more = at_ > size
  let table = if rows.length() == 0 {
    let why = if prefix == "" && after == "" {
      "This store has no keys yet."
    } else {
      "No key here."
    }
    "<p class=muted>{h(why)}</p>"
  } else {
    "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>key</th><th>value</th><th>size</th></tr>{"".join(rows.freeze())}</table></div>"
  }
  let filter = "<form class=inline method=get action=\"{h(at)}/kv\"><label for=prefix>keys starting with</label><input id=prefix name=prefix value=\"{h(prefix)}\" placeholder=\"(any)\"><button>Show</button></form>"
  var steps = Vector.of()
  if after != "" {
    steps.push("<a href=\"{h("{at}/kv?prefix={text.urlEncode(prefix)}")}\">← the first {size}</a>")
  }
  if more {
    steps.push("<a href=\"{h("{at}/kv?prefix={text.urlEncode(prefix)}&after={text.urlEncode(last)}")}\">the next {size} →</a>")
  }
  let paging = if steps.length() == 0 { "" } else { "<p class=actions>{" ".join(steps.freeze())}</p>" }
  let held = if app.kvKeys < 0 {
    "The host has not opened this store since it started."
  } else {
    "{app.kvKeys} keys, {text.bytes(app.kvBytes)} in all."
  }
  layout(
    base,
    "apps",
    "{app.name} store",
    "{crumb(base, app, "store")}<h1>{h(app.name)} <span class=muted>store</span></h1><p class=lead>{h(held)} A value longer than the column is cut; the key opens it whole. Nothing here writes: the admin app reads another app's store and cannot change it.</p>{filter}{table}{paging}",
  )
}

/// One key of an app's store, its value whole (cut at what the host
/// carries, which the page says).
fn storeKeyPage(base: String, app: host.App, key: String) -> String {
  let at = appAt(base, app)
  let back = "<p class=actions><a href=\"{h(at)}/kv\">← every key</a></p>"
  match host.kvValue(app.name, key) {
    Ok(entry) => {
      let cut = if entry.cut { " <span class=muted>(cut: the whole value is {text.bytes(entry.bytes)})</span>" } else { "" }
      let facts = "<div class=\"scroll narrow\"><table class=facts><tr><th>key</th><td><code>{h(entry.key)}</code></td></tr><tr><th>size</th><td>{text.bytes(entry.bytes)}{cut}</td></tr></table></div>"
      layout(
        base,
        "apps",
        "{app.name} store",
        "{crumb(base, app, "store")}<h1>{h(app.name)} <span class=muted>key</span></h1>{facts}<h2>Value</h2><pre>{h(entry.value)}</pre>{back}",
      )
    }
    Err(error) => layout(
      base,
      "apps",
      "{app.name} store",
      "{crumb(base, app, "store")}<h1>{h(app.name)} <span class=muted>key</span></h1><div class=problem><b>Not read.</b> The host said:<pre>{h(error.message)}</pre></div>{back}",
    )
  }
}

// ------------------------------------- the code the app is running
//
// No entry in `nav` for this: it is an app's own page, like its store and
// its log, reached from the app and placed by `crumb`. The navigation is
// the three things that are not about one app (apps, secrets, history).

/// How many files a page of a deploy shows.
fn codePageSize() -> Int {
  200
}

/// The longest file text the host carries (`crate::code::READ_TEXT_BYTES`),
/// so that a page that was cut can say at what.
fn codeTextBytes() -> Int {
  131072
}

/// What `assets/` is called in a deploy's names, which is also what comes
/// off one to leave the path the host answers that file on.
fn assetsPrefix() -> String {
  "assets/"
}

/// What a file is, as the listing says it. The configuration first, because
/// it is the thing that decides what the app may do and the usual reason to
/// look.
fn codeKind(file: host.CodeFile) -> String {
  if file.kind == "config" {
    return "<span class=muted>configuration</span>"
  }
  if file.kind == "cove" {
    return "<span class=muted>code</span>"
  }
  if file.isText {
    return "<span class=muted>asset</span>"
  }
  "<span class=muted>asset, not text</span>"
}

/// What the file of the same name in the app's directory says of this one.
/// `same` is the quiet case; the others are what a deploy that was staged
/// and not switched to, or an edit made on the machine, looks like from
/// here. The colours are the state badges' rather than two more of their
/// own: a difference is the bad news and a file that is not there to
/// compare is the odd news.
fn onDisk(file: host.CodeFile) -> String {
  if file.kind == "config" {
    // There is nothing for it to disagree with: the load keeps only what
    // it parsed to, so this file is the directory's.
    return "<span class=muted title=\"this file is read from the app's directory\">read from there</span>"
  }
  if file.onDisk == "same" {
    return "<span class=muted>same</span>"
  }
  if file.onDisk == "differs" {
    return "<span class=\"state refused\" title=\"the file in the app's directory is not the one that is running\">differs</span>"
  }
  if file.onDisk == "missing" {
    return "<span class=\"state removed\" title=\"the app's directory has no such file\">missing</span>"
  }
  "<span class=\"state removed\" title=\"the file in the app's directory could not be read\">unread</span>"
}

/// Where the host answers an asset of this app, as a path: the whole path is
/// the app's where it is reached by hostname, and `/<app>/…` where it is
/// reached by path.
///
/// Only an asset has one — the name it takes `assets/` off is an asset's —
/// so the caller asks this of nothing else.
fn servedAt(app: host.App, file: host.CodeFile) -> String {
  let prefix = assetsPrefix()
  let within = file.name.sliceBytes(prefix.byteLength(), file.name.byteLength()).unwrapOr("")
  if app.hosts.length() > 0 {
    return "/{within}"
  }
  "/{app.name}/{within}"
}

/// Which hostname that path is on. Said rather than linked: these pages are
/// reached by a hostname of their own, and a hostname bound to an app
/// reaches that app with the whole path, so `/{app}/file` written from here
/// would be a request to this app and a 404.
fn servedOn(app: host.App) -> String {
  match app.hosts.get(0) {
    Some(hostname) => "<code>{h(hostname)}</code>"
    None => "whichever hostname reaches the host's apps by path"
  }
}

/// What the version the app is running is made of: its `app.toml`, its
/// `.cove` files at any depth and its `assets/` — the whole of what a deploy
/// carries — or, with `?file=`, one file's text.
///
/// What is shown is what is **running**: the code is the source map the app
/// was compiled with and the assets are the bytes the host serves, both held
/// since the app was loaded, so neither can disagree with the version above.
/// `app.toml` is the exception — the load keeps only what it parsed to — and
/// is read from the app's directory.
fn codePage(base: String, app: host.App, request: web.Request) -> String {
  let file = request.query.get("file").unwrapOr("")
  if file != "" {
    return codeFilePage(base, app, file)
  }
  let at = appAt(base, app)
  // One more than the page, to know whether there are more.
  let size = codePageSize()
  let found = host.code(app.name, size + 1)
  var rows = Vector.of()
  var at_ = 0
  var differing = 0
  for entry in found {
    if at_ < size {
      let link = "{at}/code?file={text.urlEncode(entry.name)}"
      rows.push(
        "<tr><td class=title data-label=file><a href=\"{h(link)}\"><code>{h(entry.name)}</code></a></td><td data-label=what>{codeKind(entry)}</td><td class=nums data-label=size>{text.bytes(entry.bytes)}</td><td data-label=\"on disk\">{onDisk(entry)}</td></tr>",
      )
      if entry.kind != "config" && entry.onDisk != "same" {
        differing = differing + 1
      }
    }
    at_ = at_ + 1
  }
  let table = if rows.length() == 0 {
    "<p class=muted>The host has no version of this app loaded, so there is nothing it is running.</p>"
  } else {
    "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>file</th><th>what</th><th>size</th><th>on disk</th></tr>{"".join(rows.freeze())}</table></div>"
  }
  let differs = if differing == 0 {
    ""
  } else {
    let count = if differing == 1 {
      "One file in the app's directory is not the one that is running."
    } else {
      "{differing} files in the app's directory are not the ones that are running."
    }
    "<div class=problem><b>{h(count)}</b> A deploy that was staged and not switched to, or an edit made on the machine: either way, what is below is what the host is running, and the directory holds something else.</div>"
  }
  let more = if at_ > size {
    "<p class=muted>The first {size} files; this deploy has more, which this page does not show.</p>"
  } else {
    ""
  }
  layout(
    base,
    "apps",
    "{app.name} code",
    "{crumb(base, app, "code")}<h1>{h(app.name)} <span class=muted>code</span></h1><p class=lead>What <code>{h(app.version)}</code> is made of: its <code>app.toml</code>, its <code>.cove</code> files and its <code>assets/</code>, which is the whole of what a deploy carries. The code and the assets are the ones the host is running, held since the app was loaded; <code>app.toml</code> is read from the app's directory, because the load keeps only the settings it parsed to — which is why the app's own page can show a grant or a limit this file does not. “on disk” is how the file of the same name in the directory compares. Reading only.</p>{differs}{table}{more}",
  )
}

/// One file of a deploy: its text, cut at what the host carries, which the
/// page says. A file that is not UTF-8 has no text to show — a page that
/// pretended to render a PNG would say less than this does — so where the
/// host answers it is said instead.
fn codeFilePage(base: String, app: host.App, name: String) -> String {
  let at = appAt(base, app)
  let back = "<p class=actions><a href=\"{h(at)}/code\">← every file</a></p>"
  match host.codeFile(app.name, name) {
    Ok(file) => {
      let cut = if file.cut { " <span class=muted>(cut at {text.bytes(codeTextBytes())}: the whole file is {text.bytes(file.bytes)})</span>" } else { "" }
      let facts = "<div class=\"scroll narrow\"><table class=facts><tr><th>file</th><td><code>{h(file.name)}</code></td></tr><tr><th>what</th><td>{codeKind(file)}</td></tr><tr><th>size</th><td>{text.bytes(file.bytes)}{cut}</td></tr><tr><th>on disk</th><td>{onDisk(file)}</td></tr></table></div>"
      let body = if file.isText {
        "<h2>{if file.cut { "The first {text.bytes(codeTextBytes())}" } else { "The file" }}</h2><pre class=code>{h(file.text)}</pre>"
      } else if file.kind == "asset" {
        "<h2>Not text</h2><p class=muted>Not UTF-8, so there is no text of it to show. The host answers this file itself, at <code>{h(servedAt(app, file))}</code> on {servedOn(app)}, where a browser shows it as it is.</p>"
      } else {
        // Only an asset is meant not to be text. A `.cove` file that is not
        // could not have compiled, and an `app.toml` that is not could not
        // have been read — so this is the app's page saying why it is
        // refused, from the other end.
        "<h2>Not text</h2><p class=muted>Not UTF-8, which for this file is not a kind of file but a fault: the host reads it as text or does not load the app at all.</p>"
      }
      layout(
        base,
        "apps",
        "{app.name} code",
        "{crumb(base, app, "code")}<h1>{h(app.name)} <span class=muted>file</span></h1>{facts}{body}{back}",
      )
    }
    Err(error) => layout(
      base,
      "apps",
      "{app.name} code",
      "{crumb(base, app, "code")}<h1>{h(app.name)} <span class=muted>file</span></h1><div class=problem><b>Not read.</b> The host said:<pre>{h(error.message)}</pre></div>{back}",
    )
  }
}

/// The last few lines of an app's log, on the app's own page, with the
/// way to the rest of them.
fn logSection(at: String, app: host.App) -> String {
  let lines = host.logs(app.name, 10)
  let more = "<p class=actions><a href=\"{h(at)}/logs\">the last 200 lines →</a></p>"
  "<h2>Log</h2>{logTable(lines)}{more}"
}

/// The lines of a log, oldest first, as a table of the time and what was
/// said. `lines` is what the host gave: it is never markup.
fn logTable(lines: Array<host.LogLine>) -> String {
  if lines.length() == 0 {
    return "<p class=muted>No lines yet.</p>"
  }
  var rows = Vector.of()
  for line in lines {
    rows.push(
      "<tr><td class=at>{atTime(line.atMs)}</td><td class=said><span class=\"lvl {levelClass(line.level)}\">{h(line.level)}</span>{h(line.text)}</td></tr>",
    )
  }
  "<div class=scroll><table class=log>{"".join(rows.freeze())}</table></div>"
}

/// The class a level is shown with; anything the host grows later reads as
/// a level of its own without a colour of its own.
fn levelClass(level: String) -> String {
  if level == "info" || level == "warn" || level == "error" || level == "host" {
    return "lvl-{level}"
  }
  "lvl-info"
}

/// How many lines a log page shows, as asked for.
fn logLines(request: web.Request) -> Int {
  match Int.parse(request.query.get("n").unwrapOr("").trim()) {
    Ok(asked) => {
      if asked < 1 {
        1
      } else if asked > 1000 {
        1000
      } else {
        asked
      }
    }
    Err(_) => 200
  }
}

/// One app's log: the host's ring of its last lines, oldest first.
fn logPage(base: String, app: host.App, request: web.Request) -> String {
  let at = appAt(base, app)
  let n = logLines(request)
  let lines = host.logs(app.name, n)
  var steps = Vector.of()
  for size in Vector.of(50, 200, 1000).freeze() {
    if size == n {
      steps.push("<b>{size}</b>")
    } else {
      steps.push("<a href=\"{h("{at}/logs?n={size}")}\">{size}</a>")
    }
  }
  let how = "<p class=actions><span class=muted>lines:</span> {" ".join(steps.freeze())}</p>"
  layout(
    base,
    "apps",
    "{app.name} log",
    "{crumb(base, app, "log")}<h1>{h(app.name)} <span class=muted>log</span></h1><p class=lead>What the app logged and what the host said of it, oldest first: {lines.length()} lines, of the last {logKept()} the host keeps in memory, which a restart empties. Every line is also appended to <code>&lt;data&gt;/{h(app.name)}/log.txt</code>, which this page does not read.</p>{how}{logTable(lines)}{how}",
  )
}

/// How many lines the host's ring keeps (`crate::logs::LOG_LINES`).
fn logKept() -> Int {
  1000
}

/// What a `?done=` says after a change went through.
fn notice(request: web.Request) -> String {
  let done = request.query.get("done").unwrapOr("")
  let said = if done == "enable" {
    "Enabled: requests are routed to it again."
  } else if done == "disable" {
    "Disabled: new requests are answered 503; its data is kept."
  } else if done == "configure" {
    "Applied. The host reloaded the app with the new configuration; its state is below."
  } else if done == "reset" {
    "Reset: the app is loaded from its app.toml again."
  } else {
    ""
  }
  if said == "" { "" } else { "<div class=notice>{h(said)} <a href=\"{h(base(request))}/history\">history</a></div>" }
}

fn problemsNotice(problems: Array<String>) -> String {
  var items = Vector.of()
  for problem in problems {
    items.push("<li>{h(problem)}</li>")
  }
  "<div class=problem><b>Nothing was changed.</b> The form has problems:<ul>{"".join(items.freeze())}</ul></div>"
}

fn refusedNotice(action: String, message: String) -> String {
  "<div class=problem><b>Refused: nothing was changed.</b> The host said, of <code>{h(action)}</code>:<pre>{h(message)}</pre></div>"
}

/// The app a change was about: a link, or a dash for a change to the host
/// itself (a secret).
fn historyApp(base: String, app: String) -> String {
  if app == "" {
    return "<span class=muted>–</span>"
  }
  "<a href=\"{h(base)}/apps/{h(app)}\">{h(app)}</a>"
}

fn doneNotice(message: String) -> String {
  "<div class=notice>{h(message)}</div>"
}

/// The secret store: every secret stored or used, and the forms that set,
/// replace and delete them. A value is never part of the page: the store
/// gives none, and the inputs are password fields that start empty.
/// `notice` is said above everything; `name` fills the set form's name.
fn secretsPage(base: String, secrets: Array<host.Secret>, notice: String, name: String) -> String {
  var rows = Vector.of()
  for secret in secrets {
    let state = if secret.set { "<span class=\"state serving\">set</span>" } else { "<span class=\"state refused\">unset</span>" }
    let updated = if secret.set { text.isoTime(secret.updatedMs) } else { "<span class=muted>–</span>" }
    var users = Vector.of()
    for app in secret.apps {
      users.push("<a href=\"{h(base)}/apps/{h(app)}\"><code>{h(app)}</code></a>")
    }
    let used = if users.length() == 0 { "<span class=muted>none</span>" } else { " ".join(users.freeze()) }
    let replace = "<form class=inline method=post action=\"{h(base)}/secrets/set\"><input type=hidden name=name value=\"{h(secret.name)}\"><input type=password name=value autocomplete=new-password required placeholder=\"new value\"><button class=primary>{if secret.set { "Replace" } else { "Set" }}</button></form>"
    let force = if secret.apps.length() > 0 { "<label><input type=checkbox name=force> even though apps use it (they are refused)</label>" } else { "" }
    let delete = if secret.set { "<form class=inline method=post action=\"{h(base)}/secrets/delete\"><input type=hidden name=name value=\"{h(secret.name)}\"><label><input type=checkbox name=confirm required> confirm</label>{force}<button class=danger>Delete</button></form>" } else { "<span class=muted>–</span>" }
    rows.push("<tr><td class=title data-label=name><code>{h(secret.name)}</code></td><td data-label=state>{state}</td><td class=when data-label=\"set at (UTC)\">{updated}</td><td data-label=\"used by\">{used}</td><td class=block data-label=\"set or replace\">{replace}</td><td class=block data-label=delete>{delete}</td></tr>")
  }
  let table = if rows.length() == 0 {
    "<p class=muted>No secret is stored or used.</p>"
  } else {
    "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>name</th><th>state</th><th>set at (UTC)</th><th>used by</th><th>set or replace</th><th>delete</th></tr>{"".join(rows.freeze())}</table></div>"
  }
  let add = "<h2>Set a secret</h2><div class=panel><form method=post action=\"{h(base)}/secrets/set\"><div class=fields><div class=field><label for=secret-name>name</label><input id=secret-name name=name value=\"{h(name)}\" required pattern=\"[A-Za-z0-9][A-Za-z0-9_.\\-]*\" maxlength=64></div><div class=field><label for=secret-value>value</label><input id=secret-value type=password name=value autocomplete=new-password required></div></div><div class=actions><button class=primary>Set</button><span class=muted>Stored by the host (<code>&lt;data&gt;/_host/secrets</code>, mode 0600); the apps that use it are reloaded with it.</span></div></form></div>"
  let about = "<p class=muted>An app takes a stored secret with <code>[secrets] key = \{ store = \"name\" \}</code> in its app.toml, for <code>auth.check</code> or a <code>[fetch.headers]</code> header. A value is write-only: no page, log or history shows it.</p>"
  layout(base, "secrets", "secrets", "<h1>Secrets</h1>{notice}{table}{add}{about}")
}

/// The change history.
fn historyPage(base: String, changes: Array<host.Change>) -> String {
  var rows = Vector.of()
  for change in changes {
    rows.push(
      "<tr><td class=\"title when\" data-label=\"at (UTC)\">{text.isoTime(change.atMs)}</td><td class=nowrap data-label=who>{h(change.who)}</td><td data-label=app>{historyApp(base, change.app)}</td><td class=nowrap data-label=action><code>{h(change.action)}</code></td><td class=block data-label=\"asked for\">{h(change.detail)}</td><td class=block data-label=outcome>{h(change.outcome)}</td></tr>",
    )
  }
  let table = if rows.length() == 0 {
    "<p class=muted>No changes yet.</p>"
  } else {
    "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>at (UTC)</th><th>who</th><th>app</th><th>action</th><th>asked for</th><th>outcome</th></tr>{"".join(rows.freeze())}</table></div>"
  }
  layout(base, "history", "history", "<h1>History</h1><p class=lead>Every change, made here or with <code>minicloud update|remove|enable|disable|reset</code> on the machine, refused ones included; newest first.</p>{table}")
}
