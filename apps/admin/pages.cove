use web
use host
use text

// The pages. Every value that came from the host — an app's name, a reason,
// an error message, a history entry — and every value echoed from a form
// goes through `h` before it is part of a page; the page's own markup is
// the only markup in it. There is no script at all: what the pages do on a
// narrow screen, they do in CSS (`assets/style.css`).

/// `value`, escaped for HTML.
fn h(value: String) -> String {
  text.escapeHtml(value)
}

/// The headers every answer carries: no script, nothing but this site's
/// forms, no framing, no sniffing, no caching, no referrer to another site.
/// The stylesheet and the icon are files the host serves from `assets/`, so
/// `style-src 'self'` and `img-src 'self'` are all the page needs: there is no
/// inline style left that `'unsafe-inline'` would have had to allow.
fn pageHeaders(contentType: String) -> Map<String, String> {
  Map.of(
    MapEntry(key: "content-type", value: contentType),
    MapEntry(
      key: "content-security-policy",
      value: "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
    ),
    MapEntry(key: "x-content-type-options", value: "nosniff"),
    MapEntry(key: "x-frame-options", value: "DENY"),
    MapEntry(key: "referrer-policy", value: "same-origin"),
    MapEntry(key: "cache-control", value: "no-store"),
  )
}

fn htmlResponse(status: Int, page: String) -> web.Response {
  web.Response(status: status, headers: pageHeaders("text/html; charset=utf-8"), body: page)
}

fn textResponse(status: Int, body: String) -> web.Response {
  web.Response(status: status, headers: pageHeaders("text/plain; charset=utf-8"), body: body)
}

/// A `303 See Other` to `location`.
fn redirect(location: String) -> web.Response {
  web.Response(
    status: 303,
    headers: Map.of(
      MapEntry(key: "location", value: location),
      MapEntry(key: "cache-control", value: "no-store"),
    ),
    body: "",
  )
}

/// The navigation, with the page one is on marked.
fn nav(base: String, here: String) -> String {
  var out = Vector.of()
  for item in Vector.of(
    MapEntry(key: "apps", value: "/"),
    MapEntry(key: "logs", value: "/logs"),
    MapEntry(key: "secrets", value: "/secrets"),
    MapEntry(key: "history", value: "/history"),
  )
    .freeze() {
    let mark = if item.key == here { " aria-current=page" } else { "" }
    out.push("<a href=\"{h(base)}{h(item.value)}\"{mark}>{h(item.key)}</a>")
  }
  "<nav>{"".join(out.freeze())}</nav>"
}

/// The query that pins the files in `assets/` to `version`: `?v=<version>`,
/// and "" for a version the host could not say.
///
/// The URL of a file the host serves is otherwise the same URL for every
/// deploy, so a browser or a cache that holds one holds it against the new
/// pages as well — a phone that had the old `style.css` drew the new HTML
/// with it, and only the rules the release added went missing. A version in
/// the URL means there is nothing of an old deploy left to hold: the new
/// pages ask for a URL nothing has.
///
/// An empty `version` leaves the URL as it was. A page whose stylesheet
/// cannot be read is the worst thing this could do, so a host that will not
/// say the version gets the plain URL back and a browser revalidates as
/// before (`cache-control: no-cache`).
fn assetQuery(version: String) -> String {
  if version == "" {
    return ""
  }
  "?v={h(text.urlEncode(version))}"
}

/// The page around `content`. `here` is the navigation entry it belongs to.
///
/// The version is asked for here and not passed in: every page in this
/// module calls `layout`, and a parameter for it would be a score of call
/// sites that each have to remember, with a page that forgot drawn exactly
/// like one that could not be told. The cost is one host call per page — a
/// slot lookup and a `String` clone (`host.selfVersion`), beside the
/// `host.apps` and `host.logs` a page already makes.
fn layout(base: String, here: String, title: String, content: String) -> String {
  let v = assetQuery(host.selfVersion())
  "<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>{h(title)} · minicloud admin</title><link rel=stylesheet href=\"{h(base)}/style.css{v}\"><link rel=icon href=\"{h(base)}/favicon.svg{v}\" type=\"image/svg+xml\"><link rel=icon href=\"{h(base)}/favicon.ico{v}\" sizes=\"16x16 32x32\"></head><body><header><a class=brand href=\"{h(base)}/\">minicloud admin</a>{nav(base, here)}</header><main>{content}</main></body></html>"
}

fn badge(state: String) -> String {
  "<span class=\"state {h(state)}\">{h(state)}</span>"
}

/// A list of names, or a dash.
fn names(items: Array<String>) -> String {
  if items.length() == 0 {
    return "<span class=muted>–</span>"
  }
  var out = Vector.of()
  for item in items {
    out.push("<code>{h(item)}</code>")
  }
  " ".join(out.freeze())
}

/// The grant, with what the admin added and what it took away marked.
fn grantList(app: host.App) -> String {
  var out = Vector.of()
  for capability in app.granted {
    if app.grantAdded.contains(capability) {
      out.push("<code class=added title=\"granted here, not in app.toml\">+{h(capability)}</code>")
    } else {
      out.push("<code>{h(capability)}</code>")
    }
  }
  for capability in app.grantRemoved {
    out.push("<code class=taken title=\"in app.toml, taken away here\">{h(capability)}</code>")
  }
  if out.length() == 0 {
    return "<span class=muted>–</span>"
  }
  " ".join(out.freeze())
}

/// The first line of `reason`.
fn firstLine(reason: String) -> String {
  reason.split("\n").get(0).unwrapOr("")
}

// -------------------------------------------- an app is a workspace
//
// Every page about one app opens the same way: where it is, its name and
// its state, one line of what it is serving and where, and a row of tabs.
// The tabs are what the app was granted — a store it has no grant for gets
// no tab, because the page on the other end of one would say nothing but
// that the host keeps no file for it (issue 108).

/// A page's explanation, folded: the summary is the one line worth reading
/// and what opens is the page's own words, unchanged. A tool belongs on the
/// first screen, and five lines of prose above it put it below the fold.
///
/// `<details>` is HTML and runs nothing, so the CSP is the one every other
/// page has. `summary` and `body` are the page's own markup, and every
/// value of the host's inside them went through `h` before it got here.
fn about(summary: String, body: String) -> String {
  "<details class=about><summary>{summary}</summary><p>{body}</p></details>"
}

/// What a change to an app comes to, which is what every page that can make
/// one says.
fn recheck() -> String {
  "A change to an app is a re-check: the host loads the app again with it and serves the new version only if it loads. Taking away a capability the code needs leaves that app refused — and no other. Changes are kept in the host's data directory and survive restarts and releases."
}

/// One tab of an app's row: what it says, and where it leads.
struct Tab {
  label: String
  path: String
}

/// The tabs of one app, with the page one is on marked.
///
/// **A tab is there when the app has the thing.** An app not granted `sql`
/// has no SQL tab, and the same for `kv` and `queue`: the capabilities an
/// app was granted are the shape of its pages, which is this app saying
/// what the capability model already says. The windows themselves still
/// answer for an app without the grant — a URL somebody kept is not a 404 —
/// and say what is missing; they are simply not offered.
///
/// Overview, Speed, Code and Settings are on every app: each has a version, a
/// configuration, and something to say about how it is running.
///
/// **So is Logs, `log` grant or not.** The ring that page reads is the
/// host's, not the app's: it holds the host's own lines about the app — why
/// it was refused, what a delivery came to — and an app granted nothing at
/// all still has those. The grant decides what the app may write to the
/// log, not whether there is one to read.
fn appTabs(base: String, app: host.App, here: String) -> String {
  let at = appAt(base, app)
  var tabs = Vector.of()
  tabs.push(Tab(label: "Overview", path: at))
  tabs.push(Tab(label: "Speed", path: "{at}/speed"))
  tabs.push(Tab(label: "Logs", path: "{at}/logs"))
  if app.granted.contains("kv") {
    tabs.push(Tab(label: "Data", path: "{at}/kv"))
  }
  if app.granted.contains("sql") {
    tabs.push(Tab(label: "SQL", path: "{at}/sql"))
  }
  if app.granted.contains("queue") {
    tabs.push(Tab(label: "Queues", path: "{at}/queues"))
  }
  tabs.push(Tab(label: "Code", path: "{at}/code"))
  tabs.push(Tab(label: "Settings", path: "{at}/settings"))
  var out = Vector.of()
  for tab in tabs.freeze() {
    let mark = if tab.label == here { " aria-current=page" } else { "" }
    out.push("<a href=\"{h(tab.path)}\"{mark}>{h(tab.label)}</a>")
  }
  "<nav class=tabs>{"".join(out.freeze())}</nav>"
}

/// The head of every page about one app: where it is, its name and state,
/// the line that says what it is serving and where, and the tabs. `here` is
/// the tab this page is.
fn appHead(base: String, app: host.App, here: String) -> String {
  let reached = if app.hosts.length() > 0 {
    names(app.hosts)
  } else {
    "<code>/{h(app.name)}/</code>"
  }
  let version = if app.version == "" {
    "<span class=muted>no version loaded</span>"
  } else {
    "<code>{h(app.version)}</code> {h(app.tier)}"
  }
  let entry = if app.entry == "" { "" } else { " · entry <code>{h(app.entry)}</code>" }
  "<p class=crumb><a href=\"{h(base)}/\">apps</a> / {h(app.name)}</p><h1>{h(app.name)} {badge(app.state)}</h1><p class=sub>{version} · reached at {reached}{entry}</p>{appTabs(base, app, here)}"
}

// ------------------------------------------------------ worth a look
//
// The thing these pages have never had: the host saying what is wrong
// before being asked. Everything here is something the host already knows —
// a refusal and why, the requests that failed, what is on the queues, how
// large a store is against what it may hold, whether the deploy and the
// directory agree, whether an app that asked for Access got it.
//
// Nothing wrong is one line saying so, and that line is not a decoration:
// "is anything wrong" is the question somebody opened the page to answer,
// and a page that answers it only by being empty has not answered it.

/// One line of what is worth a look. `level` is `bad`, `warn`, `ok`, or ""
/// for a line that is neither news nor reassurance; `what` and `seen` are
/// markup, with every value of the host's escaped already.
struct Look {
  level: String
  what: String
  seen: String
}

/// How full a store has to be before this says so, in hundredths.
///
/// Eighty: a store at its limit refuses the app's next write, and the point
/// of saying it early is that nobody reads an admin page in the minute
/// before that happens.
fn storeNearly() -> Int {
  80
}

/// Whether `held` is within [`storeNearly`] of `limit`. A limit of 0 is no
/// limit to be near, and a count of -1 is a store the host has not opened.
fn nearLimit(held: Int, limit: Int) -> Bool {
  if limit <= 0 || held < 0 {
    return false
  }
  held * 100 >= limit * storeNearly()
}

/// `items` as a sentence: `a`, `a and b`, `a, b and c`.
fn sentence(items: Array<String>) -> String {
  if items.length() <= 1 {
    return "".join(items)
  }
  var first = Vector.of()
  var at = 0
  for item in items {
    if at < items.length() - 1 {
      first.push(item)
    }
    at = at + 1
  }
  "{", ".join(first.freeze())} and {items.get(items.length() - 1).unwrapOr("")}"
}

/// The lines, as a list. The worst are first because the caller put them
/// there: nothing is sorted here.
fn lookList(items: Array<Look>) -> String {
  var out = Vector.of()
  for item in items {
    let mark = if item.level == "" { "" } else { " class=\"is-{h(item.level)}\"" }
    let seen = if item.seen == "" { "" } else { "<span class=where>{item.seen}</span>" }
    out.push("<li{mark}><span class=what>{item.what}</span>{seen}</li>")
  }
  "<ul class=look>{"".join(out.freeze())}</ul>"
}

/// What the host has to say about `app` before being asked.
///
/// `queues` and `disk` are passed in because the caller has already asked
/// the host for them: the stores below the list want the same queues, and
/// the disk comparison is the one expensive read on this page.
fn worthALook(base: String, app: host.App, queues: Array<host.Queue>, disk: host.CodeDisk) -> String {
  let at = appAt(base, app)
  let toLog = "<a href=\"{h(at)}/logs\">log</a>"
  var bad = Vector.of()
  var warn = Vector.of()
  var clean = Vector.of()
  // Why it is not serving, which is the whole of the answer when it is not.
  if app.state == "refused" {
    bad.push(
      Look(
        level: "bad",
        what: "Refused, so nothing reaches it: {h(firstLine(app.reason))}",
        seen: "<a href=\"{h(at)}/settings\">settings</a>",
      ),
    )
  } else if app.state == "disabled" {
    warn.push(
      Look(
        level: "warn",
        what: "Disabled: requests are answered 503 and its data is kept.",
        seen: "<a href=\"{h(at)}/settings\">settings</a>",
      ),
    )
  } else if app.state == "removed" {
    warn.push(Look(level: "warn", what: "Removed: the host has no version of it left.", seen: ""))
  }
  // The failures the host kept, newest first, and then how many more there
  // have been than it keeps.
  var shown = 0
  for failure in app.recentErrors {
    if shown < 3 {
      bad.push(
        Look(
          level: "bad",
          what: "A request failed — <code>{h(failure.kind)}</code> {failure.status}: {h(firstLine(failure.message))}",
          seen: "{toLog} · {atTime(failure.atMs)}",
        ),
      )
      shown = shown + 1
    }
  }
  if app.errors > shown {
    let rest = app.errors - shown
    let counted = if rest == 1 { "1 more request has failed" } else { "{rest} more requests have failed" }
    bad.push(Look(level: "bad", what: "{counted} since the load.", seen: toLog))
  }
  if app.errors == 0 {
    clean.push("no request failed")
  }
  if app.rejected > 0 {
    warn.push(
      Look(
        level: "warn",
        what: "{app.rejected} requests were turned away: the app was at <code>max_in_flight</code> or <code>max_queued</code>.",
        seen: "<a href=\"{h(at)}/settings\">limits</a>",
      ),
    )
  } else {
    clean.push("no request was turned away")
  }
  // What is on the queues. A dead letter is the bad news — nothing delivers
  // it again until somebody puts it back — and what is held is a delivery
  // on lease or a failed one waiting for its retry, which is worth a look
  // and is not yet a failure.
  var deadAnywhere = false
  for queue in queues {
    if queue.dead > 0 {
      deadAnywhere = true
      let counted = if queue.dead == 1 { "1 dead letter waits" } else { "{queue.dead} dead letters wait" }
      bad.push(
        Look(
          level: "bad",
          what: "{counted} on <code>{h(queue.name)}</code>: nothing delivers one again until somebody puts it back.",
          seen: "<a href=\"{h(at)}/queues\">queues</a>",
        ),
      )
    }
    if queue.held > 0 {
      warn.push(
        Look(
          level: "warn",
          what: "{queue.held} held on <code>{h(queue.name)}</code>: a delivery on lease, or a failed one waiting for its retry.",
          seen: "<a href=\"{h(at)}/queues\">queues</a>",
        ),
      )
    }
    if !queue.declared {
      warn.push(
        Look(
          level: "warn",
          what: "<code>{h(queue.name)}</code> holds messages and the app's <code>[[queues]]</code> no longer declares it: nothing will ever deliver them.",
          seen: "<a href=\"{h(at)}/queues\">queues</a>",
        ),
      )
    }
  }
  if queues.length() > 0 && !deadAnywhere {
    clean.push("no dead letter waits")
  }
  // A store near what it may hold. The write that reaches the limit is the
  // app's `Err`, and this is the page that could have said so first.
  var tight = false
  if nearLimit(app.kvBytes, app.kvMaxBytes) {
    tight = true
    warn.push(
      Look(
        level: "warn",
        what: "The <code>kv</code> store holds {text.bytes(app.kvBytes)} of the {text.bytes(app.kvMaxBytes)} it may: a write past that is refused.",
        seen: "<a href=\"{h(at)}/kv\">data</a>",
      ),
    )
  }
  if nearLimit(app.kvKeys, app.kvMaxKeys) {
    tight = true
    warn.push(
      Look(
        level: "warn",
        what: "The <code>kv</code> store holds {app.kvKeys} of the {app.kvMaxKeys} keys it may: a write past that is refused.",
        seen: "<a href=\"{h(at)}/kv\">data</a>",
      ),
    )
  }
  if nearLimit(app.sqlBytes, app.sqlMaxBytes) {
    tight = true
    warn.push(
      Look(
        level: "warn",
        what: "The <code>sql</code> store is {text.bytes(app.sqlBytes)} of the {text.bytes(app.sqlMaxBytes)} it may be: a statement that writes past that is refused.",
        seen: "<a href=\"{h(at)}/sql\">sql</a>",
      ),
    )
  }
  if !tight && (app.granted.contains("kv") || app.granted.contains("sql")) {
    clean.push("no store is near its limit")
  }
  // The deploy against the app's directory. `looked` is the host saying
  // whether it read the files at all; a page that said "the same" without
  // having looked would be the one wrong answer here.
  if !disk.looked {
    warn.push(
      Look(
        level: "",
        what: "The deploy was not compared with the app's directory here: it comes to {text.bytes(disk.bytes)}, past the {text.bytes(disk.budget)} this page reads. The Code tab reads every file of it.",
        seen: "<a href=\"{h(at)}/code\">code</a>",
      ),
    )
  } else if disk.differing > 0 {
    let counted = if disk.differing == 1 {
      "One file in the app's directory is not the one that is running"
    } else {
      "{disk.differing} files in the app's directory are not the ones that are running"
    }
    warn.push(
      Look(
        level: "warn",
        what: "{counted}: a deploy staged and not switched to, or an edit made on the machine.",
        seen: "<a href=\"{h(at)}/code\">code</a>",
      ),
    )
  } else {
    clean.push("every file of the deploy is the same as the one in the app's directory")
  }
  // An app that asked for Access and did not get it is serving to whoever
  // reaches it. An app that asked for none says nothing here: it is not
  // this page's business to want Access on an app that never wanted it.
  if app.accessOff != "" {
    warn.push(
      Look(
        level: "warn",
        what: "Cloudflare Access is off for this app — {h(app.accessOff)}.",
        seen: toLog,
      ),
    )
  }
  var items = Vector.of()
  for item in bad.freeze() {
    items.push(item)
  }
  for item in warn.freeze() {
    items.push(item)
  }
  if clean.length() > 0 {
    let lead = if items.length() == 0 { "Nothing" } else { "Nothing else" }
    items.push(Look(level: "ok", what: "{lead}: {sentence(clean.freeze())}.", seen: ""))
  }
  if items.length() == 0 {
    return "<p class=allwell>Nothing the host can see, and nothing it could look at: this app is loaded with no store, no queue and no deploy to compare.</p>"
  }
  lookList(items.freeze())
}

// ----------------------------------------------------- an app's Overview
//
// What is happening, before how it is set up. The numbers, then what is
// worth a look, then a card for each store that is also the way into it,
// then the last lines of the log, then one line about the grant with the
// way to Settings.

/// The numbers, as a band.
fn nowStrip(app: host.App) -> String {
  let errors = if app.errors == 0 { " is-ok" } else { " is-bad" }
  let since = if app.errors == 0 { "none since the load" } else { "since the load" }
  let served = "<div class=fig><span class=lbl>served</span><span class=big>{app.served}</span><span class=note>{app.ok} ok, {app.rejected} rejected</span></div>"
  let failed = "<div class=\"fig{errors}\"><span class=lbl>errors</span><span class=big>{app.errors}</span><span class=note>{since}</span></div>"
  let flight = "<div class=fig><span class=lbl>in flight</span><span class=big>{app.inFlight}</span><span class=note>of {app.limits.maxInFlight}</span></div>"
  let queued = "<div class=fig><span class=lbl>queued</span><span class=big>{app.queued}</span><span class=note>of {app.limits.maxQueued}</span></div>"
  "<div class=strip>{served}{failed}{flight}{queued}</div>"
}

/// One pair of a store's card: a word and a number, the number coloured
/// where it is the thing to look at.
fn storePair(label: String, value: String, level: String) -> String {
  let mark = if level == "" { "" } else { " {h(level)}" }
  "<span class=pair><span class=lbl>{h(label)}</span><span class=\"v{mark}\">{value}</span></span>"
}

/// A store, as a card that is the way into it.
fn storeCard(link: String, name: String, go: String, pairs: String, foot: String) -> String {
  let below = if foot == "" { "" } else { "<span class=foot>{foot}</span>" }
  "<a class=store href=\"{h(link)}\"><span class=top><span class=name>{h(name)}</span><span class=go>{h(go)} →</span></span><span class=pairs>{pairs}</span>{below}</a>"
}

/// A card for each store the app has, and nothing at all for an app with
/// none: an empty heading saying "no stores" is a row of the old table
/// again.
fn storeCards(base: String, app: host.App, queues: Array<host.Queue>) -> String {
  let at = appAt(base, app)
  var cards = Vector.of()
  if app.granted.contains("kv") {
    let keys = if app.kvKeys < 0 { "–" } else { "{app.kvKeys}" }
    let size = if app.kvBytes < 0 { "–" } else { text.bytes(app.kvBytes) }
    let pairs = "{storePair("keys", keys, if nearLimit(app.kvKeys, app.kvMaxKeys) { "is-warn" } else { "" })}{storePair("size", size, if nearLimit(app.kvBytes, app.kvMaxBytes) { "is-warn" } else { "" })}"
    let foot = if app.kvKeys < 0 {
      "The host has not opened this store since it started."
    } else {
      "At most {app.kvMaxKeys} keys and {text.bytes(app.kvMaxBytes)}."
    }
    cards.push(storeCard("{at}/kv", "kv", "browse", pairs, foot))
  }
  if app.granted.contains("sql") {
    let tables = host.sqlTables(app.name)
    var rows = 0
    var counted = true
    var named = Vector.of()
    for table in tables {
      if table.counted {
        rows = rows + table.rows
      } else {
        counted = false
      }
      if named.length() < 4 {
        named.push("<code>{h(table.name)}</code> {if table.counted { "{table.rows}" } else { "?" }}")
      }
    }
    let total = if counted { "{rows}" } else { "{rows}+" }
    let pairs = "{storePair("tables", "{tables.length()}", "")}{storePair("rows", total, "")}"
    let foot = if named.length() == 0 {
      "No tables yet."
    } else {
      " · ".join(named.freeze())
    }
    cards.push(storeCard("{at}/sql", "sql", "run a statement", pairs, foot))
  }
  if queues.length() > 0 {
    var due = 0
    var held = 0
    var dead = 0
    var named = Vector.of()
    for queue in queues {
      due = due + queue.due
      held = held + queue.held
      dead = dead + queue.dead
      if named.length() < 4 {
        named.push("<code>{h(queue.name)}</code>")
      }
    }
    let pairs = "{storePair("due", "{due}", "")}{storePair("held", "{held}", if held > 0 { "is-warn" } else { "" })}{storePair("dead", "{dead}", if dead > 0 { "is-bad" } else { "" })}"
    let listed = " · ".join(named.freeze())
    let foot = if due + held + dead == 0 { "Nothing waits on {listed}." } else { listed }
    cards.push(storeCard("{at}/queues", "queues", "see what waits", pairs, foot))
  }
  if cards.length() == 0 {
    return ""
  }
  "<h2>Stores</h2><div class=stores>{"".join(cards.freeze())}</div>"
}

/// What the Overview's folded line says, which depends on what the app is
/// doing: there is no point summarising a re-check to somebody looking at
/// an app that is refused.
fn overviewSummary(app: host.App) -> String {
  if app.state == "refused" {
    return "Refused: it is not served again until the reason below is gone."
  }
  if app.state == "disabled" {
    return "Disabled: requests are answered 503, and its data is kept."
  }
  if app.state == "removed" {
    return "Removed: the host has no version of it left."
  }
  "Serving the version it was last loaded with; a change is a re-check."
}

/// One app's Overview: what is happening, and the way to everything else
/// about it.
///
/// The host is asked four things here — its queues, its SQL tables, its
/// last log lines, and how the deploy compares with the app's directory —
/// and the last of those is the only one that is not free. `host.codeDisk`
/// reads every file of the deploy to compare it, so it reads nothing at all
/// for a deploy past the host's budget and says which it did; the line this
/// page writes is "they are the same", "these differ", or "I did not look
/// and the Code tab will", and never a guess.
fn appOverviewPage(base: String, app: host.App) -> String {
  let at = appAt(base, app)
  let queues = if app.granted.contains("queue") { host.queues(app.name) } else { Vector.of().freeze() }
  let disk = host.codeDisk(app.name)
  let reason = if app.reason == "" { "" } else { "<pre>{h(app.reason)}</pre>" }
  let lines = host.logs(app.name, 5)
  let log = "<h2>Last lines</h2>{logTable(lines)}<p class=more><a href=\"{h(at)}/logs\">the last 200 lines →</a></p>"
  let required = if app.requiredOpen {
    "{names(app.required)} <span class=muted>(at least: it makes a call the checker cannot follow)</span>"
  } else {
    names(app.required)
  }
  let setUp = "<h2>How it is set up</h2><p class=more>The grant, the fetch allowlist, the limits and the forms that change them are on <a href=\"{h(at)}/settings\">Settings</a>: it is granted {grantList(app)}, and its code requires {required}.</p>"
  layout(
    base,
    "apps",
    app.name,
    "{appHead(base, app, "Overview")}{about(h(overviewSummary(app)), recheck())}{reason}<h2>Now</h2>{nowStrip(app)}<h2>Worth a look</h2>{worthALook(base, app, queues, disk)}{storeCards(base, app, queues)}{log}{setUp}",
  )
}

// ------------------------------------------------------ an app's Settings
//
// Everything that *changes* an app, in one place; the pages that only read
// are the other tabs. There is no link to a window here: the tabs carry
// that, and a second way in is a second thing to keep worded.

/// One app's Settings: what the deploy says, and the forms that change it.
/// `notice` is said above everything; `posted` is a form to show again as it
/// was posted, instead of the app's current settings.
fn settingsPage(
  base: String,
  app: host.App,
  capabilities: Array<String>,
  notice: String,
  posted: Option<Map<String, String>>,
) -> String {
  let at = appAt(base, app)
  let reason = if app.reason == "" { "" } else { "<pre>{h(app.reason)}</pre>" }
  let required = if app.requiredOpen {
    "{names(app.required)} <span class=muted>(at least: it makes a call the checker cannot follow)</span>"
  } else {
    names(app.required)
  }
  let facts = "<h2>What the deploy says <span class=ronly>read only</span></h2><div class=\"scroll narrow\"><table class=facts><tr><th>code requires</th><td>{required}</td></tr><tr><th>granted now</th><td>{grantList(app)}</td></tr></table></div><p class=more>The host read this out of the deploy; it changes when the code does. What is happening — the numbers, the stores, the log — is on <a href=\"{h(at)}\">Overview</a>.</p>"
  let summary = "This is where <code>{h(app.name)}</code> is changed — every change is a re-check, and one that does not load is not kept."
  let told = "{recheck()} Each one is a line in the <a href=\"{h(base)}/history\">history</a>."
  layout(
    base,
    "apps",
    "{app.name} settings",
    "{appHead(base, app, "Settings")}{notice}{about(summary, told)}{reason}{facts}{configureForm(at, app, capabilities, posted)}{enableForm(at, app)}{resetForm(at)}",
  )
}

// ------------------------------------------------------- the list of apps
//
// One card an app, and the ones with something to say first. A row here is
// not configuration: what an app may do and what its code asks for are what
// Settings is for, and reading them down a list told nobody anything.

/// What one app has to say for itself, as the pill at the end of its card.
/// The pill is the way to the page that shows it: a warning somebody has to
/// go and find is a warning that keeps.
struct Flag {
  level: String
  text: String
  path: String
}

/// Whether anything said about an app is the bad kind, which is what puts
/// its card above the ones that are merely worth a look.
fn anyBad(flags: Array<Flag>) -> Bool {
  for flag in flags {
    if flag.level == "is-bad" {
      return true
    }
  }
  false
}

/// What is worth saying about `app` in a list.
///
/// **The deploy is not compared with the app's directory here.** That read
/// is one file of the deploy at a time and this page has every app on it;
/// an app's own Overview does it, within the host's budget, because that
/// page is about one app. So a list says nothing about the files, rather
/// than saying something it did not check.
fn appFlags(base: String, app: host.App, queues: Array<host.Queue>) -> Array<Flag> {
  let at = appAt(base, app)
  var out = Vector.of()
  if app.state == "refused" {
    out.push(Flag(level: "is-bad", text: "refused", path: "{at}/settings"))
  }
  if app.errors > 0 {
    let counted = if app.errors == 1 { "1 failed" } else { "{app.errors} failed" }
    out.push(Flag(level: "is-bad", text: h(counted), path: at))
  }
  for queue in queues {
    if queue.dead > 0 {
      out.push(
        Flag(level: "is-bad", text: "{queue.dead} dead on <code>{h(queue.name)}</code>", path: "{at}/queues"),
      )
    }
  }
  for queue in queues {
    if queue.held > 0 {
      out.push(
        Flag(level: "is-warn", text: "{queue.held} held on <code>{h(queue.name)}</code>", path: "{at}/queues"),
      )
    }
  }
  if nearLimit(app.kvBytes, app.kvMaxBytes) || nearLimit(app.kvKeys, app.kvMaxKeys) {
    out.push(Flag(level: "is-warn", text: "<code>kv</code> near its limit", path: "{at}/kv"))
  }
  if nearLimit(app.sqlBytes, app.sqlMaxBytes) {
    out.push(Flag(level: "is-warn", text: "<code>sql</code> near its limit", path: "{at}/sql"))
  }
  if app.accessOff != "" {
    out.push(Flag(level: "is-warn", text: "Access off", path: at))
  }
  out.freeze()
}

/// One app's card.
fn appCard(base: String, app: host.App, flags: Array<Flag>) -> String {
  let at = appAt(base, app)
  var worst = ""
  for flag in flags {
    if flag.level == "is-bad" {
      worst = "is-bad"
    } else if worst == "" {
      worst = "is-warn"
    }
  }
  let tone = if worst == "" { "" } else { " {worst}" }
  let mine = if app.isAdmin { " <span class=muted>(this app)</span>" } else { "" }
  let who = "<div class=who><a class=nm href=\"{h(at)}\">{h(app.name)}</a>{badge(app.state)}{mine}</div>"
  let reached = if app.hosts.length() > 0 {
    names(app.hosts)
  } else {
    "<code>/{h(app.name)}/</code>"
  }
  let version = if app.version == "" {
    "<span class=muted>no version loaded</span>"
  } else {
    "<code>{h(app.version)}</code> {h(app.tier)}"
  }
  // A refusal's reason is the one thing a list cannot send somebody to go
  // and read: it is why the app is not working at all.
  let why = if app.reason == "" { "" } else { "<div class=muted>{h(firstLine(app.reason))}</div>" }
  let what = "<div class=what>{version} · reached at {reached}{why}</div>"
  let count = "<div class=count><span class=n>{app.served}</span> served <span class=muted>· {app.errors} errors · {app.inFlight} in flight</span></div>"
  var pills = Vector.of()
  for flag in flags {
    pills.push("<a class=\"flag {h(flag.level)}\" href=\"{h(flag.path)}\">{flag.text} →</a>")
  }
  let said = if pills.length() == 0 {
    "<span class=quiet>quiet</span>"
  } else {
    "".join(pills.freeze())
  }
  "<li class=\"app{tone}\">{who}{what}{count}<div class=flags>{said}</div></li>"
}

/// Every app, one card each, the ones with something to say first.
///
/// This asks the host for each app's queues, which is one read of its queue
/// store: a dead letter nobody has looked at is the thing this list exists
/// to put in front of somebody, and a list that could not say it would send
/// them through every app's page to find out.
fn appsPage(base: String, apps: Array<host.App>) -> String {
  var serving = 0
  var served = 0
  var errors = 0
  var away = Vector.of()
  var bad = Vector.of()
  var warn = Vector.of()
  var quiet = Vector.of()
  var wanting = 0
  for app in apps {
    served = served + app.served
    errors = errors + app.errors
    if app.state == "serving" {
      serving = serving + 1
    } else {
      away.push("{app.name} {app.state}")
    }
    let queues = if app.granted.contains("queue") { host.queues(app.name) } else { Vector.of().freeze() }
    let flags = appFlags(base, app, queues)
    if flags.length() == 0 {
      quiet.push(appCard(base, app, flags))
    } else {
      wanting = wanting + 1
      // Worst first, as an app's own list is: a dead letter is something
      // that was lost and a held message is something that is late, and a
      // list that mixed them makes the reader sort them again.
      if anyBad(flags) {
        bad.push(appCard(base, app, flags))
      } else {
        warn.push(appCard(base, app, flags))
      }
    }
  }
  let rest = if away.length() == 0 {
    "all serving"
  } else {
    "{serving} serving, {", ".join(away.freeze())}"
  }
  let wants = if wanting == 0 {
    ""
  } else if wanting == 1 {
    " <b>1 wants a look.</b>"
  } else {
    " <b>{wanting} want a look.</b>"
  }
  let counted = if errors == 1 { "1 error" } else { "{errors} errors" }
  let lead = "<p class=sub>{apps.length()} apps — {h(rest)} — {served} requests served, {h(counted)}.{wants}</p>"
  let cards = "<ul class=apps>{"".join(bad.freeze())}{"".join(warn.freeze())}{"".join(quiet.freeze())}</ul>"
  let trailer = "<p class=more>The ones with something to say are first, and the worst of those above the rest; the others are quiet, and a quiet app has no failed request, no refusal, no dead letter and no store near its limit. What each app may do, and what its code asks for, is on that app's Settings.</p>"
  layout(
    base,
    "apps",
    "apps",
    "<h1>Apps</h1>{lead}{about("A change to an app is a re-check: it is served again only if it loads.", recheck())}{cards}{trailer}",
  )
}

/// The `[limits]` key a form field changes, as the host names it.
fn limitKey(field: String) -> String {
  if field == "maxHostCalls" {
    "max_host_calls"
  } else if field == "deadlineMs" {
    "deadline"
  } else if field == "maxHeapWords" {
    "max_heap_words"
  } else if field == "maxInFlight" {
    "max_in_flight"
  } else if field == "maxQueued" {
    "max_queued"
  } else if field == "maxRequestBytes" {
    "max_request_bytes"
  } else {
    "max_response_bytes"
  }
}

fn enableForm(at: String, app: host.App) -> String {
  if app.isAdmin {
    return "<h2>Routing</h2><div class=panel><p class=muted>The admin app cannot disable itself. On the machine, <code>minicloud disable admin</code> can.</p></div>"
  }
  if app.state == "removed" {
    return ""
  }
  if app.state == "disabled" {
    return "<h2>Routing</h2><div class=panel><form method=post action=\"{h(at)}/enable\"><p>Disabled: requests are answered 503, and its data is kept.</p><div class=actions><button class=primary>Enable</button></div></form></div>"
  }
  "<h2>Routing</h2><div class=panel><form method=post action=\"{h(at)}/disable\"><p>Disabling stops routing to it — requests are answered 503 — and keeps its data; requests in flight finish.</p><div class=actions><button class=danger>Disable</button></div></form></div>"
}

/// The grant, the allowlist and the limits, as a form: the app's current
/// settings, or `posted` as it was posted.
fn configureForm(
  at: String,
  app: host.App,
  capabilities: Array<String>,
  posted: Option<Map<String, String>>,
) -> String {
  if app.state == "removed" {
    return ""
  }
  var boxes = Vector.of()
  for capability in capabilities {
    let checked = match posted {
      Some(form) => form.contains("cap.{capability}")
      None => app.granted.contains(capability)
    }
    let needed = if app.required.contains(capability) { " <span class=note>the code uses it</span>" } else { "" }
    if !app.isAdmin && capability == "admin" {
      // Only the admin app may hold it; the host refuses it to any other.
      continue
    }
    if app.isAdmin && capability == "admin" {
      // Not the admin app's to give up: sent whatever the box says.
      boxes.push("<label class=cap><input type=hidden name=\"cap.admin\" value=on><input type=checkbox checked disabled> <code>admin</code>{needed}</label>")
    } else {
      boxes.push(
        "<label class=cap><input type=checkbox name=\"cap.{h(capability)}\"{if checked { " checked" } else { "" }}> <code>{h(capability)}</code>{needed}</label>",
      )
    }
  }
  let allow = match posted {
    Some(form) => form.get("allow").unwrapOr("")
    None => "\n".join(app.fetchAllow)
  }
  var inputs = Vector.of()
  for field in limitFields() {
    let value = match posted {
      Some(form) => form.get(field.name).unwrapOr("")
      None => "{limitValue(app.limits, field.name)}"
    }
    // The field holds the value; this says where the value came from, which
    // is the one thing the form cannot show by holding it.
    let changed = if app.limitsChanged.contains(limitKey(field.name)) {
      " <span class=added title=\"set here, not in app.toml\">(changed)</span>"
    } else {
      ""
    }
    inputs.push(
      "<div class=field><label for=\"{h(field.name)}\">{h(field.label)}{changed}</label><input id=\"{h(field.name)}\" name=\"{h(field.name)}\" value=\"{h(value)}\" inputmode=numeric required></div>",
    )
  }
  "<h2>Grant, allowlist and limits</h2><div class=panel><form method=post action=\"{h(at)}/configure\"><fieldset><legend>Grant</legend><p class=more>A capability the code needs and does not have leaves this app refused, and no other.</p><div class=caps>{"".join(boxes.freeze())}</div></fieldset><fieldset><legend>Fetch allowlist</legend><p class=muted>One per line: <code>https://host</code>, <code>http://host:port</code> or <code>http://host:*</code>.</p><textarea name=allow rows=5>{h(allow)}</textarea></fieldset><fieldset><legend>Limits</legend><div class=fields>{"".join(inputs.freeze())}</div></fieldset><div class=actions><button class=primary>Check and apply</button><span class=muted>The host reloads the app with these settings; a change that does not work is not kept.</span></div></form></div>"
}

fn resetForm(at: String) -> String {
  "<h2>Back to the deploy</h2><div class=panel><form method=post action=\"{h(at)}/reset\"><div class=actions><button>Reset to app.toml</button><span class=muted>Drops every change made here to the grant, the allowlist and the limits.</span></div></form></div>"
}

// ------------------------------------------- an app's store and its log

/// How many keys a page of the store shows.
fn storePageSize() -> Int {
  50
}

/// The path of an app's pages.
fn appAt(base: String, app: host.App) -> String {
  "{base}/apps/{app.name}"
}

/// The time of day of `millis`, the whole stamp as its title.
fn atTime(millis: Int) -> String {
  let stamp = text.isoTime(millis)
  let clock = stamp.sliceBytes(11, 23).unwrapOr(stamp)
  "<span title=\"{h(stamp)}\">{h(clock)}</span>"
}

/// One app's store: a page of its keys, or — with `?key=` — one key whole.
/// Reading only: the admin app has no way to write to another app's store,
/// and the host gives it none.
fn storePage(base: String, app: host.App, request: web.Request) -> String {
  let key = request.query.get("key").unwrapOr("")
  if key != "" {
    return storeKeyPage(base, app, key)
  }
  let at = appAt(base, app)
  let prefix = request.query.get("prefix").unwrapOr("")
  let after = request.query.get("after").unwrapOr("")
  if !app.granted.contains("kv") {
    return layout(
      base,
      "apps",
      "{app.name} store",
      "{appHead(base, app, "Data")}<p class=lead><code>{h(app.name)}</code> is not granted <code>kv</code>: it has no store, and the host keeps no file for it.</p>",
    )
  }
  // One more than the page, to know whether there is another page.
  let size = storePageSize()
  let found = host.kv(app.name, prefix, after, size + 1)
  var rows = Vector.of()
  var at_ = 0
  var last = ""
  for entry in found {
    if at_ < size {
      let link = "{at}/kv?key={text.urlEncode(entry.key)}"
      // The host cut at its own length; a row of a table wants less again.
      let preview = text.truncateBytes(entry.value, 140)
      let cut = entry.cut || preview.byteLength() < entry.value.byteLength()
      let shown = if cut { "{h(preview)}<span class=muted>…</span>" } else { h(preview) }
      rows.push(
        "<tr><td class=title data-label=key><a href=\"{h(link)}\"><code>{h(entry.key)}</code></a></td><td class=\"value block\" data-label=value><code>{shown}</code></td><td class=nums data-label=size>{text.bytes(entry.bytes)}</td></tr>",
      )
      last = entry.key
    }
    at_ = at_ + 1
  }
  let more = at_ > size
  let table = if rows.length() == 0 {
    let why = if prefix == "" && after == "" {
      "This store has no keys yet."
    } else {
      "No key here."
    }
    "<p class=muted>{h(why)}</p>"
  } else {
    "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>key</th><th>value</th><th>size</th></tr>{"".join(rows.freeze())}</table></div>"
  }
  let filter = "<form class=inline method=get action=\"{h(at)}/kv\"><label for=prefix>keys starting with</label><input id=prefix name=prefix value=\"{h(prefix)}\" placeholder=\"(any)\"><button>Show</button></form>"
  var steps = Vector.of()
  if after != "" {
    steps.push("<a href=\"{h("{at}/kv?prefix={text.urlEncode(prefix)}")}\">← the first {size}</a>")
  }
  if more {
    steps.push("<a href=\"{h("{at}/kv?prefix={text.urlEncode(prefix)}&after={text.urlEncode(last)}")}\">the next {size} →</a>")
  }
  let paging = if steps.length() == 0 { "" } else { "<p class=actions>{" ".join(steps.freeze())}</p>" }
  let held = if app.kvKeys < 0 {
    "The host has not opened this store since it started."
  } else {
    "{app.kvKeys} keys, {text.bytes(app.kvBytes)} in all."
  }
  layout(
    base,
    "apps",
    "{app.name} store",
    "{appHead(base, app, "Data")}{about("Reading only — the admin app cannot write to another app's store.", "{h(held)} A value longer than the column is cut; the key opens it whole. Nothing here writes: the admin app reads another app's store and cannot change it.")}{filter}{table}{paging}",
  )
}

/// One key of an app's store, its value whole (cut at what the host
/// carries, which the page says).
fn storeKeyPage(base: String, app: host.App, key: String) -> String {
  let at = appAt(base, app)
  let back = "<p class=actions><a href=\"{h(at)}/kv\">← every key</a></p>"
  match host.kvValue(app.name, key) {
    Ok(entry) => {
      let cut = if entry.cut { " <span class=muted>(cut: the whole value is {text.bytes(entry.bytes)})</span>" } else { "" }
      let facts = "<div class=\"scroll narrow\"><table class=facts><tr><th>key</th><td><code>{h(entry.key)}</code></td></tr><tr><th>size</th><td>{text.bytes(entry.bytes)}{cut}</td></tr></table></div>"
      layout(
        base,
        "apps",
        "{app.name} store",
        "{appHead(base, app, "Data")}{facts}<h2>Value</h2><pre>{h(entry.value)}</pre>{back}",
      )
    }
    Err(error) => layout(
      base,
      "apps",
      "{app.name} store",
      "{appHead(base, app, "Data")}<div class=problem><b>Not read.</b> The host said:<pre>{h(error.message)}</pre></div>{back}",
    )
  }
}

// ------------------------------------- the code the app is running
//
// No entry in `nav` for this: it is an app's own page, like its store and
// its log, reached from the app and placed by `crumb`. The navigation is
// the three things that are not about one app (apps, secrets, history).

/// How many files a page of a deploy shows.
fn codePageSize() -> Int {
  200
}

/// The longest file text the host carries (`crate::code::READ_TEXT_BYTES`),
/// so that a page that was cut can say at what.
fn codeTextBytes() -> Int {
  131072
}

/// The most pieces one file's colouring carries
/// (`crate::code::HIGHLIGHT_PIECES`), so that a file shown plain for being
/// past it can say what it was past.
fn codePieceLimit() -> Int {
  20000
}

/// What `assets/` is called in a deploy's names, which is also what comes
/// off one to leave the path the host answers that file on.
fn assetsPrefix() -> String {
  "assets/"
}

/// What a file is, as the listing says it. The configuration first, because
/// it is the thing that decides what the app may do and the usual reason to
/// look.
fn codeKind(file: host.CodeFile) -> String {
  if file.kind == "dir" {
    return "<span class=muted>directory</span>"
  }
  if file.kind == "config" {
    return "<span class=muted>configuration</span>"
  }
  if file.kind == "cove" {
    return "<span class=muted>code</span>"
  }
  if file.isText {
    return "<span class=muted>asset</span>"
  }
  "<span class=muted>asset, not text</span>"
}

/// What the file of the same name in the app's directory says of this one.
/// `same` is the quiet case; the others are what a deploy that was staged
/// and not switched to, or an edit made on the machine, looks like from
/// here. The colours are the state badges' rather than two more of their
/// own: a difference is the bad news and a file that is not there to
/// compare is the odd news.
fn onDisk(file: host.CodeFile) -> String {
  if file.kind == "dir" {
    // A directory is not a file, so there is no file of it on disk for the
    // one that is running to differ from. A row of the tree asks this of
    // the files only; this is what a caller that does not is told.
    return "<span class=muted>–</span>"
  }
  if file.kind == "config" {
    // There is nothing for it to disagree with: the load keeps only what
    // it parsed to, so this file is the directory's.
    return "<span class=muted title=\"this file is read from the app's directory\">read from there</span>"
  }
  if file.onDisk == "same" {
    return "<span class=muted>same</span>"
  }
  if file.onDisk == "differs" {
    return "<span class=\"state refused\" title=\"the file in the app's directory is not the one that is running\">differs</span>"
  }
  if file.onDisk == "missing" {
    return "<span class=\"state removed\" title=\"the app's directory has no such file\">missing</span>"
  }
  "<span class=\"state removed\" title=\"the file in the app's directory could not be read\">unread</span>"
}

/// Where the host answers an asset of this app, as a path: the whole path is
/// the app's where it is reached by hostname, and `/<app>/…` where it is
/// reached by path.
///
/// Only an asset has one — the name it takes `assets/` off is an asset's —
/// so the caller asks this of nothing else.
fn servedAt(app: host.App, file: host.CodeFile) -> String {
  let prefix = assetsPrefix()
  let within = file.name.sliceBytes(prefix.byteLength(), file.name.byteLength()).unwrapOr("")
  if app.hosts.length() > 0 {
    return "/{within}"
  }
  "/{app.name}/{within}"
}

/// Which hostname that path is on. Said rather than linked: these pages are
/// reached by a hostname of their own, and a hostname bound to an app
/// reaches that app with the whole path, so `/{app}/file` written from here
/// would be a request to this app and a 404.
fn servedOn(app: host.App) -> String {
  match app.hosts.get(0) {
    Some(hostname) => "<code>{h(hostname)}</code>"
    None => "whichever hostname reaches the host's apps by path"
  }
}

/// One row of the tree: a file, with the way to its text, or the directory
/// that holds the rows under it, as the item that opens it.
///
/// It opens the item and leaves it open, because a directory's `</li>` comes
/// after the list of what is under it and `codeTree`, which is watching the
/// depths, is what knows where that is.
///
/// What the file is, what it comes to and how the directory's copy compares
/// are beside the name rather than in columns of their own — the tree is the
/// shape here, and a column is what cost it the nesting. They are **named**
/// here all the same, `what`, `size` and `disk`, so the stylesheet can hold
/// each to a width and line them up down the page: a list of sizes that does
/// not line up is a list nobody reads down. A directory has nothing on disk
/// to differ from, so its `disk` is empty and keeps the column open.
///
/// The name and what is beside it are one `row` inside the item, because the
/// item also holds the list of what is under a directory, and a row that is
/// the whole item would take that list into it.
///
/// The name shown is the last part of it, since the parts above are the rows
/// above; the whole path is the link's `title`, where it is still readable
/// and still escaped. A directory is not a link: the host has no text of one
/// to answer, so there is nothing for it to point at.
fn codeRow(at: String, file: host.CodeFile) -> String {
  let disk = if file.kind == "dir" { "" } else { onDisk(file) }
  let meta = "<span class=meta><span class=what>{codeKind(file)}</span><span class=size>{text.bytes(file.bytes)}</span><span class=disk>{disk}</span></span>"
  if file.kind == "dir" {
    return "<li class=dir><span class=row><code>{h(file.label)}/</code> {meta}</span>"
  }
  let link = "{at}/code?file={text.urlEncode(file.name)}"
  "<li><span class=row><a href=\"{h(link)}\" title=\"{h(file.name)}\"><code>{h(file.label)}</code></a> {meta}</span>"
}

/// The rows as a tree: a list inside the item that holds it, which is what
/// makes the nesting the markup and not a left padding. **A table could not
/// do it**: an indented cell reads as a tree only on a wide screen, and on a
/// narrow one `table.cards` turns every row into a card of its own and the
/// nesting is gone altogether.
///
/// The host said how deep every row is, so this only opens and closes lists
/// to match: a row deeper than the one above opens a list inside its item, a
/// row shallower closes one list a level, and the end closes what is left.
/// A depth that skips a level — which the host does not produce, since it
/// opens a directory row for every part of a name — opens one list and no
/// more, so no gap in the depths can leave a tag unclosed or close one that
/// was never opened.
fn codeTree(at: String, files: Array<host.CodeFile>) -> String {
  var out = Vector.of()
  // How many lists are open. The item opened last is in the innermost of
  // them and is still waiting for its `</li>`.
  var open = 0
  for file in files {
    // Which list this row belongs in, counting from one: its depth, but at
    // most one deeper than what is open and never outside the outermost.
    var want = file.depth + 1
    if want > open + 1 {
      want = open + 1
    }
    if want < 1 {
      want = 1
    }
    while open > want {
      out.push("</li></ul>")
      open = open - 1
    }
    if open == want {
      // A sibling of the row above: that row's item ends here.
      out.push("</li>")
    } else {
      let list = if open == 0 { "<ul class=tree>" } else { "<ul>" }
      out.push(list)
      open = want
    }
    out.push(codeRow(at, file))
  }
  while open > 0 {
    out.push("</li></ul>")
    open = open - 1
  }
  "".join(out.freeze())
}

/// What the version the app is running is made of: its `app.toml`, its
/// `.cove` files at any depth and its `assets/` — the whole of what a deploy
/// carries, as a tree — or, with `?file=`, one file's text.
///
/// What is shown is what is **running**: the code is the source map the app
/// was compiled with and the assets are the bytes the host serves, both held
/// since the app was loaded, so neither can disagree with the version above.
/// `app.toml` is the exception — the load keeps only what it parsed to — and
/// is read from the app's directory.
fn codePage(base: String, app: host.App, request: web.Request) -> String {
  let file = request.query.get("file").unwrapOr("")
  if file != "" {
    return codeFilePage(base, app, file)
  }
  let at = appAt(base, app)
  // One more than the page, to know whether there are more.
  let size = codePageSize()
  let found = host.code(app.name, size + 1)
  var shown = Vector.of()
  // The host's limit counts files, and so does this: a directory row is
  // there for the files under it and is not one of them.
  var files = 0
  var differing = 0
  for entry in found {
    let isFile = entry.kind != "dir"
    if isFile {
      files = files + 1
    }
    if files <= size {
      shown.push(entry)
      if isFile && entry.kind != "config" && entry.onDisk != "same" {
        differing = differing + 1
      }
    }
  }
  let tree = if shown.length() == 0 {
    "<p class=muted>The host has no version of this app loaded, so there is nothing it is running.</p>"
  } else {
    "<div class=\"panel tree\">{codeTree(at, shown.freeze())}</div>"
  }
  let differs = if differing == 0 {
    ""
  } else {
    let count = if differing == 1 {
      "One file in the app's directory is not the one that is running."
    } else {
      "{differing} files in the app's directory are not the ones that are running."
    }
    "<div class=problem><b>{h(count)}</b> A deploy that was staged and not switched to, or an edit made on the machine: either way, what is below is what the host is running, and the directory holds something else.</div>"
  }
  let more = if files > size {
    "<p class=muted>The first {size} files; this deploy has more, which this page does not show.</p>"
  } else {
    ""
  }
  layout(
    base,
    "apps",
    "{app.name} code",
    "{appHead(base, app, "Code")}{about("What is running, not what is in the app's directory — and each file says how the two compare.", "What <code>{h(app.version)}</code> is made of: its <code>app.toml</code>, its <code>.cove</code> files and its <code>assets/</code>, which is the whole of what a deploy carries. The code and the assets are the ones the host is running, held since the app was loaded; <code>app.toml</code> is read from the app's directory, because the load keeps only the settings it parsed to — which is why the app's own page can show a grant or a limit this file does not. Beside each name is what the file is, what it comes to, and how the file of the same name in the app's directory compares. The directories are the app's own, nested as it has them. Reading only.")}{differs}{tree}{more}",
  )
}

/// One piece of a coloured file: its text, escaped, inside the `<span>` the
/// stylesheet colours.
///
/// **The text is the file's own bytes and `h` is what makes it text.** The
/// host answers a kind and a run of text and never markup, so every value
/// these pages show is escaped in one place — and a file's text is the value
/// likeliest to be markup itself.
///
/// The class is one letter because a file comes to thousands of these and
/// the class is in every one of them. A kind with no span of its own —
/// `plain`, and any kind the host grows later — is its text and no element,
/// which is how an unknown kind reads as code rather than as nothing.
fn codePiece(piece: host.CodePiece) -> String {
  let body = h(piece.text)
  if piece.kind == "keyword" {
    return "<span class=k>{body}</span>"
  }
  if piece.kind == "type" {
    return "<span class=t>{body}</span>"
  }
  if piece.kind == "ident" {
    return "<span class=i>{body}</span>"
  }
  if piece.kind == "string" {
    return "<span class=s>{body}</span>"
  }
  if piece.kind == "number" {
    return "<span class=n>{body}</span>"
  }
  if piece.kind == "comment" {
    return "<span class=c>{body}</span>"
  }
  if piece.kind == "doc" {
    return "<span class=d>{body}</span>"
  }
  if piece.kind == "punct" {
    return "<span class=p>{body}</span>"
  }
  body
}

/// Why a file is shown with no colour, said rather than left to look like a
/// file with nothing in it worth colouring.
fn codePlainWhy(file: host.CodeFile) -> String {
  if file.plain == "cut" {
    return "<p class=muted>Shown with no colouring: the text below stops at what the host carries, and colouring part of a file would say that the rest of it is whatever the cut fell inside.</p>"
  }
  if file.plain == "dense" {
    return "<p class=muted>Shown with no colouring: this file comes to more pieces than one page carries ({codePieceLimit()}), and a page that was slow to arrive would be worse than a page with no colour on it.</p>"
  }
  "<p class=muted>Shown with no colouring: the host reads <code>.cove</code>, <code>.toml</code>, <code>.css</code> and XML, and has no reader for this kind of file. A colouring guessed from a name would be a claim about the file; none is no claim.</p>"
}

/// A file's text in a `<pre>`, coloured where the host coloured it.
///
/// The pieces concatenated are the text, so this shows the file either way;
/// what the host decides is whether the `<span>`s are there.
fn codeBody(file: host.CodeFile) -> String {
  if file.plain != "" {
    return "{codePlainWhy(file)}<pre class=code>{h(file.text)}</pre>"
  }
  var parts = Vector.of()
  for piece in file.pieces {
    parts.push(codePiece(piece))
  }
  "<pre class=code>{"".join(parts.freeze())}</pre>"
}

/// One file of a deploy: its text, coloured, and cut at what the host
/// carries, which the page says. A file that is not UTF-8 has no text to
/// show — a page that pretended to render a PNG would say less than this
/// does — so where the host answers it is said instead.
fn codeFilePage(base: String, app: host.App, name: String) -> String {
  let at = appAt(base, app)
  let back = "<p class=actions><a href=\"{h(at)}/code\">← every file</a></p>"
  match host.codeFile(app.name, name) {
    Ok(file) => {
      let cut = if file.cut { " <span class=muted>(cut at {text.bytes(codeTextBytes())}: the whole file is {text.bytes(file.bytes)})</span>" } else { "" }
      let facts = "<div class=\"scroll narrow\"><table class=facts><tr><th>file</th><td><code>{h(file.name)}</code></td></tr><tr><th>what</th><td>{codeKind(file)}</td></tr><tr><th>size</th><td>{text.bytes(file.bytes)}{cut}</td></tr><tr><th>on disk</th><td>{onDisk(file)}</td></tr></table></div>"
      let body = if file.isText {
        "<h2>{if file.cut { "The first {text.bytes(codeTextBytes())}" } else { "The file" }}</h2>{codeBody(file)}"
      } else if file.kind == "asset" {
        "<h2>Not text</h2><p class=muted>Not UTF-8, so there is no text of it to show. The host answers this file itself, at <code>{h(servedAt(app, file))}</code> on {servedOn(app)}, where a browser shows it as it is.</p>"
      } else {
        // Only an asset is meant not to be text. A `.cove` file that is not
        // could not have compiled, and an `app.toml` that is not could not
        // have been read — so this is the app's page saying why it is
        // refused, from the other end.
        "<h2>Not text</h2><p class=muted>Not UTF-8, which for this file is not a kind of file but a fault: the host reads it as text or does not load the app at all.</p>"
      }
      layout(
        base,
        "apps",
        "{app.name} code",
        "{appHead(base, app, "Code")}{facts}{body}{back}",
      )
    }
    Err(error) => layout(
      base,
      "apps",
      "{app.name} code",
      "{appHead(base, app, "Code")}<div class=problem><b>Not read.</b> The host said:<pre>{h(error.message)}</pre></div>{back}",
    )
  }
}

// ------------------------------------------- an app's SQL store
//
// Reading only, and not by a check of this app's own: the host runs the
// statement through the same `sql.query` the app's own calls go through,
// which refuses one that writes before it is stepped. The page says so and
// shows the refusal as it came.
//
// The form is a GET, and the statement is in the URL. A read changes
// nothing, so there is nothing here for a form on another site to make
// happen — the origin check the host app does is for the POSTs that change
// it — and the page can be linked, reloaded and gone back to.

/// The most rows the host's window answers (`crate::sql::PEEK_ROWS`), so
/// that the page can say what it is bounded by rather than leaving somebody
/// to find out.
fn sqlRowLimit() -> Int {
  200
}

/// How long one of its statements may run (`crate::sql::PEEK_STATEMENT_MS`).
fn sqlStatementMs() -> Int {
  1000
}

/// How much of a cell a column shows, as the store's page cuts a value.
fn sqlCellBytes() -> Int {
  140
}

/// One cell of an answer.
///
/// `None` is SQL's `NULL` and `Some("")` is the empty string: the store
/// keeps the two apart, and a window that showed them alike — both as an
/// empty cell — would hide the one thing a nullable column is about. So
/// each is said in words, and neither is said in nothing.
fn sqlCell(value: Option<String>) -> String {
  match value {
    Some(said) => {
      if said == "" {
        "<span class=muted title=\"the empty string, not NULL\">empty</span>"
      } else {
        let preview = text.truncateBytes(said, sqlCellBytes())
        if preview.byteLength() < said.byteLength() {
          // Longer than the column: `substr` is how to ask for the rest,
          // which is a statement and not a page of its own.
          "<code>{h(preview)}<span class=muted>…</span></code>"
        } else {
          "<code>{h(said)}</code>"
        }
      }
    }
    None => "<span class=muted title=\"SQL NULL, not the empty string\">NULL</span>"
  }
}

/// What a statement answered, as a table: the column names, then a row
/// each. Every name and every value came from the host and goes through
/// `h` — a row of an app's data is the likeliest markup on these pages.
fn sqlAnswerTable(answer: host.SqlAnswer) -> String {
  if answer.columns.length() == 0 {
    return "<p class=muted>The statement answered no columns.</p>"
  }
  var heads = Vector.of()
  for column in answer.columns {
    heads.push("<th>{h(column)}</th>")
  }
  var rows = Vector.of()
  for row in answer.rows {
    var cells = Vector.of()
    var at = 0
    for value in row.values {
      let label = answer.columns.get(at).unwrapOr("")
      cells.push("<td class=\"value block\" data-label=\"{h(label)}\">{sqlCell(value)}</td>")
      at = at + 1
    }
    rows.push("<tr>{"".join(cells.freeze())}</tr>")
  }
  if rows.length() == 0 {
    return "<p class=muted>No rows.</p>"
  }
  let counted = if rows.length() == 1 { "1 row." } else { "{rows.length()} rows." }
  "<div class=\"scroll cardwrap\"><table class=cards><tr class=head>{"".join(heads.freeze())}</tr>{"".join(rows.freeze())}</table></div><p class=muted>{h(counted)}</p>"
}

/// The tables of a store and how many rows each holds, with a statement
/// written for each: the first rows of a table are what somebody wants next,
/// and a link is less to type than a `SELECT`.
fn sqlTablesTable(at: String, tables: Array<host.SqlTable>) -> String {
  if tables.length() == 0 {
    return "<p class=muted>This store has no tables yet.</p>"
  }
  var rows = Vector.of()
  for table in tables {
    let count = if table.counted {
      "{table.rows}"
    } else {
      "<span class=muted title=\"counting its rows ran out of the window's time\">not counted</span>"
    }
    // A name is an identifier in the statement's text, which is where
    // SQLite takes one: quoted, with a `"` in it doubled.
    let quoted = table.name.replace("\"", "\"\"")
    let statement = "SELECT * FROM \"{quoted}\" LIMIT 50"
    let link = "{at}/sql?q={text.urlEncode(statement)}"
    rows.push(
      "<tr><td class=title data-label=table><a href=\"{h(link)}\"><code>{h(table.name)}</code></a></td><td class=nums data-label=rows>{count}</td></tr>",
    )
  }
  "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>table</th><th>rows</th></tr>{"".join(rows.freeze())}</table></div>"
}

/// The box a statement is typed into, with the statement in it again.
///
/// This is the one place on these pages where something somebody typed goes
/// back inside an attribute's quotes. `h` writes `"` as `&quot;` and `'` as
/// `&#39;` as well as the angle brackets, so the statement stays the
/// attribute's value whatever it holds; without that, a statement holding a
/// quote would end the attribute and the rest of it would be markup.
fn sqlForm(at: String, statement: String) -> String {
  "<form class=inline method=get action=\"{h(at)}/sql\"><label for=q>statement</label><input class=sql id=q name=q value=\"{h(statement)}\" placeholder=\"SELECT * FROM … LIMIT 20\" spellcheck=false autocapitalize=off><button>Run</button></form>"
}

/// What the page says above the box, which is what the window is and what it
/// will not do.
fn sqlLead(app: host.App) -> String {
  about("Reading only — a statement that writes is refused.", "What is in <code>{h(app.name)}</code>'s relational store. The box runs one statement that <b>only reads</b>: a statement that writes is refused by the host, the same refusal the app's own <code>sql.query</code> gets, so there is nothing here that can change this app's data — repairing data is done on the machine, where it is deliberate. At most {sqlRowLimit()} rows come back, and an answer with more rows than that says so rather than showing the first {sqlRowLimit()} of them; a statement still running after {sqlStatementMs()} ms is stopped where it is. A value is text: <code>NULL</code> and the empty string are said in words, and a long one is cut to the column. Nothing typed here is kept — a read is not a change, so the history does not record it.")
}

/// One app's SQL store: its tables and their row counts, or — with `?q=` —
/// what one statement answers.
fn sqlPage(base: String, app: host.App, request: web.Request) -> String {
  let at = appAt(base, app)
  let head = appHead(base, app, "SQL")
  if !app.granted.contains("sql") {
    return layout(
      base,
      "apps",
      "{app.name} sql",
      "{head}<p class=lead><code>{h(app.name)}</code> is not granted <code>sql</code>: it has no relational store, and the host keeps no file for it.</p>",
    )
  }
  let statement = request.query.get("q").unwrapOr("").trim()
  let form = sqlForm(at, statement)
  if statement == "" {
    let tables = host.sqlTables(app.name)
    return layout(
      base,
      "apps",
      "{app.name} sql",
      "{head}{sqlLead(app)}{form}<h2>Tables</h2>{sqlTablesTable(at, tables)}",
    )
  }
  let answered = match host.sqlQuery(app.name, statement) {
    Ok(answer) => "<h2>Answer</h2>{sqlAnswerTable(answer)}"
    Err(error) => "<div class=problem><b>Not answered.</b> The host said:<pre>{h(error.message)}</pre></div>"
  }
  let back = "<p class=actions><a href=\"{h(at)}/sql\">← the tables</a></p>"
  layout(base, "apps", "{app.name} sql", "{head}{sqlLead(app)}{form}{answered}{back}")
}

// ------------------------------------------- an app's queues
//
// Reading only, and not by a rule of this page's: the host's window leases
// nothing, counts no attempt and moves no due time, so a queue somebody
// opened is delivered exactly as it would have been. `queue.lease` — the
// only way the delivery loop sees a message — could not be used for a page
// at all, which is why the host grew reads of its own for this.
//
// There is no button to put a dead letter back. That is a change, and a
// change on these pages has a confirmation and a line in the history;
// `minicloud queues <app> --revive <id>` on the machine has both already,
// so the page says so rather than growing a half of one.

/// The most messages the host's window lists
/// (`crate::queue::PEEK_MESSAGES`), so the page can say what it is bounded
/// by rather than leaving somebody to find out.
fn queueListSize() -> Int {
  200
}

/// How much of a body a row shows, as the store's page cuts a value.
fn queueBodyBytes() -> Int {
  140
}

/// A duration the host carries in milliseconds, written as `[[queues]]`
/// writes it: `30s`, or milliseconds where seconds would round.
fn queueDuration(millis: Int) -> String {
  if millis % 1000 == 0 {
    return "{millis / 1000}s"
  }
  "{millis}ms"
}

/// What a message is, as the store can say it.
///
/// `held` is the one that has to be explained: a message whose due time is
/// ahead is either a delivery holding it on lease or a failed delivery
/// waiting for its retry, and the store keeps one `due` for both — so this
/// says `held` rather than calling a backoff a lease.
fn queueState(state: String) -> String {
  if state == "due" {
    return "<span class=\"state serving\" title=\"the next delivery tick may take it\">due</span>"
  }
  if state == "held" {
    return "<span class=\"state disabled\" title=\"its due time is ahead: a delivery holding it on lease, or a failed delivery waiting for its retry. The store keeps one due time for both, so the host does not say which.\">held</span>"
  }
  "<span class=\"state refused\" title=\"buried as a dead letter: nothing delivers it again until somebody puts it back\">dead</span>"
}

/// A message's body in a row. A queue carries whatever an app sent — a
/// webhook's payload, a form somebody filled in — so this is the likeliest
/// markup on these pages and every part of it goes through `h`.
fn queueBodyCell(message: host.QueueMessage) -> String {
  if message.bytes == 0 {
    return "<span class=muted title=\"the message's body is empty\">empty</span>"
  }
  // The host cut at its own length; a row of a table wants less again.
  let preview = text.truncateBytes(message.body, queueBodyBytes())
  let cut = message.cut || preview.byteLength() < message.body.byteLength()
  if cut {
    return "<code>{h(preview)}<span class=muted>…</span></code>"
  }
  "<code>{h(message.body)}</code>"
}

/// Each queue of an app with what it holds and how the host delivers it.
///
/// Every queue the app declares is here, a queue nothing was ever sent to
/// included: 0 is an answer, and a missing row would read as "no such
/// queue". A queue the store holds messages for that the app no longer
/// declares is here too, saying so — nothing will ever deliver it.
fn queuesTable(queues: Array<host.Queue>) -> String {
  var rows = Vector.of()
  for queue in queues {
    let delivered = if queue.declared {
      "<code>{h(queue.path)}</code>"
    } else {
      "<span class=\"state removed\" title=\"the app's [[queues]] no longer declares this queue, so the host delivers nothing from it\">not declared</span>"
    }
    let settings = if queue.declared {
      "<span class=muted>{queue.maxAttempts} attempts, retry {h(queueDuration(queue.retryMs))} doubling, lease {h(queueDuration(queue.leaseMs))}, {queue.batch} at once, depth {queue.maxDepth}, body {text.bytes(queue.maxBodyBytes)}</span>"
    } else {
      "<span class=muted>–</span>"
    }
    rows.push(
      "<tr><td class=title data-label=queue><code>{h(queue.name)}</code></td><td data-label=\"delivered to\">{delivered}</td><td class=nums data-label=due>{queue.due}</td><td class=nums data-label=held>{queue.held}</td><td class=nums data-label=dead>{queue.dead}</td><td class=block data-label=settings>{settings}</td></tr>",
    )
  }
  "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>queue</th><th>delivered to</th><th>due</th><th>held</th><th>dead</th><th>settings</th></tr>{"".join(rows.freeze())}</table></div>"
}

/// The whole stamp of a queue's time, not the time of day the log shows: a
/// retry's delay doubles, so a message can be due days off, and a dead
/// letter can be weeks old — a clock alone would read as today.
fn queueTime(millis: Int) -> String {
  text.isoTime(millis)
}

/// A message's id, as the way to the whole of it — the shape the store's
/// page has for a key, and for the same reason: a listing cuts a body, and
/// a queue's body is a payload that is often longer than the cut.
fn queueIdLink(at: String, message: host.QueueMessage) -> String {
  "<a href=\"{h(at)}/queues?message={message.id}\"><code>{message.id}</code></a>"
}

/// The messages still on an app's queues, what is due first — the order the
/// host will take them in.
fn queueMessagesTable(at: String, messages: Array<host.QueueMessage>) -> String {
  if messages.length() == 0 {
    return "<p class=muted>Nothing is waiting.</p>"
  }
  var rows = Vector.of()
  for message in messages {
    rows.push(
      "<tr><td class=title data-label=id>{queueIdLink(at, message)}</td><td data-label=queue><code>{h(message.queue)}</code></td><td data-label=state>{queueState(message.state)}</td><td class=nums data-label=tries>{message.attempts}</td><td class=when data-label=\"due (UTC)\">{queueTime(message.dueMs)}</td><td class=when data-label=\"sent (UTC)\">{queueTime(message.sentMs)}</td><td class=\"value block\" data-label=body>{queueBodyCell(message)}</td></tr>",
    )
  }
  "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>id</th><th>queue</th><th>state</th><th>tries</th><th>due (UTC)</th><th>sent (UTC)</th><th>body</th></tr>{"".join(rows.freeze())}</table></div>"
}

/// The dead letters, newest buried first, each with why it was buried —
/// which is the status and the first line the consumer answered, or that it
/// did not answer at all.
fn queueDeadTable(at: String, messages: Array<host.QueueMessage>) -> String {
  if messages.length() == 0 {
    return "<p class=muted>No dead letters.</p>"
  }
  var rows = Vector.of()
  for message in messages {
    let why = if message.why == "" { "<span class=muted>–</span>" } else { "<code>{h(message.why)}</code>" }
    rows.push(
      "<tr><td class=title data-label=id>{queueIdLink(at, message)}</td><td data-label=queue><code>{h(message.queue)}</code></td><td class=nums data-label=tries>{message.attempts}</td><td class=when data-label=\"buried (UTC)\">{queueTime(message.buriedMs)}</td><td class=\"value block\" data-label=why>{why}</td><td class=\"value block\" data-label=body>{queueBodyCell(message)}</td></tr>",
    )
  }
  "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>id</th><th>queue</th><th>tries</th><th>buried (UTC)</th><th>why</th><th>body</th></tr>{"".join(rows.freeze())}</table></div>"
}

/// What a listing that reached the window's limit says. The counts in the
/// table above are whole, so the difference between them and what is listed
/// is what this page is not showing — which is worth saying, because a page
/// that showed 200 of 4000 as though they were all of them would be the one
/// wrong answer here.
fn queueMore(listed: Int, counted: Int, what: String) -> String {
  if listed < queueListSize() {
    return ""
  }
  "<p class=muted>The first {listed} {h(what)}, which is this window's limit; the counts above are whole. <code>minicloud queues</code> on the machine reads the rest.</p>"
}

/// What the page says above the tables: what the window is, and what it
/// will not do.
fn queuesLead(app: host.App) -> String {
  about("Reading only — nothing here sends, deletes or revives a message.", "What is on <code>{h(app.name)}</code>'s queues. <b>Reading only</b>: the host's window leases nothing and counts no attempt, so a message read here is delivered exactly as if nobody had looked, and there is nothing on this page that sends, deletes or revives one. <b>due</b> is what the next delivery tick may take, oldest sent first; <b>held</b> is a message whose due time is ahead — a delivery holding it on lease, or a failed delivery waiting for its retry — and the store keeps one due time for both, so neither the host nor this page claims to know which. At most {queueListSize()} messages are listed, and a body longer than the column is cut — the id opens it whole. A dead letter is kept until somebody deals with it: the host prunes none, so a number here that grows is work nobody has looked at. To put one back: <code>minicloud queues {h(app.name)} --revive &lt;id&gt;</code> on the machine, because reviving is a change and a change wants the confirmation and the line in the history that the forms here have.")
}

/// One app's queues: each declared queue with what it holds, the messages
/// waiting, and the dead letters — or, with `?message=`, one message whole.
fn queuesPage(base: String, app: host.App, request: web.Request) -> String {
  match Int.parse(request.query.get("message").unwrapOr("").trim()) {
    Ok(id) => return queueMessagePage(base, app, id)
    Err(_) => {}
  }
  let head = appHead(base, app, "Queues")
  let title = "{app.name} queues"
  let queues = host.queues(app.name)
  if queues.length() == 0 {
    // Two different nothings, and which it is decides what to do about it.
    let why = if app.granted.contains("queue") {
      "<code>{h(app.name)}</code> is granted <code>queue</code>, and its <code>app.toml</code> declares no <code>[[queues]]</code>: a queue must be declared before anything can be sent to it."
    } else {
      "<code>{h(app.name)}</code> is not granted <code>queue</code>: it has no queue, and the host keeps no file for it."
    }
    return layout(base, "apps", title, "{head}<p class=lead>{why}</p>")
  }
  var waiting = 0
  var dead = 0
  for queue in queues {
    waiting = waiting + queue.due + queue.held
    dead = dead + queue.dead
  }
  let at = appAt(base, app)
  let messages = host.queueMessages(app.name, queueListSize())
  let buried = host.queueDead(app.name, queueListSize())
  layout(
    base,
    "apps",
    title,
    "{head}{queuesLead(app)}<h2>Queues</h2>{queuesTable(queues)}<h2>Waiting</h2>{queueMessagesTable(at, messages)}{queueMore(messages.length(), waiting, "of what is waiting")}<h2>Dead letters</h2>{queueDeadTable(at, buried)}{queueMore(buried.length(), dead, "dead letters")}",
  )
}

/// The longest body one message's read carries
/// (`crate::queue::READ_BODY_CHARS`), so that a page that was cut can say
/// at what.
fn queueBodyChars() -> Int {
  65536
}

/// One message of a queue, waiting or buried: what the host knows of it,
/// and its body whole — cut at what the host carries, which the page says.
fn queueMessagePage(base: String, app: host.App, id: Int) -> String {
  let at = appAt(base, app)
  let head = appHead(base, app, "Queues")
  let title = "{app.name} queues"
  let back = "<p class=actions><a href=\"{h(at)}/queues\">← every queue</a></p>"
  match host.queueMessage(app.name, id) {
    Ok(message) => {
      let cut = if message.cut { " <span class=muted>(cut at {text.bytes(queueBodyChars())} of text: the whole body is {text.bytes(message.bytes)})</span>" } else { "" }
      // A dead letter's due time is the one it had when it was buried, so
      // showing it as "due" would be saying something untrue; the two rows
      // it has instead are when it was buried and why.
      let when = if message.state == "dead" {
        "<tr><th>buried</th><td class=when>{queueTime(message.buriedMs)}</td></tr><tr><th>why</th><td><pre>{h(message.why)}</pre></td></tr>"
      } else {
        "<tr><th>next due</th><td class=when>{queueTime(message.dueMs)}</td></tr>"
      }
      let facts = "<div class=\"scroll narrow\"><table class=facts><tr><th>id</th><td><code>{message.id}</code></td></tr><tr><th>queue</th><td><code>{h(message.queue)}</code></td></tr><tr><th>state</th><td>{queueState(message.state)}</td></tr><tr><th>tries</th><td>{message.attempts}</td></tr><tr><th>sent</th><td class=when>{queueTime(message.sentMs)}</td></tr>{when}<tr><th>size</th><td>{text.bytes(message.bytes)}{cut}</td></tr></table></div>"
      layout(base, "apps", title, "{head}{facts}<h2>Body</h2><pre>{h(message.body)}</pre>{back}")
    }
    Err(error) => layout(
      base,
      "apps",
      title,
      "{head}<div class=problem><b>Not read.</b> The host said:<pre>{h(error.message)}</pre></div>{back}",
    )
  }
}

/// The lines of a log, oldest first, as a table of the time and what was
/// said. `lines` is what the host gave: it is never markup.
///
/// `withApp` puts the app each line came from beside the time, for the page
/// that has every app's on it. One app's page knows the app already, and a
/// column saying the same word on every row is a column that says nothing.
///
/// The level is a cell of its own and not the head of the text, so that a
/// narrow screen can keep what a line *is* — the time, the app, the level —
/// on one line and put what was said under it. A badge inside the text cell
/// can only be the first word of a paragraph, and the second line of that
/// paragraph starts under the time, where it reads as the next line's.
fn logTable(lines: Array<host.LogLine>, withApp: Bool = false) -> String {
  if lines.length() == 0 {
    return "<p class=muted>No lines yet.</p>"
  }
  var rows = Vector.of()
  for line in lines {
    let who = if withApp { "<td class=app><code>{h(line.app)}</code></td>" } else { "" }
    rows.push(
      "<tr><td class=at>{atTime(line.atMs)}</td>{who}<td class=lv><span class=\"lvl {levelClass(line.level)}\">{h(line.level)}</span></td><td class=said>{h(line.text)}</td></tr>",
    )
  }
  "<div class=scroll><table class=log>{"".join(rows.freeze())}</table></div>"
}

/// The class a level is shown with; anything the host grows later reads as
/// a level of its own without a colour of its own.
fn levelClass(level: String) -> String {
  if level == "info" || level == "warn" || level == "error" || level == "host" {
    return "lvl-{level}"
  }
  "lvl-info"
}

/// How many lines a log page shows, as asked for.
fn logLines(request: web.Request) -> Int {
  match Int.parse(request.query.get("n").unwrapOr("").trim()) {
    Ok(asked) => {
      if asked < 1 {
        1
      } else if asked > 1000 {
        1000
      } else {
        asked
      }
    }
    Err(_) => 200
  }
}

/// How many lines a log page shows, as the same page with `?n=`. `at` is
/// the page's own path, so the choice is the one thing the link changes.
fn logSteps(at: String, n: Int) -> String {
  var steps = Vector.of()
  for size in Vector.of(50, 200, 1000).freeze() {
    if size == n {
      steps.push("<b>{size}</b>")
    } else {
      steps.push("<a href=\"{h("{at}?n={size}")}\">{size}</a>")
    }
  }
  "<p class=actions><span class=muted>lines:</span> {" ".join(steps.freeze())}</p>"
}

/// One app's log: the host's ring of its last lines, oldest first.
fn logPage(base: String, app: host.App, request: web.Request) -> String {
  let at = appAt(base, app)
  let n = logLines(request)
  let lines = host.logs(app.name, n)
  let how = logSteps("{at}/logs", n)
  layout(
    base,
    "apps",
    "{app.name} log",
    "{appHead(base, app, "Logs")}{about("What the app logged and what the host said of it, oldest first.", "{lines.length()} lines, of the last {logKept()} the host keeps in memory, which a restart empties. Every line is also appended to <code>&lt;data&gt;/{h(app.name)}/log.txt</code>, which this page does not read.")}{how}{logTable(lines)}{how}",
  )
}

// ------------------------------------------------------------ speed
//
// How fast an app is and how much it served, over time. The numbers are the
// ones the host samples each minute (`host.series`), drawn the way the
// operations page draws its sparkline — scaled to the largest value in the
// window, the number in a `<title>` and no axis — only bigger, because here
// the picture is the subject and not a cell in a table.

/// Which window `?over=` asks for. One of the three the host knows, and
/// `hour` for anything else: the host would fall back to an hour as well,
/// but the page names the window in what it says and in the link it marks,
/// so it has to know which one it is showing rather than pass a stranger
/// through and be wrong about it.
fn speedWindow(request: web.Request) -> String {
  let asked = request.query.get("over").unwrapOr("").trim()
  if asked == "day" || asked == "month" {
    return asked
  }
  "hour"
}

/// What a window is called in a sentence. The month is thirty days, which is
/// what the host reads (`crate::series::window`), so it says thirty.
fn speedSpan(over: String) -> String {
  if over == "day" {
    "the last day"
  } else if over == "month" {
    "the last 30 days"
  } else {
    "the last hour"
  }
}

/// The three windows as the same page with `?over=`, the one being shown
/// marked and not a link, as the lines of a log page are.
fn speedSteps(at: String, over: String) -> String {
  var steps = Vector.of()
  for name in Vector.of("hour", "day", "month").freeze() {
    let label = speedSpan(name)
    if name == over {
      steps.push("<b>{label}</b>")
    } else {
      steps.push("<a href=\"{h("{at}/speed?over={name}")}\">{label}</a>")
    }
  }
  "<p class=actions><span class=muted>window:</span> {" ".join(steps.freeze())}</p>"
}

/// Microseconds as milliseconds with one decimal, which is what the speed
/// chart and its figure are written in: a request is rarely under a tenth of
/// a millisecond and rarely over a few seconds, so milliseconds are the unit
/// both ends of that fit without a string of digits — and the histogram the
/// host estimates from is not finer than a tenth of one at the sizes where
/// it matters, so a decimal is all the precision there is to show.
fn speedMs(us: Int) -> String {
  let tenths = (us + 50) / 100
  "{tenths / 10}.{tenths % 10}"
}

/// The larger of two lists' largest values.
fn speedLargest(a: Array<Int>, b: Array<Int>) -> Int {
  var largest = 0
  for value in a {
    if value > largest {
      largest = value
    }
  }
  for value in b {
    if value > largest {
      largest = value
    }
  }
  largest
}

/// One line's `points`, in a box 640 by 120 with 4 of margin on every side,
/// so that the stroke of the first, last, highest and lowest value is not
/// cut in half by the edge. Whole numbers: nothing a screen draws is finer
/// than a pixel at this size.
///
/// A row is put where its *time* is, not where it comes in the list: the
/// host writes no row for a minute it was down, or a minute an app did
/// nothing in the first sample after a start, and evenly spaced rows would
/// draw that gap as if the two sides of it were a minute apart.
fn speedPoints(times: Array<Int>, values: Array<Int>, largest: Int) -> String {
  let first = times.get(0).unwrapOr(0)
  let apart = times.get(times.length() - 1).unwrapOr(0) - first
  // A row is one app's one minute (`PRIMARY KEY (app, at)`), so two rows
  // are never the same moment and the span is never nothing. One rather
  // than a division by it anyway: a page anybody may open should not be one
  // surprising row away from a trap.
  let span = if apart > 0 { apart } else { 1 }
  var out = Vector.of()
  var at = 0
  for value in values {
    let when = times.get(at).unwrapOr(first) - first
    out.push("{4 + when * 632 / span},{116 - value * 112 / largest}")
    at = at + 1
  }
  " ".join(out.freeze())
}

/// What tells a line from the other in the legend: the same stroke the
/// chart draws it with, so the dashes are what one reads the key by and not
/// the colour alone.
fn speedKey(class: String, name: String) -> String {
  "<span class=key><svg width=32 height=8 viewBox=\"0 0 32 8\" aria-hidden=true><line class=\"ln {class}\" x1=0 y1=4 x2=32 y2=4 /></svg>{h(name)}</span>"
}

/// Two lines on one chart, scaled together to the larger of them: the
/// question is how the two compare, and two scales would make a p99 that is
/// ten times its p50 look like it is touching it.
///
/// `peak` is what the largest value is, in the words of the chart, and it
/// is **written beside the key** and not only in the `<title>`: a line with
/// no number anywhere on the page is a shape nobody can size, and a title
/// is a hover, which a phone does not have.
///
/// A line needs two points, and a chart of nothing but zeros is a line along
/// the floor, so each says what is true instead of drawing that.
fn speedChart(label: String, peak: String, largest: Int, times: Array<Int>, a: Array<Int>, aClass: String, aName: String, b: Array<Int>, bClass: String, bName: String) -> String {
  if a.length() < 2 {
    return "<p class=muted>One row so far — a line wants two. Come back in a minute.</p>"
  }
  if largest == 0 {
    return "<p class=muted>{h(label)}: nothing but zero in this window, which is not worth a line along the bottom.</p>"
  }
  let legend = "<p class=legend>{speedKey(aClass, aName)}{speedKey(bClass, bName)}<span class=peak>up to {h(peak)}</span></p>"
  "{legend}<svg class=chart viewBox=\"0 0 640 120\" role=img aria-label=\"{h(label)}\"><title>up to {h(peak)}, over {a.length()} rows</title><polyline class=\"ln {aClass}\" fill=none points=\"{speedPoints(times, a, largest)}\"/><polyline class=\"ln {bClass}\" fill=none points=\"{speedPoints(times, b, largest)}\"/></svg>"
}

/// One app's speed: what it served and how long it took, over the window
/// asked for — the totals, then the two charts.
///
/// An empty answer is two different nothings that this page cannot tell
/// apart (a host that keeps no history, and one that has not sampled this
/// app yet), so what it says when there are no rows is true of both, and
/// there is no frame drawn round nothing.
fn speedPage(base: String, app: host.App, request: web.Request) -> String {
  let at = appAt(base, app)
  let over = speedWindow(request)
  let span = speedSpan(over)
  let points = host.series(app.name, over)
  let head = appHead(base, app, "Speed")
  let lead = "<p class=lead>How fast <code>{h(app.name)}</code> answers and how much of it it served. The host takes a sample of every app's counters once a minute and keeps the minutes for about two days and the hours for about three months, so these are what the app did in each minute — or, for the last 30 days, each hour — and not a running total. The <b>p50</b> and <b>p99</b> are <b>estimates</b>: the host does not keep the time of every request, it counts them into a histogram of time ranges and reads the quantile off that, so a figure here is the right range and not an exact time.</p>"
  let steps = speedSteps(at, over)
  let title = "{app.name} speed"
  if points.length() == 0 {
    return layout(base, "apps", title, "{head}{lead}{steps}<p class=muted>Nothing to show for {span}: either the host has not sampled <code>{h(app.name)}</code> yet — it takes a sample a minute, so a minute after it has served something — or it keeps no history at all, which it does not when it is started without a data directory. This page cannot tell which, and a chart of nothing would say neither.</p>")
  }
  var times = Vector.of()
  var served = Vector.of()
  var errors = Vector.of()
  var p50 = Vector.of()
  var p99 = Vector.of()
  var requests = 0
  var failed = 0
  var worst = 0
  for point in points {
    times.push(point.atUnix)
    served.push(point.served)
    errors.push(point.errors)
    p50.push(point.p50Us)
    p99.push(point.p99Us)
    requests = requests + point.served
    failed = failed + point.errors
    if point.p99Us > worst {
      worst = point.p99Us
    }
  }
  let timeRows = times.freeze()
  let servedRows = served.freeze()
  let errorRows = errors.freeze()
  let p50Rows = p50.freeze()
  let p99Rows = p99.freeze()
  let level = if failed == 0 { " is-ok" } else { " is-bad" }
  let said = if failed == 0 { "none in {span}" } else { "of {requests} in {span}" }
  let figures = "<div class=strip><div class=fig><span class=lbl>requests</span><span class=big>{requests}</span><span class=note>in {span}</span></div><div class=\"fig{level}\"><span class=lbl>errors</span><span class=big>{failed}</span><span class=note>{said}</span></div><div class=fig><span class=lbl>worst p99</span><span class=big>{speedMs(worst)} ms</span><span class=note>the slowest minute's estimate</span></div></div>"
  let first = match points.get(0) {
    Some(point) => point.atUnix
    None => 0
  }
  let last = match points.get(points.length() - 1) {
    Some(point) => point.atUnix
    None => 0
  }
  let each = if over == "month" { "hour" } else { "minute" }
  let rows = if points.length() == 1 { "1 row" } else { "{points.length()} rows" }
  let covers = "<p class=muted>{rows}, one for each {each} the host sampled, from {text.isoTime(first * 1000)} to {text.isoTime(last * 1000)}. Each chart is scaled to its own largest value, which is written beside its key; there is no axis to read, because the shape is the question.</p>"
  let traffic = speedChart(
    "requests served and errors, {span}",
    "{speedLargest(servedRows, errorRows)} a {each}",
    speedLargest(servedRows, errorRows),
    timeRows,
    servedRows,
    "ln-served",
    "served",
    errorRows,
    "ln-errors",
    "errors",
  )
  let slowest = speedLargest(p50Rows, p99Rows)
  let speed = speedChart(
    "request time, p50 and p99 in milliseconds, {span}",
    "{speedMs(slowest)} ms",
    slowest,
    timeRows,
    p50Rows,
    "ln-p50",
    "p50, the middle request",
    p99Rows,
    "ln-p99",
    "p99, the slow one in a hundred",
  )
  layout(
    base,
    "apps",
    title,
    "{head}{lead}{steps}{figures}{covers}<h2>Traffic</h2>{traffic}<h2>Speed, in milliseconds</h2>{speed}",
  )
}

/// Which app's log is being read: `all apps`, then every app the host has a
/// line of.
///
/// **An app's chip goes to that app's own Logs**, which is a page that
/// already exists: there is one log window, and this is the way to it. So
/// the row is not a filter that this page applies — the only thing it
/// chooses here is `all apps`, which is where it is.
///
/// There is no dot of health on a chip as the list of apps has: health is
/// what `worthALook` works out, from an app's counters and a read of its
/// queues, and a second rule for the same word — on a page about logs — is
/// two answers to one question.
fn logChips(base: String, apps: Array<String>) -> String {
  var out = Vector.of()
  out.push("<a href=\"{h(base)}/logs\" aria-current=page>all apps</a>")
  if apps.length() > 0 {
    out.push("<span class=sep></span>")
  }
  for app in apps {
    out.push("<a href=\"{h(base)}/apps/{h(app)}/logs\">{h(app)}</a>")
  }
  "<nav class=pick><span class=lbl>app</span>{"".join(out.freeze())}</nav>"
}

/// Every app's log, in one order (issue #108): a queue delivery that failed
/// in one app and the request that caused it in another are one sequence,
/// and on two pages they are two pages and a clock.
///
/// The host does the mixing (`host.allLogs`): it holds every app's ring, and
/// the last `n` lines of the host's whole log are the last `n` of the merge.
/// Which means an app that is talking fills the page and the quiet ones fall
/// off the end — that is what "the last `n` lines" is — so the lines to show
/// is the choice this page offers twice, and an app's own log is one chip
/// away.
fn allLogsPage(base: String, request: web.Request) -> String {
  let n = logLines(request)
  let all = host.allLogs(n)
  let how = logSteps("{base}/logs", n)
  let said = "{all.lines.length()} lines: the newest the host has, of the last {logKept()} it keeps in memory for each app, which a restart empties. One app with a lot to say fills the page — ask for more lines, or read an app alone from its chip above. Every line is also appended to <code>&lt;data&gt;/&lt;app&gt;/log.txt</code>, which this page does not read."
  layout(
    base,
    "logs",
    "logs",
    "<h1>Logs</h1>{logChips(base, all.apps)}{about("Every app that logs, in one order, oldest first.", said)}{how}{logTable(all.lines, true)}{how}",
  )
}

/// How many lines the host's ring keeps (`crate::logs::LOG_LINES`).
fn logKept() -> Int {
  1000
}

/// What a `?done=` says after a change went through.
fn notice(request: web.Request) -> String {
  let done = request.query.get("done").unwrapOr("")
  let said = if done == "enable" {
    "Enabled: requests are routed to it again."
  } else if done == "disable" {
    "Disabled: new requests are answered 503; its data is kept."
  } else if done == "configure" {
    "Applied. The host reloaded the app with the new configuration; its state is below."
  } else if done == "reset" {
    "Reset: the app is loaded from its app.toml again."
  } else {
    ""
  }
  if said == "" { "" } else { "<div class=notice>{h(said)} <a href=\"{h(base(request))}/history\">history</a></div>" }
}

fn problemsNotice(problems: Array<String>) -> String {
  var items = Vector.of()
  for problem in problems {
    items.push("<li>{h(problem)}</li>")
  }
  "<div class=problem><b>Nothing was changed.</b> The form has problems:<ul>{"".join(items.freeze())}</ul></div>"
}

fn refusedNotice(action: String, message: String) -> String {
  "<div class=problem><b>Refused: nothing was changed.</b> The host said, of <code>{h(action)}</code>:<pre>{h(message)}</pre></div>"
}

/// The app a change was about: a link, or a dash for a change to the host
/// itself (a secret).
fn historyApp(base: String, app: String) -> String {
  if app == "" {
    return "<span class=muted>–</span>"
  }
  "<a href=\"{h(base)}/apps/{h(app)}\">{h(app)}</a>"
}

fn doneNotice(message: String) -> String {
  "<div class=notice>{h(message)}</div>"
}

/// The secret store: every secret stored or used, and the forms that set,
/// replace and delete them. A value is never part of the page: the store
/// gives none, and the inputs are password fields that start empty.
/// `notice` is said above everything; `name` fills the set form's name.
fn secretsPage(base: String, secrets: Array<host.Secret>, notice: String, name: String) -> String {
  var rows = Vector.of()
  for secret in secrets {
    let state = if secret.set { "<span class=\"state serving\">set</span>" } else { "<span class=\"state refused\">unset</span>" }
    let updated = if secret.set { text.isoTime(secret.updatedMs) } else { "<span class=muted>–</span>" }
    var users = Vector.of()
    for app in secret.apps {
      users.push("<a href=\"{h(base)}/apps/{h(app)}\"><code>{h(app)}</code></a>")
    }
    let used = if users.length() == 0 { "<span class=muted>none</span>" } else { " ".join(users.freeze()) }
    let replace = "<form class=inline method=post action=\"{h(base)}/secrets/set\"><input type=hidden name=name value=\"{h(secret.name)}\"><input type=password name=value autocomplete=new-password required placeholder=\"new value\"><button class=primary>{if secret.set { "Replace" } else { "Set" }}</button></form>"
    let force = if secret.apps.length() > 0 { "<label><input type=checkbox name=force> even though apps use it (they are refused)</label>" } else { "" }
    let delete = if secret.set { "<form class=inline method=post action=\"{h(base)}/secrets/delete\"><input type=hidden name=name value=\"{h(secret.name)}\"><label><input type=checkbox name=confirm required> confirm</label>{force}<button class=danger>Delete</button></form>" } else { "<span class=muted>–</span>" }
    rows.push("<tr><td class=title data-label=name><code>{h(secret.name)}</code></td><td data-label=state>{state}</td><td class=when data-label=\"set at (UTC)\">{updated}</td><td data-label=\"used by\">{used}</td><td class=block data-label=\"set or replace\">{replace}</td><td class=block data-label=delete>{delete}</td></tr>")
  }
  let table = if rows.length() == 0 {
    "<p class=muted>No secret is stored or used.</p>"
  } else {
    "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>name</th><th>state</th><th>set at (UTC)</th><th>used by</th><th>set or replace</th><th>delete</th></tr>{"".join(rows.freeze())}</table></div>"
  }
  let add = "<h2>Set a secret</h2><div class=panel><form method=post action=\"{h(base)}/secrets/set\"><div class=fields><div class=field><label for=secret-name>name</label><input id=secret-name name=name value=\"{h(name)}\" required pattern=\"[A-Za-z0-9][A-Za-z0-9_.\\-]*\" maxlength=64></div><div class=field><label for=secret-value>value</label><input id=secret-value type=password name=value autocomplete=new-password required></div></div><div class=actions><button class=primary>Set</button><span class=muted>Stored by the host (<code>&lt;data&gt;/_host/secrets</code>, mode 0600); the apps that use it are reloaded with it.</span></div></form></div>"
  let how = about(
    "A value is write-only: no page, log or history shows it.",
    "An app takes a stored secret with <code>[secrets] key = \{ store = \"name\" \}</code> in its app.toml, for <code>auth.check</code> or a <code>[fetch.headers]</code> header. A value is write-only: no page, log or history shows it.",
  )
  layout(base, "secrets", "secrets", "<h1>Secrets</h1>{how}{notice}{table}{add}")
}

/// The change history.
fn historyPage(base: String, changes: Array<host.Change>) -> String {
  var rows = Vector.of()
  for change in changes {
    rows.push(
      "<tr><td class=\"title when\" data-label=\"at (UTC)\">{text.isoTime(change.atMs)}</td><td class=nowrap data-label=who>{h(change.who)}</td><td data-label=app>{historyApp(base, change.app)}</td><td class=nowrap data-label=action><code>{h(change.action)}</code></td><td class=block data-label=\"asked for\">{h(change.detail)}</td><td class=block data-label=outcome>{h(change.outcome)}</td></tr>",
    )
  }
  let table = if rows.length() == 0 {
    "<p class=muted>No changes yet.</p>"
  } else {
    "<div class=\"scroll cardwrap\"><table class=cards><tr class=head><th>at (UTC)</th><th>who</th><th>app</th><th>action</th><th>asked for</th><th>outcome</th></tr>{"".join(rows.freeze())}</table></div>"
  }
  layout(base, "history", "history", "<h1>History</h1>{about("Every change to an app, made here or on the machine, refused ones included.", "Every change, made here or with <code>minicloud update|remove|enable|disable|reset</code> on the machine, refused ones included; newest first.")}{table}")
}
