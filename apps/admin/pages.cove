use std.web
use host
use text
use std.html
use std.html.Html

// The pages. Every page is an `html"…"` literal, and a hole in one is escaped
// unless its type is `Html`: an app's name, a reason, an error message, a
// history entry and every value echoed from a form are `String`s, so each is
// text on the page whatever it holds, and the page's own markup is the only
// markup in it. A part of a page built in one function and put in another is
// an `Html`, which is how the second knows to take it whole. There is no
// script at all: what the pages do on a narrow screen, they do in CSS
// (`assets/style.css`).

/// The headers every answer carries: no script, nothing but this site's
/// forms, no framing, no sniffing, no caching, no referrer to another site.
/// The stylesheet and the icon are files the host serves from `assets/`, so
/// `style-src 'self'` and `img-src 'self'` are all the page needs: there is no
/// inline style left that `'unsafe-inline'` would have had to allow.
fn pageHeaders(contentType: String) -> Map<String, String> {
  Map.of(
    MapEntry(key: "content-type", value: contentType),
    MapEntry(
      key: "content-security-policy",
      value: "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
    ),
    MapEntry(key: "x-content-type-options", value: "nosniff"),
    MapEntry(key: "x-frame-options", value: "DENY"),
    MapEntry(key: "referrer-policy", value: "same-origin"),
    MapEntry(key: "cache-control", value: "no-store"),
  )
}

/// A page as the answer. This is the one place a page stops being `Html`
/// and becomes the text of a body: everything before it is markup that every
/// hole was checked into.
fn htmlResponse(status: Int, page: Html) -> web.Response {
  let body = page.render()
  web.Response(status: status, headers: pageHeaders("text/html; charset=utf-8"), body: body)
}

fn textResponse(status: Int, body: String) -> web.Response {
  web.Response(status: status, headers: pageHeaders("text/plain; charset=utf-8"), body: body)
}

/// A `303 See Other` to `location`.
fn redirect(location: String) -> web.Response {
  web.Response(
    status: 303,
    headers: Map.of(
      MapEntry(key: "location", value: location),
      MapEntry(key: "cache-control", value: "no-store"),
    ),
    body: "",
  )
}

/// `aria-current=page` on the link to where one is, with the space in front
/// of it; nothing on any other.
fn current(here: Bool) -> Html {
  html.only(here, html" aria-current=page")
}

/// The navigation, with the page one is on marked.
fn nav(base: String, here: String) -> Html {
  var out = Vector.of()
  for item in Vector.of(
    MapEntry(key: "apps", value: "/"),
    MapEntry(key: "logs", value: "/logs"),
    MapEntry(key: "platform", value: "/platform"),
    MapEntry(key: "live", value: "/live"),
    MapEntry(key: "timeline", value: "/timeline"),
    MapEntry(key: "load", value: "/load"),
    MapEntry(key: "secrets", value: "/secrets"),
    MapEntry(key: "history", value: "/history"),
  )
    .freeze() {
    out.push(html"""<a href="{base}{item.value}"{current(item.key == here)}>{item.key}</a>""")
  }
  html"<nav>{out.freeze()}</nav>"
}

/// The query that pins the files in `assets/` to `version`: `?v=<version>`,
/// and "" for a version the host could not say.
///
/// The URL of a file the host serves is otherwise the same URL for every
/// deploy, so a browser or a cache that holds one holds it against the new
/// pages as well — a phone that had the old `style.css` drew the new HTML
/// with it, and only the rules the release added went missing. A version in
/// the URL means there is nothing of an old deploy left to hold: the new
/// pages ask for a URL nothing has.
///
/// An empty `version` leaves the URL as it was. A page whose stylesheet
/// cannot be read is the worst thing this could do, so a host that will not
/// say the version gets the plain URL back and a browser revalidates as
/// before (`cache-control: no-cache`).
///
/// It is text, encoded for a query and not yet for the attribute it goes
/// in: the hole in [`layout`] escapes it as it escapes any other value.
fn assetQuery(version: String) -> String {
  if version == "" {
    return ""
  }
  "?v={text.urlEncode(version)}"
}

/// The page around `content`. `here` is the navigation entry it belongs to.
///
/// The version is asked for here and not passed in: every page in this
/// module calls `layout`, and a parameter for it would be a score of call
/// sites that each have to remember, with a page that forgot drawn exactly
/// like one that could not be told. The cost is one host call per page — a
/// slot lookup and a `String` clone (`host.selfVersion`), beside the
/// `host.apps` and `host.logs` a page already makes.
///
/// What it answers is still `Html`: [`htmlResponse`] is where a page becomes
/// the text of a body.
///
/// `refresh` is the seconds after which the browser loads the page again
/// (`<meta http-equiv=refresh>`, which is HTML and not a script, so the CSP
/// has nothing to say about it); 0, the default, never. `again` is the URL
/// it loads, "" for the one it is on — which for a page answered to a POST
/// is the POST's path, which a GET does not answer; [`reloading`] says which.
fn layout(base: String, here: String, title: String, content: Html, refresh: Int = 0, again: String = "") -> Html {
  let v = assetQuery(host.selfVersion())
  let when = if again == "" { "{refresh}" } else { "{refresh}; url={again}" }
  let reload = html.only(refresh > 0, html"""<meta http-equiv=refresh content="{when}">""")
  html"""
    <!doctype html>
    <html lang=en>
    <head>
      <meta charset=utf-8>
      <meta name=viewport content="width=device-width,initial-scale=1">{reload}
      <title>{title} · minicloud admin</title>
      <link rel=stylesheet href="{base}/style.css{v}">
      <link rel=icon href="{base}/favicon.svg{v}" type="image/svg+xml">
      <link rel=icon href="{base}/favicon.ico{v}" sizes="16x16 32x32">
    </head>
    <body>
      <header><a class=brand href="{base}/">minicloud admin</a>{nav(base, here)}</header>
      <main>{content}</main>
    </body>
    </html>
    """
}

/// How a page that loads itself again does it: every `seconds`, to `link`,
/// and the line that says so with the way to stop it — or, paused, no
/// reload at all and the way to start it again.
struct Reload {
  seconds: Int
  link: String
  control: Html
}

/// Whether `?refresh=off` paused a page that reloads itself.
fn paused(request: web.Request) -> Bool {
  request.query.get("refresh").unwrapOr("").trim() == "off"
}

/// A page at `link` — its own query (`over`, `app`) in it, and no
/// `refresh` — that loads itself again every `seconds`, unless `paused`.
///
/// The pause is a link and not a button: there is no script to stop a
/// `<meta>` refresh, so stopping is a page without one, which is the same
/// URL with `refresh=off`, and resuming is the URL without it. A paused page
/// stays paused for as long as it is looked at, which is what pausing is for:
/// a figure stays still to be read.
fn reloading(link: String, seconds: Int, paused: Bool) -> Reload {
  if paused {
    return Reload(
      seconds: 0,
      link: link,
      control: html"""<p class=reload>paused · <a href="{link}">resume</a></p>""",
    )
  }
  let joint = if link.contains("?") { "&" } else { "?" }
  Reload(
    seconds: seconds,
    link: link,
    control: html"""<p class=reload>refreshing every {seconds} s · <a href="{link}{joint}refresh=off">pause</a></p>""",
  )
}

fn badge(state: String) -> Html {
  html"""<span class="state {state}">{state}</span>"""
}

/// A list of names, or a dash.
fn names(items: Array<String>) -> Html {
  if items.length() == 0 {
    return html"<span class=muted>–</span>"
  }
  var out = Vector.of()
  for item in items {
    out.push(html"<code>{item}</code>")
  }
  html.join(out.freeze(), html" ")
}

/// The grant, with what the admin added and what it took away marked.
fn grantList(app: host.App) -> Html {
  var out = Vector.of()
  for capability in app.granted {
    if app.grantAdded.contains(capability) {
      out.push(html"""<code class=added title="granted here, not in app.toml">+{capability}</code>""")
    } else {
      out.push(html"<code>{capability}</code>")
    }
  }
  for capability in app.grantRemoved {
    out.push(html"""<code class=taken title="in app.toml, taken away here">{capability}</code>""")
  }
  if out.length() == 0 {
    return html"<span class=muted>–</span>"
  }
  html.join(out.freeze(), html" ")
}

/// The first line of `reason`.
fn firstLine(reason: String) -> String {
  reason.split("\n").get(0).unwrapOr("")
}

// -------------------------------------------- an app is a workspace
//
// Every page about one app opens the same way: where it is, its name and
// its state, one line of what it is serving and where, and a row of tabs.
// The tabs are what the app was granted — a store it has no grant for gets
// no tab, because the page on the other end of one would say nothing but
// that the host keeps no file for it (issue 108).

/// A page's explanation, folded: the summary is the one line worth reading
/// and what opens is the page's own words, unchanged. A tool belongs on the
/// first screen, and five lines of prose above it put it below the fold.
///
/// `<details>` is HTML and runs nothing, so the CSP is the one every other
/// page has. `summary` and `body` are `Html` — the page's own words, written
/// as markup by the caller — and every value of the host's inside them was
/// escaped by the hole it went into before it got here.
fn about(summary: Html, body: Html) -> Html {
  html"<details class=about><summary>{summary}</summary><p>{body}</p></details>"
}

/// What a change to an app comes to, which is what every page that can make
/// one says.
///
/// Markup and not a `String`, though it holds no tag: it is the page's own
/// prose, and the host's `'` in it is written as it is, which a hole would
/// have escaped.
fn recheck() -> Html {
  html"""
    A change to an app is a re-check: the host loads the app again with it and serves the new
    version only if it loads. Taking away a capability the code needs leaves that app refused
    — and no other. Changes are kept in the host's data directory and survive restarts and
    releases.
    """
}

/// One tab of an app's row: what it says, and where it leads.
struct Tab {
  label: String
  path: String
}

/// The tabs of one app, with the page one is on marked.
///
/// **A tab is there when the app has the thing.** An app not granted `sql`
/// has no SQL tab, and the same for `kv` and `queue`: the capabilities an
/// app was granted are the shape of its pages, which is this app saying
/// what the capability model already says. The windows themselves still
/// answer for an app without the grant — a URL somebody kept is not a 404 —
/// and say what is missing; they are simply not offered.
///
/// Overview, Metrics, Code and Settings are on every app: each has a version, a
/// configuration, and something to say about how it is running.
///
/// **So is Logs, `log` grant or not.** The ring that page reads is the
/// host's, not the app's: it holds the host's own lines about the app — why
/// it was refused, what a delivery came to — and an app granted nothing at
/// all still has those. The grant decides what the app may write to the
/// log, not whether there is one to read.
fn appTabs(base: String, app: host.App, here: String) -> Html {
  let at = appAt(base, app)
  var tabs = Vector.of()
  tabs.push(Tab(label: "Overview", path: at))
  tabs.push(Tab(label: "Metrics", path: "{at}/metrics"))
  tabs.push(Tab(label: "Logs", path: "{at}/logs"))
  if app.granted.contains("kv") {
    tabs.push(Tab(label: "Data", path: "{at}/kv"))
  }
  if app.granted.contains("sql") {
    tabs.push(Tab(label: "SQL", path: "{at}/sql"))
  }
  if app.granted.contains("queue") {
    tabs.push(Tab(label: "Queues", path: "{at}/queues"))
  }
  tabs.push(Tab(label: "Code", path: "{at}/code"))
  tabs.push(Tab(label: "Settings", path: "{at}/settings"))
  var out = Vector.of()
  for tab in tabs.freeze() {
    out.push(html"""<a href="{tab.path}"{current(tab.label == here)}>{tab.label}</a>""")
  }
  html"<nav class=tabs>{out.freeze()}</nav>"
}

/// The head of every page about one app: where it is, its name and state,
/// the line that says what it is serving and where, and the tabs. `here` is
/// the tab this page is.
fn appHead(base: String, app: host.App, here: String) -> Html {
  let reached = if app.hosts.length() > 0 {
    names(app.hosts)
  } else {
    html"<code>/{app.name}/</code>"
  }
  let version = if app.version == "" {
    html"<span class=muted>no version loaded</span>"
  } else {
    html"<code>{app.version}</code> {app.tier}"
  }
  let entry = html.only(app.entry != "", html" · entry <code>{app.entry}</code>")
  html"""
    <p class=crumb><a href="{base}/">apps</a> / {app.name}</p>
    <h1>{app.name} {badge(app.state)}</h1>
    <p class=sub>{version} · reached at {reached}{entry}</p>
    {appTabs(base, app, here)}
    """
}


// ------------------------------------------------------ worth a look
//
// The thing these pages have never had: the host saying what is wrong
// before being asked. Everything here is something the host already knows —
// a refusal and why, the requests that failed, what is on the queues, how
// large a store is against what it may hold, whether the deploy and the
// directory agree, whether an app that asked for Access got it.
//
// Nothing wrong is one line saying so, and that line is not a decoration:
// "is anything wrong" is the question somebody opened the page to answer,
// and a page that answers it only by being empty has not answered it.

/// One line of what is worth a look. `level` is `bad`, `warn`, `ok`, or ""
/// for a line that is neither news nor reassurance; `what` is the line and
/// `seen` the way to where it shows, or `None` for a line that has none.
/// Both are markup, and every value of the host's in them was escaped by its
/// hole.
struct Look {
  level: String
  what: Html
  seen: Option<Html>
}

/// How full a store has to be before this says so, in hundredths.
///
/// Eighty: a store at its limit refuses the app's next write, and the point
/// of saying it early is that nobody reads an admin page in the minute
/// before that happens.
fn storeNearly() -> Int {
  80
}

/// Whether `held` is within [`storeNearly`] of `limit`. A limit of 0 is no
/// limit to be near, and a count of -1 is a store the host has not opened.
fn nearLimit(held: Int, limit: Int) -> Bool {
  if limit <= 0 || held < 0 {
    return false
  }
  held * 100 >= limit * storeNearly()
}

/// `items` as a sentence: `a`, `a and b`, `a, b and c`.
///
/// The items are markup because they are the page's own words — "the app's
/// directory" among them — and a word of the page's is written as it is.
fn sentence(items: Array<Html>) -> Html {
  if items.length() <= 1 {
    return html"{items}"
  }
  var first = Vector.of()
  var at = 0
  for item in items {
    if at < items.length() - 1 {
      first.push(item)
    }
    at = at + 1
  }
  let last = items.get(items.length() - 1)
  html"{html.join(first.freeze(), html", ")} and {last}"
}

/// A link to `path` that says `label`: the way to where a line of
/// [`worthALook`] shows.
fn lookAt(path: String, label: String) -> Html {
  html"""<a href="{path}">{label}</a>"""
}

/// The lines, as a list. The worst are first because the caller put them
/// there: nothing is sorted here.
fn lookList(items: Array<Look>) -> Html {
  var out = Vector.of()
  for item in items {
    let mark = html.only(item.level != "", html""" class="is-{item.level}"""")
    let seen = html.only(item.seen.isSome(), html"<span class=where>{item.seen}</span>")
    out.push(html"<li{mark}><span class=what>{item.what}</span>{seen}</li>")
  }
  html"<ul class=look>{out.freeze()}</ul>"
}

/// What the host has to say about `app` before being asked.
///
/// `queues` and `disk` are passed in because the caller has already asked
/// the host for them: the stores below the list want the same queues, and
/// the disk comparison is the one expensive read on this page.
fn worthALook(base: String, app: host.App, queues: Array<host.Queue>, disk: host.CodeDisk) -> Html {
  let at = appAt(base, app)
  let toLog = lookAt("{at}/logs", "log")
  var bad = Vector.of()
  var warn = Vector.of()
  var clean = Vector.of()
  // Why it is not serving, which is the whole of the answer when it is not.
  if app.state == "refused" {
    bad.push(
      Look(
        level: "bad",
        what: html"Refused, so nothing reaches it: {firstLine(app.reason)}",
        seen: Some(lookAt("{at}/settings", "settings")),
      ),
    )
  } else if app.state == "disabled" {
    warn.push(
      Look(
        level: "warn",
        what: html"Disabled: requests are answered 503 and its data is kept.",
        seen: Some(lookAt("{at}/settings", "settings")),
      ),
    )
  } else if app.state == "removed" {
    warn.push(Look(level: "warn", what: html"Removed: the host has no version of it left.", seen: None))
  }
  // The failures the host kept, newest first, and then how many more there
  // have been than it keeps.
  var shown = 0
  for failure in app.recentErrors {
    if shown < 3 {
      bad.push(
        Look(
          level: "bad",
          what: html"""
            A request failed — <code>{failure.kind}</code> {failure.status}:
            {firstLine(failure.message)}
            """,
          seen: Some(html"{toLog} · {atTime(failure.atMs)}"),
        ),
      )
      shown = shown + 1
    }
  }
  if app.errors > shown {
    let rest = app.errors - shown
    let counted = if rest == 1 { "1 more request has failed" } else { "{rest} more requests have failed" }
    bad.push(Look(level: "bad", what: html"{counted} since the load.", seen: Some(toLog)))
  }
  if app.errors == 0 {
    clean.push(html"no request failed")
  }
  if app.rejected > 0 {
    warn.push(
      Look(
        level: "warn",
        what: html"""
          {app.rejected} requests were turned away: the app was at <code>max_in_flight</code>
          or <code>max_queued</code>.
          """,
        seen: Some(lookAt("{at}/settings", "limits")),
      ),
    )
  } else {
    clean.push(html"no request was turned away")
  }
  // What is on the queues. A dead letter is the bad news — nothing delivers
  // it again until somebody puts it back — and what is held is a delivery
  // on lease or a failed one waiting for its retry, which is worth a look
  // and is not yet a failure.
  var deadAnywhere = false
  for queue in queues {
    if queue.dead > 0 {
      deadAnywhere = true
      let counted = if queue.dead == 1 { "1 dead letter waits" } else { "{queue.dead} dead letters wait" }
      bad.push(
        Look(
          level: "bad",
          what: html"""
            {counted} on <code>{queue.name}</code>: nothing delivers one again until somebody
            puts it back.
            """,
          seen: Some(lookAt("{at}/queues", "queues")),
        ),
      )
    }
    if queue.held > 0 {
      warn.push(
        Look(
          level: "warn",
          what: html"""
            {queue.held} held on <code>{queue.name}</code>: a delivery on lease, or a failed
            one waiting for its retry.
            """,
          seen: Some(lookAt("{at}/queues", "queues")),
        ),
      )
    }
    if !queue.declared {
      warn.push(
        Look(
          level: "warn",
          what: html"""
            <code>{queue.name}</code> holds messages and the app's <code>[[queues]]</code> no
            longer declares it: nothing will ever deliver them.
            """,
          seen: Some(lookAt("{at}/queues", "queues")),
        ),
      )
    }
  }
  if queues.length() > 0 && !deadAnywhere {
    clean.push(html"no dead letter waits")
  }
  // A store near what it may hold. The write that reaches the limit is the
  // app's `Err`, and this is the page that could have said so first.
  var tight = false
  if nearLimit(app.kvBytes, app.kvMaxBytes) {
    tight = true
    warn.push(
      Look(
        level: "warn",
        what: html"""
          The <code>kv</code> store holds {text.bytes(app.kvBytes)} of the
          {text.bytes(app.kvMaxBytes)} it may: a write past that is refused.
          """,
        seen: Some(lookAt("{at}/kv", "data")),
      ),
    )
  }
  if nearLimit(app.kvKeys, app.kvMaxKeys) {
    tight = true
    warn.push(
      Look(
        level: "warn",
        what: html"""
          The <code>kv</code> store holds {app.kvKeys} of the {app.kvMaxKeys} keys it may:
          a write past that is refused.
          """,
        seen: Some(lookAt("{at}/kv", "data")),
      ),
    )
  }
  if nearLimit(app.sqlBytes, app.sqlMaxBytes) {
    tight = true
    warn.push(
      Look(
        level: "warn",
        what: html"""
          The <code>sql</code> store is {text.bytes(app.sqlBytes)} of the
          {text.bytes(app.sqlMaxBytes)} it may be: a statement that writes past that is refused.
          """,
        seen: Some(lookAt("{at}/sql", "sql")),
      ),
    )
  }
  if !tight && (app.granted.contains("kv") || app.granted.contains("sql")) {
    clean.push(html"no store is near its limit")
  }
  // The deploy against the app's directory. `looked` is the host saying
  // whether it read the files at all; a page that said "the same" without
  // having looked would be the one wrong answer here.
  if !disk.looked {
    warn.push(
      Look(
        level: "",
        what: html"""
          The deploy was not compared with the app's directory here: it comes to
          {text.bytes(disk.bytes)}, past the {text.bytes(disk.budget)} this page reads.
          The Code tab reads every file of it.
          """,
        seen: Some(lookAt("{at}/code", "code")),
      ),
    )
  } else if disk.differing > 0 {
    let counted = if disk.differing == 1 {
      html"One file in the app's directory is not the one that is running"
    } else {
      html"{disk.differing} files in the app's directory are not the ones that are running"
    }
    warn.push(
      Look(
        level: "warn",
        what: html"{counted}: a deploy staged and not switched to, or an edit made on the machine.",
        seen: Some(lookAt("{at}/code", "code")),
      ),
    )
  } else {
    clean.push(html"every file of the deploy is the same as the one in the app's directory")
  }
  // An app that asked for Access and did not get it is serving to whoever
  // reaches it. An app that asked for none says nothing here: it is not
  // this page's business to want Access on an app that never wanted it.
  if app.accessOff != "" {
    warn.push(
      Look(
        level: "warn",
        what: html"Cloudflare Access is off for this app — {app.accessOff}.",
        seen: Some(toLog),
      ),
    )
  }
  var items = Vector.of()
  for item in bad.freeze() {
    items.push(item)
  }
  for item in warn.freeze() {
    items.push(item)
  }
  if clean.length() > 0 {
    let lead = if items.length() == 0 { "Nothing" } else { "Nothing else" }
    items.push(Look(level: "ok", what: html"{lead}: {sentence(clean.freeze())}.", seen: None))
  }
  if items.length() == 0 {
    return html"""
      <p class=allwell>Nothing the host can see, and nothing it could look at: this app is
      loaded with no store, no queue and no deploy to compare.</p>
      """
  }
  lookList(items.freeze())
}

// ----------------------------------------------------- an app's Overview
//
// What is happening, before how it is set up. The numbers, then what is
// worth a look, then a card for each store that is also the way into it,
// then the last lines of the log, then one line about the grant with the
// way to Settings.

/// The numbers, as a band.
fn nowStrip(app: host.App) -> Html {
  let errors = if app.errors == 0 { " is-ok" } else { " is-bad" }
  let since = if app.errors == 0 { "none since the load" } else { "since the load" }
  html"""
    <div class=strip>
      <div class=fig>
        <span class=lbl>served</span>
        <span class=big>{app.served}</span>
        <span class=note>{app.ok} ok, {app.rejected} rejected</span>
      </div>
      <div class="fig{errors}">
        <span class=lbl>errors</span>
        <span class=big>{app.errors}</span>
        <span class=note>{since}</span>
      </div>
      <div class=fig>
        <span class=lbl>in flight</span>
        <span class=big>{app.inFlight}</span>
        <span class=note>of {app.limits.maxInFlight}</span>
      </div>
      <div class=fig>
        <span class=lbl>queued</span>
        <span class=big>{app.queued}</span>
        <span class=note>of {app.limits.maxQueued}</span>
      </div>
    </div>
    """
}

/// One pair of a store's card: a word and a number, the number coloured
/// where it is the thing to look at. `value` is text — a count, a size, or
/// a dash for a store the host has not opened.
fn storePair(label: String, value: String, level: String) -> Html {
  let mark = if level == "" { "" } else { " {level}" }
  html"""<span class=pair><span class=lbl>{label}</span><span class="v{mark}">{value}</span></span>"""
}

/// A store, as a card that is the way into it. Every card has a foot: what
/// the store holds at most, its first few names, or that it has none yet.
fn storeCard(link: String, name: String, go: String, pairs: Html, foot: Html) -> Html {
  html"""
    <a class=store href="{link}">
      <span class=top><span class=name>{name}</span><span class=go>{go} →</span></span>
      <span class=pairs>{pairs}</span>
      <span class=foot>{foot}</span>
    </a>
    """
}

/// A card for each store the app has, and nothing at all for an app with
/// none: an empty heading saying "no stores" is a row of the old table
/// again.
fn storeCards(base: String, app: host.App, queues: Array<host.Queue>) -> Html {
  let at = appAt(base, app)
  var cards = Vector.of()
  if app.granted.contains("kv") {
    let keys = if app.kvKeys < 0 { "–" } else { "{app.kvKeys}" }
    let size = if app.kvBytes < 0 { "–" } else { text.bytes(app.kvBytes) }
    let keysLevel = if nearLimit(app.kvKeys, app.kvMaxKeys) { "is-warn" } else { "" }
    let sizeLevel = if nearLimit(app.kvBytes, app.kvMaxBytes) { "is-warn" } else { "" }
    let pairs = html"{storePair("keys", keys, keysLevel)}{storePair("size", size, sizeLevel)}"
    let note = if app.kvKeys < 0 {
      "The host has not opened this store since it started."
    } else {
      "At most {app.kvMaxKeys} keys and {text.bytes(app.kvMaxBytes)}."
    }
    let foot = html"{note}"
    cards.push(storeCard("{at}/kv", "kv", "browse", pairs, foot))
  }
  if app.granted.contains("sql") {
    let tables = host.sqlTables(app.name)
    var rows = 0
    var counted = true
    var named = Vector.of()
    for table in tables {
      if table.counted {
        rows = rows + table.rows
      } else {
        counted = false
      }
      if named.length() < 4 {
        named.push(html"<code>{table.name}</code> {if table.counted { "{table.rows}" } else { "?" }}")
      }
    }
    let total = if counted { "{rows}" } else { "{rows}+" }
    let pairs = html"{storePair("tables", "{tables.length()}", "")}{storePair("rows", total, "")}"
    let foot = if named.length() == 0 {
      html"No tables yet."
    } else {
      html.join(named.freeze(), html" · ")
    }
    cards.push(storeCard("{at}/sql", "sql", "run a statement", pairs, foot))
  }
  if queues.length() > 0 {
    var due = 0
    var held = 0
    var dead = 0
    var named = Vector.of()
    for queue in queues {
      due = due + queue.due
      held = held + queue.held
      dead = dead + queue.dead
      if named.length() < 4 {
        named.push(html"<code>{queue.name}</code>")
      }
    }
    let pairs = html"""
      {storePair("due", "{due}", "")}
      {storePair("held", "{held}", if held > 0 { "is-warn" } else { "" })}
      {storePair("dead", "{dead}", if dead > 0 { "is-bad" } else { "" })}
      """
    let listed = html.join(named.freeze(), html" · ")
    let foot = if due + held + dead == 0 { html"Nothing waits on {listed}." } else { listed }
    cards.push(storeCard("{at}/queues", "queues", "see what waits", pairs, foot))
  }
  if cards.length() == 0 {
    return html""
  }
  html"<h2>Stores</h2><div class=stores>{cards.freeze()}</div>"
}

/// What the Overview's folded line says, which depends on what the app is
/// doing: there is no point summarising a re-check to somebody looking at
/// an app that is refused.
fn overviewSummary(app: host.App) -> Html {
  if app.state == "refused" {
    return html"Refused: it is not served again until the reason below is gone."
  }
  if app.state == "disabled" {
    return html"Disabled: requests are answered 503, and its data is kept."
  }
  if app.state == "removed" {
    return html"Removed: the host has no version of it left."
  }
  html"Serving the version it was last loaded with; a change is a re-check."
}

/// One app's Overview: what is happening, and the way to everything else
/// about it.
///
/// The host is asked four things here — its queues, its SQL tables, its
/// last log lines, and how the deploy compares with the app's directory —
/// and the last of those is the only one that is not free. `host.codeDisk`
/// reads every file of the deploy to compare it, so it reads nothing at all
/// for a deploy past the host's budget and says which it did; the line this
/// page writes is "they are the same", "these differ", or "I did not look
/// and the Code tab will", and never a guess.
fn appOverviewPage(base: String, app: host.App) -> Html {
  let at = appAt(base, app)
  let queues = if app.granted.contains("queue") { host.queues(app.name) } else { Vector.of().freeze() }
  let disk = host.codeDisk(app.name)
  let reason = html.only(app.reason != "", html"<pre>{app.reason}</pre>")
  let lines = host.logs(app.name, 5)
  let required = if app.requiredOpen {
    html"""
      {names(app.required)} \
      <span class=muted>(at least: it makes a call the checker cannot follow)</span>
      """
  } else {
    names(app.required)
  }
  layout(
    base,
    "apps",
    app.name,
    html"""
      {appHead(base, app, "Overview")}
      {about(overviewSummary(app), recheck())}
      {reason}
      <h2>Now</h2>{nowStrip(app)}
      <h2>Worth a look</h2>{worthALook(base, app, queues, disk)}
      {storeCards(base, app, queues)}
      <h2>Last lines</h2>{logTable(lines)}
      <p class=more><a href="{at}/logs">the last 200 lines →</a></p>
      <h2>How it is set up</h2>
      <p class=more>The grant, the fetch allowlist, the limits and the forms that change them
      are on <a href="{at}/settings">Settings</a>: it is granted {grantList(app)}, and its
      code requires {required}.</p>
      """,
  )
}

// ------------------------------------------------------ an app's Settings
//
// Everything that *changes* an app, in one place; the pages that only read
// are the other tabs. There is no link to a window here: the tabs carry
// that, and a second way in is a second thing to keep worded.

/// One app's Settings: what the deploy says, and the forms that change it.
/// `notice` is said above everything; `posted` is a form to show again as it
/// was posted, instead of the app's current settings.
fn settingsPage(
  base: String,
  app: host.App,
  capabilities: Array<String>,
  notice: Html,
  posted: Option<Map<String, String>>,
) -> Html {
  let at = appAt(base, app)
  let reason = html.only(app.reason != "", html"<pre>{app.reason}</pre>")
  let required = if app.requiredOpen {
    html"""
      {names(app.required)} \
      <span class=muted>(at least: it makes a call the checker cannot follow)</span>
      """
  } else {
    names(app.required)
  }
  let facts = html"""
    <h2>What the deploy says <span class=ronly>read only</span></h2>
    <div class="scroll narrow">
      <table class=facts>
        <tr><th>code requires</th><td>{required}</td></tr>
        <tr><th>granted now</th><td>{grantList(app)}</td></tr>
      </table>
    </div>
    <p class=more>The host read this out of the deploy; it changes when the code does. What
    is happening — the numbers, the stores, the log — is on <a href="{at}">Overview</a>.</p>
    """
  let summary = html"""
    This is where <code>{app.name}</code> is changed — every change is a re-check, and one
    that does not load is not kept.
    """
  let told = html"""{recheck()} Each one is a line in the <a href="{base}/history">history</a>."""
  layout(
    base,
    "apps",
    "{app.name} settings",
    html"""
      {appHead(base, app, "Settings")}
      {notice}
      {about(summary, told)}
      {reason}
      {facts}
      {configureForm(at, app, capabilities, posted)}
      {enableForm(at, app)}
      {resetForm(at)}
      """,
  )
}

// ------------------------------------------------------- the list of apps
//
// One card an app, and the ones with something to say first. A row here is
// not configuration: what an app may do and what its code asks for are what
// Settings is for, and reading them down a list told nobody anything.

/// What one app has to say for itself, as the pill at the end of its card.
/// The pill is the way to the page that shows it: a warning somebody has to
/// go and find is a warning that keeps. `text` is markup, a name of the
/// host's in it escaped by its hole.
struct Flag {
  level: String
  text: Html
  path: String
}

/// Whether anything said about an app is the bad kind, which is what puts
/// its card above the ones that are merely worth a look.
fn anyBad(flags: Array<Flag>) -> Bool {
  for flag in flags {
    if flag.level == "is-bad" {
      return true
    }
  }
  false
}

/// What is worth saying about `app` in a list.
///
/// **The deploy is not compared with the app's directory here.** That read
/// is one file of the deploy at a time and this page has every app on it;
/// an app's own Overview does it, within the host's budget, because that
/// page is about one app. So a list says nothing about the files, rather
/// than saying something it did not check.
fn appFlags(base: String, app: host.App, queues: Array<host.Queue>) -> Array<Flag> {
  let at = appAt(base, app)
  var out = Vector.of()
  if app.state == "refused" {
    out.push(Flag(level: "is-bad", text: html"refused", path: "{at}/settings"))
  }
  if app.errors > 0 {
    let counted = if app.errors == 1 { "1 failed" } else { "{app.errors} failed" }
    out.push(Flag(level: "is-bad", text: html"{counted}", path: at))
  }
  for queue in queues {
    if queue.dead > 0 {
      let said = html"{queue.dead} dead on <code>{queue.name}</code>"
      out.push(Flag(level: "is-bad", text: said, path: "{at}/queues"))
    }
  }
  for queue in queues {
    if queue.held > 0 {
      let said = html"{queue.held} held on <code>{queue.name}</code>"
      out.push(Flag(level: "is-warn", text: said, path: "{at}/queues"))
    }
  }
  if nearLimit(app.kvBytes, app.kvMaxBytes) || nearLimit(app.kvKeys, app.kvMaxKeys) {
    out.push(Flag(level: "is-warn", text: html"<code>kv</code> near its limit", path: "{at}/kv"))
  }
  if nearLimit(app.sqlBytes, app.sqlMaxBytes) {
    out.push(Flag(level: "is-warn", text: html"<code>sql</code> near its limit", path: "{at}/sql"))
  }
  if app.accessOff != "" {
    out.push(Flag(level: "is-warn", text: html"Access off", path: at))
  }
  out.freeze()
}

/// One app's card.
fn appCard(base: String, app: host.App, flags: Array<Flag>) -> Html {
  let at = appAt(base, app)
  var worst = ""
  for flag in flags {
    if flag.level == "is-bad" {
      worst = "is-bad"
    } else if worst == "" {
      worst = "is-warn"
    }
  }
  let tone = if worst == "" { "" } else { " {worst}" }
  let mine = html.only(app.isAdmin, html" <span class=muted>(this app)</span>")
  let reached = if app.hosts.length() > 0 {
    names(app.hosts)
  } else {
    html"<code>/{app.name}/</code>"
  }
  let version = if app.version == "" {
    html"<span class=muted>no version loaded</span>"
  } else {
    html"<code>{app.version}</code> {app.tier}"
  }
  // A refusal's reason is the one thing a list cannot send somebody to go
  // and read: it is why the app is not working at all.
  let why = html.only(app.reason != "", html"<div class=muted>{firstLine(app.reason)}</div>")
  var pills = Vector.of()
  for flag in flags {
    pills.push(html"""<a class="flag {flag.level}" href="{flag.path}">{flag.text} →</a>""")
  }
  let said = if pills.length() == 0 {
    html"<span class=quiet>quiet</span>"
  } else {
    html"{pills.freeze()}"
  }
  html"""
    <li class="app{tone}">
      <div class=who><a class=nm href="{at}">{app.name}</a>{badge(app.state)}{mine}</div>
      <div class=what>{version} · reached at {reached}{why}</div>
      <div class=count><span class=n>{app.served}</span> served
      <span class=muted>· {app.errors} errors · {app.inFlight} in flight</span></div>
      <div class=flags>{said}</div>
    </li>
    """
}

/// Every app, one card each, the ones with something to say first.
///
/// This asks the host for each app's queues, which is one read of its queue
/// store: a dead letter nobody has looked at is the thing this list exists
/// to put in front of somebody, and a list that could not say it would send
/// them through every app's page to find out.
fn appsPage(base: String, apps: Array<host.App>) -> Html {
  var serving = 0
  var served = 0
  var errors = 0
  var away = Vector.of()
  var bad = Vector.of()
  var warn = Vector.of()
  var quiet = Vector.of()
  var wanting = 0
  for app in apps {
    served = served + app.served
    errors = errors + app.errors
    if app.state == "serving" {
      serving = serving + 1
    } else {
      away.push("{app.name} {app.state}")
    }
    let queues = if app.granted.contains("queue") { host.queues(app.name) } else { Vector.of().freeze() }
    let flags = appFlags(base, app, queues)
    if flags.length() == 0 {
      quiet.push(appCard(base, app, flags))
    } else {
      wanting = wanting + 1
      // Worst first, as an app's own list is: a dead letter is something
      // that was lost and a held message is something that is late, and a
      // list that mixed them makes the reader sort them again.
      if anyBad(flags) {
        bad.push(appCard(base, app, flags))
      } else {
        warn.push(appCard(base, app, flags))
      }
    }
  }
  let rest = if away.length() == 0 {
    "all serving"
  } else {
    "{serving} serving, {", ".join(away.freeze())}"
  }
  let wants = if wanting == 0 {
    html""
  } else if wanting == 1 {
    html" <b>1 wants a look.</b>"
  } else {
    html" <b>{wanting} want a look.</b>"
  }
  let counted = if errors == 1 { "1 error" } else { "{errors} errors" }
  let summary = html"A change to an app is a re-check: it is served again only if it loads."
  layout(
    base,
    "apps",
    "apps",
    html"""
      <h1>Apps</h1>
      <p class=sub>{apps.length()} apps — {rest} — {served} requests served, {counted}.{wants}</p>
      {about(summary, recheck())}
      <ul class=apps>{bad.freeze()}{warn.freeze()}{quiet.freeze()}</ul>
      <p class=more>The ones with something to say are first, and the worst of those above the
      rest; the others are quiet, and a quiet app has no failed request, no refusal, no dead
      letter and no store near its limit. What each app may do, and what its code asks for, is
      on that app's Settings.</p>
      """,
  )
}


/// The `[limits]` key a form field changes, as the host names it.
fn limitKey(field: String) -> String {
  if field == "maxHostCalls" {
    "max_host_calls"
  } else if field == "deadlineMs" {
    "deadline"
  } else if field == "maxHeapWords" {
    "max_heap_words"
  } else if field == "maxInFlight" {
    "max_in_flight"
  } else if field == "maxQueued" {
    "max_queued"
  } else if field == "maxRequestBytes" {
    "max_request_bytes"
  } else {
    "max_response_bytes"
  }
}

fn enableForm(at: String, app: host.App) -> Html {
  if app.isAdmin {
    return html"""
      <h2>Routing</h2>
      <div class=panel><p class=muted>The admin app cannot disable itself. On the machine,
      <code>minicloud disable admin</code> can.</p></div>
      """
  }
  if app.state == "removed" {
    return html""
  }
  if app.state == "disabled" {
    return html"""
      <h2>Routing</h2>
      <div class=panel>
        <form method=post action="{at}/enable">
          <p>Disabled: requests are answered 503, and its data is kept.</p>
          <div class=actions><button class=primary>Enable</button></div>
        </form>
      </div>
      """
  }
  html"""
    <h2>Routing</h2>
    <div class=panel>
      <form method=post action="{at}/disable">
        <p>Disabling stops routing to it — requests are answered 503 — and keeps its data;
        requests in flight finish.</p>
        <div class=actions><button class=danger>Disable</button></div>
      </form>
    </div>
    """
}

/// The grant, the allowlist and the limits, as a form: the app's current
/// settings, or `posted` as it was posted.
fn configureForm(
  at: String,
  app: host.App,
  capabilities: Array<String>,
  posted: Option<Map<String, String>>,
) -> Html {
  if app.state == "removed" {
    return html""
  }
  var boxes = Vector.of()
  for capability in capabilities {
    let checked = match posted {
      Some(form) => form.contains("cap.{capability}")
      None => app.granted.contains(capability)
    }
    let needed = html.only(app.required.contains(capability), html" <span class=note>the code uses it</span>")
    if !app.isAdmin && capability == "admin" {
      // Only the admin app may hold it; the host refuses it to any other.
      continue
    }
    if app.isAdmin && capability == "admin" {
      // Not the admin app's to give up: sent whatever the box says.
      boxes.push(html"""
        <label class=cap>
          <input type=hidden name="cap.admin" value=on>
          <input type=checkbox checked disabled> <code>admin</code>{needed}
        </label>
        """)
    } else {
      let mark = html.only(checked, html" checked")
      boxes.push(html"""
        <label class=cap>
          <input type=checkbox name="cap.{capability}"{mark}> <code>{capability}</code>{needed}
        </label>
        """)
    }
  }
  let allow = match posted {
    Some(form) => form.get("allow").unwrapOr("")
    None => "\n".join(app.fetchAllow)
  }
  var inputs = Vector.of()
  for field in limitFields() {
    let value = match posted {
      Some(form) => form.get(field.name).unwrapOr("")
      None => "{limitValue(app.limits, field.name)}"
    }
    // The field holds the value; this says where the value came from, which
    // is the one thing the form cannot show by holding it.
    let changed = html.only(
      app.limitsChanged.contains(limitKey(field.name)),
      html""" <span class=added title="set here, not in app.toml">(changed)</span>""",
    )
    inputs.push(html"""
      <div class=field>
        <label for="{field.name}">{field.label}{changed}</label>
        <input id="{field.name}" name="{field.name}" value="{value}" inputmode=numeric required>
      </div>
      """)
  }
  html"""
    <h2>Grant, allowlist and limits</h2>
    <div class=panel>
      <form method=post action="{at}/configure">
        <fieldset>
          <legend>Grant</legend>
          <p class=more>A capability the code needs and does not have leaves this app refused,
          and no other.</p>
          <div class=caps>{boxes.freeze()}</div>
        </fieldset>
        <fieldset>
          <legend>Fetch allowlist</legend>
          <p class=muted>One per line: <code>https://host</code>, <code>http://host:port</code>
          or <code>http://host:*</code>.</p>
          <textarea name=allow rows=5>{allow}</textarea>
        </fieldset>
        <fieldset>
          <legend>Limits</legend>
          <div class=fields>{inputs.freeze()}</div>
        </fieldset>
        <div class=actions>
          <button class=primary>Check and apply</button>
          <span class=muted>The host reloads the app with these settings; a change that does
          not work is not kept.</span>
        </div>
      </form>
    </div>
    """
}

fn resetForm(at: String) -> Html {
  html"""
    <h2>Back to the deploy</h2>
    <div class=panel>
      <form method=post action="{at}/reset">
        <div class=actions>
          <button>Reset to app.toml</button>
          <span class=muted>Drops every change made here to the grant, the allowlist and the
          limits.</span>
        </div>
      </form>
    </div>
    """
}

// ------------------------------------------- an app's store and its log

/// How many keys a page of the store shows.
fn storePageSize() -> Int {
  50
}

/// The path of an app's pages.
fn appAt(base: String, app: host.App) -> String {
  "{base}/apps/{app.name}"
}

/// The time of day of `millis` (JST), the whole stamp as its title.
fn atTime(millis: Int) -> Html {
  let stamp = jstStamp(millis)
  let clock = stamp.sliceBytes(11, 23).unwrapOr(stamp)
  html"""<span title="{jst(millis)} JST">{clock}</span>"""
}

/// What a page about one thing of an app's says when the host could not
/// read it, and the way back.
fn notRead(head: Html, message: String, back: Html) -> Html {
  html"{head}<div class=problem><b>Not read.</b> The host said:<pre>{message}</pre></div>{back}"
}

/// One app's store: a page of its keys, or — with `?key=` — one key whole.
/// Reading only: the admin app has no way to write to another app's store,
/// and the host gives it none.
fn storePage(base: String, app: host.App, request: web.Request) -> Html {
  let key = request.query.get("key").unwrapOr("")
  if key != "" {
    return storeKeyPage(base, app, key)
  }
  let at = appAt(base, app)
  let prefix = request.query.get("prefix").unwrapOr("")
  let after = request.query.get("after").unwrapOr("")
  if !app.granted.contains("kv") {
    return layout(
      base,
      "apps",
      "{app.name} store",
      html"""
        {appHead(base, app, "Data")}
        <p class=lead><code>{app.name}</code> is not granted <code>kv</code>: it has no store,
        and the host keeps no file for it.</p>
        """,
    )
  }
  // One more than the page, to know whether there is another page.
  let size = storePageSize()
  let found = host.kv(app.name, prefix, after, size + 1)
  var rows = Vector.of()
  var at_ = 0
  var last = ""
  for entry in found {
    if at_ < size {
      let link = "{at}/kv?key={text.urlEncode(entry.key)}"
      // The host cut at its own length; a row of a table wants less again.
      let preview = text.truncateBytes(entry.value, 140)
      let cut = entry.cut || preview.byteLength() < entry.value.byteLength()
      let shown = html"{preview}{html.only(cut, html"<span class=muted>…</span>")}"
      rows.push(html"""
        <tr>
          <td class=title data-label=key><a href="{link}"><code>{entry.key}</code></a></td>
          <td class="value block" data-label=value><code>{shown}</code></td>
          <td class=nums data-label=size>{text.bytes(entry.bytes)}</td>
        </tr>
        """)
      last = entry.key
    }
    at_ = at_ + 1
  }
  let more = at_ > size
  let table = if rows.length() == 0 {
    let why = if prefix == "" && after == "" {
      "This store has no keys yet."
    } else {
      "No key here."
    }
    html"<p class=muted>{why}</p>"
  } else {
    html"""
      <div class="scroll cardwrap">
        <table class=cards>
          <tr class=head><th>key</th><th>value</th><th>size</th></tr>
          {rows.freeze()}
        </table>
      </div>
      """
  }
  let filter = html"""
    <form class=inline method=get action="{at}/kv">
      <label for=prefix>keys starting with</label>
      <input id=prefix name=prefix value="{prefix}" placeholder="(any)">
      <button>Show</button>
    </form>
    """
  // The `&` between two parameters is written `&amp;`, as an `&` in an
  // attribute is: the parameters are holes and escaped, and the `&` is the
  // page's own.
  let first = text.urlEncode(prefix)
  var steps = Vector.of()
  if after != "" {
    steps.push(html"""<a href="{at}/kv?prefix={first}">← the first {size}</a>""")
  }
  if more {
    steps.push(html"""<a href="{at}/kv?prefix={first}&amp;after={text.urlEncode(last)}">the next {size} →</a>""")
  }
  let paging = html.only(steps.length() > 0, html"<p class=actions>{html.join(steps.freeze(), html" ")}</p>")
  let held = if app.kvKeys < 0 {
    "The host has not opened this store since it started."
  } else {
    "{app.kvKeys} keys, {text.bytes(app.kvBytes)} in all."
  }
  let summary = html"Reading only — the admin app cannot write to another app's store."
  let told = html"""
    {held} A value longer than the column is cut; the key opens it whole. Nothing here writes:
    the admin app reads another app's store and cannot change it.
    """
  layout(
    base,
    "apps",
    "{app.name} store",
    html"{appHead(base, app, "Data")}{about(summary, told)}{filter}{table}{paging}",
  )
}

/// One key of an app's store, its value whole (cut at what the host
/// carries, which the page says).
fn storeKeyPage(base: String, app: host.App, key: String) -> Html {
  let at = appAt(base, app)
  let back = html"""<p class=actions><a href="{at}/kv">← every key</a></p>"""
  match host.kvValue(app.name, key) {
    Ok(entry) => {
      let cut = html.only(entry.cut, html" <span class=muted>(cut: the whole value is {text.bytes(entry.bytes)})</span>")
      let facts = html"""
        <div class="scroll narrow">
          <table class=facts>
            <tr><th>key</th><td><code>{entry.key}</code></td></tr>
            <tr><th>size</th><td>{text.bytes(entry.bytes)}{cut}</td></tr>
          </table>
        </div>
        """
      layout(
        base,
        "apps",
        "{app.name} store",
        html"{appHead(base, app, "Data")}{facts}<h2>Value</h2><pre>{entry.value}</pre>{back}",
      )
    }
    Err(error) => layout(
      base,
      "apps",
      "{app.name} store",
      notRead(appHead(base, app, "Data"), error.message, back),
    )
  }
}

// ------------------------------------- the code the app is running
//
// No entry in `nav` for this: it is an app's own page, like its store and
// its log, reached from the app and placed by `crumb`. The navigation is
// the three things that are not about one app (apps, secrets, history).

/// How many files a page of a deploy shows.
fn codePageSize() -> Int {
  200
}

/// The longest file text the host carries (`crate::code::READ_TEXT_BYTES`),
/// so that a page that was cut can say at what.
fn codeTextBytes() -> Int {
  131072
}

/// The most pieces one file's colouring carries
/// (`crate::code::HIGHLIGHT_PIECES`), so that a file shown plain for being
/// past it can say what it was past.
fn codePieceLimit() -> Int {
  20000
}

/// What `assets/` is called in a deploy's names, which is also what comes
/// off one to leave the path the host answers that file on.
fn assetsPrefix() -> String {
  "assets/"
}

/// What a file is, as the listing says it. The configuration first, because
/// it is the thing that decides what the app may do and the usual reason to
/// look.
fn codeKind(file: host.CodeFile) -> Html {
  if file.kind == "dir" {
    return html"<span class=muted>directory</span>"
  }
  if file.kind == "config" {
    return html"<span class=muted>configuration</span>"
  }
  if file.kind == "cove" {
    return html"<span class=muted>code</span>"
  }
  if file.isText {
    return html"<span class=muted>asset</span>"
  }
  html"<span class=muted>asset, not text</span>"
}

/// What the file of the same name in the app's directory says of this one.
/// `same` is the quiet case; the others are what a deploy that was staged
/// and not switched to, or an edit made on the machine, looks like from
/// here. The colours are the state badges' rather than two more of their
/// own: a difference is the bad news and a file that is not there to
/// compare is the odd news.
fn onDisk(file: host.CodeFile) -> Html {
  if file.kind == "dir" {
    // A directory is not a file, so there is no file of it on disk for the
    // one that is running to differ from. A row of the tree asks this of
    // the files only; this is what a caller that does not is told.
    return html"<span class=muted>–</span>"
  }
  if file.kind == "config" {
    // There is nothing for it to disagree with: the load keeps only what
    // it parsed to, so this file is the directory's.
    return html"""<span class=muted title="this file is read from the app's directory">read from there</span>"""
  }
  if file.onDisk == "same" {
    return html"<span class=muted>same</span>"
  }
  if file.onDisk == "differs" {
    return html"""
      <span class="state refused"
      title="the file in the app's directory is not the one that is running">differs</span>
      """
  }
  if file.onDisk == "missing" {
    return html"""<span class="state removed" title="the app's directory has no such file">missing</span>"""
  }
  html"""
    <span class="state removed"
    title="the file in the app's directory could not be read">unread</span>
    """
}

/// Where the host answers an asset of this app, as a path: the whole path is
/// the app's where it is reached by hostname, and `/<app>/…` where it is
/// reached by path.
///
/// Only an asset has one — the name it takes `assets/` off is an asset's —
/// so the caller asks this of nothing else.
fn servedAt(app: host.App, file: host.CodeFile) -> String {
  let prefix = assetsPrefix()
  let within = file.name.sliceBytes(prefix.byteLength(), file.name.byteLength()).unwrapOr("")
  if app.hosts.length() > 0 {
    return "/{within}"
  }
  "/{app.name}/{within}"
}

/// Which hostname that path is on. Said rather than linked: these pages are
/// reached by a hostname of their own, and a hostname bound to an app
/// reaches that app with the whole path, so `/{app}/file` written from here
/// would be a request to this app and a 404.
fn servedOn(app: host.App) -> Html {
  match app.hosts.get(0) {
    Some(hostname) => html"<code>{hostname}</code>"
    None => html"whichever hostname reaches the host's apps by path"
  }
}

/// One row of the tree: a file, with the way to its text, or the directory
/// that holds the rows under it, as the item that opens it.
///
/// It opens the item and leaves it open, because a directory's `</li>` comes
/// after the list of what is under it and `codeTree`, which is watching the
/// depths, is what knows where that is.
///
/// What the file is, what it comes to and how the directory's copy compares
/// are beside the name rather than in columns of their own — the tree is the
/// shape here, and a column is what cost it the nesting. They are **named**
/// here all the same, `what`, `size` and `disk`, so the stylesheet can hold
/// each to a width and line them up down the page: a list of sizes that does
/// not line up is a list nobody reads down. A directory has nothing on disk
/// to differ from, so its `disk` is empty and keeps the column open.
///
/// The name and what is beside it are one `row` inside the item, because the
/// item also holds the list of what is under a directory, and a row that is
/// the whole item would take that list into it.
///
/// The name shown is the last part of it, since the parts above are the rows
/// above; the whole path is the link's `title`, where it is still readable
/// and still escaped. A directory is not a link: the host has no text of one
/// to answer, so there is nothing for it to point at.
fn codeRow(at: String, file: host.CodeFile) -> Html {
  let disk = if file.kind == "dir" { None } else { Some(onDisk(file)) }
  let meta = html"""
    <span class=meta>
      <span class=what>{codeKind(file)}</span>
      <span class=size>{text.bytes(file.bytes)}</span>
      <span class=disk>{disk}</span>
    </span>
    """
  if file.kind == "dir" {
    return html"<li class=dir><span class=row><code>{file.label}/</code> {meta}</span>"
  }
  let link = "{at}/code?file={text.urlEncode(file.name)}"
  html"""
    <li>
      <span class=row><a href="{link}" title="{file.name}"><code>{file.label}</code></a> {meta}</span>
    """
}

/// The rows as a tree: a list inside the item that holds it, which is what
/// makes the nesting the markup and not a left padding. **A table could not
/// do it**: an indented cell reads as a tree only on a wide screen, and on a
/// narrow one `table.cards` turns every row into a card of its own and the
/// nesting is gone altogether.
///
/// The host said how deep every row is, so this only opens and closes lists
/// to match: a row deeper than the one above opens a list inside its item, a
/// row shallower closes one list a level, and the end closes what is left.
/// A depth that skips a level — which the host does not produce, since it
/// opens a directory row for every part of a name — opens one list and no
/// more, so no gap in the depths can leave a tag unclosed or close one that
/// was never opened.
///
/// Which is also why the pieces here are not each a whole element: an
/// `html"…"` is markup whatever it holds, and `</li></ul>` is the markup
/// that closes what an earlier piece opened.
fn codeTree(at: String, files: Array<host.CodeFile>) -> Html {
  var out = Vector.of()
  // How many lists are open. The item opened last is in the innermost of
  // them and is still waiting for its `</li>`.
  var open = 0
  for file in files {
    // Which list this row belongs in, counting from one: its depth, but at
    // most one deeper than what is open and never outside the outermost.
    var want = file.depth + 1
    if want > open + 1 {
      want = open + 1
    }
    if want < 1 {
      want = 1
    }
    while open > want {
      out.push(html"</li></ul>")
      open = open - 1
    }
    if open == want {
      // A sibling of the row above: that row's item ends here.
      out.push(html"</li>")
    } else {
      let list = html"<ul{html.only(open == 0, html" class=tree")}>"
      out.push(list)
      open = want
    }
    out.push(codeRow(at, file))
  }
  while open > 0 {
    out.push(html"</li></ul>")
    open = open - 1
  }
  html"{out.freeze()}"
}

/// What the version the app is running is made of: its `app.toml`, its
/// `.cove` files at any depth and its `assets/` — the whole of what a deploy
/// carries, as a tree — or, with `?file=`, one file's text.
///
/// What is shown is what is **running**: the code is the source map the app
/// was compiled with and the assets are the bytes the host serves, both held
/// since the app was loaded, so neither can disagree with the version above.
/// `app.toml` is the exception — the load keeps only what it parsed to — and
/// is read from the app's directory.
fn codePage(base: String, app: host.App, request: web.Request) -> Html {
  let file = request.query.get("file").unwrapOr("")
  if file != "" {
    return codeFilePage(base, app, file)
  }
  let at = appAt(base, app)
  // One more than the page, to know whether there are more.
  let size = codePageSize()
  let found = host.code(app.name, size + 1)
  var shown = Vector.of()
  // The host's limit counts files, and so does this: a directory row is
  // there for the files under it and is not one of them.
  var files = 0
  var differing = 0
  for entry in found {
    let isFile = entry.kind != "dir"
    if isFile {
      files = files + 1
    }
    if files <= size {
      shown.push(entry)
      if isFile && entry.kind != "config" && entry.onDisk != "same" {
        differing = differing + 1
      }
    }
  }
  let tree = if shown.length() == 0 {
    html"""
      <p class=muted>The host has no version of this app loaded, so there is nothing it is
      running.</p>
      """
  } else {
    html"""<div class="panel tree">{codeTree(at, shown.freeze())}</div>"""
  }
  let differs = html.only(differing != 0, differingFiles(differing))
  let more = html.only(
    files > size,
    html"""
      <p class=muted>The first {size} files; this deploy has more, which this page does not
      show.</p>
      """,
  )
  let summary = html"""
    What is running, not what is in the app's directory — and each file says how the two
    compare.
    """
  let told = html"""
    What <code>{app.version}</code> is made of: its <code>app.toml</code>, its
    <code>.cove</code> files and its <code>assets/</code>, which is the whole of what a deploy
    carries. The code and the assets are the ones the host is running, held since the app was
    loaded; <code>app.toml</code> is read from the app's directory, because the load keeps
    only the settings it parsed to — which is why the app's own page can show a grant or a
    limit this file does not. Beside each name is what the file is, what it comes to, and how
    the file of the same name in the app's directory compares. The directories are the app's
    own, nested as it has them. Reading only.
    """
  layout(
    base,
    "apps",
    "{app.name} code",
    html"{appHead(base, app, "Code")}{about(summary, told)}{differs}{tree}{more}",
  )
}

/// The problem the code page states when `differing` of the files it shows
/// are not the ones in the app's directory: how many, and the two ways that
/// comes about.
fn differingFiles(differing: Int) -> Html {
  // Text and not markup, so the `'` in it is escaped as a host's value is:
  // that is how this page has always written it.
  let count = if differing == 1 {
    "One file in the app's directory is not the one that is running."
  } else {
    "{differing} files in the app's directory are not the ones that are running."
  }
  html"""
    <div class=problem><b>{count}</b> A deploy that was staged and not switched to, or an
    edit made on the machine: either way, what is below is what the host is running, and the
    directory holds something else.</div>
    """
}

/// One piece of a coloured file: its text, escaped, inside the `<span>` the
/// stylesheet colours.
///
/// **The text is the file's own bytes and the hole is what makes it text.**
/// The host answers a kind and a run of text and never markup, so the text is
/// a `String` and escaped like every other value these pages show — and a
/// file's text is the value likeliest to be markup itself.
///
/// The class is one letter because a file comes to thousands of these and
/// the class is in every one of them. A kind with no span of its own —
/// `plain`, and any kind the host grows later — is its text and no element,
/// which is how an unknown kind reads as code rather than as nothing.
fn codePiece(piece: host.CodePiece) -> Html {
  let body = html"{piece.text}"
  if piece.kind == "keyword" {
    return html"<span class=k>{body}</span>"
  }
  if piece.kind == "type" {
    return html"<span class=t>{body}</span>"
  }
  if piece.kind == "ident" {
    return html"<span class=i>{body}</span>"
  }
  if piece.kind == "string" {
    return html"<span class=s>{body}</span>"
  }
  if piece.kind == "number" {
    return html"<span class=n>{body}</span>"
  }
  if piece.kind == "comment" {
    return html"<span class=c>{body}</span>"
  }
  if piece.kind == "doc" {
    return html"<span class=d>{body}</span>"
  }
  if piece.kind == "punct" {
    return html"<span class=p>{body}</span>"
  }
  body
}

/// Why a file is shown with no colour, said rather than left to look like a
/// file with nothing in it worth colouring.
fn codePlainWhy(file: host.CodeFile) -> Html {
  if file.plain == "cut" {
    return html"""
      <p class=muted>Shown with no colouring: the text below stops at what the host carries,
      and colouring part of a file would say that the rest of it is whatever the cut fell
      inside.</p>
      """
  }
  if file.plain == "dense" {
    return html"""
      <p class=muted>Shown with no colouring: this file comes to more pieces than one page
      carries ({codePieceLimit()}), and a page that was slow to arrive would be worse than a
      page with no colour on it.</p>
      """
  }
  html"""
    <p class=muted>Shown with no colouring: the host reads <code>.cove</code>,
    <code>.toml</code>, <code>.css</code> and XML, and has no reader for this kind of file.
    A colouring guessed from a name would be a claim about the file; none is no claim.</p>
    """
}

/// A file's text in a `<pre>`, coloured where the host coloured it.
///
/// The pieces concatenated are the text, so this shows the file either way;
/// what the host decides is whether the `<span>`s are there.
fn codeBody(file: host.CodeFile) -> Html {
  if file.plain != "" {
    return html"{codePlainWhy(file)}<pre class=code>{file.text}</pre>"
  }
  var parts = Vector.of()
  for piece in file.pieces {
    parts.push(codePiece(piece))
  }
  html"<pre class=code>{parts.freeze()}</pre>"
}

/// One file of a deploy: its text, coloured, and cut at what the host
/// carries, which the page says. A file that is not UTF-8 has no text to
/// show — a page that pretended to render a PNG would say less than this
/// does — so where the host answers it is said instead.
fn codeFilePage(base: String, app: host.App, name: String) -> Html {
  let at = appAt(base, app)
  let back = html"""<p class=actions><a href="{at}/code">← every file</a></p>"""
  match host.codeFile(app.name, name) {
    Ok(file) => {
      let whole = text.bytes(file.bytes)
      let cut = html.only(file.cut, html" <span class=muted>(cut at {text.bytes(codeTextBytes())}: the whole file is {whole})</span>")
      let facts = html"""
        <div class="scroll narrow">
          <table class=facts>
            <tr><th>file</th><td><code>{file.name}</code></td></tr>
            <tr><th>what</th><td>{codeKind(file)}</td></tr>
            <tr><th>size</th><td>{text.bytes(file.bytes)}{cut}</td></tr>
            <tr><th>on disk</th><td>{onDisk(file)}</td></tr>
          </table>
        </div>
        """
      let body = if file.isText {
        let heading = if file.cut { "The first {text.bytes(codeTextBytes())}" } else { "The file" }
        html"<h2>{heading}</h2>{codeBody(file)}"
      } else if file.kind == "asset" {
        html"""
          <h2>Not text</h2>
          <p class=muted>Not UTF-8, so there is no text of it to show. The host answers this
          file itself, at <code>{servedAt(app, file)}</code> on {servedOn(app)}, where a
          browser shows it as it is.</p>
          """
      } else {
        // Only an asset is meant not to be text. A `.cove` file that is not
        // could not have compiled, and an `app.toml` that is not could not
        // have been read — so this is the app's page saying why it is
        // refused, from the other end.
        html"""
          <h2>Not text</h2>
          <p class=muted>Not UTF-8, which for this file is not a kind of file but a fault: the
          host reads it as text or does not load the app at all.</p>
          """
      }
      layout(
        base,
        "apps",
        "{app.name} code",
        html"{appHead(base, app, "Code")}{facts}{body}{back}",
      )
    }
    Err(error) => layout(
      base,
      "apps",
      "{app.name} code",
      notRead(appHead(base, app, "Code"), error.message, back),
    )
  }
}


// ------------------------------------------- an app's SQL store
//
// Reading only, and not by a check of this app's own: the host runs the
// statement through the same `sql.query` the app's own calls go through,
// which refuses one that writes before it is stepped. The page says so and
// shows the refusal as it came.
//
// The form is a GET, and the statement is in the URL. A read changes
// nothing, so there is nothing here for a form on another site to make
// happen — the origin check the host app does is for the POSTs that change
// it — and the page can be linked, reloaded and gone back to.

/// The most rows the host's window answers (`crate::sql::PEEK_ROWS`), so
/// that the page can say what it is bounded by rather than leaving somebody
/// to find out.
fn sqlRowLimit() -> Int {
  200
}

/// How long one of its statements may run (`crate::sql::PEEK_STATEMENT_MS`).
fn sqlStatementMs() -> Int {
  1000
}

/// How much of a cell a column shows, as the store's page cuts a value.
fn sqlCellBytes() -> Int {
  140
}

/// One cell of an answer.
///
/// `None` is SQL's `NULL` and `Some("")` is the empty string: the store
/// keeps the two apart, and a window that showed them alike — both as an
/// empty cell — would hide the one thing a nullable column is about. So
/// each is said in words, and neither is said in nothing.
fn sqlCell(value: Option<String>) -> Html {
  match value {
    Some(said) => {
      if said == "" {
        html"""<span class=muted title="the empty string, not NULL">empty</span>"""
      } else {
        let preview = text.truncateBytes(said, sqlCellBytes())
        if preview.byteLength() < said.byteLength() {
          // Longer than the column: `substr` is how to ask for the rest,
          // which is a statement and not a page of its own.
          html"<code>{preview}<span class=muted>…</span></code>"
        } else {
          html"<code>{said}</code>"
        }
      }
    }
    None => html"""<span class=muted title="SQL NULL, not the empty string">NULL</span>"""
  }
}

/// What a statement answered, as a table: the column names, then a row
/// each. Every name and every value came from the host as a `String` and is
/// escaped by the hole it goes in — a row of an app's data is the likeliest
/// markup on these pages.
fn sqlAnswerTable(answer: host.SqlAnswer) -> Html {
  if answer.columns.length() == 0 {
    return html"<p class=muted>The statement answered no columns.</p>"
  }
  var heads = Vector.of()
  for column in answer.columns {
    heads.push(html"<th>{column}</th>")
  }
  var rows = Vector.of()
  for row in answer.rows {
    var cells = Vector.of()
    var at = 0
    for value in row.values {
      let label = answer.columns.get(at).unwrapOr("")
      cells.push(html"""<td class="value block" data-label="{label}">{sqlCell(value)}</td>""")
      at = at + 1
    }
    rows.push(html"<tr>{cells.freeze()}</tr>")
  }
  if rows.length() == 0 {
    return html"<p class=muted>No rows.</p>"
  }
  let counted = if rows.length() == 1 { "1 row." } else { "{rows.length()} rows." }
  html"""
    <div class="scroll cardwrap">
      <table class=cards>
        <tr class=head>{heads.freeze()}</tr>
        {rows.freeze()}
      </table>
    </div>
    <p class=muted>{counted}</p>
    """
}

/// The tables of a store and how many rows each holds, with a statement
/// written for each: the first rows of a table are what somebody wants next,
/// and a link is less to type than a `SELECT`.
fn sqlTablesTable(at: String, tables: Array<host.SqlTable>) -> Html {
  if tables.length() == 0 {
    return html"<p class=muted>This store has no tables yet.</p>"
  }
  var rows = Vector.of()
  for table in tables {
    let count = if table.counted {
      html"{table.rows}"
    } else {
      html"""<span class=muted title="counting its rows ran out of the window's time">not counted</span>"""
    }
    // A name is an identifier in the statement's text, which is where
    // SQLite takes one: quoted, with a `"` in it doubled.
    let quoted = table.name.replace("\"", "\"\"")
    let statement = "SELECT * FROM \"{quoted}\" LIMIT 50"
    let link = "{at}/sql?q={text.urlEncode(statement)}"
    rows.push(html"""
      <tr>
        <td class=title data-label=table><a href="{link}"><code>{table.name}</code></a></td>
        <td class=nums data-label=rows>{count}</td>
      </tr>
      """)
  }
  html"""
    <div class="scroll cardwrap">
      <table class=cards>
        <tr class=head><th>table</th><th>rows</th></tr>
        {rows.freeze()}
      </table>
    </div>
    """
}

/// The box a statement is typed into, with the statement in it again.
///
/// This is the one place on these pages where something somebody typed goes
/// back inside an attribute's quotes. A hole writes `"` as `&quot;` and `'`
/// as `&#39;` as well as the angle brackets, so the statement stays the
/// attribute's value whatever it holds; without that, a statement holding a
/// quote would end the attribute and the rest of it would be markup.
fn sqlForm(at: String, statement: String) -> Html {
  html"""
    <form class=inline method=get action="{at}/sql">
      <label for=q>statement</label>
      <input class=sql id=q name=q value="{statement}" placeholder="SELECT * FROM … LIMIT 20"
      spellcheck=false autocapitalize=off>
      <button>Run</button>
    </form>
    """
}

/// What the page says above the box, which is what the window is and what it
/// will not do.
fn sqlLead(app: host.App) -> Html {
  about(
    html"Reading only — a statement that writes is refused.",
    html"""
      What is in <code>{app.name}</code>'s relational store. The box runs one statement that
      <b>only reads</b>: a statement that writes is refused by the host, the same refusal the
      app's own <code>sql.query</code> gets, so there is nothing here that can change this
      app's data — repairing data is done on the machine, where it is deliberate. At most
      {sqlRowLimit()} rows come back, and an answer with more rows than that says so rather
      than showing the first {sqlRowLimit()} of them; a statement still running after
      {sqlStatementMs()} ms is stopped where it is. A value is text: <code>NULL</code> and the
      empty string are said in words, and a long one is cut to the column. Nothing typed here
      is kept — a read is not a change, so the history does not record it.
      """,
  )
}

/// One app's SQL store: its tables and their row counts, or — with `?q=` —
/// what one statement answers.
fn sqlPage(base: String, app: host.App, request: web.Request) -> Html {
  let at = appAt(base, app)
  let head = appHead(base, app, "SQL")
  if !app.granted.contains("sql") {
    return layout(
      base,
      "apps",
      "{app.name} sql",
      html"""
        {head}
        <p class=lead><code>{app.name}</code> is not granted <code>sql</code>: it has no
        relational store, and the host keeps no file for it.</p>
        """,
    )
  }
  let statement = request.query.get("q").unwrapOr("").trim()
  let form = sqlForm(at, statement)
  if statement == "" {
    let tables = host.sqlTables(app.name)
    return layout(
      base,
      "apps",
      "{app.name} sql",
      html"{head}{sqlLead(app)}{form}<h2>Tables</h2>{sqlTablesTable(at, tables)}",
    )
  }
  let answered = match host.sqlQuery(app.name, statement) {
    Ok(answer) => html"<h2>Answer</h2>{sqlAnswerTable(answer)}"
    Err(error) => html"<div class=problem><b>Not answered.</b> The host said:<pre>{error.message}</pre></div>"
  }
  let back = html"""<p class=actions><a href="{at}/sql">← the tables</a></p>"""
  layout(base, "apps", "{app.name} sql", html"{head}{sqlLead(app)}{form}{answered}{back}")
}

// ------------------------------------------- an app's queues
//
// Reading only, and not by a rule of this page's: the host's window leases
// nothing, counts no attempt and moves no due time, so a queue somebody
// opened is delivered exactly as it would have been. `queue.lease` — the
// only way the delivery loop sees a message — could not be used for a page
// at all, which is why the host grew reads of its own for this.
//
// There is no button to put a dead letter back. That is a change, and a
// change on these pages has a confirmation and a line in the history;
// `minicloud queues <app> --revive <id>` on the machine has both already,
// so the page says so rather than growing a half of one.

/// The most messages the host's window lists
/// (`crate::queue::PEEK_MESSAGES`), so the page can say what it is bounded
/// by rather than leaving somebody to find out.
fn queueListSize() -> Int {
  200
}

/// How much of a body a row shows, as the store's page cuts a value.
fn queueBodyBytes() -> Int {
  140
}

/// A duration the host carries in milliseconds, written as `[[queues]]`
/// writes it: `30s`, or milliseconds where seconds would round.
fn queueDuration(millis: Int) -> String {
  if millis % 1000 == 0 {
    return "{millis / 1000}s"
  }
  "{millis}ms"
}

/// What a message is, as the store can say it.
///
/// `held` is the one that has to be explained: a message whose due time is
/// ahead is either a delivery holding it on lease or a failed delivery
/// waiting for its retry, and the store keeps one `due` for both — so this
/// says `held` rather than calling a backoff a lease.
fn queueState(state: String) -> Html {
  if state == "due" {
    return html"""<span class="state serving" title="the next delivery tick may take it">due</span>"""
  }
  if state == "held" {
    return html"""
      <span class="state disabled" title="its due time is ahead: a delivery holding it on
      lease, or a failed delivery waiting for its retry. The store keeps one due time for
      both, so the host does not say which.">held</span>
      """
  }
  html"""
    <span class="state refused" title="buried as a dead letter: nothing delivers it again
    until somebody puts it back">dead</span>
    """
}

/// A message's body in a row. A queue carries whatever an app sent — a
/// webhook's payload, a form somebody filled in — so this is the likeliest
/// markup on these pages, and every part of it is a `String` in a hole.
fn queueBodyCell(message: host.QueueMessage) -> Html {
  if message.bytes == 0 {
    return html"""<span class=muted title="the message's body is empty">empty</span>"""
  }
  // The host cut at its own length; a row of a table wants less again.
  let preview = text.truncateBytes(message.body, queueBodyBytes())
  let cut = message.cut || preview.byteLength() < message.body.byteLength()
  if cut {
    return html"<code>{preview}<span class=muted>…</span></code>"
  }
  html"<code>{message.body}</code>"
}

/// Each queue of an app with what it holds and how the host delivers it.
///
/// Every queue the app declares is here, a queue nothing was ever sent to
/// included: 0 is an answer, and a missing row would read as "no such
/// queue". A queue the store holds messages for that the app no longer
/// declares is here too, saying so — nothing will ever deliver it.
fn queuesTable(queues: Array<host.Queue>) -> Html {
  var rows = Vector.of()
  for queue in queues {
    let delivered = if queue.declared {
      html"<code>{queue.path}</code>"
    } else {
      html"""
        <span class="state removed" title="the app's [[queues]] no longer declares this queue,
        so the host delivers nothing from it">not declared</span>
        """
    }
    let values = if queue.declared {
      "{queue.maxAttempts} attempts, retry {queueDuration(queue.retryMs)} doubling, \
        lease {queueDuration(queue.leaseMs)}, {queue.batch} at once, depth {queue.maxDepth}, \
        body {text.bytes(queue.maxBodyBytes)}"
    } else {
      "–"
    }
    let settings = html"<span class=muted>{values}</span>"
    rows.push(html"""
      <tr>
        <td class=title data-label=queue><code>{queue.name}</code></td>
        <td data-label="delivered to">{delivered}</td>
        <td class=nums data-label=due>{queue.due}</td>
        <td class=nums data-label=held>{queue.held}</td>
        <td class=nums data-label=dead>{queue.dead}</td>
        <td class=block data-label=settings>{settings}</td>
      </tr>
      """)
  }
  html"""
    <div class="scroll cardwrap">
      <table class=cards>
        <tr class=head>
          <th>queue</th><th>delivered to</th><th>due</th><th>held</th><th>dead</th>
          <th>settings</th>
        </tr>
        {rows.freeze()}
      </table>
    </div>
    """
}

/// The whole stamp of a queue's time, not the time of day the log shows: a
/// retry's delay doubles, so a message can be due days off, and a dead
/// letter can be weeks old — a clock alone would read as today.
fn queueTime(millis: Int) -> String {
  jst(millis)
}

/// A message's id, as the way to the whole of it — the shape the store's
/// page has for a key, and for the same reason: a listing cuts a body, and
/// a queue's body is a payload that is often longer than the cut.
fn queueIdLink(at: String, message: host.QueueMessage) -> Html {
  html"""<a href="{at}/queues?message={message.id}"><code>{message.id}</code></a>"""
}

/// The messages still on an app's queues, what is due first — the order the
/// host will take them in.
fn queueMessagesTable(at: String, messages: Array<host.QueueMessage>) -> Html {
  if messages.length() == 0 {
    return html"<p class=muted>Nothing is waiting.</p>"
  }
  var rows = Vector.of()
  for message in messages {
    rows.push(html"""
      <tr>
        <td class=title data-label=id>{queueIdLink(at, message)}</td>
        <td data-label=queue><code>{message.queue}</code></td>
        <td data-label=state>{queueState(message.state)}</td>
        <td class=nums data-label=tries>{message.attempts}</td>
        <td class=when data-label="due (JST)">{queueTime(message.dueMs)}</td>
        <td class=when data-label="sent (JST)">{queueTime(message.sentMs)}</td>
        <td class="value block" data-label=body>{queueBodyCell(message)}</td>
      </tr>
      """)
  }
  html"""
    <div class="scroll cardwrap">
      <table class=cards>
        <tr class=head>
          <th>id</th><th>queue</th><th>state</th><th>tries</th>
          <th>due (JST)</th><th>sent (JST)</th><th>body</th>
        </tr>
        {rows.freeze()}
      </table>
    </div>
    """
}

/// The dead letters, newest buried first, each with why it was buried —
/// which is the status and the first line the consumer answered, or that it
/// did not answer at all.
fn queueDeadTable(at: String, messages: Array<host.QueueMessage>) -> Html {
  if messages.length() == 0 {
    return html"<p class=muted>No dead letters.</p>"
  }
  var rows = Vector.of()
  for message in messages {
    let why = if message.why == "" {
      html"<span class=muted>–</span>"
    } else {
      html"<code>{message.why}</code>"
    }
    rows.push(html"""
      <tr>
        <td class=title data-label=id>{queueIdLink(at, message)}</td>
        <td data-label=queue><code>{message.queue}</code></td>
        <td class=nums data-label=tries>{message.attempts}</td>
        <td class=when data-label="buried (JST)">{queueTime(message.buriedMs)}</td>
        <td class="value block" data-label=why>{why}</td>
        <td class="value block" data-label=body>{queueBodyCell(message)}</td>
      </tr>
      """)
  }
  html"""
    <div class="scroll cardwrap">
      <table class=cards>
        <tr class=head>
          <th>id</th><th>queue</th><th>tries</th><th>buried (JST)</th><th>why</th><th>body</th>
        </tr>
        {rows.freeze()}
      </table>
    </div>
    """
}

/// What a listing that reached the window's limit says. The counts in the
/// table above are whole, so the difference between them and what is listed
/// is what this page is not showing — which is worth saying, because a page
/// that showed 200 of 4000 as though they were all of them would be the one
/// wrong answer here.
fn queueMore(listed: Int, counted: Int, what: String) -> Html {
  if listed < queueListSize() {
    return html""
  }
  html"""
    <p class=muted>The first {listed} {what}, which is this window's limit; the counts above
    are whole. <code>minicloud queues</code> on the machine reads the rest.</p>
    """
}

/// What the page says above the tables: what the window is, and what it
/// will not do.
fn queuesLead(app: host.App) -> Html {
  about(
    html"Reading only — nothing here sends, deletes or revives a message.",
    html"""
      What is on <code>{app.name}</code>'s queues. <b>Reading only</b>: the host's window
      leases nothing and counts no attempt, so a message read here is delivered exactly as if
      nobody had looked, and there is nothing on this page that sends, deletes or revives one.
      <b>due</b> is what the next delivery tick may take, oldest sent first; <b>held</b> is a
      message whose due time is ahead — a delivery holding it on lease, or a failed delivery
      waiting for its retry — and the store keeps one due time for both, so neither the host
      nor this page claims to know which. At most {queueListSize()} messages are listed, and a
      body longer than the column is cut — the id opens it whole. A dead letter is kept until
      somebody deals with it: the host prunes none, so a number here that grows is work nobody
      has looked at. To put one back:
      <code>minicloud queues {app.name} --revive &lt;id&gt;</code> on the machine, because
      reviving is a change and a change wants the confirmation and the line in the history
      that the forms here have.
      """,
  )
}

/// One app's queues: each declared queue with what it holds, the messages
/// waiting, and the dead letters — or, with `?message=`, one message whole.
fn queuesPage(base: String, app: host.App, request: web.Request) -> Html {
  match Int.parse(request.query.get("message").unwrapOr("").trim()) {
    Ok(id) => return queueMessagePage(base, app, id)
    Err(_) => {}
  }
  let head = appHead(base, app, "Queues")
  let title = "{app.name} queues"
  let queues = host.queues(app.name)
  if queues.length() == 0 {
    // Two different nothings, and which it is decides what to do about it.
    let why = if app.granted.contains("queue") {
      html"""
        <code>{app.name}</code> is granted <code>queue</code>, and its <code>app.toml</code>
        declares no <code>[[queues]]</code>: a queue must be declared before anything can be
        sent to it.
        """
    } else {
      html"""
        <code>{app.name}</code> is not granted <code>queue</code>: it has no queue, and the
        host keeps no file for it.
        """
    }
    return layout(base, "apps", title, html"{head}<p class=lead>{why}</p>")
  }
  var waiting = 0
  var dead = 0
  for queue in queues {
    waiting = waiting + queue.due + queue.held
    dead = dead + queue.dead
  }
  let at = appAt(base, app)
  let messages = host.queueMessages(app.name, queueListSize())
  let buried = host.queueDead(app.name, queueListSize())
  layout(
    base,
    "apps",
    title,
    html"""
      {head}
      {queuesLead(app)}
      <h2>Queues</h2>{queuesTable(queues)}
      <h2>Waiting</h2>{queueMessagesTable(at, messages)}
      {queueMore(messages.length(), waiting, "of what is waiting")}
      <h2>Dead letters</h2>{queueDeadTable(at, buried)}
      {queueMore(buried.length(), dead, "dead letters")}
      """,
  )
}

/// The longest body one message's read carries
/// (`crate::queue::READ_BODY_CHARS`), so that a page that was cut can say
/// at what.
fn queueBodyChars() -> Int {
  65536
}

/// One message of a queue, waiting or buried: what the host knows of it,
/// and its body whole — cut at what the host carries, which the page says.
fn queueMessagePage(base: String, app: host.App, id: Int) -> Html {
  let at = appAt(base, app)
  let head = appHead(base, app, "Queues")
  let title = "{app.name} queues"
  let back = html"""<p class=actions><a href="{at}/queues">← every queue</a></p>"""
  match host.queueMessage(app.name, id) {
    Ok(message) => {
      let carried = text.bytes(queueBodyChars())
      let whole = text.bytes(message.bytes)
      let cut = html.only(message.cut, html" <span class=muted>(cut at {carried} of text: the whole body is {whole})</span>")
      // A dead letter's due time is the one it had when it was buried, so
      // showing it as "due" would be saying something untrue; the two rows
      // it has instead are when it was buried and why.
      let when = if message.state == "dead" {
        html"""
          <tr><th>buried</th><td class=when>{queueTime(message.buriedMs)}</td></tr>
          <tr><th>why</th><td><pre>{message.why}</pre></td></tr>
          """
      } else {
        html"<tr><th>next due</th><td class=when>{queueTime(message.dueMs)}</td></tr>"
      }
      let facts = html"""
        <div class="scroll narrow">
          <table class=facts>
            <tr><th>id</th><td><code>{message.id}</code></td></tr>
            <tr><th>queue</th><td><code>{message.queue}</code></td></tr>
            <tr><th>state</th><td>{queueState(message.state)}</td></tr>
            <tr><th>tries</th><td>{message.attempts}</td></tr>
            <tr><th>sent</th><td class=when>{queueTime(message.sentMs)}</td></tr>
            {when}
            <tr><th>size</th><td>{text.bytes(message.bytes)}{cut}</td></tr>
          </table>
        </div>
        """
      layout(base, "apps", title, html"{head}{facts}<h2>Body</h2><pre>{message.body}</pre>{back}")
    }
    Err(error) => layout(base, "apps", title, notRead(head, error.message, back))
  }
}

/// The lines of a log, oldest first, as a table of the time and what was
/// said. `lines` is what the host gave: it is never markup.
///
/// `withApp` puts the app each line came from beside the time, for the page
/// that has every app's on it. One app's page knows the app already, and a
/// column saying the same word on every row is a column that says nothing.
///
/// The level is a cell of its own and not the head of the text, so that a
/// narrow screen can keep what a line *is* — the time, the app, the level —
/// on one line and put what was said under it. A badge inside the text cell
/// can only be the first word of a paragraph, and the second line of that
/// paragraph starts under the time, where it reads as the next line's.
fn logTable(lines: Array<host.LogLine>, withApp: Bool = false) -> Html {
  if lines.length() == 0 {
    return html"<p class=muted>No lines yet.</p>"
  }
  var rows = Vector.of()
  for line in lines {
    let who = html.only(withApp, html"<td class=app><code>{line.app}</code></td>")
    rows.push(html"""
      <tr>
        <td class=at>{atTime(line.atMs)}</td>
        {who}
        <td class=lv><span class="lvl {levelClass(line.level)}">{line.level}</span></td>
        <td class=said>{line.text}</td>
      </tr>
      """)
  }
  html"<div class=scroll><table class=log>{rows.freeze()}</table></div>"
}

/// The class a level is shown with; anything the host grows later reads as
/// a level of its own without a colour of its own.
fn levelClass(level: String) -> String {
  if level == "info" || level == "warn" || level == "error" || level == "host" {
    return "lvl-{level}"
  }
  "lvl-info"
}

/// How many lines a log page shows, as asked for.
fn logLines(request: web.Request) -> Int {
  match Int.parse(request.query.get("n").unwrapOr("").trim()) {
    Ok(asked) => {
      if asked < 1 {
        1
      } else if asked > 1000 {
        1000
      } else {
        asked
      }
    }
    Err(_) => 200
  }
}

/// How many lines a log page shows, as the same page with `?n=`. `at` is
/// the page's own path, so the choice is the one thing the link changes.
fn logSteps(at: String, n: Int) -> Html {
  var steps = Vector.of()
  for size in Vector.of(50, 200, 1000).freeze() {
    if size == n {
      steps.push(html"<b>{size}</b>")
    } else {
      steps.push(html"""<a href="{at}?n={size}">{size}</a>""")
    }
  }
  html"<p class=actions><span class=muted>lines:</span> {html.join(steps.freeze(), html" ")}</p>"
}

/// One app's log: the host's ring of its last lines, oldest first.
fn logPage(base: String, app: host.App, request: web.Request) -> Html {
  let at = appAt(base, app)
  let n = logLines(request)
  let lines = host.logs(app.name, n)
  let how = logSteps("{at}/logs", n)
  let summary = html"What the app logged and what the host said of it, oldest first."
  let told = html"""
    {lines.length()} lines, of the last {logKept()} the host keeps in memory, which a restart
    empties. Every line is also appended to <code>&lt;data&gt;/{app.name}/log.txt</code>, which
    this page does not read.
    """
  layout(
    base,
    "apps",
    "{app.name} log",
    html"{appHead(base, app, "Logs")}{about(summary, told)}{how}{logTable(lines)}{how}",
  )
}

// ---------------------------------------------------------- metrics
//
// How fast an app is and how much it served, over time. The numbers are the
// ones the host samples each minute (`host.series`), drawn as a chart with
// a scale and times to read it by — unlike the operations page's sparkline,
// which is a cell in a table, here the picture is the subject.

/// Which window `?over=` asks for. One of the three the host knows, and
/// `hour` for anything else: the host would fall back to an hour as well,
/// but the page names the window in what it says and in the link it marks,
/// so it has to know which one it is showing rather than pass a stranger
/// through and be wrong about it.
fn metricsWindow(request: web.Request) -> String {
  let asked = request.query.get("over").unwrapOr("").trim()
  if asked == "day" || asked == "month" {
    return asked
  }
  "hour"
}

/// What a window is called in a sentence. The month is thirty days, which is
/// what the host reads (`crate::series::window`), so it says thirty.
fn metricsSpan(over: String) -> String {
  if over == "day" {
    "the last day"
  } else if over == "month" {
    "the last 30 days"
  } else {
    "the last hour"
  }
}

/// The three windows as the same page with `?over=`, the one being shown
/// marked and not a link, as the lines of a log page are.
fn metricsSteps(at: String, over: String) -> Html {
  windowSteps("{at}/metrics", over)
}

/// The three windows as links to `page?over=`, the one shown marked: the
/// row an app's Metrics and the Platform page both carry.
fn windowSteps(page: String, over: String) -> Html {
  var steps = Vector.of()
  for name in Vector.of("hour", "day", "month").freeze() {
    let label = metricsSpan(name)
    if name == over {
      steps.push(html"<b>{label}</b>")
    } else {
      steps.push(html"""<a href="{page}?over={name}">{label}</a>""")
    }
  }
  html"<p class=actions><span class=muted>window:</span> {html.join(steps.freeze(), html" ")}</p>"
}

/// Microseconds as milliseconds with one decimal, which is what the speed
/// chart and its figure are written in: a request is rarely under a tenth of
/// a millisecond and rarely over a few seconds, so milliseconds are the unit
/// both ends of that fit without a string of digits — and the histogram the
/// host estimates from is not finer than a tenth of one at the sizes where
/// it matters, so a decimal is all the precision there is to show.
fn millis(us: Int) -> String {
  let tenths = (us + 50) / 100
  "{tenths / 10}.{tenths % 10}"
}

/// The larger of two lists' largest values.
fn metricsLargest(a: Array<Int>, b: Array<Int>) -> Int {
  var largest = 0
  for value in a {
    if value > largest {
      largest = value
    }
  }
  for value in b {
    if value > largest {
      largest = value
    }
  }
  largest
}

// The charts' box, in the units of their `viewBox`: 720 wide and 460 tall,
// the plot inset from the left and right by 8, with 30 above it for the
// label of its top line and 32 below it for the times. The text is in the
// same units and is scaled with the box, so the stylesheet sets it larger
// on a narrow screen, where the box is drawn at half its size, and the
// room above and below the plot is what that larger text needs.

fn chartWidth() -> Int {
  720
}

fn chartHeight() -> Int {
  460
}

fn chartLeft() -> Int {
  8
}

fn chartRight() -> Int {
  712
}

fn chartTop() -> Int {
  30
}

fn chartBottom() -> Int {
  428
}

/// The step of a scale from 0 to `largest` with at most `count` steps: 1, 2
/// or 5 of a power of ten, the least of them that gets there — so a scale
/// has 3 to 5 lines with `count` 4, and every one of them is a round number.
fn niceStep(largest: Int, count: Int) -> Int {
  let raw = if count > 0 { (largest + count - 1) / count } else { largest }
  if raw <= 1 {
    return 1
  }
  var magnitude = 1
  while magnitude * 10 <= raw {
    magnitude = magnitude * 10
  }
  for factor in [1, 2, 5] {
    if factor * magnitude >= raw {
      return factor * magnitude
    }
  }
  magnitude * 10
}

/// The unit a size is written in on a chart: the largest of B, KiB, MiB,
/// GiB and TiB that `largest` is at least one of.
fn byteUnit(largest: Int) -> Int {
  var unit = 1
  while unit < 1099511627776 && unit * 1024 <= largest {
    unit = unit * 1024
  }
  unit
}

fn byteUnitName(unit: Int) -> String {
  if unit >= 1099511627776 {
    "TiB"
  } else if unit >= 1073741824 {
    "GiB"
  } else if unit >= 1048576 {
    "MiB"
  } else if unit >= 1024 {
    "KiB"
  } else {
    "B"
  }
}

/// The step of a chart's scale. `kind` is what its values are: `bytes`,
/// `ms` (microseconds, written as milliseconds), `percent` or `count`.
///
/// A size steps in round tenths of its unit — 0.5 GiB, 50 MiB — and not in
/// round bytes, which would be 476.8 MiB; a time steps in no less than a
/// tenth of a millisecond, the finest the chart writes.
fn chartStep(kind: String, largest: Int) -> Int {
  if kind == "bytes" {
    let unit = byteUnit(largest)
    if unit == 1 {
      return niceStep(largest, 4)
    }
    let tenths = (largest * 10 + unit - 1) / unit
    return (niceStep(tenths, 4) * unit + 5) / 10
  }
  let step = niceStep(largest, 4)
  if kind == "ms" && step < 100 {
    return 100
  }
  step
}

/// The values of a chart's horizontal lines: 0, then a step at a time up to
/// the first at or past `largest`, which is the top of the scale.
fn chartTicks(kind: String, largest: Int) -> Array<Int> {
  let step = chartStep(kind, largest)
  var out = Vector.of(0)
  var at = 0
  while at < largest {
    at = at + step
    out.push(at)
  }
  out.freeze()
}

/// A line's label, every line of a chart in one unit — that of its largest
/// value — and 0 written bare.
fn chartTickLabel(kind: String, value: Int, largest: Int) -> String {
  if value == 0 {
    return "0"
  }
  if kind == "bytes" {
    let unit = byteUnit(largest)
    if unit == 1 {
      return "{value} B"
    }
    let tenths = (value * 10 + unit / 2) / unit
    let whole = if tenths % 10 == 0 { "{tenths / 10}" } else { "{tenths / 10}.{tenths % 10}" }
    return "{whole} {byteUnitName(unit)}"
  }
  if kind == "ms" {
    if chartStep(kind, largest) % 1000 == 0 {
      return "{value / 1000} ms"
    }
    return "{millis(value)} ms"
  }
  if kind == "percent" {
    return "{value}%"
  }
  "{value}"
}

/// One value as the chart writes it at the end of a line and in a hover.
fn chartValue(kind: String, value: Int) -> String {
  if kind == "bytes" {
    platformBytes(value)
  } else if kind == "ms" {
    "{millis(value)} ms"
  } else if kind == "percent" {
    "{value}%"
  } else {
    "{value}"
  }
}

/// Japan Standard Time is UTC+9 all year — Japan has no daylight saving
/// time — so every time the pages show is the host's UTC millisecond plus
/// a fixed nine hours, written as the UTC time of that. The host's data
/// stay UTC; only what is written for a person is shifted.
fn jstOffsetSeconds() -> Int {
  32400
}

/// `millis` shifted to JST, written as `text.isoTime` writes a UTC time:
/// `2026-10-20T10:14:00.000Z` for 01:14 UTC. Not shown as it is — the Z
/// would be a lie — but sliced by the helpers below.
fn jstStamp(millis: Int) -> String {
  text.isoTime(millis + jstOffsetSeconds() * 1000)
}

/// A time as the pages write it: `2026-10-20 10:14:00`, JST.
fn jst(millis: Int) -> String {
  let stamp = jstStamp(millis)
  "{stamp.sliceBytes(0, 10).unwrapOr(stamp)} {stamp.sliceBytes(11, 19).unwrapOr(stamp)}"
}

/// The time of day in JST, to the minute: `10:14`.
fn jstClock(millis: Int) -> String {
  let stamp = jstStamp(millis)
  stamp.sliceBytes(11, 16).unwrapOr(stamp)
}

/// The date in JST, without the year: `10-20`.
fn jstDate(millis: Int) -> String {
  let stamp = jstStamp(millis)
  stamp.sliceBytes(5, 10).unwrapOr(stamp)
}

/// The spacing of the time axis for a span of `span` seconds with at most
/// `count` ticks: the least of the steps a clock is read in that does.
fn timeStep(span: Int, count: Int) -> Int {
  for step in [60, 120, 300, 600, 900, 1800, 3600, 7200, 10800, 21600, 43200, 86400, 172800, 604800] {
    if step * count >= span {
      return step
    }
  }
  2592000
}

/// The ticks of the time axis from `first` to `last` (Unix seconds): every
/// whole `step` between them, so that a tick of a quarter of an hour is at
/// :00, :15, :30 and :45, and a tick of a day at midnight, JST — the clock
/// is read in JST, so the steps are counted from JST's midnight.
fn timeTicks(first: Int, last: Int, step: Int) -> Array<Int> {
  var out = Vector.of()
  var at = (first + jstOffsetSeconds() + step - 1) / step * step - jstOffsetSeconds()
  while at <= last {
    out.push(at)
    at = at + step
  }
  out.freeze()
}

/// A tick's label: the time of day, `14:30`, or for ticks a day or more
/// apart the date, `10-20` — JST, as every time on these pages is.
fn timeTickLabel(at: Int, step: Int) -> String {
  if step >= 86400 {
    return jstDate(at * 1000)
  }
  jstClock(at * 1000)
}

/// A time as a hover says it: `10-20 14:30 JST`.
fn timeFull(at: Int) -> String {
  "{jstDate(at * 1000)} {jstClock(at * 1000)} JST"
}

/// Where a time is across the plot, for rows from `first` to `first +
/// span`. A row is put where its *time* is, not where it comes in the list:
/// the host writes no row for a minute it was down, or a minute an app did
/// nothing in the first sample after a start, and evenly spaced rows would
/// draw that gap as if the two sides of it were a minute apart.
fn chartX(at: Int, first: Int, span: Int) -> Int {
  chartLeft() + (at - first) * (chartRight() - chartLeft()) / span
}

/// Where a value is up the plot, for a scale from 0 to `top`.
fn chartY(value: Int, top: Int) -> Int {
  chartBottom() - value * (chartBottom() - chartTop()) / top
}

/// The span the rows cover, in seconds. A row is one minute (`PRIMARY KEY
/// (app, at)`), so two rows are never the same moment and the span is never
/// nothing; one rather than a division by it anyway: a page anybody may open
/// should not be one surprising row away from a trap.
fn chartSpan(times: Array<Int>) -> Int {
  let apart = times.get(times.length() - 1).unwrapOr(0) - times.get(0).unwrapOr(0)
  if apart > 0 { apart } else { 1 }
}

/// One line's `points`, for a scale from 0 to `top`. Whole numbers: nothing
/// a screen draws is finer than a pixel at this size.
fn metricsPoints(times: Array<Int>, values: Array<Int>, top: Int) -> String {
  let first = times.get(0).unwrapOr(0)
  let span = chartSpan(times)
  var out = Vector.of()
  var at = 0
  for value in values {
    let when = times.get(at).unwrapOr(first)
    out.push("{chartX(when, first, span)},{chartY(value, top)}")
    at = at + 1
  }
  " ".join(out.freeze())
}

/// The horizontal lines of the scale, drawn under everything else.
fn chartGrid(kind: String, largest: Int, top: Int) -> Html {
  var out = Vector.of()
  for value in chartTicks(kind, largest) {
    let y = chartY(value, top)
    let line = if value == 0 { "ch-base" } else { "ch-grid" }
    out.push(html"""<line class={line} x1="{chartLeft()}" y1="{y}" x2="{chartRight()}" y2="{y}"/>""")
  }
  html"{out.freeze()}"
}

/// The value of each horizontal line, above it at the left and inside the
/// plot — a margin for them would be a fifth of the chart on a phone — and
/// drawn over the data lines, so that its halo keeps a line that crosses
/// it from crossing it out.
fn chartScale(kind: String, largest: Int, top: Int) -> Html {
  var out = Vector.of()
  for value in chartTicks(kind, largest) {
    out.push(html"""<text x="{chartLeft() + 4}" y="{chartY(value, top) - 5}">{chartTickLabel(kind, value, largest)}</text>""")
  }
  html"{out.freeze()}"
}

/// The vertical lines and the times under them. Every other one is `odd`,
/// which a phone does not show: six times fit across a desk, three across
/// a phone. The ends are anchored inward, so the first and the last are not
/// cut by the edge.
fn chartTimes(times: Array<Int>) -> Html {
  let first = times.get(0).unwrapOr(0)
  let last = times.get(times.length() - 1).unwrapOr(0)
  let span = chartSpan(times)
  let step = timeStep(span, 6)
  var out = Vector.of()
  var n = 0
  for at in timeTicks(first, last, step) {
    let x = chartX(at, first, span)
    let anchor = if x < chartLeft() + 40 { "start" } else if x > chartRight() - 40 { "end" } else { "middle" }
    let odd = if n % 2 == 1 { " odd" } else { "" }
    out.push(html"""
      <g class="ch-t{odd}">
        <line class=ch-grid x1="{x}" y1="{chartTop()}" x2="{x}" y2="{chartBottom()}"/>
        <text x="{x}" y="{chartHeight() - 6}" text-anchor={anchor}>{timeTickLabel(at, step)}</text>
      </g>
      """)
    n = n + 1
  }
  html"{out.freeze()}"
}

/// The latest value of each line, at its end: above it, or — where the two
/// ends are too close for two labels — the lower one under its line, or,
/// at the floor where there is no room under it, the higher one a line
/// further up. `dy` is in `em`, so the room is right whatever size the
/// stylesheet gave the text. Two ends at the same place saying the same
/// thing are said once.
fn chartEnds(aY: Int, aText: String, bY: Int, bText: String) -> Html {
  let aHigher = aY <= bY
  let high = if aHigher { aY } else { bY }
  let low = if aHigher { bY } else { aY }
  let close = low - high < 32
  let lowUnder = close && low + 32 <= chartBottom()
  let highUp = close && !lowUnder
  let highDy = if highUp { "-1.5em" } else { "-0.45em" }
  let lowDy = if lowUnder { "1.15em" } else { "-0.45em" }
  let aDy = if aHigher { highDy } else { lowDy }
  let bDy = if aHigher { lowDy } else { highDy }
  let same = close && aText == bText
  let aDySaid = if same { "-0.45em" } else { aDy }
  let b = html.only(!same, html"""<text class=ch-end x="{chartRight() - 2}" y="{bY}" dy="{bDy}" text-anchor=end>{bText}</text>""")
  html"""
    <text class=ch-end x="{chartRight() - 2}" y="{aY}" dy="{aDySaid}" text-anchor=end>{aText}</text>
    {b}
    """
}

/// What a hover says of the rows from index `from` to `to` (inclusive): the
/// time and both values, or for more than one row the times and the
/// largest of each.
///
/// A chart of one line (`bName` empty) says that line's alone.
fn chartHoverTitle(kind: String, times: Array<Int>, a: Array<Int>, aName: String, b: Array<Int>, bName: String, from: Int, to: Int) -> String {
  let start = timeFull(times.get(from).unwrapOr(0))
  if from == to {
    let aSaid = "{aName} {chartValue(kind, a.get(from).unwrapOr(0))}"
    if bName == "" {
      return "{start}: {aSaid}"
    }
    return "{start}: {aSaid}, {bName} {chartValue(kind, b.get(from).unwrapOr(0))}"
  }
  let aLargest = metricsLargest(a.slice(from, to + 1), [])
  let bLargest = metricsLargest(b.slice(from, to + 1), [])
  let aUpTo = "{aName} up to {chartValue(kind, aLargest)}"
  let range = "{start} – {timeFull(times.get(to).unwrapOr(0))}"
  if bName == "" {
    return "{range}: {aUpTo}"
  }
  "{range}: {aUpTo}, {bName} up to {chartValue(kind, bLargest)}"
}

/// How many columns a chart's hovers are cut into at most: a day is 1440
/// rows, and a `<title>` each would be more page than chart.
fn chartColumns() -> Int {
  120
}

/// A column the height of the plot round each row — or, past
/// [`chartColumns`] rows, each group of rows — with a `<title>` that is
/// what a pointer over it (or a tap) shows.
fn chartHovers(kind: String, times: Array<Int>, a: Array<Int>, aName: String, b: Array<Int>, bName: String) -> Html {
  let rows = times.length()
  let columns = if rows < chartColumns() { rows } else { chartColumns() }
  let first = times.get(0).unwrapOr(0)
  let span = chartSpan(times)
  let width = (chartRight() - chartLeft()) / (columns - 1)
  var out = Vector.of()
  var from = 0
  while from < rows {
    let column = ((times.get(from).unwrapOr(first) - first) * (columns - 1) + span / 2) / span
    var to = from
    while to + 1 < rows && ((times.get(to + 1).unwrapOr(first) - first) * (columns - 1) + span / 2) / span == column {
      to = to + 1
    }
    let middle = chartLeft() + column * (chartRight() - chartLeft()) / (columns - 1)
    let x0 = if middle - width / 2 < chartLeft() { chartLeft() } else { middle - width / 2 }
    let x1 = if middle + width / 2 > chartRight() { chartRight() } else { middle + width / 2 }
    out.push(html"""<rect class=ch-hit x="{x0}" y="{chartTop()}" width="{x1 - x0}" height="{chartBottom() - chartTop()}"><title>{chartHoverTitle(kind, times, a, aName, b, bName, from, to)}</title></rect>""")
    from = to + 1
  }
  html"{out.freeze()}"
}

/// What tells a line from the other in the legend: the same stroke the
/// chart draws it with, so the dashes are what one reads the key by and not
/// the colour alone.
fn metricsKey(class: String, name: String) -> Html {
  html"""
    <span class=key>
      <svg width=32 height=8 viewBox="0 0 32 8" aria-hidden=true>
        <line class="ln {class}" x1=0 y1=4 x2=32 y2=4 />
      </svg>
      {name}
    </span>
    """
}

/// Two lines on one chart, scaled together from 0 to the larger of them:
/// the question is how the two compare, and two scales would make a p99
/// that is ten times its p50 look like it is touching it. A limit drawn
/// beside what is held to it (MemoryMax and the memory used) puts the used
/// line low on the chart; the lines of the scale and the value written at
/// the end of each line are what make it read anyway.
///
/// `kind` is what the values are — `bytes`, `ms` (microseconds), `percent`
/// or `count` — which is how the scale, the ends and the hovers write them.
/// The ends are written on the chart and not only in a `<title>`: a title
/// is a hover, which a phone does not have.
///
/// A line needs two points, and a chart of nothing but zeros is a line along
/// the floor, so each says what is true instead of drawing that.
///
/// A chart of one line is the same with `b` empty and `bName` `""`: what
/// has no second figure in its unit to compare with, as the bytes allocated
/// a minute.
fn metricsChart(
  label: String,
  kind: String,
  times: Array<Int>,
  a: Array<Int>,
  aClass: String,
  aName: String,
  b: Array<Int>,
  bClass: String,
  bName: String,
) -> Html {
  if a.length() < 2 {
    return html"<p class=muted>One row so far — a line wants two. Come back in a minute.</p>"
  }
  let largest = metricsLargest(a, b)
  if largest == 0 {
    return html"""
      <p class=muted>{label}: nothing but zero in this window, which is not worth a line along
      the bottom.</p>
      """
  }
  let ticks = chartTicks(kind, largest)
  let top = ticks.get(ticks.length() - 1).unwrapOr(largest)
  let aLast = a.get(a.length() - 1).unwrapOr(0)
  let bLast = b.get(b.length() - 1).unwrapOr(0)
  if bName == "" {
    return html"""
      <p class=legend>{metricsKey(aClass, aName)}</p>
      <svg class=chart viewBox="0 0 {chartWidth()} {chartHeight()}" role=img aria-label="{label}">
        <title>{label}: now {aName} {chartValue(kind, aLast)}</title>
        {chartTimes(times)}
        {chartGrid(kind, largest, top)}
        {chartHovers(kind, times, a, aName, b, bName)}
        <polyline class="ln {aClass}" fill=none points="{metricsPoints(times, a, top)}"/>
        {chartScale(kind, largest, top)}
        <text class=ch-end x="{chartRight() - 2}" y="{chartY(aLast, top)}" dy="-0.45em" text-anchor=end>{chartValue(kind, aLast)}</text>
      </svg>
      """
  }
  html"""
    <p class=legend>{metricsKey(aClass, aName)}{metricsKey(bClass, bName)}</p>
    <svg class=chart viewBox="0 0 {chartWidth()} {chartHeight()}" role=img aria-label="{label}">
      <title>{label}: now {aName} {chartValue(kind, aLast)}, {bName} {chartValue(kind, bLast)}</title>
      {chartTimes(times)}
      {chartGrid(kind, largest, top)}
      {chartHovers(kind, times, a, aName, b, bName)}
      <polyline class="ln {aClass}" fill=none points="{metricsPoints(times, a, top)}"/>
      <polyline class="ln {bClass}" fill=none points="{metricsPoints(times, b, top)}"/>
      {chartScale(kind, largest, top)}
      {chartEnds(chartY(aLast, top), chartValue(kind, aLast), chartY(bLast, top), chartValue(kind, bLast))}
    </svg>
    """
}

/// Words of a run's heap as bytes: a word is eight bytes.
fn wordBytes(words: Int) -> Int {
  words * 8
}

/// `part` as a whole percentage of `whole`, 0 of nothing: the share of runs
/// that collected, where a window with no runs collected in none.
fn shareOf(part: Int, whole: Int) -> Int {
  if whole <= 0 {
    return 0
  }
  part * 100 / whole
}

/// What a page says of how a heap is collected, the once: each run has a
/// heap of its own that is gone when it ends, and a collection comes only
/// when it has allocated twice what was live.
fn gcAbout() -> Html {
  html"""
    <p class=muted>Every run has a heap of its own, thrown away when it ends. The heap is
    collected when what the run allocated since the last collection reaches twice what was
    live, so a light run often never collects; a run that needs more than
    <code>max_heap_words</code> fails with a heap error. Allocated is every word handed out,
    reuse counted each time, at eight bytes a word.</p>
    """
}

/// One app's metrics: what it served and how long it took, over the window
/// asked for — the totals, then the two charts.
///
/// An empty answer is two different nothings that this page cannot tell
/// apart (a host that keeps no history, and one that has not sampled this
/// app yet), so what it says when there are no rows is true of both, and
/// there is no frame drawn round nothing.
fn metricsPage(base: String, app: host.App, request: web.Request) -> Html {
  let at = appAt(base, app)
  let over = metricsWindow(request)
  let span = metricsSpan(over)
  let points = host.series(app.name, over)
  let head = appHead(base, app, "Metrics")
  let lead = html"""
    <p class=lead>How fast <code>{app.name}</code> answers and how much of it it served. The
    host takes a sample of every app's counters once a minute and keeps the minutes for about
    two days and the hours for about three months, so these are what the app did in each
    minute — or, for the last 30 days, each hour — and not a running total. The <b>p50</b> and
    <b>p99</b> are <b>estimates</b>: the host does not keep the time of every request, it
    counts them into a histogram of time ranges and reads the quantile off that, so a figure
    here is the right range and not an exact time.</p>
    """
  let steps = metricsSteps(at, over)
  let reload = reloading("{at}/metrics?over={over}", 5, paused(request))
  let title = "{app.name} metrics"
  if points.length() == 0 {
    return layout(
      base,
      "apps",
      title,
      html"""
        {head}{lead}{reload.control}{steps}
        <p class=muted>Nothing to show for {span}: either the host has not sampled
        <code>{app.name}</code> yet — it takes a sample a minute, so a minute after it has
        served something — or it keeps no history at all, which it does not when it is started
        without a data directory. This page cannot tell which, and a chart of nothing would say
        neither.</p>
        """,
      reload.seconds,
      reload.link,
    )
  }
  var times = Vector.of()
  var served = Vector.of()
  var errors = Vector.of()
  var p50 = Vector.of()
  var p99 = Vector.of()
  var collections = Vector.of()
  var collected = Vector.of()
  var allocated = Vector.of()
  var requests = 0
  var failed = 0
  var worst = 0
  var runsCollected = 0
  for point in points {
    times.push(point.atUnix)
    served.push(point.served)
    errors.push(point.errors)
    p50.push(point.p50Us)
    p99.push(point.p99Us)
    collections.push(point.gcCollections)
    collected.push(point.gcRuns)
    allocated.push(wordBytes(point.allocatedWords))
    requests = requests + point.served
    failed = failed + point.errors
    runsCollected = runsCollected + point.gcRuns
    if point.p99Us > worst {
      worst = point.p99Us
    }
  }
  let timeRows = times.freeze()
  let servedRows = served.freeze()
  let errorRows = errors.freeze()
  let p50Rows = p50.freeze()
  let p99Rows = p99.freeze()
  let level = if failed == 0 { " is-ok" } else { " is-bad" }
  let said = if failed == 0 { "none in {span}" } else { "of {requests} in {span}" }
  let heapLevel = if app.heapFailures == 0 { "" } else { " is-bad" }
  let figures = html"""
    <div class=strip>
      <div class=fig>
        <span class=lbl>requests</span>
        <span class=big>{requests}</span>
        <span class=note>in {span}</span>
      </div>
      <div class="fig{level}">
        <span class=lbl>errors</span>
        <span class=big>{failed}</span>
        <span class=note>{said}</span>
      </div>
      <div class=fig>
        <span class=lbl>worst p99</span>
        <span class=big>{millis(worst)} ms</span>
        <span class=note>the slowest minute's estimate</span>
      </div>
      <div class=fig>
        <span class=lbl>runs that collected</span>
        <span class=big>{shareOf(runsCollected, requests)}%</span>
        <span class=note>{runsCollected} of {requests} in {span}</span>
      </div>
      <div class="fig{heapLevel}">
        <span class=lbl>heap-limit failures</span>
        <span class=big>{app.heapFailures}</span>
        <span class=note>since the host started</span>
      </div>
    </div>
    """
  let first = match points.get(0) {
    Some(point) => point.atUnix
    None => 0
  }
  let last = match points.get(points.length() - 1) {
    Some(point) => point.atUnix
    None => 0
  }
  let each = if over == "month" { "hour" } else { "minute" }
  let rows = if points.length() == 1 { "1 row" } else { "{points.length()} rows" }
  let covers = html"""
    <p class=muted>{rows}, one for each {each} the host sampled, from
    {jst(first * 1000)} to {jst(last * 1000)}. Each chart is scaled from zero
    to a round number past its own largest value, the latest value of each line is written at
    its end, and the times are JST. Hover a point, or tap it, for its {each}.</p>
    """
  let traffic = metricsChart(
    "requests served and errors a {each}, {span}",
    "count",
    timeRows,
    servedRows,
    "ln-served",
    "served",
    errorRows,
    "ln-errors",
    "errors",
  )
  let speed = metricsChart(
    "request time, p50 and p99 in milliseconds, {span}",
    "ms",
    timeRows,
    p50Rows,
    "ln-p50",
    "p50, the middle request",
    p99Rows,
    "ln-p99",
    "p99, the slow one in a hundred",
  )
  let gc = metricsChart(
    "garbage collections and runs that collected a {each}, {span}",
    "count",
    timeRows,
    collections.freeze(),
    "ln-used",
    "collections",
    collected.freeze(),
    "ln-held",
    "runs that collected",
  )
  let allocation = metricsChart(
    "memory allocated a {each}, {span}",
    "bytes",
    timeRows,
    allocated.freeze(),
    "ln-used",
    "allocated",
    [],
    "",
    "",
  )
  layout(
    base,
    "apps",
    title,
    html"""
      {head}{lead}{reload.control}{steps}{figures}{covers}
      <h2>Traffic</h2>{traffic}
      <h2>Speed, in milliseconds</h2>{speed}
      <h2>Garbage collection</h2>{gcAbout()}{gc}
      <h2>Allocation</h2>{allocation}
      """,
    reload.seconds,
    reload.link,
  )
}

// ---------------------------------------------------------- platform
//
// The host itself: every app runs in one process on one pool of workers, so
// the limits that bind them all are the process's — the systemd unit's
// `MemoryMax=` and `CPUQuota=`, the disk the data directory is on, and the
// workers. The figures are the host's (`host.platformNow`, and the minutes
// it keeps beside the apps' with `host.platform`); a figure it cannot read —
// no cgroup, not Linux — is a dash and not a zero.

/// A size as people read one, in GiB past one: a memory limit or a disk is
/// gigabytes, and `2048.0 MiB` is a number to divide in one's head.
fn platformBytes(count: Int) -> String {
  if count < 1073741824 {
    return text.bytes(count)
  }
  "{count / 1073741824}.{count % 1073741824 * 10 / 1073741824} GiB"
}

/// A size the host may not know: the size, or a dash.
fn knownBytes(count: Option<Int>) -> String {
  match count {
    Some(bytes) => platformBytes(bytes)
    None => "—"
  }
}

/// `part` as a whole percentage of `whole`, or a dash for a whole of
/// nothing.
fn percentOf(part: Int, whole: Int) -> String {
  if whole <= 0 {
    return "—"
  }
  "{part * 100 / whole}%"
}

/// How the share of a limit is coloured: past 80% is worth a look, past 95%
/// is trouble.
fn pressure(percent: Int) -> String {
  if percent >= 95 {
    " is-bad"
  } else if percent >= 80 {
    " is-warn"
  } else {
    ""
  }
}

/// The CPU used over `spanSecs`, as a whole percentage of `millicores`
/// (thousandths of a CPU; the quota, or 1000 — one CPU — where there is
/// none): 30 s over a minute of a 2-CPU quota is 25%.
fn cpuPercent(usec: Int, spanSecs: Int, millicores: Int) -> Int {
  let whole = spanSecs * 10 * millicores
  if whole <= 0 {
    return 0
  }
  usec / whole
}

/// Thousandths as a number with two decimals: a load average, a count of
/// CPUs.
fn thousandths(milli: Int) -> String {
  let hundredths = (milli + 5) / 10
  "{hundredths / 100}.{text.padded(hundredths % 100, 2)}"
}

/// One figure of the band.
fn platformFig(label: String, big: String, note: String, level: String) -> Html {
  html"""
    <div class="fig{level}">
      <span class=lbl>{label}</span>
      <span class=big>{big}</span>
      <span class=note>{note}</span>
    </div>
    """
}

/// The memory figure: what the cgroup is charged for, of `MemoryMax=`.
fn memoryFig(now: host.PlatformNow) -> Html {
  let used = now.memoryBytes.unwrapOr(-1)
  let max = now.memoryMaxBytes.unwrapOr(0)
  let note = if used < 0 {
    "the host cannot read its cgroup"
  } else if max <= 0 {
    "no MemoryMax"
  } else {
    "of {platformBytes(max)}, {percentOf(used, max)}"
  }
  let level = if used >= 0 && max > 0 { pressure(used * 100 / max) } else { "" }
  platformFig("memory", knownBytes(now.memoryBytes), note, level)
}

/// The CPU figure: what the cgroup used over the last minute the host
/// sampled, of its quota.
fn cpuFig(last: Option<host.PlatformPoint>) -> Html {
  let point = match last {
    Some(point) => point
    None => return platformFig("cpu", "—", "no minute sampled yet", "")
  }
  let quota = point.cpuQuotaMillicores.unwrapOr(0)
  let of = if quota > 0 { quota } else { 1000 }
  let what = if quota > 0 { "of {thousandths(quota)} CPUs (CPUQuota)" } else { "of one CPU; no CPUQuota" }
  match point.cpuUsec {
    Some(usec) => {
      let percent = cpuPercent(usec, 60, of)
      let throttled = point.cpuThrottledUsec.unwrapOr(0)
      let held = if throttled > 0 { ", throttled {throttled / 1000} ms" } else { "" }
      platformFig("cpu", "{percent}%", "{what}, last minute{held}", pressure(percent))
    }
    None => platformFig("cpu", "—", "the host cannot read its cgroup", "")
  }
}

/// The disk figure: what is free on the data directory's disk.
fn diskFig(now: host.PlatformNow) -> Html {
  let total = now.diskTotalBytes.unwrapOr(0)
  let free = now.diskAvailableBytes.unwrapOr(0)
  let history = knownBytes(now.storeBytes)
  let note = if total > 0 {
    "free of {platformBytes(total)}; history {history}"
  } else {
    "no data directory, or not read"
  }
  let level = if total > 0 { pressure((total - free) * 100 / total) } else { "" }
  platformFig("disk free", knownBytes(now.diskAvailableBytes), note, level)
}

/// The workers figure: busy of all, with what is waiting.
fn workersFig(now: host.PlatformNow) -> Html {
  let level = if now.queued > 0 { " is-warn" } else { "" }
  platformFig(
    "workers busy",
    "{now.busy} / {now.workers}",
    "{now.inFlight} in flight, {now.queued} queued",
    level,
  )
}

/// The machine's figure: the load average, and what memory it has left.
fn machineFig(now: host.PlatformNow) -> Html {
  let load = match now.load1Milli {
    Some(milli) => thousandths(milli)
    None => "—"
  }
  let memory = match now.hostMemoryAvailableBytes {
    Some(free) => "{platformBytes(free)} of {knownBytes(now.hostMemoryTotalBytes)} memory free"
    None => "machine memory unknown"
  }
  platformFig("load", load, memory, "")
}

/// The Platform page: the figures now, then the minutes (or hours) the
/// host kept of them over the window asked for.
fn platformPage(base: String, request: web.Request) -> Html {
  let over = metricsWindow(request)
  let span = metricsSpan(over)
  let now = host.platformNow()
  let recent = host.platform("hour")
  let last = recent.get(recent.length() - 1)
  let lead = html"""
    <p class=lead>The host itself. Every app runs in one process on one pool of workers, so
    the limits that bind them all are the process's: the service's <code>MemoryMax</code> and
    <code>CPUQuota</code>, the disk its data directory is on, and its workers. The figures
    below are now; the charts are what the host sampled once a minute, kept as the apps'
    are. A dash is a figure the host cannot read here — it reads its cgroup and
    <code>/proc</code>, which only Linux has.</p>
    """
  let figures = html"""
    <div class=strip>
      {memoryFig(now)}{cpuFig(last)}{diskFig(now)}{workersFig(now)}{machineFig(now)}
    </div>
    """
  let steps = windowSteps("{base}/platform", over)
  let reload = reloading("{base}/platform?over={over}", 5, paused(request))
  let points = host.platform(over)
  if points.length() == 0 {
    return layout(
      base,
      "platform",
      "platform",
      html"""
        <h1>Platform</h1>{lead}{reload.control}{figures}{steps}
        <p class=muted>Nothing to chart for {span}: either the host has not sampled itself
        yet — the first minute after a start keeps nothing, as there is nothing yet to take
        the CPU's difference from — or it keeps no history, which it does not without a data
        directory.</p>
        """,
      reload.seconds,
      reload.link,
    )
  }
  let seconds = if over == "month" { 3600 } else { 60 }
  var times = Vector.of()
  var memory = Vector.of()
  var limit = Vector.of()
  var cpu = Vector.of()
  var throttled = Vector.of()
  var free = Vector.of()
  var total = Vector.of()
  var inFlight = Vector.of()
  var queued = Vector.of()
  var collections = Vector.of()
  var collected = Vector.of()
  var allocated = Vector.of()
  for point in points {
    let of = point.cpuQuotaMillicores.unwrapOr(1000)
    times.push(point.atUnix)
    memory.push(point.memoryBytes.unwrapOr(0))
    limit.push(point.memoryMaxBytes.unwrapOr(0))
    cpu.push(cpuPercent(point.cpuUsec.unwrapOr(0), seconds, of))
    throttled.push(point.cpuThrottledUsec.unwrapOr(0) / (seconds * 10000))
    free.push(point.diskAvailableBytes.unwrapOr(0))
    total.push(point.diskTotalBytes.unwrapOr(0))
    inFlight.push(point.inFlight)
    queued.push(point.queued)
    collections.push(point.gcCollections.unwrapOr(0))
    collected.push(point.gcRuns.unwrapOr(0))
    allocated.push(wordBytes(point.allocatedWords.unwrapOr(0)))
  }
  let timeRows = times.freeze()
  let memoryRows = memory.freeze()
  let limitRows = limit.freeze()
  let cpuRows = cpu.freeze()
  let throttledRows = throttled.freeze()
  let freeRows = free.freeze()
  let totalRows = total.freeze()
  let flightRows = inFlight.freeze()
  let queuedRows = queued.freeze()
  let each = if over == "month" { "hour" } else { "minute" }
  let first = timeRows.get(0).unwrapOr(0)
  let final = timeRows.get(timeRows.length() - 1).unwrapOr(0)
  let rows = if points.length() == 1 { "1 row" } else { "{points.length()} rows" }
  let covers = html"""
    <p class=muted>{rows}, one for each {each} the host sampled, from
    {jst(first * 1000)} to {jst(final * 1000)}. The CPU is what the
    {each} used of the quota (of one CPU without one); memory, disk and workers are as they
    were at its end, and an hour is its worst minute. The times are JST.</p>
    """
  let memoryChart = metricsChart(
    "memory used and MemoryMax, {span}",
    "bytes",
    timeRows,
    memoryRows,
    "ln-used",
    "used",
    limitRows,
    "ln-limit",
    "MemoryMax",
  )
  let cpuChart = metricsChart(
    "CPU used and throttled, percent, {span}",
    "percent",
    timeRows,
    cpuRows,
    "ln-used",
    "used, % of the quota",
    throttledRows,
    "ln-held",
    "throttled, % of the {each}",
  )
  let diskChart = metricsChart(
    "disk free and disk size, {span}",
    "bytes",
    timeRows,
    freeRows,
    "ln-used",
    "free",
    totalRows,
    "ln-limit",
    "size",
  )
  let workChart = metricsChart(
    "requests in flight and queued, {span}",
    "count",
    timeRows,
    flightRows,
    "ln-used",
    "in flight",
    queuedRows,
    "ln-held",
    "queued",
  )
  let gcChart = metricsChart(
    "garbage collections and runs that collected a {each}, all apps, {span}",
    "count",
    timeRows,
    collections.freeze(),
    "ln-used",
    "collections",
    collected.freeze(),
    "ln-held",
    "runs that collected",
  )
  let allocationChart = metricsChart(
    "memory allocated a {each}, all apps, {span}",
    "bytes",
    timeRows,
    allocated.freeze(),
    "ln-used",
    "allocated",
    [],
    "",
    "",
  )
  layout(
    base,
    "platform",
    "platform",
    html"""
      <h1>Platform</h1>{lead}{reload.control}{figures}{steps}{covers}
      <h2>Memory</h2>{memoryChart}
      <h2>CPU</h2>{cpuChart}
      <h2>Disk</h2>{diskChart}
      <h2>Requests</h2>{workChart}
      <h2>Garbage collection</h2>
      <p class=muted>Read the allocation beside the Memory chart: allocation churning while
      memory stays flat means what the runs allocate is being reclaimed; memory climbing with
      it would mean something is held.</p>
      {gcAbout()}{gcChart}{allocationChart}
      """,
    reload.seconds,
    reload.link,
  )
}

/// Which app's log is being read: `all apps`, then every app the host has a
/// line of.
///
/// **An app's chip goes to that app's own Logs**, which is a page that
/// already exists: there is one log window, and this is the way to it. So
/// the row is not a filter that this page applies — the only thing it
/// chooses here is `all apps`, which is where it is.
///
/// There is no dot of health on a chip as the list of apps has: health is
/// what `worthALook` works out, from an app's counters and a read of its
/// queues, and a second rule for the same word — on a page about logs — is
/// two answers to one question.
fn logChips(base: String, apps: Array<String>) -> Html {
  var out = Vector.of()
  out.push(html"""<a href="{base}/logs" aria-current=page>all apps</a>""")
  if apps.length() > 0 {
    out.push(html"<span class=sep></span>")
  }
  for app in apps {
    out.push(html"""<a href="{base}/apps/{app}/logs">{app}</a>""")
  }
  html"<nav class=pick><span class=lbl>app</span>{out.freeze()}</nav>"
}

/// Every app's log, in one order (issue #108): a queue delivery that failed
/// in one app and the request that caused it in another are one sequence,
/// and on two pages they are two pages and a clock.
///
/// The host does the mixing (`host.allLogs`): it holds every app's ring, and
/// the last `n` lines of the host's whole log are the last `n` of the merge.
/// Which means an app that is talking fills the page and the quiet ones fall
/// off the end — that is what "the last `n` lines" is — so the lines to show
/// is the choice this page offers twice, and an app's own log is one chip
/// away.
fn allLogsPage(base: String, request: web.Request) -> Html {
  let n = logLines(request)
  let all = host.allLogs(n)
  let how = logSteps("{base}/logs", n)
  let summary = html"Every app that logs, in one order, oldest first."
  let said = html"""
    {all.lines.length()} lines: the newest the host has, of the last {logKept()} it keeps in
    memory for each app, which a restart empties. One app with a lot to say fills the page —
    ask for more lines, or read an app alone from its chip above. Every line is also appended
    to <code>&lt;data&gt;/&lt;app&gt;/log.txt</code>, which this page does not read.
    """
  layout(
    base,
    "logs",
    "logs",
    html"""
      <h1>Logs</h1>
      {logChips(base, all.apps)}
      {about(summary, said)}
      {how}{logTable(all.lines, true)}{how}
      """,
  )
}

/// How many lines the host's ring keeps (`crate::logs::LOG_LINES`).
fn logKept() -> Int {
  1000
}

/// What a `?done=` says after a change went through.
fn notice(request: web.Request) -> Html {
  let done = request.query.get("done").unwrapOr("")
  let said = if done == "enable" {
    "Enabled: requests are routed to it again."
  } else if done == "disable" {
    "Disabled: new requests are answered 503; its data is kept."
  } else if done == "configure" {
    "Applied. The host reloaded the app with the new configuration; its state is below."
  } else if done == "reset" {
    "Reset: the app is loaded from its app.toml again."
  } else {
    ""
  }
  if said == "" {
    return html""
  }
  html"""<div class=notice>{said} <a href="{base(request)}/history">history</a></div>"""
}

fn problemsNotice(problems: Array<String>) -> Html {
  var items = Vector.of()
  for problem in problems {
    items.push(html"<li>{problem}</li>")
  }
  html"""
    <div class=problem>
      <b>Nothing was changed.</b> The form has problems:<ul>{items.freeze()}</ul>
    </div>
    """
}

fn refusedNotice(action: String, message: String) -> Html {
  html"""
    <div class=problem>
      <b>Refused: nothing was changed.</b> The host said, of <code>{action}</code>:
      <pre>{message}</pre>
    </div>
    """
}

/// The app a change was about: a link, or a dash for a change to the host
/// itself (a secret).
fn historyApp(base: String, app: String) -> Html {
  if app == "" {
    return html"<span class=muted>–</span>"
  }
  html"""<a href="{base}/apps/{app}">{app}</a>"""
}

fn doneNotice(message: String) -> Html {
  html"<div class=notice>{message}</div>"
}

/// The secret store: every secret stored or used, and the forms that set,
/// replace and delete them. A value is never part of the page: the store
/// gives none, and the inputs are password fields that start empty.
/// `notice` is said above everything; `name` fills the set form's name.
fn secretsPage(base: String, secrets: Array<host.Secret>, notice: Html, name: String) -> Html {
  var rows = Vector.of()
  for secret in secrets {
    let state = if secret.set {
      html"""<span class="state serving">set</span>"""
    } else {
      html"""<span class="state refused">unset</span>"""
    }
    let updated = if secret.set {
      html"{jst(secret.updatedMs)}"
    } else {
      html"<span class=muted>–</span>"
    }
    var users = Vector.of()
    for app in secret.apps {
      users.push(html"""<a href="{base}/apps/{app}"><code>{app}</code></a>""")
    }
    let used = if users.length() == 0 {
      html"<span class=muted>none</span>"
    } else {
      html.join(users.freeze(), html" ")
    }
    let replace = html"""
      <form class=inline method=post action="{base}/secrets/set">
        <input type=hidden name=name value="{secret.name}">
        <input type=password name=value autocomplete=new-password required placeholder="new value">
        <button class=primary>{if secret.set { "Replace" } else { "Set" }}</button>
      </form>
      """
    let force = html.only(
      secret.apps.length() > 0,
      html"<label><input type=checkbox name=force> even though apps use it (they are refused)</label>",
    )
    let delete = if secret.set {
      html"""
        <form class=inline method=post action="{base}/secrets/delete">
          <input type=hidden name=name value="{secret.name}">
          <label><input type=checkbox name=confirm required> confirm</label>
          {force}
          <button class=danger>Delete</button>
        </form>
        """
    } else {
      html"<span class=muted>–</span>"
    }
    rows.push(html"""
      <tr>
        <td class=title data-label=name><code>{secret.name}</code></td>
        <td data-label=state>{state}</td>
        <td class=when data-label="set at (JST)">{updated}</td>
        <td data-label="used by">{used}</td>
        <td class=block data-label="set or replace">{replace}</td>
        <td class=block data-label=delete>{delete}</td>
      </tr>
      """)
  }
  let table = if rows.length() == 0 {
    html"<p class=muted>No secret is stored or used.</p>"
  } else {
    html"""
      <div class="scroll cardwrap">
        <table class=cards>
          <tr class=head>
            <th>name</th><th>state</th><th>set at (JST)</th><th>used by</th>
            <th>set or replace</th><th>delete</th>
          </tr>
          {rows.freeze()}
        </table>
      </div>
      """
  }
  let add = html"""
    <h2>Set a secret</h2>
    <div class=panel>
      <form method=post action="{base}/secrets/set">
        <div class=fields>
          <div class=field>
            <label for=secret-name>name</label>
            <input id=secret-name name=name value="{name}" required
            pattern="[A-Za-z0-9][A-Za-z0-9_.\\-]*" maxlength=64>
          </div>
          <div class=field>
            <label for=secret-value>value</label>
            <input id=secret-value type=password name=value autocomplete=new-password required>
          </div>
        </div>
        <div class=actions>
          <button class=primary>Set</button>
          <span class=muted>Stored by the host (<code>&lt;data&gt;/_host/secrets</code>, mode
          0600); the apps that use it are reloaded with it.</span>
        </div>
      </form>
    </div>
    """
  let how = about(
    html"A value is write-only: no page, log or history shows it.",
    html"""
      An app takes a stored secret with
      <code>[secrets] key = \{ store = "name" \}</code> in its app.toml, for
      <code>auth.check</code> or a <code>[fetch.headers]</code> header. A value is write-only:
      no page, log or history shows it.
      """,
  )
  layout(base, "secrets", "secrets", html"<h1>Secrets</h1>{how}{notice}{table}{add}")
}

/// The change history.
fn historyPage(base: String, changes: Array<host.Change>) -> Html {
  var rows = Vector.of()
  for change in changes {
    rows.push(html"""
      <tr>
        <td class="title when" data-label="at (JST)">{jst(change.atMs)}</td>
        <td class=nowrap data-label=who>{change.who}</td>
        <td data-label=app>{historyApp(base, change.app)}</td>
        <td class=nowrap data-label=action><code>{change.action}</code></td>
        <td class=block data-label="asked for">{change.detail}</td>
        <td class=block data-label=outcome>{change.outcome}</td>
      </tr>
      """)
  }
  let table = if rows.length() == 0 {
    html"<p class=muted>No changes yet.</p>"
  } else {
    html"""
      <div class="scroll cardwrap">
        <table class=cards>
          <tr class=head>
            <th>at (JST)</th><th>who</th><th>app</th><th>action</th><th>asked for</th>
            <th>outcome</th>
          </tr>
          {rows.freeze()}
        </table>
      </div>
      """
  }
  let summary = html"Every change to an app, made here or on the machine, refused ones included."
  let told = html"""
    Every change, made here or with <code>minicloud update|remove|enable|disable|reset</code> on
    the machine, refused ones included; newest first.
    """
  layout(base, "history", "history", html"<h1>History</h1>{about(summary, told)}{table}")
}
