use host
use text
use web
use std.html

fn capabilities() -> Array<String> {
  Vector.of("admin", "auth", "kv", "log").freeze()
}

fn limitsForm() -> String {
  "maxHostCalls=0&deadlineMs=500&maxHeapWords=0&maxInFlight=4&maxQueued=0&maxRequestBytes=10&maxResponseBytes=20"
}

test fn readsAConfigureForm() -> Result<Unit, Error> {
  let read = settingsFrom(
    text.parseForm("cap.kv=on&cap.log=on&allow=https%3A%2F%2Fa.example%0D%0A%0D%0A++http%3A%2F%2Fb.example%3A8080+&{limitsForm()}"),
    capabilities(),
  )
  assertEqual(read.problems.length(), 0)?
  assertEqual(",".join(read.settings.grant), "kv,log")?
  assertEqual(",".join(read.settings.fetchAllow), "https://a.example,http://b.example:8080")?
  assertEqual(read.settings.limits.deadlineMs, 500)?
  assertEqual(read.settings.limits.maxInFlight, 4)?
  assertEqual(read.settings.limits.maxResponseBytes, 20)?
  Ok(())
}

test fn namesEveryProblemOfAForm() -> Result<Unit, Error> {
  let read = settingsFrom(
    text.parseForm("cap.teleport=on&allow=ftp%3A%2F%2Fx&maxHostCalls=-1&deadlineMs=soon&maxHeapWords=0&maxInFlight=0&maxQueued=0&maxRequestBytes=1&maxResponseBytes=1"),
    capabilities(),
  )
  let said = "\n".join(read.problems)
  assert(said.contains("`teleport` is not a capability"))?
  assert(said.contains("allowlist: `ftp://x`"))?
  assert(said.contains("host calls per request: -1 is less than 0"))?
  assert(said.contains("deadline per request (ms): `soon` is not a whole number"))?
  assert(said.contains("runs in flight: 0 is less than 1"))?
  assertEqual(read.problems.length(), 5)?
  Ok(())
}

test fn refusesTheRemovedFuelLimitByName() -> Result<Unit, Error> {
  let read = settingsFrom(text.parseForm("fuel=1000&{limitsForm()}"), capabilities())
  assertEqual(read.problems.length(), 1)?
  assert(read.problems.get(0).unwrapOr("").contains("removed (Cove ADR 0091)"))?
  Ok(())
}

test fn escapesWhatItShows() -> Result<Unit, Error> {
  // What a hole does with a `String`, which is what every value of the
  // host's is when it reaches a page.
  let said = "<script>alert('x')</script>"
  assertEqual(html"{said}".render(), "&lt;script&gt;alert(&#39;x&#39;)&lt;/script&gt;")?
  assert(badge("<b>").render().contains("&lt;b&gt;"))?
  assert(!problemsNotice(Vector.of("<img src=x>").freeze()).render().contains("<img"))?
  Ok(())
}

test fn stampsAnAssetUrlWithTheVersionItWasBuiltFrom() -> Result<Unit, Error> {
  assertEqual(assetQuery("v1-3def5fe8"), "?v=v1-3def5fe8")?
  // Another deploy, another URL: that is the whole of it. A browser or a
  // cache holding the old `style.css` has nothing the new pages ask for.
  assert(assetQuery("v1-3def5fe8") != assetQuery("v2-9ab0c1d2"))?
  // The version is the host's word and goes through the same two escapes as
  // every other: once for the query, here, and once for the attribute, by
  // the hole in `layout` it goes in.
  assertEqual(assetQuery("a b&\"x\""), "?v=a%20b%26%22x%22")?
  Ok(())
}

test fn leavesTheAssetUrlsAloneWhenTheVersionIsNotKnown() -> Result<Unit, Error> {
  assertEqual(assetQuery(""), "")?
  // `minicloud test` runs the app with no host behind it, so
  // `host.selfVersion` says "" here: the page is the page it always was.
  let page = layout("", "apps", "apps", html"<h1>Apps</h1>").render()
  assert(page.contains("<link rel=stylesheet href=\"/style.css\">"))?
  assert(page.contains("href=\"/favicon.svg\""))?
  assert(page.contains("href=\"/favicon.ico\""))?
  assert(!page.contains("?v="))?
  Ok(())
}

/// A line of a log, as the host gives one.
fn aLine(app: String, atMs: Int, level: String, text: String) -> host.LogLine {
  host.LogLine(app: app, atMs: atMs, level: level, text: text)
}

test fn showsALogLineAsItCame() -> Result<Unit, Error> {
  let said = logTable(Vector.of(aLine("notes", 1791170989566, "warn", "<img src=x> & on")).freeze()).render()
  assert(said.contains("lvl-warn"))?
  assert(said.contains("&lt;img src=x&gt; &amp; on"))?
  assert(!said.contains("<img"))?
  // 2026-10-05T03:29:49.566Z is 12:29:49.566 JST, as the clock of the day.
  assert(said.contains("12:29:49.566"))?
  assert(said.contains("title=\"2026-10-05 12:29:49 JST\""))?
  // The level is a cell of its own and the text is the whole of the cell
  // beside it: a narrow screen puts the level with the time and the text
  // on a line under them, which it cannot do with the badge inside the
  // text.
  assert(said.contains("<td class=lv><span class=\"lvl lvl-warn\">warn</span></td>"))?
  assert(said.contains("<td class=said>&lt;img src=x&gt; &amp; on</td>"))?
  // One app's page knows the app: no column saying the same word on every
  // row.
  assert(!said.contains("td class=app"))?
  // A level the host grows later still reads, without a colour of its own.
  assertEqual(levelClass("fatal"), "lvl-info")?
  assertEqual(levelClass("error"), "lvl-error")?
  Ok(())
}

test fn saysWhichAppEveryLineCameFrom() -> Result<Unit, Error> {
  let said = logTable(
    Vector.of(
      aLine("jobs", 1791170989000, "host", "work: delivering 1 to /do"),
      aLine("<img src=y>&\"'", 1791170989566, "info", "GET /ledger/ 200"),
    )
      .freeze(),
    true,
  ).render()
  assert(said.contains("<td class=app><code>jobs</code></td>"))?
  // The name is the host's and is escaped like anything else: an app
  // cannot be named this, and the page does not rely on that.
  assert(said.contains("&lt;img src=y&gt;&amp;&quot;&#39;"))?
  assert(!said.contains("<img"))?
  // Oldest first, as the host gave them.
  assert(said.indexOf("delivering 1").unwrapOr(0) < said.indexOf("GET /ledger/").unwrapOr(0))?
  Ok(())
}

test fn offersEveryAppThatHasALog() -> Result<Unit, Error> {
  let said = logChips("/admin", Vector.of("jobs", "ledger").freeze()).render()
  // Where the page is, said so.
  assert(said.contains("<a href=\"/admin/logs\" aria-current=page>all apps</a>"))?
  // An app's chip is the way to that app's own window, not a filter here.
  assert(said.contains("<a href=\"/admin/apps/jobs/logs\">jobs</a>"))?
  assert(said.contains("<a href=\"/admin/apps/ledger/logs\">ledger</a>"))?
  // An app the host has no line of is not offered: the chip would lead to
  // an empty page.
  assert(!said.contains("watch"))?
  // Nothing logged at all is `all apps` alone, with no rule beside it.
  let alone = logChips("", Vector.of().freeze()).render()
  assert(alone.contains("aria-current=page>all apps</a>"))?
  assert(!alone.contains("class=sep"))?
  Ok(())
}

test fn asksForTheSameLinesOnEveryLogPage() -> Result<Unit, Error> {
  // The choice is the one thing the link changes, so the path it is on is
  // the page's own: an app's, or every app's.
  let one = logSteps("/apps/jobs/logs", 200).render()
  assert(one.contains("<a href=\"/apps/jobs/logs?n=50\">50</a>"))?
  assert(one.contains("<b>200</b>"))?
  assert(!one.contains("?n=200"))?
  assert(logSteps("/logs", 50).render().contains("<a href=\"/logs?n=1000\">1000</a>"))?
  Ok(())
}

test fn asksForTheLinesItIsAskedFor() -> Result<Unit, Error> {
  assertEqual(logLines(asking(Map.of())), 200)?
  assertEqual(logLines(asking(Map.of(MapEntry(key: "n", value: " 40 ")))), 40)?
  assertEqual(logLines(asking(Map.of(MapEntry(key: "n", value: "0")))), 1)?
  assertEqual(logLines(asking(Map.of(MapEntry(key: "n", value: "9999")))), 1000)?
  assertEqual(logLines(asking(Map.of(MapEntry(key: "n", value: "lots")))), 200)?
  Ok(())
}

/// One file of a deploy, as `host.code` gives one.
fn aFile(name: String, kind: String, isText: Bool, onDisk: String) -> host.CodeFile {
  host.CodeFile(
    name: name,
    label: name,
    depth: 0,
    kind: kind,
    bytes: 0,
    text: "",
    pieces: Vector.of().freeze(),
    plain: "",
    isText: isText,
    cut: false,
    onDisk: onDisk,
  )
}

/// One file of a deploy with its text and the pieces it is coloured by.
fn aColouredFile(name: String, text: String, pieces: Array<host.CodePiece>, plain: String) -> host.CodeFile {
  host.CodeFile(
    name: name,
    label: name,
    depth: 0,
    kind: "cove",
    bytes: text.byteLength(),
    text: text,
    pieces: pieces,
    plain: plain,
    isText: true,
    cut: plain == "cut",
    onDisk: "same",
  )
}

/// One row of the tree, as `host.code` gives a directory or a file at a
/// depth.
fn aRow(name: String, label: String, depth: Int, kind: String) -> host.CodeFile {
  host.CodeFile(
    name: name,
    label: label,
    depth: depth,
    kind: kind,
    bytes: 1024,
    text: "",
    pieces: Vector.of().freeze(),
    plain: "",
    isText: kind != "dir",
    cut: false,
    onDisk: if kind == "dir" { "" } else { "same" },
  )
}

/// An app as the host lists one: enough of it for the pages that only ask
/// its name and how it is reached.
/// An app as the pages see one. Everything but the name has a default, so a
/// test names the one or two things it is about and nothing else.
fn anApp(
  name: String,
  hosts: Array<String> = Vector.of().freeze(),
  granted: Array<String> = Vector.of().freeze(),
  required: Array<String> = Vector.of().freeze(),
  state: String = "serving",
  reason: String = "",
  served: Int = 0,
  errors: Int = 0,
  rejected: Int = 0,
  recentErrors: Array<host.Failure> = Vector.of().freeze(),
  kvKeys: Int = -1,
  kvBytes: Int = -1,
  kvMaxKeys: Int = 0,
  kvMaxBytes: Int = 0,
  sqlBytes: Int = -1,
  sqlMaxBytes: Int = 0,
  accessOff: String = "",
  isAdmin: Bool = false,
  heapFailures: Int = 0,
) -> host.App {
  host.App(
    name: name,
    state: state,
    reason: reason,
    version: "v1-abcdef01",
    tier: "vm",
    entry: "{name}.handle",
    hosts: hosts,
    required: required,
    requiredOpen: false,
    granted: granted,
    grantAdded: Vector.of().freeze(),
    grantRemoved: Vector.of().freeze(),
    fetchAllow: Vector.of().freeze(),
    limits: host.Limits(
      maxHostCalls: 0,
      deadlineMs: 2000,
      maxHeapWords: 0,
      maxInFlight: 1,
      maxQueued: 0,
      maxRequestBytes: 0,
      maxResponseBytes: 0,
    ),
    limitsChanged: Vector.of().freeze(),
    isAdmin: isAdmin,
    served: served,
    ok: served - errors,
    errors: errors,
    rejected: rejected,
    inFlight: 0,
    queued: 0,
    gcCollections: 0,
    gcRuns: 0,
    allocatedWords: 0,
    heapFailures: heapFailures,
    kvKeys: kvKeys,
    kvBytes: kvBytes,
    kvMaxKeys: kvMaxKeys,
    kvMaxBytes: kvMaxBytes,
    sqlBytes: sqlBytes,
    sqlMaxBytes: sqlMaxBytes,
    accessOff: accessOff,
    recentErrors: recentErrors,
  )
}

/// A queue for the tests: declared, with what it holds.
fn aQueue(name: String, due: Int = 0, held: Int = 0, dead: Int = 0, declared: Bool = true) -> host.Queue {
  host.Queue(
    name: name,
    path: "/queue/{name}",
    due: due,
    held: held,
    dead: dead,
    declared: declared,
    maxDepth: 1000,
    maxAttempts: 5,
    retryMs: 30000,
    leaseMs: 30000,
    batch: 1,
    maxBodyBytes: 65536,
  )
}

/// A deploy the host compared, or did not.
fn aDisk(looked: Bool = true, differing: Int = 0) -> host.CodeDisk {
  host.CodeDisk(looked: looked, differing: differing, bytes: 4096, budget: 1048576)
}

fn aFailure(kind: String, status: Int, message: String) -> host.Failure {
  host.Failure(atMs: 1760351890157, kind: kind, status: status, version: "v1-abcdef01", message: message)
}

fn noQueues() -> Array<host.Queue> {
  Vector.of().freeze()
}

/// A tab is there when the app has the thing: the grant is the shape of the
/// app's pages, which is what the capability model already says.
test fn drawsATabForEachThingTheAppHas() -> Result<Unit, Error> {
  let bare = appTabs("", anApp("hello"), "Overview").render()
  assert(bare.contains(">Overview</a>"))?
  assert(bare.contains(">Code</a>"))?
  assert(bare.contains(">Settings</a>"))?
  // The log ring is the host's, not the app's: it holds the host's own
  // lines about an app granted nothing at all.
  assert(bare.contains(">Logs</a>"))?
  // Every app has counters, so every app has Metrics.
  assert(bare.contains(">Metrics</a>"))?
  assertEqual(bare.contains(">Data</a>"), false)?
  assertEqual(bare.contains(">SQL</a>"), false)?
  assertEqual(bare.contains(">Queues</a>"), false)?
  let full = appTabs("", anApp("watch", granted: Vector.of("kv", "queue", "sql").freeze()), "SQL").render()
  assert(full.contains(">Data</a>"))?
  assert(full.contains(">SQL</a>"))?
  assert(full.contains(">Queues</a>"))?
  // And the page one is on is the one marked.
  assert(full.contains("<a href=\"/apps/watch/sql\" aria-current=page>SQL</a>"))?
  assertEqual(full.contains("<a href=\"/apps/watch\" aria-current=page>"), false)?
  Ok(())
}

/// The order is the one every page of the app has: Overview, Metrics, Logs, the
/// stores, Code, Settings.
test fn keepsTheTabsInOneOrder() -> Result<Unit, Error> {
  let tabs = appTabs("", anApp("watch", granted: Vector.of("kv", "queue", "sql").freeze()), "Overview").render()
  var order = Vector.of()
  for part in tabs.split("</a>") {
    for name in Vector.of("Overview", "Metrics", "Logs", "Data", "SQL", "Queues", "Code", "Settings").freeze() {
      if part.endsWith(">{name}") {
        order.push(name)
      }
    }
  }
  assertEqual(",".join(order.freeze()), "Overview,Metrics,Logs,Data,SQL,Queues,Code,Settings")?
  Ok(())
}

/// A page of an app with no rows is a page and not a failure: the host
/// answers an empty array both for one that keeps no history and for one that
/// has not sampled yet, and `minicloud test` is the first of those. What it
/// says must be true of both, and it must not draw a frame round nothing.
test fn saysSoWhenThereIsNothingToDrawAMetricFrom() -> Result<Unit, Error> {
  let page = metricsPage("", anApp("hello"), asking(Map.of())).render()
  assert(page.contains("Nothing to show for the last hour"))?
  assert(page.contains("cannot tell which"))?
  assert(!page.contains("<svg class=chart"))?
  assert(!page.contains("is not recording"))?
  // and the tab is the one marked
  assert(page.contains("<a href=\"/apps/hello/metrics\" aria-current=page>Metrics</a>"))?
  Ok(())
}

test fn fallsBackToTheHourForAWindowItDoesNotKnow() -> Result<Unit, Error> {
  assertEqual(metricsWindow(asking(Map.of())), "hour")?
  assertEqual(metricsWindow(asking(Map.of(MapEntry(key: "over", value: "day")))), "day")?
  assertEqual(metricsWindow(asking(Map.of(MapEntry(key: "over", value: " month ")))), "month")?
  assertEqual(metricsWindow(asking(Map.of(MapEntry(key: "over", value: "year")))), "hour")?
  assertEqual(metricsWindow(asking(Map.of(MapEntry(key: "over", value: "<script>")))), "hour")?
  let page = metricsPage("", anApp("hello"), asking(Map.of(MapEntry(key: "over", value: "<script>")))).render()
  assert(!page.contains("<script>"))?
  assert(page.contains("<b>the last hour</b>"))?
  Ok(())
}

test fn reloadsUntilPausedAndKeepsTheQuery() -> Result<Unit, Error> {
  let going = reloading("/timeline?app=a%26b&over=5m", 5, false)
  assertEqual(going.seconds, 5)?
  assertEqual(
    going.control.render(),
    "<p class=reload>refreshing every 5 s · <a href=\"/timeline?app=a%26b&amp;over=5m&amp;refresh=off\">pause</a></p>",
  )?
  let still = reloading("/timeline?app=a%26b&over=5m", 5, true)
  assertEqual(still.seconds, 0)?
  assertEqual(still.control.render(), "<p class=reload>paused · <a href=\"/timeline?app=a%26b&amp;over=5m\">resume</a></p>")?
  assert(reloading("/live", 2, false).control.render().contains("href=\"/live?refresh=off\""))?
  assert(paused(asking(Map.of(MapEntry(key: "refresh", value: "off")))))?
  assert(!paused(asking(Map.of(MapEntry(key: "refresh", value: "on")))))?
  assert(!paused(asking(Map.of())))?
  // The pages that reload: every 5 s, and none when paused.
  let metrics = metricsPage("", anApp("hello"), asking(Map.of(MapEntry(key: "over", value: "day")))).render()
  assert(metrics.contains("<meta http-equiv=refresh content=\"5; url=/apps/hello/metrics?over=day\">"))?
  assert(metrics.contains("<a href=\"/apps/hello/metrics?over=day&amp;refresh=off\">pause</a>"))?
  let pausedMetrics = metricsPage("", anApp("hello"), asking(Map.of(MapEntry(key: "over", value: "day"), MapEntry(key: "refresh", value: "off")))).render()
  assert(!pausedMetrics.contains("http-equiv"))?
  assert(pausedMetrics.contains("paused · <a href=\"/apps/hello/metrics?over=day\">resume</a>"))?
  let platform = platformPage("", asking(Map.of())).render()
  assert(platform.contains("<meta http-equiv=refresh content=\"5; url=/platform?over=hour\">"))?
  let timeline = timelinePage("", asking(Map.of(MapEntry(key: "app", value: "hello"), MapEntry(key: "refresh", value: "off")))).render()
  assert(!timeline.contains("http-equiv"))?
  assert(timeline.contains("paused · <a href=\"/timeline?app=hello&amp;over=1m\">resume</a>"))?
  assert(!requestAnswer("", "42").body.contains("http-equiv"))?
  Ok(())
}

test fn marksTheWindowItShowsAndLinksTheOthers() -> Result<Unit, Error> {
  let steps = metricsSteps("/apps/hello", "day").render()
  assert(steps.contains("<b>the last day</b>"))?
  assert(steps.contains("<a href=\"/apps/hello/metrics?over=hour\">the last hour</a>"))?
  assert(steps.contains("<a href=\"/apps/hello/metrics?over=month\">the last 30 days</a>"))?
  Ok(())
}

test fn writesThePlatformsFiguresAsPeopleReadThem() -> Result<Unit, Error> {
  assertEqual(platformBytes(512), "512 B")?
  assertEqual(platformBytes(1572864), "1.5 MiB")?
  assertEqual(platformBytes(2147483648), "2.0 GiB")?
  assertEqual(platformBytes(1073741824 * 3 / 2), "1.5 GiB")?
  assertEqual(knownBytes(None), "—")?
  assertEqual(knownBytes(Some(1024)), "1.0 KiB")?
  assertEqual(percentOf(1, 4), "25%")?
  assertEqual(percentOf(1, 0), "—")?
  assertEqual(thousandths(750), "0.75")?
  assertEqual(thousandths(2000), "2.00")?
  assertEqual(thousandths(12005), "12.01")?
  assertEqual(thousandths(0), "0.00")?
  Ok(())
}

test fn takesTheCpuAsAShareOfTheQuota() -> Result<Unit, Error> {
  // 30 s of a minute, of two CPUs, is a quarter.
  assertEqual(cpuPercent(30000000, 60, 2000), 25)?
  // Without a quota, of one CPU, which may be past 100.
  assertEqual(cpuPercent(90000000, 60, 1000), 150)?
  // An hour of half a CPU at full use.
  assertEqual(cpuPercent(1800000000, 3600, 500), 100)?
  assertEqual(cpuPercent(5, 60, 0), 0)?
  assertEqual(pressure(50), "")?
  assertEqual(pressure(80), " is-warn")?
  assertEqual(pressure(95), " is-bad")?
  Ok(())
}

/// Under `minicloud test` there is no host: no figure is known and no row is
/// kept, and the page says so rather than drawing zeros.
test fn thePlatformPageSaysWhatItCannotRead() -> Result<Unit, Error> {
  let page = platformPage("", asking(Map.of(MapEntry(key: "over", value: "day")))).render()
  assert(page.contains("<h1>Platform</h1>"))?
  assert(page.contains("<a href=\"/platform\" aria-current=page>platform</a>"))?
  assert(page.contains("Nothing to chart for the last day"))?
  assert(page.contains("the host cannot read its cgroup"))?
  assert(page.contains("no minute sampled yet"))?
  assert(page.contains("<span class=big>0 / 0</span>"))?
  assert(page.contains("<b>the last day</b>"))?
  assert(page.contains("<a href=\"/platform?over=month\">the last 30 days</a>"))?
  assert(!page.contains("<svg class=chart"))?
  Ok(())
}

test fn writesMicrosecondsAsMilliseconds() -> Result<Unit, Error> {
  assertEqual(millis(0), "0.0")?
  assertEqual(millis(340), "0.3")?
  assertEqual(millis(12500), "12.5")?
  assertEqual(millis(2500000), "2500.0")?
  Ok(())
}

test fn scalesTwoLinesToTheLargerAndTellsThemApart() -> Result<Unit, Error> {
  let a = Vector.of(0, 5, 10).freeze()
  let b = Vector.of(0, 0, 5).freeze()
  assertEqual(metricsLargest(a, b), 10)?
  let times = Vector.of(0, 60, 120).freeze()
  // from 8 to 712 across and from 248 (zero) up to 30 (the top of the scale)
  assertEqual(metricsPoints(times, a, 10), "8,428 360,229 712,30")?
  // a minute with no row is a gap, not a closer neighbour
  assertEqual(metricsPoints(Vector.of(0, 60, 180).freeze(), a, 10), "8,428 242,229 712,30")?
  let chart = metricsChart("two things", "count", times, a, "ln-served", "served", b, "ln-errors", "errors").render()
  assert(chart.contains("role=img aria-label=\"two things\""))?
  assert(chart.contains("<title>two things: now served 10, errors 5</title>"))?
  assert(chart.contains("polyline class=\"ln ln-served\""))?
  assert(chart.contains("polyline class=\"ln ln-errors\""))?
  // a legend, so the lines are not told apart by colour alone
  assert(chart.contains("class=legend"))?
  // the scale: 0, 5, 10, a line each with its value
  assert(chart.contains("<text x=\"12\" y=\"25\">10</text>"))?
  assert(chart.contains("<text x=\"12\" y=\"224\">5</text>"))?
  // the times under the plot, JST: 9 hours past UTC's
  assert(chart.contains("text-anchor=start>09:00</text>"))?
  assert(chart.contains("text-anchor=end>09:02</text>"))?
  // the latest values at the ends of the lines
  assert(chart.contains(">10</text>"))?
  assert(chart.contains("text-anchor=end>5</text>"))?
  // and a hover for each row
  assert(chart.contains("<title>01-01 09:01 JST: served 5, errors 0</title>"))?
  assert(!chart.contains("up to"))?
  // and no line from one sample, or from nothing but zeros
  assert(!metricsChart("x", "count", Vector.of(0).freeze(), Vector.of(1).freeze(), "a", "a", Vector.of(1).freeze(), "b", "b").render().contains("<svg class=chart"))?
  let zeros = Vector.of(0, 0, 0).freeze()
  assert(!metricsChart("x", "count", times, zeros, "a", "a", zeros, "b", "b").render().contains("<svg class=chart"))?
  Ok(())
}

/// A chart of one line: no second key, line, end or figure in a hover.
test fn drawsAChartOfOneLine() -> Result<Unit, Error> {
  let times = Vector.of(0, 60, 120).freeze()
  let mib = 1048576
  let bytes = Vector.of(mib, 3 * mib, 2 * mib).freeze()
  let chart = metricsChart("allocated", "bytes", times, bytes, "ln-used", "allocated", [], "", "").render()
  assert(chart.contains("<title>allocated: now allocated 2.0 MiB</title>"))?
  assertEqual(chart.split("<polyline").length() - 1, 1)?
  assertEqual(chart.split("class=key").length() - 1, 1)?
  assertEqual(chart.split("class=ch-end").length() - 1, 1)?
  assert(chart.contains("text-anchor=end>2.0 MiB</text>"))?
  assert(chart.contains("<title>01-01 09:01 JST: allocated 3.0 MiB</title>"))?
  assertEqual(
    chartHoverTitle("count", times, Vector.of(1, 5, 2).freeze(), "collections", [], "", 0, 2),
    "01-01 09:00 JST – 01-01 09:02 JST: collections up to 5",
  )?
  Ok(())
}

test fn writesWordsAsBytesAndASharePerHundred() -> Result<Unit, Error> {
  assertEqual(wordBytes(131072), 1048576)?
  assertEqual(shareOf(1, 3), 33)?
  assertEqual(shareOf(0, 0), 0)?
  assertEqual(shareOf(5, 5), 100)?
  Ok(())
}

test fn stepsAScaleInOneTwoOrFive() -> Result<Unit, Error> {
  assertEqual(niceStep(1, 4), 1)?
  assertEqual(niceStep(3, 4), 1)?
  assertEqual(niceStep(10, 4), 5)?
  // never more than four steps: 21 is three of 10, not five of 5
  assertEqual(niceStep(21, 4), 10)?
  assertEqual(niceStep(100, 4), 50)?
  assertEqual(niceStep(101, 4), 50)?
  assertEqual(niceStep(201, 4), 100)?
  assertEqual(chartTicks("count", 3), [0, 1, 2, 3])?
  assertEqual(chartTicks("count", 21), [0, 10, 20, 30])?
  assertEqual(chartTicks("percent", 7), [0, 2, 4, 6, 8])?
  // a time steps by no less than a tenth of a millisecond
  assertEqual(chartTicks("ms", 150), [0, 100, 200])?
  assertEqual(chartTicks("ms", 3400), [0, 1000, 2000, 3000, 4000])?
  Ok(())
}

test fn stepsASizeInRoundTenthsOfItsUnit() -> Result<Unit, Error> {
  let gib = 1073741824
  let mib = 1048576
  assertEqual(byteUnit(500), 1)?
  assertEqual(byteUnit(150 * mib), mib)?
  assertEqual(byteUnit(2 * gib), gib)?
  // MemoryMax of 2 GiB: half a GiB a line
  assertEqual(chartTicks("bytes", 2 * gib), [0, gib / 2, gib, gib + gib / 2, 2 * gib])?
  var labels = Vector.of()
  for value in chartTicks("bytes", 2 * gib) {
    labels.push(chartTickLabel("bytes", value, 2 * gib))
  }
  assertEqual(",".join(labels.freeze()), "0,0.5 GiB,1 GiB,1.5 GiB,2 GiB")?
  // 150 MiB with no limit: 50 MiB a line
  assertEqual(chartTicks("bytes", 150 * mib), [0, 50 * mib, 100 * mib, 150 * mib])?
  assertEqual(chartTickLabel("bytes", 100 * mib, 150 * mib), "100 MiB")?
  // a disk of 100 GiB
  assertEqual(chartTickLabel("bytes", 50 * gib, 100 * gib), "50 GiB")?
  assertEqual(chartTickLabel("bytes", 300, 500), "300 B")?
  // the other kinds, each in its own unit
  assertEqual(chartTickLabel("ms", 2000, 3400), "2 ms")?
  assertEqual(chartTickLabel("ms", 100, 150), "0.1 ms")?
  assertEqual(chartTickLabel("percent", 40, 80), "40%")?
  assertEqual(chartTickLabel("count", 0, 80), "0")?
  // and a value at the end of a line, as the figures write it
  assertEqual(chartValue("bytes", 152 * mib), "152.0 MiB")?
  assertEqual(chartValue("bytes", 2 * gib), "2.0 GiB")?
  assertEqual(chartValue("ms", 1250), "1.3 ms")?
  assertEqual(chartValue("percent", 5), "5%")?
  Ok(())
}

test fn putsTimeTicksOnTheClock() -> Result<Unit, Error> {
  // an hour: every 10 minutes
  assertEqual(timeStep(3540, 6), 600)?
  // a day: every 6 hours
  assertEqual(timeStep(86340, 6), 21600)?
  // 30 days: every week
  assertEqual(timeStep(30 * 86400, 6), 604800)?
  // whole steps between the first row and the last, not from the first
  assertEqual(timeTicks(1000, 4000, 900), [1800, 2700, 3600])?
  assertEqual(timeTicks(900, 1800, 900), [900, 1800])?
  // and a day on JST's midnight, 15:00 UTC
  assertEqual(timeTicks(0, 86400, 86400), [54000])?
  // 2026-10-20T14:30:00Z is 23:30 JST
  let at = 1792506600
  assertEqual(timeTickLabel(at, 900), "23:30")?
  assertEqual(timeTickLabel(at, 86400), "10-20")?
  assertEqual(timeFull(at), "10-20 23:30 JST")?
  Ok(())
}

test fn writesTimesInJapanStandardTime() -> Result<Unit, Error> {
  // 2026-10-20T01:14:00Z
  assertEqual(jst(1792458840000), "2026-10-20 10:14:00")?
  assertEqual(jstClock(1792458840000), "10:14")?
  assertEqual(jstDate(1792458840000), "10-20")?
  // 14:59:59.999 UTC is 23:59:59 JST, the same day; a millisecond later
  // it is the next day's midnight, and the date, the month and the year turn
  assertEqual(jst(1792508399999), "2026-10-20 23:59:59")?
  assertEqual(jst(1792508400000), "2026-10-21 00:00:00")?
  assertEqual(jstDate(1792508400000), "10-21")?
  assertEqual(jst(1798729199999), "2026-12-31 23:59:59")?
  assertEqual(jst(1798729200000), "2027-01-01 00:00:00")?
  // the epoch is nine in the morning
  assertEqual(jst(0), "1970-01-01 09:00:00")?
  // the clock of a log line keeps its milliseconds and says the whole stamp
  let said = atTime(1792508400123).render()
  assert(said.contains(">00:00:00.123<"))?
  assert(said.contains("title=\"2026-10-21 00:00:00 JST\""))?
  Ok(())
}

test fn putsDayTicksOnJstMidnight() -> Result<Unit, Error> {
  // 2026-10-20T14:00:00Z is 23:00 JST; the day's tick after it is 15:00Z
  // (JST midnight), not UTC's midnight at 00:00Z
  let first = 1792504800
  let ticks = timeTicks(first, first + 3 * 86400, 86400)
  assertEqual(ticks, [1792508400, 1792594800, 1792681200])?
  assertEqual(timeTickLabel(1792508400, 86400), "10-21")?
  assertEqual(jstClock(1792508400 * 1000), "00:00")?
  // a quarter of an hour is on JST's :00, :15, :30 and :45 as well
  assertEqual(timeTicks(1792504801, 1792506600, 900), [1792505700, 1792506600])?
  assertEqual(timeTickLabel(1792505700, 900), "23:15")?
  Ok(())
}

test fn keepsTheEndsOfTwoLinesApart() -> Result<Unit, Error> {
  // far apart: both above their lines
  let far = chartEnds(40, "2.0 GiB", 230, "150.0 MiB").render()
  assert(far.contains("y=\"40\" dy=\"-0.45em\" text-anchor=end>2.0 GiB"))?
  assert(far.contains("y=\"230\" dy=\"-0.45em\" text-anchor=end>150.0 MiB"))?
  // close: the lower one under its line
  let close = chartEnds(110, "5", 100, "6").render()
  assert(close.contains("y=\"110\" dy=\"1.15em\" text-anchor=end>5"))?
  assert(close.contains("y=\"100\" dy=\"-0.45em\" text-anchor=end>6"))?
  // close at the floor: the higher one a line further up
  let floor = chartEnds(428, "0", 428, "1").render()
  assert(floor.contains("dy=\"-0.45em\""))?
  assert(floor.contains("dy=\"-1.5em\""))?
  // the same value at the same place: said once
  let same = chartEnds(100, "1", 100, "1").render()
  assertEqual(same.split("<text").length() - 1, 1)?
  assert(same.contains("dy=\"-0.45em\""))?
  Ok(())
}

test fn hoversARowOrAGroupOfRows() -> Result<Unit, Error> {
  var times = Vector.of()
  var values = Vector.of()
  var at = 0
  while at < 1440 {
    times.push(at * 60)
    values.push(at)
    at = at + 1
  }
  let rows = values.freeze()
  let day = chartHovers("count", times.freeze(), rows, "a", rows, "b").render()
  // a day of minutes is 120 columns, not 1440
  assertEqual(day.split("<title>").length() - 1, 120)?
  assert(day.contains("<title>01-01 09:00 JST – 01-01 09:06 JST: a up to 6, b up to 6</title>"))?
  Ok(())
}

/// Nothing wrong is a line saying so, and it names what was looked at: "is
/// anything wrong" is the question somebody opened the page to answer, and
/// a page that answers it by being empty has not answered it.
test fn saysSoWhenNothingIsWorthALook() -> Result<Unit, Error> {
  let said = worthALook("", anApp("hello"), noQueues(), aDisk()).render()
  assert(said.contains("class=\"is-ok\""))?
  assert(said.contains("Nothing: no request failed"))?
  assert(said.contains("every file of the deploy is the same as the one in the app's directory"))?
  assertEqual(said.contains("is-bad"), false)?
  assertEqual(said.contains("is-warn"), false)?
  Ok(())
}

/// A dead letter is the news the queues page exists for, and it is said
/// here before anybody goes to that page.
test fn saysWhatIsOnTheQueuesWorstFirst() -> Result<Unit, Error> {
  let queues = Vector.of(aQueue("work", held: 3, dead: 2)).freeze()
  let said = worthALook("", anApp("jobs", granted: Vector.of("queue").freeze()), queues, aDisk()).render()
  assert(said.contains("2 dead letters wait on <code>work</code>"))?
  assert(said.contains("3 held on <code>work</code>"))?
  assert(said.contains("/apps/jobs/queues"))?
  // The dead letters are above what is held, and both above the green line.
  assert(said.indexOf("dead letters wait").unwrapOr(0) < said.indexOf("3 held").unwrapOr(0))?
  assert(said.indexOf("3 held").unwrapOr(0) < said.indexOf("Nothing else").unwrapOr(0))?
  // And the green line no longer claims the queues are clear.
  assertEqual(said.contains("no dead letter waits"), false)?
  Ok(())
}

/// A store near what it may hold, before the write that is refused.
test fn saysWhenAStoreIsNearItsLimit() -> Result<Unit, Error> {
  let full = anApp("notes", granted: Vector.of("kv").freeze(), kvKeys: 10, kvBytes: 900, kvMaxKeys: 1000, kvMaxBytes: 1000)
  assert(worthALook("", full, noQueues(), aDisk()).render().contains("holds 900 B of the 1000 B it may"))?
  // Eighty hundredths is where it starts, so 799 of 1000 is not it.
  let room = anApp("notes", granted: Vector.of("kv").freeze(), kvKeys: 10, kvBytes: 799, kvMaxKeys: 1000, kvMaxBytes: 1000)
  assert(worthALook("", room, noQueues(), aDisk()).render().contains("no store is near its limit"))?
  // A store the host has not opened, and a limit of 0, are not "near".
  assertEqual(nearLimit(-1, 100), false)?
  assertEqual(nearLimit(100, 0), false)?
  assertEqual(nearLimit(80, 100), true)?
  assertEqual(nearLimit(79, 100), false)?
  Ok(())
}

/// The deploy against the app's directory: the page says it did not look
/// rather than saying they are the same, because a dashboard cannot read
/// every file of every deploy and a wrong "the same" is the one answer
/// that would matter.
test fn saysWhenItDidNotCompareTheDeployWithTheDirectory() -> Result<Unit, Error> {
  let said = worthALook("", anApp("big"), noQueues(), aDisk(looked: false)).render()
  assert(said.contains("The deploy was not compared with the app's directory here"))?
  assert(said.contains("The Code tab reads every file of it."))?
  assertEqual(said.contains("every file of the deploy is the same"), false)?
  let differs = worthALook("", anApp("big"), noQueues(), aDisk(differing: 2)).render()
  assert(differs.contains("2 files in the app's directory are not the ones that are running"))?
  Ok(())
}

/// A refusal and a failure are the host's words, and the host's words are
/// an app's: every one of them is a `String` in a hole, escaped before it is
/// in a page.
test fn escapesWhatTheHostSaidAboutAnApp() -> Result<Unit, Error> {
  let app = anApp(
    "notes",
    state: "refused",
    reason: "requires `<img src=x>`",
    served: 1,
    errors: 1,
    recentErrors: Vector.of(aFailure("runtime", 500, "<script>alert(1)</script>")).freeze(),
  )
  let said = worthALook("", app, noQueues(), aDisk()).render()
  assertEqual(said.contains("<img src=x>"), false)?
  assertEqual(said.contains("<script>"), false)?
  assert(said.contains("&lt;img src=x&gt;"))?
  assert(said.contains("&lt;script&gt;alert(1)&lt;/script&gt;"))?
  // A queue's name is the app's too.
  let queues = Vector.of(aQueue("<b>q</b>", dead: 1)).freeze()
  let onQueues = worthALook("", anApp("jobs", granted: Vector.of("queue").freeze()), queues, aDisk()).render()
  assertEqual(onQueues.contains("<b>q</b>"), false)?
  assert(onQueues.contains("&lt;b&gt;q&lt;/b&gt;"))?
  Ok(())
}

/// A card's pill is the way to the page that shows what it says, and an app
/// with nothing to say says `quiet` and no more.
test fn putsWhatAnAppHasToSayAtTheEndOfItsCard() -> Result<Unit, Error> {
  let quiet = appFlags("", anApp("ledger"), noQueues())
  assertEqual(quiet.length(), 0)?
  assert(appCard("", anApp("ledger"), quiet).render().contains("<span class=quiet>quiet</span>"))?
  let loud = anApp("notes", state: "refused", reason: "requires `kv`", served: 4, errors: 2, accessOff: "no team")
  let flags = appFlags("", loud, noQueues())
  let card = appCard("", loud, flags).render()
  assert(card.contains("<li class=\"app is-bad\">"))?
  assert(card.contains("href=\"/apps/notes/settings\">refused →</a>"))?
  assert(card.contains("href=\"/apps/notes\">2 failed →</a>"))?
  assert(card.contains("Access off →"))?
  // The refusal's reason is the one thing a list cannot send somebody away
  // to read, so the card holds it — escaped, like everything else.
  assert(card.contains("requires `kv`"))?
  Ok(())
}

/// The sentence the green line is made of.
test fn writesAListAsASentence() -> Result<Unit, Error> {
  assertEqual(sentence(Vector.of().freeze()).render(), "")?
  assertEqual(sentence(Vector.of(html"a").freeze()).render(), "a")?
  assertEqual(sentence(Vector.of(html"a", html"b").freeze()).render(), "a and b")?
  assertEqual(sentence(Vector.of(html"a", html"b", html"c").freeze()).render(), "a, b and c")?
  // The words are the page's own, so an apostrophe in one is written as it
  // is: the green line says "the app's directory".
  assertEqual(sentence(Vector.of(html"x", html"the app's").freeze()).render(), "x and the app's")?
  Ok(())
}

test fn saysWhichPartOfADeployAFileIs() -> Result<Unit, Error> {
  assert(codeKind(aFile("app.toml", "config", true, "same")).render().contains("configuration"))?
  assert(codeKind(aFile("admin.cove", "cove", true, "same")).render().contains(">code<"))?
  assert(codeKind(aFile("assets/style.css", "asset", true, "same")).render().contains(">asset<"))?
  // Not text, so there is no body of it to show: the listing says so where
  // it says what the file is.
  assert(codeKind(aFile("assets/logo.png", "asset", false, "same")).render().contains("asset, not text"))?
  Ok(())
}

test fn saysWhenTheFileOnDiskIsNotTheOneRunning() -> Result<Unit, Error> {
  // app.toml is read from the app's directory, so there is nothing for it
  // to disagree with.
  assert(onDisk(aFile("app.toml", "config", true, "same")).render().contains("read from there"))?
  assert(onDisk(aFile("a.cove", "cove", true, "same")).render().contains(">same<"))?
  assert(onDisk(aFile("a.cove", "cove", true, "differs")).render().contains(">differs<"))?
  assert(onDisk(aFile("a.cove", "cove", true, "missing")).render().contains(">missing<"))?
  assert(onDisk(aFile("a.cove", "cove", true, "unread")).render().contains(">unread<"))?
  // A word the host grows later still reads, as a log level does.
  assert(onDisk(aFile("a.cove", "cove", true, "elsewhere")).render().contains(">unread<"))?
  // A directory has no file of it on disk to differ from.
  assert(onDisk(aRow("assets", "assets", 0, "dir")).render().contains("–"))?
  Ok(())
}

/// A row of the tree is the item it opens: the name is the last part of the
/// path, the whole path is where the link points and what it is titled, and
/// what the file is and what it comes to are beside the name, each in a
/// column the stylesheet can line up with the rows above and below.
test fn opensAnItemForEachRowOfTheTree() -> Result<Unit, Error> {
  let top = codeRow("/apps/notes", aRow("app.toml", "app.toml", 0, "config")).render()
  // The name and what is beside it are one row inside the item, because the
  // item also holds the list of what is under a directory.
  assert(top.startsWith("<li><span class=row>"))?
  assert(top.contains("code?file=app.toml"))?
  // What the table had in columns is beside the name now — and is named, so
  // the stylesheet can hold each to a width of its own.
  assert(top.contains("configuration"))?
  assert(top.contains("1.0 KiB"))?
  assert(top.contains("<span class=what>"))?
  assert(top.contains("<span class=size>1.0 KiB</span>"))?
  assert(top.contains("<span class=disk>"))?
  // The row closes and the item does not: the row is the name's line.
  assert(top.endsWith("</span>"))?
  let under = codeRow("/apps/notes", aRow("text/text.cove", "text.cove", 1, "cove")).render()
  assert(under.contains("title=\"text/text.cove\""))?
  assert(under.contains("code?file=text%2Ftext.cove"))?
  // The row says the last part; the parts above it are the rows above it.
  assert(under.contains("<code>text.cove</code>"))?
  assert(!under.contains("<code>text/text.cove</code>"))?
  // A directory is not a link — there is no file of it to show — and it
  // says so where a file says what it is.
  let dir = codeRow("/apps/notes", aRow("assets", "assets", 0, "dir")).render()
  assert(dir.startsWith("<li class=dir><span class=row>"))?
  assert(dir.contains("<code>assets/</code>"))?
  assert(!dir.contains("href"))?
  assert(dir.contains("directory"))?
  // A directory has nothing on disk to differ from, so the column is empty
  // rather than gone: a column that comes and goes is one that never lines
  // up with the rows around it.
  assert(dir.contains("<span class=disk></span>"))?
  // The item is left open: what is under a directory goes inside it.
  assert(!dir.contains("</li>"))?
  Ok(())
}

/// **The tree closes every list it opens**, whatever the depths do: the
/// nesting is the markup, so a list left open is the rest of the page in
/// the wrong place. A depth that skips a level opens one list and no more,
/// and a row two levels shallower closes the two that are open.
test fn closesEveryListTheTreeOpens() -> Result<Unit, Error> {
  let at = "/apps/notes"
  let top = aRow("app.toml", "app.toml", 0, "config")
  let dir = aRow("assets", "assets", 0, "dir")
  let img = aRow("assets/img", "img", 1, "dir")
  // Two deeper than the row above it, which the host does not do.
  let deep = aRow("assets/img/icons/a.svg", "a.svg", 3, "asset")
  let last = aRow("assets/style.css", "style.css", 1, "asset")
  assertEqual(
    codeTree(at, Vector.of(top, dir, img, deep, last).freeze()).render(),
    "<ul class=tree>{codeRow(at, top).render()}</li>{codeRow(at, dir).render()}<ul>{codeRow(at, img).render()}<ul>{codeRow(at, deep).render()}</li></ul></li>{codeRow(at, last).render()}</li></ul></li></ul>",
  )?
  // As many closes as opens, which is the whole of what must hold.
  let shown = codeTree(at, Vector.of(top, dir, img, deep, last).freeze()).render()
  assertEqual(shown.split("<ul").length(), shown.split("</ul").length())?
  assertEqual(shown.split("<li").length(), shown.split("</li").length())?
  // A row deeper than nothing opens the one list, and no rows open none.
  let alone = codeTree(at, Vector.of(aRow("a.cove", "a.cove", 4, "cove")).freeze()).render()
  assertEqual(alone, "<ul class=tree>{codeRow(at, aRow("a.cove", "a.cove", 4, "cove")).render()}</li></ul>")?
  assertEqual(codeTree(at, Vector.of().freeze()).render(), "")?
  Ok(())
}

/// A piece's text is the file's own bytes, so the hole it goes in is the
/// whole of what keeps a file holding `<img src=y>` a file.
test fn escapesEveryPieceOfAColouredFile() -> Result<Unit, Error> {
  let pieces = Vector.of(
    host.CodePiece(kind: "comment", text: "// <img src=y> & \"it's\""),
    host.CodePiece(kind: "plain", text: "\nlet a = "),
    host.CodePiece(kind: "string", text: "\"<script>alert(1)</script>\""),
    // A kind the page has no colour for is its text and no element, which
    // is how a kind the host grows later still reads.
    host.CodePiece(kind: "whatever", text: "\n<b>"),
  ).freeze()
  let body = codeBody(aColouredFile("a.cove", "", pieces, "")).render()
  assert(!body.contains("<img"))?
  assert(!body.contains("<script>"))?
  assert(!body.contains("<b>"))?
  assert(body.contains("<span class=c>// &lt;img src=y&gt; &amp; &quot;it&#39;s&quot;</span>"))?
  assert(body.contains("<span class=s>&quot;&lt;script&gt;alert(1)&lt;/script&gt;&quot;</span>"))?
  assert(body.contains("&lt;b&gt;"))?
  Ok(())
}

/// A file shown with no colour says why rather than looking like a file
/// with nothing in it worth colouring.
test fn saysWhyAFileIsShownWithNoColour() -> Result<Unit, Error> {
  let none = Vector.of().freeze()
  let cut = codeBody(aColouredFile("big.cove", "x", none, "cut")).render()
  assert(cut.contains("stops at what the host carries"))?
  assert(cut.contains("<pre class=code>x</pre>"))?
  let dense = codeBody(aColouredFile("dense.cove", "x", none, "dense")).render()
  assert(dense.contains("more pieces than one page carries (20000)"))?
  let unknown = codeBody(aColouredFile("notes.txt", "x", none, "unknown")).render()
  assert(unknown.contains("no reader for this kind of file"))?
  // And a word the host grows later still says something.
  let later = codeBody(aColouredFile("a.rs", "x", none, "elsewhere")).render()
  assert(later.contains("no reader for this kind of file"))?
  // Coloured, there is nothing to explain.
  let shown = codeBody(aColouredFile("a.cove", "x", Vector.of(host.CodePiece(kind: "plain", text: "x")).freeze(), "")).render()
  assertEqual(shown, "<pre class=code>x</pre>")?
  Ok(())
}

test fn saysWhereTheHostAnswersAnAssetItCannotShow() -> Result<Unit, Error> {
  let logo = aFile("assets/img/logo.png", "asset", false, "same")
  let byPath = anApp("notes", Vector.of().freeze())
  assertEqual(servedAt(byPath, logo), "/notes/img/logo.png")?
  assert(servedOn(byPath).render().contains("by path"))?
  // A hostname reaches its app with the whole path, so the app's name is
  // not part of it.
  let byName = anApp("watch", Vector.of("watch.example").freeze())
  assertEqual(servedAt(byName, logo), "/img/logo.png")?
  assert(servedOn(byName).render().contains("watch.example"))?
  Ok(())
}

test fn saysANullCellApartFromAnEmptyOne() -> Result<Unit, Error> {
  // The store keeps the two apart, so the page does: neither is an empty
  // cell, and each says which it is.
  assert(sqlCell(None).render().contains("NULL"))?
  assert(sqlCell(Some("")).render().contains("empty"))?
  assertEqual(sqlCell(Some("x")).render(), "<code>x</code>")?
  Ok(())
}

test fn escapesACellWhateverTheAppStoredInIt() -> Result<Unit, Error> {
  let said = sqlCell(Some("<img src=y>&\"'")).render()
  assert(!said.contains("<img"))?
  assert(said.contains("&lt;img src=y&gt;&amp;&quot;&#39;"))?
  Ok(())
}

test fn putsTheStatementBackInTheBoxAsTheAttributesValue() -> Result<Unit, Error> {
  // The statement goes back inside quotes. A quote in it has to come out
  // as an entity, or the rest of the statement would be markup.
  let said = sqlForm("/apps/notes", "SELECT \"a\" FROM t WHERE v = '<img src=y>'").render()
  assert(said.contains("value=\"SELECT &quot;a&quot; FROM t WHERE v = &#39;&lt;img src=y&gt;&#39;\""))?
  assert(!said.contains("<img"))?
  // And it is a GET: a read is in the URL, and there is no change for a
  // form on another site to make.
  assert(said.contains("method=get"))?
  Ok(())
}

test fn showsAnAnswerAsItsColumnsAndRows() -> Result<Unit, Error> {
  let answer = host.SqlAnswer(
    columns: Vector.of("title", "pages").freeze(),
    rows: Vector.of(
      host.SqlRow(values: Vector.of(Some("Dune"), Some("412")).freeze()),
      host.SqlRow(values: Vector.of(Some("<b>"), None).freeze()),
    )
      .freeze(),
  )
  let said = sqlAnswerTable(answer).render()
  assert(said.contains("<th>title</th>"))?
  assert(said.contains("<code>Dune</code>"))?
  assert(said.contains("&lt;b&gt;"))?
  assert(said.contains("NULL"))?
  assert(said.contains("2 rows."))?
  // A column name is the host's too, and is escaped where it labels a cell.
  let evil = host.SqlAnswer(
    columns: Vector.of("<img src=y>").freeze(),
    rows: Vector.of(host.SqlRow(values: Vector.of(Some("1")).freeze())).freeze(),
  )
  assert(!sqlAnswerTable(evil).render().contains("<img"))?
  // An answer with no rows is said, not shown as an empty table.
  let none = host.SqlAnswer(columns: Vector.of("n").freeze(), rows: Vector.of().freeze())
  assert(sqlAnswerTable(none).render().contains("No rows."))?
  Ok(())
}

test fn listsTheTablesWithAStatementForEach() -> Result<Unit, Error> {
  let said = sqlTablesTable(
    "/apps/notes",
    Vector.of(
      host.SqlTable(name: "books", rows: 2, counted: true),
      host.SqlTable(name: "huge", rows: 0, counted: false),
    )
      .freeze(),
  ).render()
  assert(said.contains("<code>books</code>"))?
  assert(said.contains(">2</td>"))?
  // A count that could not be taken says so, where a 0 would have been a
  // wrong answer.
  assert(said.contains("not counted"))?
  assert(said.contains("/apps/notes/sql?q=SELECT%20%2A%20FROM%20%22books%22%20LIMIT%2050"))?
  // A store with no tables is said in words.
  assert(sqlTablesTable("/apps/notes", Vector.of().freeze()).render().contains("no tables"))?
  Ok(())
}

/// One message of a queue, as the host answers one: the fields a dead
/// letter has are empty for a message that is still waiting.
fn waitingMessage(body: String, state: String) -> host.QueueMessage {
  host.QueueMessage(
    id: 7,
    queue: "mail",
    body: body,
    bytes: body.byteLength(),
    cut: false,
    attempts: 1,
    state: state,
    dueMs: 1760000000000,
    sentMs: 1759999000000,
    why: "",
    buriedMs: 0,
  )
}

test fn saysWhatAMessageIsAndWhatHeldMeans() -> Result<Unit, Error> {
  assert(queueState("due").render().contains(">due<"))?
  // The one that has to be explained: the store keeps one due time for a
  // lease and for a retry's wait, so the page does not claim to know which.
  let held = queueState("held").render()
  assert(held.contains(">held<"))?
  assert(held.contains("lease"))?
  assert(held.contains("retry"))?
  assert(queueState("dead").render().contains(">dead<"))?
  Ok(())
}

test fn escapesABodyWhateverWasSentToTheQueue() -> Result<Unit, Error> {
  // A body is whatever an app sent — a webhook's payload, a form somebody
  // filled in — so it is the likeliest markup on these pages.
  let said = queueBodyCell(waitingMessage("<img src=y>&\"'", "due")).render()
  assert(!said.contains("<img"))?
  assert(said.contains("&lt;img src=y&gt;&amp;&quot;&#39;"))?
  // An empty body is said in words rather than shown as an empty cell.
  assert(queueBodyCell(waitingMessage("", "due")).render().contains("empty"))?
  Ok(())
}

test fn cutsALongBodyToTheColumnAndSaysSo() -> Result<Unit, Error> {
  var long = ""
  while long.byteLength() < 400 {
    long = "{long}x"
  }
  let said = queueBodyCell(waitingMessage(long, "due")).render()
  assert(said.contains("…"))?
  assertEqual(said.contains(text.truncateBytes(long, 141)), false)?
  Ok(())
}

test fn listsTheMessagesWaitingWithTheirTriesAndTheirDueTime() -> Result<Unit, Error> {
  let said = queueMessagesTable(
    "/apps/post",
    Vector.of(waitingMessage("one", "due"), waitingMessage("two", "held")).freeze(),
  ).render()
  assert(said.contains("<code>one</code>"))?
  assert(said.contains(">held<"))?
  assert(said.contains("<th>tries</th>"))?
  // The whole stamp, not the time of day: a retry's delay doubles, so a
  // message can be due days off and a clock alone would read as today.
  assert(said.contains("2025-10-09 17:53:20"))?
  // Nothing waiting is said in words, not shown as an empty table.
  assert(queueMessagesTable("/apps/post", Vector.of().freeze()).render().contains("Nothing is waiting"))?
  // The id is the way to the whole of a body, which a row cuts.
  assert(said.contains("<a href=\"/apps/post/queues?message=7\">"))?
  Ok(())
}

test fn saysWhyADeadLetterWasBuriedAndEscapesThat() -> Result<Unit, Error> {
  let buried = host.QueueMessage(
    id: 9,
    queue: "mail",
    body: "payload",
    bytes: 7,
    cut: false,
    attempts: 5,
    state: "dead",
    dueMs: 1760000000000,
    sentMs: 1759999000000,
    // The consumer's own words: a status and the first line of its answer.
    why: "500 <img src=y>",
    buriedMs: 1760000500000,
  )
  let said = queueDeadTable("/apps/post", Vector.of(buried).freeze()).render()
  assert(said.contains("<th>why</th>"))?
  assert(!said.contains("<img"))?
  assert(said.contains("500 &lt;img src=y&gt;"))?
  assert(said.contains("<code>payload</code>"))?
  assert(said.contains("2025-10-09 18:01:40"))?
  assert(queueDeadTable("/apps/post", Vector.of().freeze()).render().contains("No dead letters"))?
  Ok(())
}

test fn namesEachQueueWithWhatItHoldsAndHowItIsDelivered() -> Result<Unit, Error> {
  let said = queuesTable(
    Vector.of(
      host.Queue(
        name: "mail",
        path: "/queue/mail",
        due: 2,
        held: 1,
        dead: 3,
        declared: true,
        maxDepth: 1000,
        maxAttempts: 5,
        retryMs: 30000,
        leaseMs: 60000,
        batch: 8,
        maxBodyBytes: 65536,
      ),
      // A queue the store holds messages for that the app no longer
      // declares: nothing will ever deliver it, which is the thing to see.
      host.Queue(
        name: "gone",
        path: "",
        due: 4,
        held: 0,
        dead: 0,
        declared: false,
        maxDepth: 0,
        maxAttempts: 0,
        retryMs: 0,
        leaseMs: 0,
        batch: 0,
        maxBodyBytes: 0,
      ),
    )
      .freeze(),
  ).render()
  assert(said.contains("<code>mail</code>"))?
  assert(said.contains("<code>/queue/mail</code>"))?
  assert(said.contains(">2</td>"))?
  assert(said.contains("5 attempts, retry 30s"))?
  assert(said.contains("lease 60s"))?
  assert(said.contains("not declared"))?
  Ok(())
}

test fn writesADurationAsAppTomlWritesIt() -> Result<Unit, Error> {
  assertEqual(queueDuration(30000), "30s")?
  assertEqual(queueDuration(1000), "1s")?
  assertEqual(queueDuration(1500), "1500ms")?
  Ok(())
}

test fn saysWhenAListingReachedTheWindowsLimit() -> Result<Unit, Error> {
  // Under the limit: the listing is the whole of it, and there is nothing
  // to say.
  assertEqual(queueMore(3, 3, "of what is waiting").render(), "")?
  let said = queueMore(queueListSize(), 4000, "of what is waiting").render()
  assert(said.contains("The first 200"))?
  assert(said.contains("minicloud queues"))?
  Ok(())
}

fn asking(query: Map<String, String>) -> web.Request {
  web.Request(method: "GET", path: "/", query: query, headers: Map.of(), body: "")
}

fn req(headers: Map<String, String>) -> web.Request {
  web.Request(method: "POST", path: "/", query: Map.of(), headers: headers, body: "")
}

fn withHost(extra: Array<MapEntry<String, String>>) -> web.Request {
  var headers = Map.of(MapEntry(key: "host", value: "app.example"))
  for entry in extra {
    headers = headers.inserted(entry.key, entry.value)
  }
  req(headers)
}

test fn sameOriginTrustsSecFetchSiteAlone() -> Result<Unit, Error> {
  // A form posted from a `no-referrer` page: the browser says `Origin: null`.
  assertEqual(sameOrigin(withHost([MapEntry(key: "sec-fetch-site", value: "same-origin"), MapEntry(key: "origin", value: "null")])), true)?
  assertEqual(sameOrigin(withHost([MapEntry(key: "sec-fetch-site", value: "none")])), true)?
  // A matching Origin does not rescue a cross-site request.
  assertEqual(sameOrigin(withHost([MapEntry(key: "sec-fetch-site", value: "cross-site"), MapEntry(key: "origin", value: "http://app.example")])), false)?
  assertEqual(sameOrigin(withHost([MapEntry(key: "sec-fetch-site", value: "same-site")])), false)?
  Ok(())
}

test fn sameOriginFallsBackToOrigin() -> Result<Unit, Error> {
  assertEqual(sameOrigin(withHost([MapEntry(key: "origin", value: "null")])), false)?
  assertEqual(sameOrigin(withHost([MapEntry(key: "origin", value: "http://app.example")])), true)?
  assertEqual(sameOrigin(withHost([MapEntry(key: "origin", value: "http://evil.example")])), false)?
  assertEqual(sameOrigin(withHost([])), true)?
  Ok(())
}

test fn theWorstCardsComeFirst() -> Result<Unit, Error> {
  // What puts a card above another: an app with a dead letter is above one
  // whose only news is that it is near a limit, as the list within an app
  // puts them.
  let bad = Flag(level: "is-bad", text: html"2 dead on <code>work</code>", path: "/apps/jobs/queues")
  let warn = Flag(level: "is-warn", text: html"Access off", path: "/apps/jobs")
  assertEqual(anyBad([bad]), true)?
  assertEqual(anyBad([warn, bad]), true)?
  assertEqual(anyBad([warn]), false)?
  // Nothing to say is neither, and such a card is last of all.
  assertEqual(anyBad([]), false)?
  Ok(())
}

// ------------------------------------------------- the request timeline

fn aPhase(
  kind: String,
  fromUs: Int,
  toUs: Int,
  worker: Int = -1,
  began: String = "",
  moved: Bool = false,
  op: String = "",
  by: String = "",
  after: String = "",
  open: Bool = false,
) -> host.Phase {
  host.Phase(
    kind: kind,
    fromUs: fromUs,
    toUs: toUs,
    open: open,
    worker: worker,
    began: began,
    moved: moved,
    op: op,
    by: by,
    after: after,
  )
}

fn aRequest(
  id: Int,
  phases: Array<host.Phase>,
  outcome: String = "ok",
  status: Option<Int> = Some(200),
  reason: String = "",
  endedUs: Option<Int> = Some(28000),
  gcCollections: Option<Int> = Some(2),
) -> host.TimelineRequest {
  host.TimelineRequest(
    id: id,
    app: "slow",
    method: "GET",
    path: "/slow/<b>",
    arrivedUs: 10000,
    queuedUs: Some(11000),
    endedUs: endedUs,
    status: status,
    outcome: outcome,
    reason: reason,
    latencyUs: match endedUs {
      Some(ended) => Some(ended - 10000)
      None => None
    },
    workerUs: 3000,
    instructions: Some(1234),
    heapWords: Some(56),
    gcCollections: gcCollections,
    allocatedWords: match gcCollections {
      Some(_) => Some(131072)
      None => None
    },
    yields: 1,
    parks: 1,
    moves: 1,
    nowUs: 100000,
    startedUnixMs: 1790000000000,
    phases: phases,
  )
}

/// The request of `timeline.rs`'s first unit test: it waits, runs on #0,
/// sleeps, resumes on #1, yields and continues there.
fn parkedAndMoved() -> Array<host.Phase> {
  [
    aPhase("wait", 11000, 12000, after: "arrival"),
    aPhase("run", 12000, 13000, worker: 0, began: "start"),
    aPhase("park", 13000, 23000, op: "timer.sleep", by: "answer"),
    aPhase("wait", 23000, 25000, after: "park"),
    aPhase("run", 25000, 26000, worker: 1, began: "resume", moved: true),
    aPhase("wait", 26000, 27000, after: "yield"),
    aPhase("run", 27000, 28000, worker: 1, began: "continue"),
  ]
}

test fn scalesATimeAcrossThePicture() -> Result<Unit, Error> {
  assertEqual(scaleX(0, 0, 1000, 900), 0)?
  assertEqual(scaleX(500, 0, 1000, 900), 450)?
  assertEqual(scaleX(1000, 0, 1000, 900), 900)?
  // Outside the window, at the edge it is past.
  assertEqual(scaleX(-5, 0, 1000, 900), 0)?
  assertEqual(scaleX(5000, 0, 1000, 900), 900)?
  // A window of no length divides by nothing.
  assertEqual(scaleX(7, 7, 7, 900), 0)?
  assertEqual(tlX(300000000, 0, 300000000), tlLeft() + tlPlot())?
  Ok(())
}

test fn putsTicksAtOneTwoOrFiveOfAPowerOfTen() -> Result<Unit, Error> {
  assertEqual(tickStep(10000000, 6), 2000000)?
  assertEqual(tickStep(60000000, 6), 10000000)?
  assertEqual(tickStep(300000000, 6), 50000000)?
  assertEqual(tickStep(0, 6), 1)?
  // Every label of an axis in the unit its step is whole in.
  assertEqual(tickLabel(0, 2000000), "0 s")?
  assertEqual(tickLabel(4000000, 2000000), "4 s")?
  assertEqual(tickLabel(1000000, 500000), "1000 ms")?
  assertEqual(tickLabel(1500, 500), "1.5 ms")?
  Ok(())
}

test fn colorsAnAppByItsPlaceInTheOrder() -> Result<Unit, Error> {
  let order = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"]
  assertEqual(paletteSlot(order, "a"), "0")?
  assertEqual(paletteSlot(order, "j"), "9")?
  // Past the tenth the colours begin again; an app not there is grey.
  assertEqual(paletteSlot(order, "k"), "0")?
  assertEqual(paletteSlot(order, "l"), "1")?
  assertEqual(paletteSlot(order, "nobody"), "x")?
  Ok(())
}

test fn ordersColoursByNameWhateverTheWindowHolds() -> Result<Unit, Error> {
  let deployed = ["watch", "admin", "hello", "algo"]
  // The same order whichever app the window saw first.
  assertEqual(colourOrder(deployed, ["hello", "watch"]), ["admin", "algo", "hello", "watch"])?
  assertEqual(colourOrder(deployed, ["watch", "hello", "admin"]), ["admin", "algo", "hello", "watch"])?
  // An app no longer deployed comes after them, by name, once.
  assertEqual(colourOrder(deployed, ["zed", "old", "zed", "hello"]), ["admin", "algo", "hello", "watch", "old", "zed"])?
  // Where the host cannot list its apps, the window's by name.
  assertEqual(colourOrder([], ["slow", "hello", "slow"]), ["hello", "slow"])?
  Ok(())
}

test fn choosesAWindowOfTheTimeline() -> Result<Unit, Error> {
  assertEqual(timelineWindow(asking(Map.of())), "1m")?
  assertEqual(timelineWindow(asking(Map.of(MapEntry(key: "over", value: "10s")))), "10s")?
  assertEqual(timelineWindow(asking(Map.of(MapEntry(key: "over", value: "5m")))), "5m")?
  assertEqual(timelineWindow(asking(Map.of(MapEntry(key: "over", value: "1h")))), "1m")?
  assertEqual(timelineSecs("10s"), 10)?
  assertEqual(timelineSecs("1m"), 60)?
  assertEqual(timelineSecs("5m"), 300)?
  assertEqual(timelineLink("", "", "5m"), "/timeline?over=5m")?
  assertEqual(timelineLink("/x", "a b", "10s"), "/x/timeline?app=a%20b&over=10s")?
  let steps = timelineSteps("", "hello", "10s").render()
  assert(steps.contains("<b>the last 10 seconds</b>"))?
  assert(steps.contains("<a href=\"/timeline?app=hello&amp;over=5m\">the last 5 minutes</a>"))?
  let chips = timelineChips("", ["hello", "notes"], "notes", "1m").render()
  assert(chips.contains("<a href=\"/timeline?over=1m\">all apps</a>"))?
  assert(chips.contains("<a href=\"/timeline?app=notes&amp;over=1m\" aria-current=page>notes</a>"))?
  Ok(())
}

test fn saysWhereARequestInFlightIs() -> Result<Unit, Error> {
  assertEqual(liveState("waiting", ""), "waiting for a worker")?
  assertEqual(liveState("running", ""), "running")?
  assertEqual(liveState("parked", "fetch"), "parked on fetch")?
  assertEqual(liveState("resuming", ""), "answered, waiting for a worker to resume it")?
  assertEqual(liveState("yielded", ""), "yielded, waiting for a worker to continue it")?
  assertEqual(workerName(-1), "–")?
  assertEqual(workerName(3), "#3")?
  Ok(())
}

test fn writesEachPhaseInWords() -> Result<Unit, Error> {
  let phases = parkedAndMoved()
  assertEqual(phaseWords(phases.get(0).unwrapOr(aPhase("", 0, 0))), "waited for a worker 1.0 ms")?
  assertEqual(phaseWords(phases.get(1).unwrapOr(aPhase("", 0, 0))), "ran 1.0 ms on worker #0")?
  assertEqual(phaseWords(phases.get(2).unwrapOr(aPhase("", 0, 0))), "parked on timer.sleep 10.0 ms (answered)")?
  assertEqual(phaseWords(phases.get(3).unwrapOr(aPhase("", 0, 0))), "waited 2.0 ms for a worker to resume it")?
  assertEqual(phaseWords(phases.get(4).unwrapOr(aPhase("", 0, 0))), "resumed on #1 (moved), ran 1.0 ms")?
  assertEqual(phaseWords(phases.get(5).unwrapOr(aPhase("", 0, 0))), "yielded, waited 1.0 ms for a worker to continue it")?
  assertEqual(phaseWords(phases.get(6).unwrapOr(aPhase("", 0, 0))), "continued on #1, ran 1.0 ms")?
  assertEqual(phaseWords(aPhase("park", 0, 30000, op: "fetch", by: "deadline")), "parked on fetch 30.0 ms (the deadline)")?
  assertEqual(phaseWords(aPhase("park", 0, 500, op: "fetch", by: "cancel")), "parked on fetch 0.5 ms (cancelled)")?
  assertEqual(phaseWords(aPhase("park", 0, 2000, op: "fetch", open: true)), "parked on fetch 2.0 ms so far (still parked)")?
  let sentence = phaseSentence(phases)
  assert(sentence.startsWith("waited for a worker 1.0 ms → ran 1.0 ms on worker #0 → parked on timer.sleep"))?
  assert(sentence.endsWith("→ continued on #1, ran 1.0 ms"))?
  assertEqual(phaseSentence([]), "")?
  Ok(())
}

test fn saysHowARequestEnded() -> Result<Unit, Error> {
  assertEqual(requestStatus(aRequest(1, [])), "200")?
  assertEqual(requestLatency(aRequest(1, [])), "18.0 ms")?
  assertEqual(requestStatus(aRequest(2, [], outcome: "error", status: Some(504), reason: "deadline")), "504 deadline")?
  assertEqual(requestStatus(aRequest(3, [], outcome: "rejected", status: Some(429), reason: "queue_full")), "429 rejected: queue_full")?
  let flying = aRequest(4, [], outcome: "in_flight", status: None, endedUs: None)
  assertEqual(requestStatus(flying), "in flight")?
  assertEqual(requestLatency(flying), "90.0 ms so far")?
  Ok(())
}

test fn drawsALaneWithItsMarks() -> Result<Unit, Error> {
  let marks = html"{laneMarks(aRequest(7, parkedAndMoved()), 0, 100000, 0, 10, "2")}".render()
  // Three runs, a park in the app's colour, three waits.
  assertEqual(marks.split("<rect class=\"tl-c2\"").length() - 1, 3)?
  assert(marks.contains("<line class=\"tl-park tl-l2\""))?
  assertEqual(marks.split("<line class=tl-wait").length() - 1, 3)?
  // One move, one yield, and an answer has no end mark.
  assertEqual(marks.split("class=tl-moved").length() - 1, 1)?
  assertEqual(marks.split("class=tl-yield").length() - 1, 1)?
  assert(!marks.contains("tl-crit"))?
  let late = html"{laneMarks(aRequest(8, [], outcome: "error", status: Some(504), reason: "deadline"), 0, 100000, 0, 10, "0")}".render()
  assert(late.contains("class=tl-crit"))?
  let turned = html"{laneMarks(aRequest(9, [], outcome: "rejected", status: Some(429), reason: "queue_full"), 0, 100000, 0, 10, "0")}".render()
  assert(turned.contains("class=tl-rej"))?
  let gone = html"{laneMarks(aRequest(10, [], outcome: "error", status: Some(499), reason: "cancelled"), 0, 100000, 0, 10, "0")}".render()
  assert(gone.contains("class=tl-err"))?
  // A lane is the way to its request, and says what it is on hover.
  let one = lane("/x", aRequest(7, parkedAndMoved()), 0, 100000, 0, 10, "0").render()
  assert(one.contains("<a href=\"/x/requests/7\"><title>#7 slow: GET /slow/&lt;b&gt; — 200, 18.0 ms, 2 collections, 1.0 MiB allocated</title>"))?
  Ok(())
}

test fn saysWhatARequestsHeapCameTo() -> Result<Unit, Error> {
  assertEqual(heapSaid(aRequest(7, [])), ", 2 collections, 1.0 MiB allocated")?
  assertEqual(heapSaid(aRequest(7, [], gcCollections: Some(1))), ", 1 collection, 1.0 MiB allocated")?
  // A request that never ran has no heap to speak of.
  assertEqual(heapSaid(aRequest(9, [], outcome: "rejected", status: Some(429), gcCollections: None)), "")?
  assertEqual(knownAllocated(Some(128)), "1.0 KiB")?
  assertEqual(knownAllocated(None), "—")?
  Ok(())
}

test fn drawsAStripAsSteps() -> Result<Unit, Error> {
  // Two buckets across the plot: 1 of a top of 2, then 2.
  let path = stripPath([1000, 2000], 2000, 100, 40)
  assertEqual(path, "M64,100 L64,80 L514,80 L514,60 L964,60 L964,100 Z")?
  assertEqual(stripPath([], 1000, 100, 40), "M64,100 L964,100")?
  assertEqual(tenthsPercent(16), "1.6%")?
  assertEqual(tenthsPercent(1000), "100.0%")?
  assertEqual(wholeAbove(0), 1000)?
  assertEqual(wholeAbove(1500), 2000)?
  assertEqual(wholeAbove(3000), 3000)?
  Ok(())
}

/// Under `minicloud test` the timeline is empty: nothing in flight, no
/// request in the window, and no request kept.
test fn theTimelinePagesSayWhatTheyHaveNot() -> Result<Unit, Error> {
  let live = livePage("", asking(Map.of())).render()
  assert(live.contains("<h1>Live</h1>"))?
  assert(live.contains("<a href=\"/live\" aria-current=page>live</a>"))?
  assert(live.contains("<meta http-equiv=refresh content=\"2; url=/live\">"))?
  assert(live.contains("refreshing every 2 s · <a href=\"/live?refresh=off\">pause</a>"))?
  assert(live.contains("Nothing is in flight."))?
  assert(live.contains("<td class=title data-label=worker>#0</td>"))?
  assert(live.contains("<span class=\"state idle\">idle</span>"))?
  let page = timelinePage("", asking(Map.of(MapEntry(key: "over", value: "10s")))).render()
  assert(page.contains("<h1>Timeline</h1>"))?
  assert(page.contains("<a href=\"/timeline\" aria-current=page>timeline</a>"))?
  assert(page.contains("No request in the last 10 seconds"))?
  assert(page.contains("<b>the last 10 seconds</b>"))?
  assert(!page.contains("<svg class=timeline"))?
  assert(page.contains("<meta http-equiv=refresh content=\"5; url=/timeline?over=10s\">"))?
  let missing = requestAnswer("", "42")
  assertEqual(missing.status, 404)?
  assert(missing.body.contains("no request 42 in the timeline"))?
  assert(missing.body.contains("<h1>Request 42</h1>"))?
  let nan = requestAnswer("", "<b>")
  assertEqual(nan.status, 404)?
  assert(nan.body.contains("`&lt;b&gt;` is not a request&#39;s id"))?
  Ok(())
}

test fn showsARequestsPhasesAndWhatItCameTo() -> Result<Unit, Error> {
  let page = requestPage("", aRequest(7, parkedAndMoved())).render()
  assert(page.contains("<h1>Request 7</h1>"))?
  assert(page.contains("<a href=\"/timeline?app=slow&amp;over=1m\">timeline of slow</a>"))?
  assert(page.contains("resumed on #1 (moved), ran 1.0 ms"))?
  assert(page.contains("<span class=\"ph ph-park\">park</span> <span class=\"nums muted\">+3.0 ms</span> parked on timer.sleep 10.0 ms (answered)"))?
  assert(page.contains("<td class=nums>1234</td>"))?
  assert(page.contains("<tr><th>collections</th><td class=nums>2</td></tr>"))?
  assert(page.contains("<tr><th>allocated</th><td class=nums>1.0 MiB <span class=muted>(131072 words, reuse counted each time)</span></td></tr>"))?
  assert(page.contains("<svg class=timeline"))?
  let turned = requestPage("", aRequest(9, [], outcome: "rejected", status: Some(429), reason: "queue_full")).render()
  assert(turned.contains("No phases"))?
  Ok(())
}

// ---------------------------------------------------------------- load

fn aLoadRun(
  state: String = "running",
  rate: Int = 0,
  notDeployed: Array<String> = [],
  p50Us: Option<Int> = Some(1500),
) -> host.LoadRun {
  host.LoadRun(
    mix: "mixed",
    rate: rate,
    connections: 4,
    seconds: 10,
    state: state,
    startedUnixMs: 1700000000000,
    elapsedMs: 2345,
    sent: 120,
    answered: 117,
    ok: 100,
    clientErrors: 3,
    tooMany: 7,
    unavailable: 2,
    serverErrors: 4,
    other: 1,
    errors: 3,
    p50Us: p50Us,
    p99Us: None,
    targets: Vector.of("hello", "crunch", "slow").freeze(),
    notDeployed: notDeployed,
  )
}

fn aLoadStatus(current: Option<host.LoadRun>, last: Option<host.LoadRun>) -> host.LoadStatus {
  host.LoadStatus(
    running: current.isSome(),
    current: current,
    last: last,
    maxRate: 500,
    maxConnections: 64,
    maxSeconds: 60,
  )
}

test fn saysHowALoadRunSends() -> Result<Unit, Error> {
  assertEqual(loadMode(0, 8), "closed loop on 8 connections")?
  assertEqual(loadMode(50, 2), "50 requests a second on up to 2 connections")?
  assertEqual(loadSeconds(2345), "2.3 s")?
  assertEqual(loadSeconds(60000), "60.0 s")?
  assertEqual(loadLatency(Some(1500)), "1.5 ms")?
  assertEqual(loadLatency(None), "–")?
  assertEqual(",".join(loadMixes()), "light,cpu,wait,alloc,mixed")?
  assert(loadMixSaid("/admin", "alloc").render().contains("<a href=\"/admin/platform\">Platform</a>"))?
  assert(loadMixSaid("", "wait").render().contains("<code>slow</code>"))?
  assertEqual(loadMixSaid("", "<b>").render(), "<code>&lt;b&gt;</code>")?
  Ok(())
}

test fn readsTheLoadFormsFigures() -> Result<Unit, Error> {
  let form = text.parseForm("rate=+20+&connections=x&seconds=")
  assertEqual(loadNumber(form, "rate").unwrapOr(-1), 20)?
  assert(loadNumber(form, "connections").isError())?
  assert(loadNumber(form, "missing").isError())?
  match loadNumber(form, "connections") {
    Ok(_) => assert(false)?
    Err(why) => assertEqual(why, "connections is a whole number, not “x”")?
  }
  assertEqual(loadField(form, "mix", "light"), "light")?
  Ok(())
}

/// Under `minicloud test` there is no host: nothing has run, and a start is
/// refused with the form as it was posted.
test fn theLoadPageWithNoHost() -> Result<Unit, Error> {
  let page = loadPage("", host.loadStatus(), html"", Map.of()).render()
  assert(!page.contains("class=reload"))?
  assert(page.contains("<h1>Load</h1>"))?
  assert(page.contains("<a href=\"/load\" aria-current=page>load</a>"))?
  assert(page.contains("No load has been run since the host started."))?
  assert(!page.contains("http-equiv"))?
  assert(page.contains("<option value=\"light\" selected>light</option>"))?
  assert(page.contains("<input id=connections name=connections value=\"8\""))?
  assert(page.contains("at most 500"))?
  assert(page.contains("<a href=\"/timeline?over=1m\">"))?
  assert(page.contains("<form method=post action=\"/load/start\">"))?
  assert(!page.contains("/load/stop"))?
  let wrong = changeLoad("", "start", text.parseForm("mix=cpu&rate=fast&connections=2&seconds=5"))
  assertEqual(wrong.status, 422)?
  assert(wrong.body.contains("rate is a whole number, not “fast”"))?
  assert(wrong.body.contains("<option value=\"cpu\" selected>cpu</option>"))?
  let refused = changeLoad("", "start", text.parseForm("mix=cpu&rate=0&connections=2&seconds=5"))
  assertEqual(refused.status, 422)?
  assert(refused.body.contains("there is no host to put load on"))?
  let stop = changeLoad("", "stop", Map.of())
  assertEqual(stop.status, 422)?
  assertEqual(changeLoad("", "bogus", Map.of()).status, 404)?
  Ok(())
}

test fn showsTheRunGoingOnWithTheWayToStopIt() -> Result<Unit, Error> {
  let running = aLoadStatus(Some(aLoadRun(notDeployed: Vector.of("slow").freeze())), Some(aLoadRun(state: "finished")))
  let page = loadPage("/admin", running, html"", Map.of()).render()
  assert(page.contains("<meta http-equiv=refresh content=\"2; url=/admin/load\">"))?
  assert(page.contains("<a href=\"/admin/load?refresh=off\">pause</a>"))?
  let still = loadPage("/admin", running, html"", Map.of(), true).render()
  assert(!still.contains("http-equiv"))?
  assert(still.contains("paused · <a href=\"/admin/load\">resume</a>"))?
  assert(page.contains("<h2>Running</h2>"))?
  assert(!page.contains("<h2>Last run</h2>"))?
  assert(page.contains("<form method=post action=\"/admin/load/stop\">"))?
  assert(page.contains("<span class=\"state running\">running</span> — 2.3 s of 10 s"))?
  assert(page.contains("closed loop on 4 connections"))?
  assert(page.contains("<li>target app <code>slow</code> is not deployed</li>"))?
  assert(page.contains("<div class=\"fig is-warn\">"))?
  assert(page.contains("7 × 429, 2 × 503"))?
  assert(page.contains("4 × 5xx, 3 unanswered"))?
  assert(page.contains("<span class=big>1.5 ms</span>"))?
  assert(page.contains("p50; p99 –"))?
  Ok(())
}

test fn showsTheLastRunWhenNoneIsGoingOn() -> Result<Unit, Error> {
  let done = aLoadStatus(None, Some(aLoadRun(state: "stopped", rate: 50, p50Us: None)))
  let page = loadPage("", done, html"", Map.of()).render()
  assert(!page.contains("http-equiv"))?
  assert(page.contains("<h2>Last run</h2>"))?
  assert(page.contains("<span class=\"state stopped\">stopped</span> — took 2.3 s"))?
  assert(page.contains("50 requests a second on up to 4 connections"))?
  assert(!page.contains("is not deployed"))?
  assert(!page.contains("/load/stop"))?
  Ok(())
}
