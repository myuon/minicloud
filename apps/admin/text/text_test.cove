test fn decodesForms() -> Result<Unit, Error> {
  let form = parseForm("name=GitHub+hooks&x=%3Cb%3E&u=%C3%A9%E3%81%82&eq=a%3Db=c&empty=")
  assertEqual(form.get("name").unwrapOr(""), "GitHub hooks")?
  assertEqual(form.get("x").unwrapOr(""), "<b>")?
  assertEqual(form.get("u").unwrapOr(""), "éあ")?
  assertEqual(form.get("eq").unwrapOr(""), "a=b=c")?
  assertEqual(form.get("empty").unwrapOr("missing"), "")?
  // Not UTF-8, and a stray percent: kept readable rather than refused.
  assertEqual(urlDecode("%FF%"), "{replacement()}%")?
  Ok(())
}

test fn encodesQueryValues() -> Result<Unit, Error> {
  assertEqual(urlEncode("plain-value_1.0~"), "plain-value_1.0~")?
  assertEqual(urlEncode("a b&c=d#e/f"), "a%20b%26c%3Dd%23e%2Ff")?
  // Every byte of a multi-byte character is written, none left alone.
  assertEqual(urlEncode("éあ"), "%C3%A9%E3%81%82")?
  assertEqual(urlEncode(""), "")?
  // What it writes, `urlDecode` reads back.
  assertEqual(urlDecode(urlEncode("a b&c=d#e/f")), "a b&c=d#e/f")?
  assertEqual(urlDecode(urlEncode("éあ")), "éあ")?
  Ok(())
}

test fn writesIsoTimes() -> Result<Unit, Error> {
  assertEqual(isoTime(0), "1970-01-01T00:00:00.000Z")?
  assertEqual(isoTime(951782400000), "2000-02-29T00:00:00.000Z")?
  assertEqual(isoTime(1791170989566), "2026-10-05T03:29:49.566Z")?
  Ok(())
}

test fn truncatesAtACharacterBoundary() -> Result<Unit, Error> {
  assertEqual(truncateBytes("aéb", 2), "a")?
  assertEqual(truncateBytes("aéb", 3), "aé")?
  assertEqual(truncateBytes("abc", 10), "abc")?
  Ok(())
}
