use std.web
use std.url
use host
use text
use std.html
use std.html.Html

// The request timeline: where each request waited, ran, parked and resumed,
// and what the workers were doing meanwhile. The host keeps it in memory —
// the last hour, at most 100,000 requests, a path without its query
// string — and a restart empties it (`host.timeline`, `host.request`,
// `host.live`). Three pages read it: what is in flight now (Live), a
// picture of a window of it (Timeline), and one request's phases in words.
//
// The picture is drawn as the edge example of Cove draws its own: worker
// swimlanes on top, a bar wherever a worker runs a request, coloured by its
// app; three small strips under them of workers running, runs parked on a
// host call and requests waiting for a worker; then one lane per request, in
// arrival order, on the same time axis — a bar where it ran, a thin line in
// its app's colour where it was parked, grey where it waited for a worker, a
// diamond where it resumed on another worker than the one before, a tick
// where it yielded, a red cross where its deadline answered 504. Colour is
// an app's identity and nothing else: a status is a mark.
//
// Every number is an `Int`: times are microseconds, and a coordinate is the
// time scaled across the picture's width with the division last.

// ---------------------------------------------------------------- live

/// How a request in flight is, in words: `parked` says on what.
fn liveState(state: String, op: String) -> String {
  if state == "waiting" {
    "waiting for a worker"
  } else if state == "running" {
    "running"
  } else if state == "parked" {
    "parked on {op}"
  } else if state == "resuming" {
    "answered, waiting for a worker to resume it"
  } else if state == "yielded" {
    "yielded, waiting for a worker to continue it"
  } else {
    state
  }
}

/// A worker by its number, or a dash for none.
fn workerName(worker: Int) -> String {
  if worker < 0 {
    return "–"
  }
  "#{worker}"
}

/// A request's id as the way to its phases.
fn requestLink(base: String, id: Int) -> Html {
  html"""<a href="{base}/requests/{id}"><code>{id}</code></a>"""
}

/// The requests in flight, oldest first.
fn liveTable(base: String, live: host.Live) -> Html {
  if live.requests.length() == 0 {
    return html"<p class=muted>None</p>"
  }
  var rows = Vector.of()
  for row in live.requests {
    rows.push(html"""
      <tr>
        <td class=title data-label=id>{requestLink(base, row.id)}</td>
        <td data-label=app><code>{row.app}</code></td>
        <td data-label=request><code>{row.method} {row.path}</code></td>
        <td data-label=state>{liveState(row.state, row.op)}</td>
        <td class=nums data-label=worker>{workerName(row.worker)}</td>
        <td class=nums data-label=elapsed>{millis(live.nowUs - row.arrivedUs)} ms</td>
        <td class=nums data-label="in this state">{millis(live.nowUs - row.sinceUs)} ms</td>
      </tr>
      """)
  }
  html"""
    <div class="scroll cardwrap">
      <table class=cards>
        <tr class=head>
          <th>id</th><th>app</th><th>request</th><th>state</th><th>worker</th>
          <th>elapsed</th><th>in this state</th>
        </tr>
        {rows.freeze()}
      </table>
    </div>
    """
}

/// What a worker is running, or that it is idle.
fn workerRun(base: String, worker: host.LiveWorker) -> Html {
  if worker.busy {
    html"""{requestLink(base, worker.id)} <code>{worker.app}</code> <code>{worker.method} {worker.path}</code>"""
  } else {
    html"<span class=muted>–</span>"
  }
}

/// Every worker, busy or idle, and what it runs.
fn workersTable(base: String, live: host.Live) -> Html {
  var rows = Vector.of()
  for worker in live.workers {
    let state = if worker.busy { "busy" } else { "idle" }
    let since = if worker.busy { "{millis(live.nowUs - worker.sinceUs)} ms" } else { "–" }
    rows.push(html"""
      <tr>
        <td class=title data-label=worker>#{worker.worker}</td>
        <td data-label=state>{badge(state)}</td>
        <td data-label=running>{workerRun(base, worker)}</td>
        <td class=nums data-label=for>{since}</td>
      </tr>
      """)
  }
  html"""
    <div class="scroll cardwrap">
      <table class=cards>
        <tr class=head><th>worker</th><th>state</th><th>running</th><th>for</th></tr>
        {rows.freeze()}
      </table>
    </div>
    """
}

/// The Live page: the requests in flight now and where each is, then each
/// worker and what it runs. It reloads itself every 2 seconds — a `<meta>`
/// refresh, which is HTML and no script.
fn livePage(base: String, request: web.Request) -> Html {
  let live = host.live()
  let reload = reloading("{base}/live", 2, paused(request))
  let listed = live.requests.length()
  let more = html.only(
    live.total > listed,
    html"<p class=muted>Oldest {listed} of {live.total} listed</p>",
  )
  layout(
    base,
    "live",
    "live",
    html"""
      <h1>Live</h1>
      {reload.control}
      <h2>In flight</h2>{liveTable(base, live)}{more}
      <h2>Workers</h2>{workersTable(base, live)}
      <p class=actions><a href="{base}/timeline">Open timeline</a></p>
      """,
    reload.seconds,
    reload.link,
  )
}

// ------------------------------------------------------------ timeline

/// The window a Timeline page shows: the last `over` up to now, which moves
/// with it (`live`), or a stretch of the past from `fromMs` to `untilMs`
/// (Unix milliseconds), which does not. `over` is `""` for a window of the
/// past; a live one's `fromMs` and `untilMs` are what the host answered for
/// it, and 0 before it has.
struct TlWindow {
  live: Bool
  over: String
  fromMs: Int
  untilMs: Int
}

/// The live window of `over`.
fn liveWindow(over: String) -> TlWindow {
  TlWindow(live: true, over: over, fromMs: 0, untilMs: 0)
}

/// A window of the past, at least [`tlLeast`] long.
fn pastWindow(fromMs: Int, untilMs: Int) -> TlWindow {
  let until = if untilMs - fromMs < tlLeast() { fromMs + tlLeast() } else { untilMs }
  TlWindow(live: false, over: "", fromMs: fromMs, untilMs: until)
}

/// The shortest window the page shows, in milliseconds: a zoom stops there.
fn tlLeast() -> Int {
  10
}

/// The live windows, shortest first.
fn timelineOvers() -> Array<String> {
  ["10s", "1m", "5m", "15m", "1h"]
}

/// Which live window `?over=` asks for, and a minute for anything else.
fn timelineWindow(request: web.Request) -> String {
  let asked = request.query.get("over").unwrapOr("").trim()
  if timelineOvers().contains(asked) {
    return asked
  }
  "1m"
}

/// A live window's seconds, as `host.timeline` takes them.
fn timelineSecs(over: String) -> Int {
  if over == "10s" {
    10
  } else if over == "5m" {
    300
  } else if over == "15m" {
    900
  } else if over == "1h" {
    3600
  } else {
    60
  }
}

/// What a live window is called in a sentence.
fn timelineSpan(over: String) -> String {
  if over == "10s" {
    "the last 10 seconds"
  } else if over == "5m" {
    "the last 5 minutes"
  } else if over == "15m" {
    "the last 15 minutes"
  } else if over == "1h" {
    "the last hour"
  } else {
    "the last minute"
  }
}

/// The shortest live window at least `spanMs` long, and the longest for a
/// span longer than them all: where a window that reaches now goes.
fn liveOver(spanMs: Int) -> String {
  for over in timelineOvers() {
    if timelineSecs(over) * 1000 >= spanMs {
      return over
    }
  }
  "1h"
}

/// A whole number of the query string, or `None` for none or not one.
fn queryInt(request: web.Request, key: String) -> Option<Int> {
  match Int.parse(request.query.get(key).unwrapOr("").trim()) {
    Ok(number) => Some(number)
    Err(_) => None
  }
}

/// The window a Timeline page asks for: `?from=&until=` (Unix
/// milliseconds), `?from=&span=` (seconds) or `?until=` alone (the `span`
/// before it) is a window of the past — a minute where no `span` says — and
/// anything else the live window of `?over=`.
fn timelineAsked(request: web.Request) -> TlWindow {
  let spanMs = match queryInt(request, "span") {
    Some(secs) => secs * 1000
    None => 60000
  }
  let until = queryInt(request, "until")
  match queryInt(request, "from") {
    Some(from) => pastWindow(from, until.unwrapOr(from + spanMs))
    None => match until {
      Some(end) => pastWindow(end - spanMs, end)
      None => liveWindow(timelineWindow(request))
    }
  }
}

/// The Timeline page of `app` (`""` for every app) over the live window
/// `over`.
fn timelineLink(base: String, app: String, over: String) -> String {
  if app == "" {
    return "{base}/timeline?over={over}"
  }
  "{base}/timeline?app={url.percentEncode(app)}&over={over}"
}

/// The Timeline page of `app` (`""` for every app) over `window`, live or
/// of the past.
fn windowLink(base: String, app: String, window: TlWindow) -> String {
  if window.live {
    return timelineLink(base, app, window.over)
  }
  let range = "from={window.fromMs}&until={window.untilMs}"
  if app == "" {
    return "{base}/timeline?{range}"
  }
  "{base}/timeline?app={url.percentEncode(app)}&{range}"
}

/// `window` moved by half its length, earlier (`toward` -1) or later (1):
/// held to start no earlier than `earliestMs`, and the live window of its
/// length where it would reach `nowMs`.
fn panned(window: TlWindow, toward: Int, nowMs: Int, earliestMs: Int) -> TlWindow {
  let span = window.untilMs - window.fromMs
  let moved = window.fromMs + toward * (span / 2)
  let from = if moved < earliestMs { earliestMs } else { moved }
  if from + span >= nowMs {
    return liveWindow(liveOver(span))
  }
  pastWindow(from, from + span)
}

/// `window` five times as long around its middle, at most all that is kept
/// (`earliestMs` to `nowMs`), and the live window of its length where it
/// would reach now; a live window is the next longer one. `None` past the
/// longest.
fn zoomedOut(window: TlWindow, nowMs: Int, earliestMs: Int) -> Option<TlWindow> {
  if window.live {
    let at = timelineOvers().indexOf(window.over).unwrapOr(0)
    return match timelineOvers().get(at + 1) {
      Some(longer) => Some(liveWindow(longer))
      None => None
    }
  }
  let wide = (window.untilMs - window.fromMs) * 5
  let kept = nowMs - earliestMs
  let span = if wide > kept { kept } else { wide }
  let centred = (window.fromMs + window.untilMs) / 2 - span / 2
  let from = if centred < earliestMs { earliestMs } else { centred }
  if from + span >= nowMs {
    return Some(liveWindow(liveOver(span)))
  }
  Some(pastWindow(from, from + span))
}

/// The window a fifth as long as `window` around the middle of its band
/// `band` of `bands`, held inside it and before `nowMs`, and at least
/// [`tlLeast`] long: what clicking that band of the picture opens.
fn zoomedIn(window: TlWindow, band: Int, bands: Int, nowMs: Int) -> TlWindow {
  let span = window.untilMs - window.fromMs
  let narrow = if span / 5 < tlLeast() { tlLeast() } else { span / 5 }
  let middle = window.fromMs + span * (2 * band + 1) / (2 * bands)
  let last = if window.untilMs < nowMs { window.untilMs } else { nowMs }
  var from = middle - narrow / 2
  if from + narrow > last {
    from = last - narrow
  }
  if from < window.fromMs {
    from = window.fromMs
  }
  pastWindow(from, from + narrow)
}

/// A window of the past from `fromMs` to `untilMs` with `pad` more on
/// either side: what a merged bar, or a request, opens.
fn around(fromMs: Int, untilMs: Int, pad: Int) -> TlWindow {
  pastWindow(fromMs - pad, untilMs + pad)
}

/// A length of time in words: `250 ms`, `2.5 s`, `5 min`, `1 h 30 min`.
fn lengthSaid(ms: Int) -> String {
  if ms < 1000 {
    "{ms} ms"
  } else if ms < 60000 && ms % 1000 == 0 {
    "{ms / 1000} s"
  } else if ms < 60000 {
    "{ms / 1000}.{ms % 1000 / 100} s"
  } else if ms < 3600000 && ms % 60000 == 0 {
    "{ms / 60000} min"
  } else if ms < 3600000 {
    "{ms / 60000} min {ms % 60000 / 1000} s"
  } else if ms % 3600000 == 0 {
    "{ms / 3600000} h"
  } else {
    "{ms / 3600000} h {ms % 3600000 / 60000} min"
  }
}

/// A time on the clock, JST: `10:14:03`, and `10:14:03.120` where the
/// window it is read in is shorter than 10 seconds (`spanUs`).
fn clockLabel(unixMs: Int, spanUs: Int) -> String {
  let at = jstTime(unixMs)
  if spanUs < 10000000 { at.toIsoTime() } else { toSecond(at) }
}

/// A time on the clock to the millisecond, JST: what a hover says.
fn clockMillis(unixMs: Int) -> String {
  clockLabel(unixMs, 0)
}

/// What a window is called in a sentence: `the last 5 minutes`, or its
/// date and times, JST: `2026-10-20 10:14:00 – 10:14:10 JST (10 s)`.
fn windowSaid(window: TlWindow) -> String {
  if window.live {
    return timelineSpan(window.over)
  }
  let spanUs = (window.untilMs - window.fromMs) * 1000
  let day = jstTime(window.fromMs).toIsoDate()
  "{day} {clockLabel(window.fromMs, spanUs)} – {clockLabel(window.untilMs, spanUs)} JST ({lengthSaid(window.untilMs - window.fromMs)})"
}

/// The live windows, the one shown marked: the row Metrics and Platform
/// carry, with this page's windows.
fn timelineSteps(base: String, app: String, shown: TlWindow) -> Html {
  var steps = Vector.of()
  for name in timelineOvers() {
    let label = timelineSpan(name)
    if shown.live && name == shown.over {
      steps.push(html"<b>{label}</b>")
    } else {
      steps.push(html"""<a href="{timelineLink(base, app, name)}">{label}</a>""")
    }
  }
  html"<p class=actions>{html.join(steps.freeze(), html" ")}</p>"
}

/// Moving the window, each a link: half a window earlier and later, five
/// times as wide, and back to now — those that would go nowhere left out:
/// no earlier than what is kept, no later than now.
fn timelineMoves(base: String, app: String, shown: TlWindow, nowMs: Int, earliestMs: Int) -> Html {
  var moves = Vector.of()
  if shown.fromMs > earliestMs {
    moves.push(html"""<a href="{windowLink(base, app, panned(shown, -1, nowMs, earliestMs))}">Earlier</a>""")
  }
  if !shown.live {
    moves.push(html"""<a href="{windowLink(base, app, panned(shown, 1, nowMs, earliestMs))}">Later</a>""")
  }
  match zoomedOut(shown, nowMs, earliestMs) {
    Some(wider) => moves.push(html"""<a href="{windowLink(base, app, wider)}">Zoom out</a>""")
    None => {}
  }
  if !shown.live {
    let now = liveWindow(liveOver(shown.untilMs - shown.fromMs))
    moves.push(html"""<a href="{windowLink(base, app, now)}">Now</a>""")
  }
  html"<p class=actions>{html.join(moves.freeze(), html" ")}</p>"
}

/// A window of the past does not reload — it would not change — and its
/// control says when it is (`said`), and is the way back to the live window
/// `live`.
fn pastReload(link: String, said: String, live: String) -> Reload {
  Reload(
    seconds: 0,
    link: link,
    control: html"""<p class=reload>{said} · <a href="{live}">Back to now</a></p>""",
  )
}

/// `all apps`, then every app with a request in the window: the one shown
/// filled. Each keeps the window.
fn timelineChips(base: String, apps: Array<String>, app: String, shown: TlWindow) -> Html {
  var out = Vector.of()
  out.push(html"""<a href="{windowLink(base, "", shown)}"{current(app == "")}>all apps</a>""")
  out.push(html.only(apps.length() > 0, html"<span class=sep></span>"))
  for name in apps {
    out.push(html"""<a href="{windowLink(base, name, shown)}"{current(name == app)}>{name}</a>""")
  }
  html"<nav class=pick><span class=lbl>app</span>{out.freeze()}</nav>"
}

/// Where `t` falls across `width`, for a window from `since` to `until`: 0
/// at its start, `width` at its end, and a time outside it at the edge it
/// is past. A window of no length is all at 0.
fn scaleX(t: Int, since: Int, until: Int, width: Int) -> Int {
  let span = until - since
  if span <= 0 {
    return 0
  }
  let at = if t < since { since } else if t > until { until } else { t }
  (at - since) * width / span
}

/// The picture's width, its left margin (the labels) and the width the
/// time axis takes, in the units of its `viewBox`.
fn tlWidth() -> Int {
  1000
}

fn tlLeft() -> Int {
  64
}

fn tlPlot() -> Int {
  900
}

/// `t` as an x in the picture.
fn tlX(t: Int, since: Int, until: Int) -> Int {
  tlLeft() + scaleX(t, since, until, tlPlot())
}

/// A tick's spacing for a span of `spanUs` with about `count` ticks: 1, 2
/// or 5 of a power of ten microseconds.
fn tickStep(spanUs: Int, count: Int) -> Int {
  let raw = if count > 0 { spanUs / count } else { spanUs }
  if raw < 1 {
    return 1
  }
  var magnitude = 1
  while magnitude * 10 <= raw {
    magnitude = magnitude * 10
  }
  for factor in [1, 2, 5] {
    if factor * magnitude >= raw {
      return factor * magnitude
    }
  }
  magnitude * 10
}

/// A tick's label: the time from the window's start, in milliseconds, or
/// in whole seconds where the ticks are whole seconds apart — every label
/// of an axis in one unit.
fn tickLabel(us: Int, step: Int) -> String {
  if step % 1000000 == 0 {
    return "{us / 1000000} s"
  }
  if step % 1000 == 0 {
    return "{us / 1000} ms"
  }
  "{millis(us)} ms"
}

/// How many colours there are before they begin again.
fn paletteSize() -> Int {
  10
}

/// An app's colour, `0` to `9` by its place in `order`, counting round again
/// past the tenth, and `x` (grey) for an app not in it. The class is
/// `tl-c<slot>` for a fill and `tl-l<slot>` for a line.
fn paletteSlot(order: Array<String>, app: String) -> String {
  match order.indexOf(app) {
    Some(at) => "{at % paletteSize()}"
    None => "x"
  }
}

/// The names of the apps the host has, or none where it cannot say.
fn deployedApps() -> Array<String> {
  var names = Vector.of()
  for app in host.apps() {
    names.push(app.name)
  }
  names.freeze()
}

/// The apps in the order their colours go: every deployed app by name, then
/// any other app the window has (one since removed) by name. It does not
/// depend on what the window holds, so an app keeps its colour from one
/// load to the next. With no `deployed` (the host cannot list them) it is
/// the window's apps by name, which is still the same each time.
fn colourOrder(deployed: Array<String>, seen: Array<String>) -> Array<String> {
  var order = Vector.of()
  for name in deployed.sorted(by: fn(a, b) { a < b }) {
    if !order.contains(name) {
      order.push(name)
    }
  }
  var others = Vector.of()
  for name in seen {
    if !order.contains(name) && !others.contains(name) {
      others.push(name)
    }
  }
  for name in others.freeze().sorted(by: fn(a, b) { a < b }) {
    order.push(name)
  }
  order.freeze()
}

/// [`colourOrder`] of the apps a window has.
fn timelineOrder(deployed: Array<String>, timeline: host.Timeline) -> Array<String> {
  var seen = Vector.of()
  for app in timeline.apps {
    seen.push(app.app)
  }
  for lane in timeline.lanes {
    seen.push(lane.app)
  }
  for segment in timeline.segments {
    seen.push(segment.app)
  }
  colourOrder(deployed, seen.freeze())
}

/// How a request ended, as a status and why: `in flight`, `200`,
/// `504 deadline`, `429 rejected: queue_full`.
fn requestStatus(request: host.TimelineRequest) -> String {
  let status = match request.status {
    Some(code) => "{code}"
    None => ""
  }
  if request.outcome == "in_flight" {
    "in flight"
  } else if request.outcome == "rejected" {
    "{status} rejected: {request.reason}"
  } else if request.reason != "" {
    "{status} {request.reason}"
  } else {
    status
  }
}

/// From arrival to answer, or to now while it is in flight.
fn requestLatency(request: host.TimelineRequest) -> String {
  match request.latencyUs {
    Some(us) => "{millis(us)} ms"
    None => "{millis(request.nowUs - request.arrivedUs)} ms so far"
  }
}

/// A small ink diamond centred at `x`, `y`: a run that resumed or
/// continued on another worker than the one before.
fn diamond(x: Int, y: Int, r: Int) -> Html {
  html"""<path class=tl-moved d="M{x},{y - r} L{x + r},{y} L{x},{y + r} L{x - r},{y} Z"/>"""
}

/// A short tick at `x`: where a run yielded at the end of its slice.
fn yieldTick(x: Int, y: Int, r: Int) -> Html {
  html"""<line class=tl-yield x1="{x}" y1="{y - r - 1}" x2="{x}" y2="{y + r + 1}"/>"""
}

/// The mark at the end of a request that did not end well: a red cross for
/// its deadline (504), a ring for another error of the host's, a square for
/// one turned away before it ran. Nothing for an answer or one in flight.
fn endMark(request: host.TimelineRequest, x: Int, y: Int, r: Int) -> Option<Html> {
  if request.reason == "deadline" {
    Some(html"""<path class=tl-crit d="M{x - r},{y - r} L{x + r},{y + r} M{x - r},{y + r} L{x + r},{y - r}"/>""")
  } else if request.outcome == "rejected" {
    Some(html"""<rect class=tl-rej x="{x - r}" y="{y - r}" width="{r * 2}" height="{r * 2}"/>""")
  } else if request.outcome == "error" {
    Some(html"""<circle class=tl-err cx="{x}" cy="{y}" r="{r}"/>""")
  } else {
    None
  }
}

/// One request's lane between `since` and `until`, `row` high from `top`:
/// grey where it waited, a bar where it ran, a line in its app's colour
/// where it was parked, and the marks over them.
fn laneMarks(request: host.TimelineRequest, since: Int, until: Int, top: Int, row: Int, slot: String) -> Array<Html> {
  var marks = Vector.of()
  var over = Vector.of()
  let mid = top + row / 2
  let bar = if row > 3 { row - 2 } else { row }
  let r = if row < 6 { 2 } else if row > 9 { 4 } else { row / 2 }
  for phase in request.phases {
    if phase.toUs < since || phase.fromUs > until {
      continue
    }
    let x0 = tlX(phase.fromUs, since, until)
    let x1 = tlX(phase.toUs, since, until)
    if phase.kind == "run" {
      let width = if x1 - x0 < 2 { 2 } else { x1 - x0 }
      marks.push(html"""<rect class="tl-c{slot}" x="{x0}" y="{mid - bar / 2}" width="{width}" height="{bar}"/>""")
      over.push(html.only(phase.moved, diamond(x0, mid, r)))
    } else if phase.kind == "park" {
      marks.push(html"""<line class="tl-park tl-l{slot}" x1="{x0}" y1="{mid}" x2="{x1}" y2="{mid}"/>""")
    } else {
      marks.push(html"""<line class=tl-wait x1="{x0}" y1="{mid}" x2="{x1}" y2="{mid}"/>""")
      over.push(html.only(phase.after == "yield", yieldTick(x0, mid, r)))
    }
  }
  match request.endedUs {
    Some(ended) => {
      if ended >= since && ended <= until {
        over.push(html"{endMark(request, tlX(ended, since, until), mid, r)}")
      }
    }
    None => {}
  }
  for mark in over {
    marks.push(mark)
  }
  marks.freeze()
}

/// What a lane says on hover: which request, how it ended, how long, and
/// when it arrived (JST).
fn laneTitle(request: host.TimelineRequest) -> String {
  "#{request.id} {request.app}: {request.method} {request.path} — {requestStatus(request)}, {requestLatency(request)}{heapSaid(request)}, arrived {clockMillis(request.startedUnixMs + request.arrivedUs / 1000)}"
}

/// What a request's heap came to, for a hover: its collections and what it
/// allocated, or nothing for a request that never ran.
fn heapSaid(request: host.TimelineRequest) -> String {
  match request.gcCollections {
    Some(collections) => {
      let gcs = if collections == 1 { "1 collection" } else { "{collections} collections" }
      ", {gcs}, {knownAllocated(request.allocatedWords)} allocated"
    }
    None => ""
  }
}

/// Words a run allocated as bytes, or a dash for a run the host has no
/// figure of.
fn knownAllocated(words: Option<Int>) -> String {
  match words {
    Some(n) => platformBytes(wordBytes(n))
    None => "—"
  }
}

/// A lane as the way to its request: the whole row is the link, and the
/// faint band under it is what a pointer finds.
fn lane(base: String, request: host.TimelineRequest, since: Int, until: Int, top: Int, row: Int, slot: String) -> Html {
  let end = match request.endedUs {
    Some(ended) => ended
    None => request.nowUs
  }
  let x0 = tlX(request.arrivedUs, since, until)
  let x1 = tlX(end, since, until)
  let width = if x1 - x0 < 4 { 4 } else { x1 - x0 }
  html"""
    <a href="{base}/requests/{request.id}"><title>{laneTitle(request)}</title><rect class=tl-hit x="{x0 - 2}" y="{top}" width="{width + 4}" height="{row}"/>{laneMarks(request, since, until, top, row, slot)}</a>
    """
}

/// A strip's outline: a step for each bucket, its value scaled so that
/// `top` is `height` above `base`, closed along the base so it can be
/// filled.
fn stripPath(values: Array<Int>, top: Int, base: Int, height: Int) -> String {
  let n = values.length()
  if n == 0 || top <= 0 {
    return "M{tlLeft()},{base} L{tlLeft() + tlPlot()},{base}"
  }
  var out = Vector.of("M{tlLeft()},{base}")
  var at = 0
  for value in values {
    let y = base - value * height / top
    out.push("L{tlLeft() + at * tlPlot() / n},{y}")
    out.push("L{tlLeft() + (at + 1) * tlPlot() / n},{y}")
    at = at + 1
  }
  out.push("L{tlLeft() + tlPlot()},{base} Z")
  " ".join(out.freeze())
}

/// The largest of `values`.
fn largestOf(values: Array<Int>) -> Int {
  metricsLargest(values, [])
}

/// A count in thousandths rounded up to a whole one, and at least one: the
/// top of a strip's scale.
fn wholeAbove(milli: Int) -> Int {
  let whole = (milli + 999) / 1000 * 1000
  if whole < 1000 { 1000 } else { whole }
}

/// One strip: its title, its scale at the left, and the means drawn as
/// steps over a light area.
fn strip(label: String, values: Array<Int>, top: Int, y: Int, height: Int) -> Html {
  let base = y + 18 + height
  html"""
    <text class=tl-head x="{tlLeft()}" y="{y + 12}">{label}, up to {thousandths(largestOf(values))}</text>
    <text x="{tlLeft() - 6}" y="{y + 22}" text-anchor=end>{top / 1000}</text>
    <text x="{tlLeft() - 6}" y="{base}" text-anchor=end>0</text>
    <line class=tl-base x1="{tlLeft()}" y1="{base}" x2="{tlLeft() + tlPlot()}" y2="{base}"/>
    <path class=tl-area d="{stripPath(values, top, base, height)}"/>
    """
}

/// The ticks of the time axis, as grid lines from `from` to `to` and a
/// label at each of `labelYs` — above the workers, and again above the
/// requests, which are far below them.
fn axis(since: Int, until: Int, from: Int, to: Int, labelYs: Array<Int>) -> Html {
  let span = until - since
  let step = tickStep(span, 6)
  var out = Vector.of()
  var at = 0
  while at <= span {
    let x = tlX(since + at, since, until)
    out.push(html"""<line class=tl-grid x1="{x}" y1="{from}" x2="{x}" y2="{to}"/>""")
    for y in labelYs {
      out.push(html"""<text x="{x}" y="{y}" text-anchor=middle>{tickLabel(at, step)}</text>""")
    }
    at = at + step
  }
  html"{out.freeze()}"
}

/// The spacing of a clock's ticks over `spanUs` with about `count` of them,
/// in microseconds: the least of the steps a clock is read in that does.
fn clockStep(spanUs: Int, count: Int) -> Int {
  for step in [1000, 2000, 5000, 10000, 20000, 50000, 100000, 200000, 500000, 1000000, 2000000, 5000000, 10000000, 15000000, 30000000, 60000000, 120000000, 300000000, 600000000, 900000000, 1800000000, 3600000000] {
    if step * count >= spanUs {
      return step
    }
  }
  3600000000
}

/// The ticks of the time axis of a window from `since` to `until` (the
/// host's microseconds, which began at `startedMs`), at whole steps of the
/// clock — :00, :15, :30, :45 for a quarter of an hour, JST — as grid lines
/// from `from` to `to` and the time at each of `labelYs`.
fn clockAxis(since: Int, until: Int, startedMs: Int, from: Int, to: Int, labelYs: Array<Int>) -> Html {
  let span = until - since
  let step = clockStep(span, 6)
  let origin = startedMs * 1000
  var out = Vector.of()
  var at = (origin + since + step - 1) / step * step - origin
  while at <= until {
    let x = tlX(at, since, until)
    out.push(html"""<line class=tl-grid x1="{x}" y1="{from}" x2="{x}" y2="{to}"/>""")
    for y in labelYs {
      out.push(html"""<text x="{x}" y="{y}" text-anchor=middle>{clockLabel((origin + at) / 1000, span)}</text>""")
    }
    at = at + step
  }
  html"{out.freeze()}"
}

/// How many bands the time axis is cut into, to zoom in.
fn tlBands() -> Int {
  10
}

/// The bands that zoom in: each a tenth of the time axis, over its labels
/// (at `labelYs`) and the strips (`top` to `bottom`), a link to a fifth of
/// `shown` around it. A pointer over one lights it.
fn zoomBands(base: String, app: String, shown: TlWindow, nowMs: Int, top: Int, bottom: Int, labelYs: Array<Int>) -> Html {
  let width = tlPlot() / tlBands()
  var out = Vector.of()
  var band = 0
  while band < tlBands() {
    let x = tlLeft() + band * tlPlot() / tlBands()
    let zoom = zoomedIn(shown, band, tlBands(), nowMs)
    let spanUs = (zoom.untilMs - zoom.fromMs) * 1000
    var rects = Vector.of()
    for y in labelYs {
      rects.push(html"""<rect class=tl-band x="{x}" y="{y - 12}" width="{width}" height="16"/>""")
    }
    rects.push(html"""<rect class=tl-band x="{x}" y="{top}" width="{width}" height="{bottom - top}"/>""")
    out.push(html"""<a href="{windowLink(base, app, zoom)}"><title>zoom in to {clockLabel(zoom.fromMs, spanUs)} – {clockLabel(zoom.untilMs, spanUs)}</title>{rects.freeze()}</a>""")
    band = band + 1
  }
  html"{out.freeze()}"
}

/// How many of a merged bar's runs each app's were: `hello 3200, crunch 2100`.
fn runsByApp(segment: host.WorkerRun) -> String {
  var parts = Vector.of()
  for app in segment.apps {
    parts.push("{app.app} {app.runs}")
  }
  ", ".join(parts.freeze())
}

/// What a worker's bar says on hover: one request's run, or the runs merged
/// into it — whose, and how much of it the worker was busy.
fn segmentTitle(segment: host.WorkerRun, startedMs: Int) -> String {
  let at = clockMillis(startedMs + segment.fromUs / 1000)
  let length = millis(segment.toUs - segment.fromUs)
  if segment.runs > 1 {
    return "{segment.runs} runs merged ({runsByApp(segment)}), busy {millis(segment.busyUs)} ms of {length} ms on worker #{segment.worker} from {at}"
  }
  "{segment.app} #{segment.id}, {length} ms on worker #{segment.worker} from {at}"
}

/// A merged bar's fill: its app's colour, or hatched for runs of more than
/// one app. The pattern is the `fill` the rect carries, which a colour's
/// class overrides.
fn segmentClass(segment: host.WorkerRun, order: Array<String>) -> String {
  if segment.apps.length() > 1 {
    return "tl-mix"
  }
  "tl-c{paletteSlot(order, segment.app)}"
}

/// One bar on a worker's lane, `height` high from `top`. A run of one
/// request is its app's colour, the way to the request. Runs merged — less
/// than a thousandth of the window apart, too close to draw apart — are a
/// faint band over their stretch with a bar in it as high as the worker was
/// busy, hatched where they are of several apps, the way to the stretch
/// zoomed in: never one solid bar that reads as one request holding it.
fn segmentBar(base: String, app: String, segment: host.WorkerRun, since: Int, until: Int, startedMs: Int, top: Int, height: Int, order: Array<String>) -> Html {
  let x0 = tlX(segment.fromUs, since, until)
  let x1 = tlX(segment.toUs, since, until)
  let width = if x1 - x0 < 2 { 2 } else { x1 - x0 }
  let title = segmentTitle(segment, startedMs)
  if segment.runs <= 1 {
    return html"""<a href="{base}/requests/{segment.id}"><rect class="tl-c{paletteSlot(order, segment.app)}" x="{x0}" y="{top}" width="{width}" height="{height}"><title>{title}</title></rect></a>"""
  }
  let busy = height * segment.occupancyMilli / 1000
  let tall = if busy < 2 { 2 } else { busy }
  let fromMs = startedMs + segment.fromUs / 1000
  let untilMs = startedMs + segment.toUs / 1000 + 1
  let pad = if (untilMs - fromMs) / 10 < 5 { 5 } else { (untilMs - fromMs) / 10 }
  html"""<a href="{windowLink(base, app, around(fromMs, untilMs, pad))}"><title>{title}</title><rect class=tl-span x="{x0}" y="{top}" width="{width}" height="{height}"/><rect class="{segmentClass(segment, order)}" fill="url(#tl-mix)" x="{x0}" y="{top + height - tall}" width="{width}" height="{tall}"/></a>"""
}

/// The hatching of runs of several apps merged, defined once in the
/// picture: a rect's `fill` names it.
fn mixPattern() -> Html {
  html"""<defs><pattern id=tl-mix width=6 height=6 patternUnits=userSpaceOnUse patternTransform="rotate(45)"><rect class=tl-mix-bg width=6 height=6 /><line class=tl-mix-ln x1=0 y1=0 x2=0 y2=6 /></pattern></defs>"""
}

/// The picture of a window: the workers, the three strips, the requests,
/// under a time axis of the clock (JST). A tenth of the axis or of the
/// strips is the way to a fifth of the window around it ([`zoomBands`]).
fn timelinePicture(base: String, app: String, timeline: host.Timeline, order: Array<String>, shown: TlWindow, nowMs: Int) -> Html {
  let since = timeline.sinceUs
  let until = timeline.untilUs
  let startedMs = timeline.startedUnixMs
  let workerLane = 20
  let workersTop = 42
  var y = workersTop + timeline.workers * workerLane + 6
  var workers = Vector.of()
  var w = 0
  while w < timeline.workers {
    let top = workersTop + w * workerLane
    workers.push(html"""
      <text x="{tlLeft() - 6}" y="{top + workerLane / 2 + 4}" text-anchor=end>#{w}</text>
      <line class=tl-base x1="{tlLeft()}" y1="{top + workerLane - 1}" x2="{tlLeft() + tlPlot()}" y2="{top + workerLane - 1}"/>
      """)
    w = w + 1
  }
  for segment in timeline.segments {
    workers.push(segmentBar(base, app, segment, since, until, startedMs, workersTop + segment.worker * workerLane + 3, workerLane - 6, order))
  }
  let stripsTop = y
  let each = "means over {millis(timeline.bucketUs)} ms"
  let runningHeight = if timeline.workers * 12 > 24 { timeline.workers * 12 } else { 24 }
  let running = strip(
    "Workers running, of {timeline.workers}; {each}",
    timeline.running,
    timeline.workers * 1000,
    y,
    runningHeight,
  )
  y = y + 18 + runningHeight + 8
  let parked = strip(
    "Runs parked on a host call",
    timeline.parked,
    wholeAbove(largestOf(timeline.parked)),
    y,
    30,
  )
  y = y + 18 + 30 + 8
  let waiting = strip(
    "Requests waiting for a worker",
    timeline.waiting,
    wholeAbove(largestOf(timeline.waiting)),
    y,
    30,
  )
  y = y + 18 + 30 + 8
  let requestsTop = y + 40
  let count = timeline.lanes.length()
  let fits = if count > 0 { 600 / count } else { 12 }
  let row = if fits < 4 { 4 } else if fits > 12 { 12 } else { fits }
  var lanes = Vector.of()
  var at = 0
  for request in timeline.lanes {
    lanes.push(lane(base, request, since, until, requestsTop + at * row, row, paletteSlot(order, request.app)))
    at = at + 1
  }
  let height = requestsTop + count * row + 8
  let labelYs = [12, requestsTop - 24]
  html"""
    <svg class=timeline viewBox="0 0 {tlWidth()} {height}" role=img aria-label="the workers and the requests over the window">
      {mixPattern()}
      {clockAxis(since, until, startedMs, 16, height - 4, labelYs)}
      <text class=tl-head x="{tlLeft()}" y="{workersTop - 8}">Workers</text>
      {workers.freeze()}
      {running}{parked}{waiting}
      {zoomBands(base, app, shown, nowMs, stripsTop, y - 8, labelYs)}
      <text class=tl-head x="{tlLeft()}" y="{requestsTop - 8}">Requests, in arrival order</text>
      <text x="{tlLeft() - 6}" y="{requestsTop + row}" text-anchor=end>first</text>
      <text x="{tlLeft() - 6}" y="{requestsTop + count * row}" text-anchor=end>last</text>
      {lanes.freeze()}
    </svg>
    """
}

/// An app's colour as a key: a swatch and its name.
fn appKey(slot: String, name: String) -> Html {
  html"""
    <span class=key>
      <svg width=12 height=12 viewBox="0 0 12 12" aria-hidden=true><rect class="tl-c{slot}" width=12 height=12 rx=2 /></svg>
      {name}
    </span>
    """
}

/// A mark as a key: `mark` drawn in a box 16 by 12, and what it means.
fn markKey(mark: Html, name: String) -> Html {
  html"""
    <span class=key>
      <svg width=16 height=12 viewBox="0 0 16 12" aria-hidden=true>{mark}</svg>
      {name}
    </span>
    """
}

/// What the colours and the marks are.
fn timelineLegend(order: Array<String>) -> Html {
  var keys = Vector.of()
  for app in order {
    keys.push(appKey(paletteSlot(order, app), app))
  }
  keys.push(markKey(
    html"""<rect class=tl-span width=16 height=12 /><rect class=tl-mix fill="url(#tl-mix)" y=5 width=16 height=7 />""",
    "runs merged; hatched for several apps",
  ))
  keys.push(markKey(html"<line class=tl-wait x1=0 y1=6 x2=16 y2=6 />", "waiting for a worker"))
  keys.push(markKey(html"<line class=\"tl-park tl-lx\" x1=0 y1=6 x2=16 y2=6 />", "parked (its app's colour)"))
  keys.push(markKey(diamond(8, 6, 4), "resumed on another worker"))
  keys.push(markKey(yieldTick(8, 6, 4), "yielded"))
  keys.push(markKey(html"<path class=tl-crit d=\"M4,2 L12,10 M4,10 L12,2\"/>", "504, its deadline"))
  keys.push(markKey(html"<circle class=tl-err cx=8 cy=6 r=4 />", "another error"))
  keys.push(markKey(html"<rect class=tl-rej x=4 y=2 width=8 height=8 />", "rejected"))
  html"<p class=legend>{keys.freeze()}</p>"
}

/// Each app's requests in the window: how many ended, how many of those
/// were errors or turned away, and how long the answered took.
fn timelineApps(base: String, timeline: host.Timeline, order: Array<String>, shown: TlWindow) -> Html {
  if timeline.apps.length() == 0 {
    return html"<p class=muted>None ended yet</p>"
  }
  var rows = Vector.of()
  for app in timeline.apps {
    rows.push(html"""
      <tr>
        <td class=title data-label=app><a href="{windowLink(base, app.app, shown)}">{appKey(paletteSlot(order, app.app), app.app)}</a></td>
        <td class=nums data-label=requests>{app.requests}</td>
        <td class=nums data-label=errors>{app.errors}</td>
        <td class=nums data-label=rejected>{app.rejected}</td>
        <td class=nums data-label="p50 (ms)">{millis(app.p50Us)}</td>
        <td class=nums data-label="p99 (ms)">{millis(app.p99Us)}</td>
      </tr>
      """)
  }
  html"""
    <div class="scroll cardwrap">
      <table class=cards>
        <tr class=head>
          <th>app</th><th>requests</th><th>errors</th><th>rejected</th><th>p50 (ms)</th><th>p99 (ms)</th>
        </tr>
        {rows.freeze()}
      </table>
    </div>
    """
}

/// Thousandths as a percentage with one decimal: a worker busy for 1.6% of
/// five minutes is not 0%.
fn tenthsPercent(milli: Int) -> String {
  "{milli / 10}.{milli % 10}%"
}

/// The figures of a window: requests, rejected, and how busy the workers
/// were.
fn timelineFigures(timeline: host.Timeline) -> Html {
  let rejected = if timeline.rejected > 0 { " is-warn" } else { "" }
  html"""
    <div class=strip>
      {platformFig("requests", "{timeline.requests}", "in the window, in flight included", "")}
      {platformFig("rejected", "{timeline.rejected}", "turned away before they ran", rejected)}
      {platformFig("workers busy", tenthsPercent(timeline.utilisationMilli), "of {timeline.workers} workers' time", pressure(timeline.utilisationMilli / 10))}
    </div>
    """
}

/// The window's answer of `app` (`""` for every app's).
fn timelineOf(app: String, window: TlWindow) -> host.Timeline {
  if window.live {
    host.timeline(app, timelineSecs(window.over))
  } else {
    host.timelineRange(app, window.fromMs, window.untilMs)
  }
}

/// The Timeline page: the picture of a window — the live `?over=` (10 s to
/// an hour), or one of the past, `?from=&until=` — of every app's requests
/// or `?app=`'s, then the figures and each app's. A live window reloads
/// every 5 seconds; one of the past does not.
fn timelinePage(base: String, request: web.Request) -> Html {
  let asked = timelineAsked(request)
  let app = request.query.get("app").unwrapOr("").trim()
  // Every app's window as well as the one asked for: its apps are the
  // chips, and their order is the colours, so an app is the same colour
  // whichever of them is shown.
  let all = timelineOf("", asked)
  let timeline = if app == "" { all } else { timelineOf(app, asked) }
  let order = timelineOrder(deployedApps(), all)
  let startedMs = all.startedUnixMs
  let nowMs = startedMs + all.nowUs / 1000
  let kept = nowMs - all.keepSecs * 1000
  let earliestMs = if kept < startedMs { startedMs } else { kept }
  // The window as the host held it: between its start and now.
  let shown = TlWindow(
    live: asked.live,
    over: asked.over,
    fromMs: startedMs + all.sinceUs / 1000,
    untilMs: startedMs + all.untilUs / 1000,
  )
  let link = windowLink(base, app, shown)
  let span = windowSaid(shown)
  let reload = if shown.live {
    reloading(link, 5, paused(request))
  } else {
    pastReload(link, span, windowLink(base, app, liveWindow(liveOver(shown.untilMs - shown.fromMs))))
  }
  let head = html"""
    <h1>Timeline</h1>
    {reload.control}
    {timelineChips(base, order, app, shown)}
    {timelineSteps(base, app, shown)}
    {timelineMoves(base, app, shown, nowMs, earliestMs)}
    """
  if timeline.requests == 0 {
    let whose = if app == "" { "" } else { " of {app}" }
    return layout(
      base,
      "timeline",
      "timeline",
      html"""
        {head}
        <p class=muted>No requests{whose} in {span}</p>
        """,
      reload.seconds,
      reload.link,
    )
  }
  let shownLanes = timeline.lanes.length()
  let newest = html.only(
    timeline.requests > shownLanes,
    html"<p class=muted>Newest {shownLanes} of {timeline.requests} shown</p>",
  )
  layout(
    base,
    "timeline",
    "timeline",
    html"""
      {head}
      {timelineFigures(timeline)}
      {timelineLegend(order)}
      {timelinePicture(base, app, timeline, order, shown, nowMs)}
      <p class=muted>Click the time axis or a strip to zoom in</p>
      {newest}
      <h2>Apps</h2>{timelineApps(base, timeline, order, shown)}
      """,
    reload.seconds,
    reload.link,
  )
}

// ---------------------------------------------------------- a request

/// How long a phase lasted, or has lasted so far.
fn phaseLength(phase: host.Phase) -> String {
  let length = "{millis(phase.toUs - phase.fromUs)} ms"
  if phase.open {
    return "{length} so far"
  }
  length
}

/// What ended a park.
fn parkEnd(phase: host.Phase) -> String {
  if phase.open {
    "still parked"
  } else if phase.by == "answer" {
    "answered"
  } else if phase.by == "deadline" {
    "the deadline"
  } else if phase.by == "cancel" {
    "cancelled"
  } else {
    "ended"
  }
}

/// One phase in words.
fn phaseWords(phase: host.Phase) -> String {
  let length = phaseLength(phase)
  if phase.kind == "wait" {
    if phase.after == "park" {
      "waited {length} for a worker to resume it"
    } else if phase.after == "yield" {
      "yielded, waited {length} for a worker to continue it"
    } else {
      "waited for a worker {length}"
    }
  } else if phase.kind == "park" {
    "parked on {phase.op} {length} ({parkEnd(phase)})"
  } else {
    let moved = if phase.moved { " (moved)" } else { "" }
    if phase.began == "resume" {
      "resumed on #{phase.worker}{moved}, ran {length}"
    } else if phase.began == "continue" {
      "continued on #{phase.worker}{moved}, ran {length}"
    } else {
      "ran {length} on worker #{phase.worker}"
    }
  }
}

/// The kind of a phase, as the badge in front of its words.
fn phaseBadge(kind: String) -> Html {
  html"""<span class="ph ph-{kind}">{kind}</span>"""
}

/// A request's phases, in order, each from its start after the arrival.
fn phaseList(request: host.TimelineRequest) -> Html {
  if request.phases.length() == 0 {
    return html"<p class=muted>None</p>"
  }
  var items = Vector.of()
  for phase in request.phases {
    items.push(html"""
      <li>{phaseBadge(phase.kind)} <span class="nums muted">+{millis(phase.fromUs - request.arrivedUs)} ms</span> {phaseWords(phase)}</li>
      """)
  }
  html"<ol class=phases>{items.freeze()}</ol>"
}

/// A number the host may not know, or a dash.
fn knownCount(count: Option<Int>) -> String {
  match count {
    Some(n) => "{n}"
    None => "—"
  }
}

/// The request alone, as one lane from its arrival to its end (or now).
fn requestPicture(request: host.TimelineRequest, slot: String) -> Html {
  let until = match request.endedUs {
    Some(ended) => ended
    None => request.nowUs
  }
  let since = request.arrivedUs
  html"""
    <svg class=timeline viewBox="0 0 {tlWidth()} 40" role=img aria-label="the request's phases">
      {axis(since, until, 16, 38, [12])}
      {laneMarks(request, since, until, 20, 14, slot)}
    </svg>
    """
}

/// The window of the past around `request`, from its arrival to its end
/// (or now) with half its length — at least a tenth of a second — on
/// either side: what "show on the timeline" opens.
fn requestWindow(request: host.TimelineRequest) -> TlWindow {
  let ended = match request.endedUs {
    Some(ended) => ended
    None => request.nowUs
  }
  let fromMs = request.startedUnixMs + request.arrivedUs / 1000
  let untilMs = request.startedUnixMs + ended / 1000 + 1
  let half = (untilMs - fromMs) / 2
  around(fromMs, untilMs, if half < 100 { 100 } else { half })
}

/// One request of the timeline: its phases, in words and drawn, and what
/// it came to.
fn requestPage(base: String, request: host.TimelineRequest) -> Html {
  let facts = html"""
    <div class="scroll narrow">
      <table class=facts>
        <tr><th>app</th><td><a href="{timelineLink(base, request.app, "1m")}"><code>{request.app}</code></a></td></tr>
        <tr><th>request</th><td><code>{request.method} {request.path}</code></td></tr>
        <tr><th>status</th><td>{requestStatus(request)}</td></tr>
        <tr><th>outcome</th><td>{request.outcome}</td></tr>
        <tr><th>latency</th><td class=nums>{requestLatency(request)}</td></tr>
        <tr><th>worker time</th><td class=nums>{millis(request.workerUs)} ms</td></tr>
        <tr><th>instructions</th><td class=nums>{knownCount(request.instructions)}</td></tr>
        <tr><th>heap words</th><td class=nums>{knownCount(request.heapWords)}</td></tr>
        <tr><th>collections</th><td class=nums>{knownCount(request.gcCollections)}</td></tr>
        <tr><th>allocated</th><td class=nums>{knownAllocated(request.allocatedWords)} <span class=muted>({knownCount(request.allocatedWords)} words)</span></td></tr>
        <tr><th>yields</th><td class=nums>{request.yields}</td></tr>
        <tr><th>parks</th><td class=nums>{request.parks}</td></tr>
        <tr><th>moves</th><td class=nums>{request.moves}</td></tr>
      </table>
    </div>
    """
  layout(
    base,
    "timeline",
    "request {request.id}",
    html"""
      <p class=crumb><a href="{timelineLink(base, request.app, "1m")}">timeline of {request.app}</a> / request</p>
      <h1>Request {request.id}</h1>
      <p class=sub><code>{request.method} {request.path}</code> · {requestStatus(request)} · {requestLatency(request)}</p>
      {requestPicture(request, paletteSlot(colourOrder(deployedApps(), [request.app]), request.app))}
      <p class=actions><a href="{windowLink(base, "", requestWindow(request))}">Show on timeline</a></p>
      <h2>Phases</h2>{phaseList(request)}
      <h2>What it came to</h2>{facts}
      """,
  )
}

/// `GET /requests/<id>`: the request's page, or a 404 that says why — an
/// id the timeline no longer keeps, or not a number at all.
fn requestAnswer(base: String, id: String) -> web.Response {
  let back = html"""<p class=actions><a href="{base}/timeline">Back to timeline</a></p>"""
  let number = match Int.parse(id) {
    Ok(number) => number
    Err(_) => return web.html(
      404,
      layout(base, "timeline", "request", html"<h1>Request</h1>{notRead(html"", "`{id}` is not a request's id", back)}"),
    ).withHeaders(pageHeaders())
  }
  match host.request(number) {
    Ok(request) => web.html(200, requestPage(base, request)).withHeaders(pageHeaders())
    Err(error) => web.html(
      404,
      layout(base, "timeline", "request {number}", html"<h1>Request {number}</h1>{notRead(html"", error.message, back)}"),
    ).withHeaders(pageHeaders())
  }
}
