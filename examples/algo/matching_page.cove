use matching
use matching.Graph
use matching.Matching
use matching.Certificate
use draw
use time
use std.html
use std.html.Html

// The matching page: the form, the examples, and the result — the summary,
// the graph drawn with the matching over it, and the table view.

/// One built-in input.
struct Example {
  name: String
  title: String
  graph: String
  /// The algorithm its link picks: `both` to compare.
  algorithm: String
}

fn matchingExamples() -> Array<Example> {
  [
    Example(
      name: "jobs",
      title: "five people, five jobs (a perfect matching)",
      graph: "# Who can do which job. A perfect matching exists: everyone gets one.\nann: cook clean\nbob: cook\ncat: clean drive\ndan: drive fix\neve: fix serve\n",
      algorithm: "",
    ),
    Example(
      name: "seminars",
      title: "three students, two seminars (Hall's condition fails)",
      graph: "# s1, s2 and s3 all want logic or algebra: two seats for three people,\n# so at most two of them get one. The maximum is 3 of 4, and König's\n# cover \{logic, algebra, s4\} — three vertices touching every edge — proves it.\nleft: s1 s2 s3 s4\nright: logic algebra topology geometry\ns1: logic algebra\ns2: logic algebra\ns3: logic algebra\ns4: algebra topology geometry\n",
      algorithm: "",
    ),
    Example(
      name: "greedy",
      title: "where the greedy choice is wrong (one augmenting path)",
      graph: "# Matching a–x first leaves b with nothing; the augmenting path\n# b–x–a–y moves a over, and both are matched.\na x\na y\nb x\n",
      algorithm: "",
    ),
    Example(
      name: "random",
      title: "random 14 × 14, 34 edges, seed 7 (drawn)",
      graph: "# A generated graph: left, right, edges, seed. Change the seed for\n# another graph; the same numbers are always the same graph.\nrandom 14 14 34 7\n",
      algorithm: "",
    ),
    Example(
      name: "large",
      title: "random 2000 × 2000, 12000 edges, seed 42 (not drawn)",
      graph: "random 2000 2000 12000 42\n",
      algorithm: "",
    ),
    Example(
      name: "heavy",
      title: "random 30000 × 30000, 300000 edges (augmenting is stopped by the deadline)",
      graph: "# Hopcroft–Karp finishes this in about a second. The simple algorithm\n# searches the whole graph again for most left vertices and is still\n# searching when the run's deadline passes: compare the two to see the\n# stop reason.\nrandom 30000 30000 300000 1\n",
      algorithm: "both",
    ),
  ]
}

/// The largest graph the page takes.
fn matchingBounds() -> matching.Bounds {
  matching.Bounds(vertices: 30000, edges: 300000)
}

/// The largest graph drawn: per side, and edges.
fn drawLimit() -> Int {
  40
}

fn algorithmName(key: String) -> String {
  if key == "augmenting" {
    "simple augmenting paths (Kuhn)"
  } else if key == "both" {
    "both, compared"
  } else {
    "Hopcroft–Karp"
  }
}

/// `GET` or `POST /matching`.
///
/// A `POST` runs the graph it carries and answers the page with the result;
/// `part=result`, posted or not, answers the result alone — what the page's
/// script asks for, and the way to run an example from a script of your
/// own (`?example=large&part=result`). A plain `GET` only fills the form —
/// with `?example=` or `?graph=` — and asks the page's script to run it, so
/// that what a heavy example costs, and why it stopped, is shown in the
/// page rather than instead of it.
fn matchingPage(base: String, fields: Map<String, String>, post: Bool) -> web.Response {
  let exampleName = fields.get("example").unwrapOr("")
  var input = fields.get("graph").unwrapOr("")
  var chosen = fields.contains("graph")
  for example in matchingExamples() {
    if example.name == exampleName {
      input = example.graph
      chosen = true
    }
  }
  if !chosen {
    input = matchingExamples().get(0).unwrapOr(Example(name: "", title: "", graph: "", algorithm: "")).graph
  }
  let algorithm = fields.get("algorithm").unwrapOr("hopcroft-karp")
  let part = fields.get("part").unwrapOr("") == "result"
  if post || part {
    let result = matchingResult(input, algorithm)
    if part {
      return web.html(200, result).withHeaders(pageHeaders())
    }
    return web.html(200, page(base, "matching", "Maximum bipartite matching", matchingForm(base, input, algorithm), resultSection(result))).withHeaders(pageHeaders())
  }
  let result = if chosen { pendingSection() } else { resultSection(html"<p class=muted>Pick an example, or write a graph and run it.</p>") }
  web.html(200, page(base, "matching", "Maximum bipartite matching", matchingForm(base, input, algorithm), result)).withHeaders(pageHeaders())
}

fn matchingForm(base: String, input: String, algorithm: String) -> Html {
  var examples = Vector.of()
  for example in matchingExamples() {
    let pick = html.only(example.algorithm != "", html"&amp;algorithm={example.algorithm}")
    examples.push(html"""
      <li><a href="{base}/matching?example={example.name}{pick}">{example.name}</a> —
        {example.title}</li>
      """)
  }
  var choices = Vector.of()
  for key in ["hopcroft-karp", "augmenting", "both"] {
    let checked = html.only(key == algorithm, html" checked")
    choices.push(html"<label><input type=radio name=algorithm value={key}{checked}> {algorithmName(key)}</label>")
  }
  html"""
    <form class=run method=post action="{base}/matching">
      <div>
        <label for=graph>Graph</label>
        <textarea id=graph name=graph spellcheck=false>{input}</textarea>
        <div class=buttons>
          <button type=submit>Run</button>
          <button type=button class=cancel hidden>Cancel</button>
        </div>
      </div>
      <div>
        <fieldset><legend>Algorithm</legend>{choices.freeze()}</fieldset>
        <fieldset><legend>Examples</legend><ul class=examples>{examples.freeze()}</ul></fieldset>
        <details class=note>
          <summary>Input format</summary>
          <pre>a x              an edge from left a to right x\n\
            b: x y z         edges from b\n\
            left: a b c      left vertices, in order (optional)\n\
            right: x y z     right vertices, in order (optional)\n\
            random 40 40 120 7\n                 a generated graph: left, right,\n                 edges, seed (the only line)\n\
            # a comment</pre>
          <p>At most {matchingBounds().vertices} vertices a side and {matchingBounds().edges} edges;
            a graph is drawn up to {drawLimit()} vertices a side.</p>
        </details>
      </div>
    </form>
    """
}

/// One algorithm's run: its answer and its time on the app's clock.
struct Timed {
  key: String
  found: Matching
  micros: Int
}

fn timed(key: String, graph: Graph) -> Timed {
  let started = time.nowMicros()
  let found = if key == "augmenting" { matching.augmenting(graph) } else { matching.hopcroftKarp(graph) }
  Timed(key: key, found: found, micros: time.nowMicros() - started)
}

fn matchingResult(input: String, algorithm: String) -> Html {
  let started = time.nowMicros()
  let parsed = matching.parse(input, matchingBounds())
  let graph = match parsed {
    matching.Parsed.Ok(graph) => graph
    matching.Parsed.Invalid(why) => return stopNote("Not run:", why)
  }
  let readMicros = time.nowMicros() - started
  var runs = Vector.of()
  if algorithm == "both" {
    runs.push(timed("hopcroft-karp", graph))
    runs.push(timed("augmenting", graph))
  } else {
    runs.push(timed(if algorithm == "augmenting" { "augmenting" } else { "hopcroft-karp" }, graph))
  }
  let all = runs.freeze()
  let first = all.get(0).unwrapOr(timed("hopcroft-karp", graph))
  let found = first.found
  let proof = matching.certify(graph, found)
  let n = graph.left.length()
  let m = graph.right.length()
  let verdict = if proof.proved {
    html"""
      <div class=ok data-proved=true><strong>Maximum: {found.size} pairs.</strong> König's vertex
        cover has {proof.coverSize} vertices and every one of the {grouped(graph.edges())} edges
        has an end in it, so no matching is larger.</div>
      """
  } else {
    html"""<div class=stop data-proved=false><strong>Not proved maximum.</strong> {", ".join(proof.problems.slice(0, 5))}</div>"""
  }
  var facts = Vector.of()
  facts.push(Fact(
    name: "graph",
    value: html"""
      {grouped(n)} left · {grouped(m)} right · {grouped(graph.edges())} edges
        (read in {showMicros(readMicros)})
      """,
  ))
  facts.push(Fact(
    name: "matching",
    value: html"""
      <strong>{grouped(found.size)}</strong> pairs · {grouped(n - found.size)} left and
        {grouped(m - found.size)} right vertices unmatched
      """,
  ))
  for one in all {
    let rounds = plural(one.found.rounds, if one.key == "augmenting" { "search" } else { "phase" })
    facts.push(Fact(
      name: algorithmName(one.key),
      value: html"""
        {grouped(one.found.size)} pairs in {showMicros(one.micros)} ·
          {grouped(one.found.scans)} edge scans · {rounds}
        """,
    ))
  }
  let agree = html.only(all.length() > 1, agreement(first, all.get(1).unwrapOr(first)))
  let picture = if n <= drawLimit() && m <= drawLimit() {
    drawMatching(graph, found, proof)
  } else {
    html"""
      <p class=muted>The graph has more than {drawLimit()} vertices on a side, so it is not drawn;
        the table lists the matching.</p>
      """
  }
  html"{verdict}{summary(facts.freeze())}{agree}{picture}{matchingTable(graph, found, proof)}"
}

/// What `second`'s run says of `first`'s: that the two found matchings of
/// the same size, and what share of the edges the faster examined — or that
/// they did not.
fn agreement(first: Timed, second: Timed) -> Html {
  if second.found.size == first.found.size {
    html"""
      <p class=note>The two agree on the size; the faster examined
        {ratio(first.found.scans, second.found.scans)} the edges.</p>
      """
  } else {
    html"<div class=stop><strong>The algorithms disagree:</strong> {second.found.size} against {first.found.size}.</div>"
  }
}

/// `small` as a share of `large`, in words.
fn ratio(small: Int, large: Int) -> String {
  if large == 0 {
    return "all"
  }
  let low = small.min(large)
  let high = small.max(large)
  "{(low.toFloat() / high.toFloat() * 100.0).format(1)}% of"
}

/// The graph as two columns, the matching over its edges, the cover marked.
fn drawMatching(graph: Graph, found: Matching, proof: Certificate) -> Html {
  let n = graph.left.length()
  let m = graph.right.length()
  let rows = n.max(m)
  let width = 640.0
  let legendHeight = 44.0
  let top = legendHeight + 16.0
  let step = 24.0
  let height = top + rows.toFloat() * step + 8.0
  let leftX = 200.0
  let rightX = 440.0
  let leftY = fn(u: Int) { top + (u.toFloat() + 0.5) * step + (rows - n).toFloat() * step / 2.0 }
  let rightY = fn(v: Int) { top + (v.toFloat() + 0.5) * step + (rows - m).toFloat() * step / 2.0 }
  var out = Vector.of()
  // The legend: each role's mark and name.
  let edgeSwatch = html"""<line x1="10" y1="16" x2="32" y2="16" stroke="{draw.muted()}" stroke-width="1.25"/>"""
  let matchedSwatch = html"""
    <line x1="10" y1="16" x2="32" y2="16" stroke="{draw.colour(0)}" stroke-width="3.5"
      stroke-linecap="round"/>
    """
  out.push(draw.legendEntry(10.0, 16.0, edgeSwatch, "edge"))
  out.push(html"""<g transform="translate(80 0)">{draw.legendEntry(10.0, 16.0, matchedSwatch, "matched edge")}</g>""")
  out.push(html"""
    <g transform="translate(200 0)">
      {vertexMark(21.0, 16.0, true, false)}
      {draw.label(38.0, 20.0, "start", "matched vertex")}
    </g>
    """)
  out.push(html"""
    <g transform="translate(330 0)">
      {vertexMark(21.0, 16.0, false, false)}
      {draw.label(38.0, 20.0, "start", "unmatched")}
    </g>
    """)
  out.push(html"""
    <g transform="translate(430 0)">
      {vertexMark(21.0, 16.0, true, true)}
      {draw.label(38.0, 20.0, "start", "in König's cover")}
    </g>
    """)
  out.push(draw.note(leftX, top - 6.0, "middle", "left"))
  out.push(draw.note(rightX, top - 6.0, "middle", "right"))
  // Edges first, the matched ones over the rest.
  var matched = Vector.of()
  var u = 0
  while u < n {
    var e = graph.start.get(u).unwrapOr(0)
    let end = graph.start.get(u + 1).unwrapOr(0)
    while e < end {
      let v = graph.adjacent.get(e).unwrapOr(0)
      let line = html"""x1="{draw.px(leftX)}" y1="{draw.px(leftY(u))}" x2="{draw.px(rightX)}" y2="{draw.px(rightY(v))}""""
      let tip = html"<title>{name(graph.left, u)} – {name(graph.right, v)}</title>"
      if found.partnerOfLeft.get(u).unwrapOr(-1) == v {
        matched.push(html"""
          <line class=matched {line} stroke="{draw.colour(0)}" stroke-width="3.5"
            stroke-linecap="round">{tip}</line>
          """)
      } else {
        out.push(html"""<line class=edge {line} stroke="{draw.muted()}" stroke-width="1.25">{tip}</line>""")
      }
      e += 1
    }
    u += 1
  }
  for line in matched {
    out.push(line)
  }
  u = 0
  while u < n {
    let y = leftY(u)
    let isMatched = found.partnerOfLeft.get(u).unwrapOr(-1) != -1
    out.push(html"""
      <g class=vertex data-side=left data-matched={isMatched}>
        <title>{name(graph.left, u)}</title>
        {vertexMark(leftX, y, isMatched, proof.coverLeft.get(u).unwrapOr(false))}
      </g>
      """)
    out.push(draw.label(leftX - 12.0, y + 4.0, "end", name(graph.left, u)))
    u += 1
  }
  var v = 0
  while v < m {
    let y = rightY(v)
    let isMatched = found.partnerOfRight.get(v).unwrapOr(-1) != -1
    out.push(html"""
      <g class=vertex data-side=right data-matched={isMatched}>
        <title>{name(graph.right, v)}</title>
        {vertexMark(rightX, y, isMatched, proof.coverRight.get(v).unwrapOr(false))}
      </g>
      """)
    out.push(draw.label(rightX + 12.0, y + 4.0, "start", name(graph.right, v)))
    v += 1
  }
  let label = "the graph: {n} left and {m} right vertices, {graph.edges()} edges, {found.size} matched"
  draw.chart(width, height, label, html"{out.freeze()}")
}

/// A vertex: filled when matched, hollow when not; a square when it is in
/// the cover, a circle otherwise — so neither is said by colour alone.
fn vertexMark(x: Float, y: Float, isMatched: Bool, inCover: Bool) -> Html {
  let fill = if isMatched { draw.colour(0) } else { draw.surface() }
  let stroke = if isMatched { draw.colour(0) } else { draw.secondary() }
  if inCover {
    html"""
      <rect x="{draw.px(x - 6.0)}" y="{draw.px(y - 6.0)}" width="12" height="12" fill="{fill}"
        stroke="{draw.colour(1)}" stroke-width="2.5"/>
      """
  } else {
    html"""
      <circle cx="{draw.px(x)}" cy="{draw.px(y)}" r="5.5" fill="{fill}" stroke="{stroke}"
        stroke-width="1.5"/>
      """
  }
}

fn name(names: Array<String>, at: Int) -> String {
  names.get(at).unwrapOr("#{at}")
}

/// The table view: the matched pairs, then who is left over and the cover.
fn matchingTable(graph: Graph, found: Matching, proof: Certificate) -> Html {
  let shown = 500
  var pairs = Vector.of()
  var freeLeft = Vector.of()
  var cover = Vector.of()
  var u = 0
  while u < graph.left.length() {
    let v = found.partnerOfLeft.get(u).unwrapOr(-1)
    if v == -1 {
      freeLeft.push(name(graph.left, u))
    } else if pairs.length() < shown {
      pairs.push(html"<tr><td>{name(graph.left, u)}</td><td>{name(graph.right, v)}</td></tr>")
    }
    if proof.coverLeft.get(u).unwrapOr(false) {
      cover.push(name(graph.left, u))
    }
    u += 1
  }
  var freeRight = Vector.of()
  var v = 0
  while v < graph.right.length() {
    if found.partnerOfRight.get(v).unwrapOr(-1) == -1 {
      freeRight.push(name(graph.right, v))
    }
    if proof.coverRight.get(v).unwrapOr(false) {
      cover.push(name(graph.right, v))
    }
    v += 1
  }
  let more = html.only(found.size > shown, html"<p class=note>The first {shown} of {grouped(found.size)} pairs.</p>")
  let listed = fn(names: Array<String>) {
    if names.length() == 0 {
      "none"
    } else if names.length() > 60 {
      "{" ".join(names.slice(0, 60))} … ({names.length()} in all)"
    } else {
      " ".join(names)
    }
  }
  html"""
    <details class=table>
      <summary>Table view: the {grouped(found.size)} matched pairs</summary>
      <table>
        <tr><th>left</th><th>right</th></tr>
        {pairs.freeze()}
      </table>
      {more}
      <dl class=meta>
        <dt>unmatched left</dt>
        <dd>{listed(freeLeft.freeze())}</dd>
        <dt>unmatched right</dt>
        <dd>{listed(freeRight.freeze())}</dd>
        <dt>König's cover</dt>
        <dd>{listed(cover.freeze())}</dd>
      </dl>
    </details>
    """
}

/// `count` and `noun`, plural when it is not one: `1 phase`, `3 phases`.
fn plural(count: Int, noun: String) -> String {
  if count == 1 {
    "1 {noun}"
  } else if noun.endsWith("h") {
    "{grouped(count)} {noun}es"
  } else {
    "{grouped(count)} {noun}s"
  }
}
