use std.html
use std.html.Html

// What every picture the playground draws shares, so they read as one
// system — the bench ledger's chart rules (`examples/ledger/chart`):
//
// - categorical colours in a fixed order, given out by a series' (or a
//   role's) place, never by its value;
// - text in neutral ink, never in a series colour;
// - identity never by colour alone: a second channel (width, shape, dash)
//   says the same thing, and a legend names each;
// - a hairline grid and axis, a light surface;
// - every picture has a table view beside it.
//
// Every piece is `Html`, an `html"…"` literal: a label or a name is a hole,
// so it is text in the picture whatever it holds.

/// The categorical colours, in the order they are given out.
export fn palette() -> Array<String> {
  ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#7c5cd6", "#3fb5c9", "#a1693f"]
}

/// Colour `index` of the palette, wrapping.
export fn colour(index: Int) -> String {
  let colours = palette()
  colours.get(index % colours.length()).unwrapOr("#2a78d6")
}

/// The background every picture is drawn on.
export fn surface() -> String {
  "#fcfcfb"
}

/// Text and labels.
export fn ink() -> String {
  "#0b0b0b"
}

/// Secondary text: axis values, notes.
export fn secondary() -> String {
  "#52514e"
}

/// A hairline, for the grid.
export fn grid() -> String {
  "#e1e0d9"
}

/// The axis, and a de-emphasised mark (an edge not chosen).
export fn muted() -> String {
  "#c3c2b7"
}

/// A coordinate, to a tenth of a pixel.
export fn px(value: Float) -> String {
  value.format(1)
}

/// An inline SVG of `width` × `height` on a surface background, around
/// `body`; `label` is what a screen reader says.
export fn chart(width: Float, height: Float, label: String, body: Html) -> Html {
  html"""
    <svg class=chart xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {px(width)} {px(height)}"
      width="{px(width)}" height="{px(height)}" role=img aria-label="{label}"
      font-family="system-ui,sans-serif" font-size="12">
      <rect width="100%" height="100%" fill="{surface()}"/>
      {body}
    </svg>
    """
}

/// Text in ink at `x`, `y`; `anchor` is `start`, `middle` or `end`.
export fn label(x: Float, y: Float, anchor: String, text: String) -> Html {
  html"""<text x="{px(x)}" y="{px(y)}" text-anchor={anchor} fill="{ink()}">{text}</text>"""
}

/// Text in the secondary ink, smaller.
export fn note(x: Float, y: Float, anchor: String, text: String) -> Html {
  html"""<text x="{px(x)}" y="{px(y)}" text-anchor={anchor} fill="{secondary()}" font-size="11">{text}</text>"""
}

/// The marker of series `index` centred on `x`, `y`: a circle, a square, a
/// diamond, a triangle, then round again — with a ring in the surface
/// colour so markers stay apart where they crowd.
export fn marker(index: Int, x: Float, y: Float, fill: String) -> Html {
  let ring = html"""stroke="{surface()}" stroke-width="2""""
  let shape = index % 4
  if shape == 0 {
    html"""<circle cx="{px(x)}" cy="{px(y)}" r="4.5" fill="{fill}" {ring}/>"""
  } else if shape == 1 {
    html"""<rect x="{px(x - 4.5)}" y="{px(y - 4.5)}" width="9" height="9" fill="{fill}" {ring}/>"""
  } else if shape == 2 {
    html"""<path d="M{px(x)} {px(y - 5.5)}L{px(x + 5.5)} {px(y)}L{px(x)} {px(y + 5.5)}L{px(x - 5.5)} {px(y)}Z" fill="{fill}" {ring}/>"""
  } else {
    html"""<path d="M{px(x)} {px(y - 5.5)}L{px(x + 5.5)} {px(y + 4.5)}L{px(x - 5.5)} {px(y + 4.5)}Z" fill="{fill}" {ring}/>"""
  }
}

/// A legend entry: `swatch` (SVG drawn around `x + 11`, `y`) and its name,
/// in ink. The width it takes is `legendSpan(name)`.
export fn legendEntry(x: Float, y: Float, swatch: Html, name: String) -> Html {
  html"""<g class=legend>{swatch}<text x="{px(x + 28.0)}" y="{px(y + 4.0)}" fill="{ink()}">{name}</text></g>"""
}

/// How wide a legend entry named `name` is.
export fn legendSpan(name: String) -> Float {
  40.0 + name.length().toFloat() * 6.6
}
