use web
use sat
use sat.Formula
use sat.Outcome
use sat.Verdict
use draw
use time
use std.html
use std.html.Html

// The SAT page: the form, the examples, and the result — the verdict and
// its check, the search's cost, the assignment drawn (a sudoku as its grid)
// and the table view.

/// One built-in formula.
struct SatExample {
  name: String
  title: String
  formula: String
  /// What is known about it, said beside the answer.
  known: String
  /// The decision budget its link fills in; 0 for the default.
  budget: Int
}

fn satExamples() -> Array<SatExample> {
  [
    SatExample(
      name: "tiny",
      title: "three variables, two clauses (satisfiable)",
      formula: "c (x1 or not x3) and (x2 or x3 or not x1)\np cnf 3 2\n1 -3 0\n2 3 -1 0\n",
      known: "satisfiable",
      budget: 0,
    ),
    SatExample(
      name: "contradiction",
      title: "every clause over two variables (unsatisfiable)",
      formula: "c Each of the four assignments of x1, x2 falsifies one clause.\np cnf 2 4\n1 2 0\n-1 2 0\n1 -2 0\n-1 -2 0\n",
      known: "unsatisfiable",
      budget: 0,
    ),
    SatExample(
      name: "pigeonhole",
      title: "6 pigeons, 5 holes (unsatisfiable, and hard for DPLL)",
      formula: "c Every pigeon in a hole, no two pigeons in one hole.\npigeonhole 6 5\n",
      known: "unsatisfiable: more pigeons than holes",
      budget: 0,
    ),
    SatExample(
      name: "random",
      title: "random 3-SAT, 60 variables, 256 clauses, seed 1 (near the threshold)",
      formula: "c 256 / 60 = 4.27 clauses a variable: near the 4.26 threshold, where\nc random 3-SAT is about as likely satisfiable as not: seed 1 is\nc satisfiable, seeds 2 and 3 are not. Change the seed.\nrandom 3 60 256 1\n",
      known: "",
      budget: 0,
    ),
    SatExample(
      name: "sudoku",
      title: "a 9 × 9 sudoku (729 variables, 12,018 clauses with the 30 givens)",
      formula: "c Row by row; `.` is an empty cell.\nsudoku 53..7....6..195....98....6.8...6...34..8.3..17...2...6.6....28....419..5....8..79\n",
      known: "satisfiable: the puzzle has one solution",
      budget: 0,
    ),
    SatExample(
      name: "hard",
      title: "8 pigeons, 7 holes (unsatisfiable; tens of thousands of decisions)",
      formula: "c No short proof exists in resolution, and DPLL is resolution: about\nc 33,000 decisions, each refuted.\npigeonhole 8 7\n",
      known: "unsatisfiable: more pigeons than holes",
      budget: 0,
    ),
    SatExample(
      name: "heavy",
      title: "10 pigeons, 9 holes (gives up at its decision budget)",
      formula: "c Unsatisfiable, but DPLL without learning has to try a number of\nc partial assignments exponential in the holes: 8 pigeons took about\nc 33,000 decisions, and 10 take far more than the 50,000 the example\nc allows. The search gives up, and the page says so; a budget large\nc enough to finish runs into the run's deadline instead.\npigeonhole 10 9\n",
      known: "unsatisfiable: more pigeons than holes",
      budget: 50000,
    ),
  ]
}

fn satBounds() -> sat.Bounds {
  sat.Bounds(variables: 5000, clauses: 50000, literals: 200000)
}

/// The decision budget when the form does not say.
fn defaultBudget() -> Int {
  1000000
}

/// `GET` or `POST /sat`, as `/matching` is.
fn satPage(base: String, fields: Map<String, String>, post: Bool) -> web.Response {
  let exampleName = fields.get("example").unwrapOr("")
  var input = fields.get("formula").unwrapOr("")
  var known = ""
  var exampleBudget = 0
  var chosen = fields.contains("formula")
  for example in satExamples() {
    if example.name == exampleName {
      input = example.formula
      known = example.known
      exampleBudget = example.budget
      chosen = true
    }
  }
  if !chosen {
    input = satExamples().get(0).unwrapOr(SatExample(name: "", title: "", formula: "", known: "", budget: 0)).formula
  }
  let budgetText = fields.get("budget").unwrapOr("")
  let budget = if budgetText != "" {
    Int.parse(budgetText).unwrapOr(-1)
  } else if exampleBudget > 0 {
    exampleBudget
  } else {
    defaultBudget()
  }
  let part = fields.get("part").unwrapOr("") == "result"
  let title = "Satisfiability (SAT)"
  if post || part {
    let result = satResult(input, budget, known)
    if part {
      return htmlResponse(200, result)
    }
    return htmlResponse(200, page(base, "sat", title, satForm(base, input, budget), resultSection(result)))
  }
  let result = if chosen { pendingSection() } else { resultSection(html"<p class=muted>Pick an example, or write a formula and run it.</p>") }
  htmlResponse(200, page(base, "sat", title, satForm(base, input, budget), result))
}

fn satForm(base: String, input: String, budget: Int) -> Html {
  var examples = Vector.of()
  for example in satExamples() {
    examples.push(html"""<li><a href="{base}/sat?example={example.name}">{example.name}</a> — {example.title}</li>""")
  }
  let shown = if budget < 0 { "" } else { "{budget}" }
  html"""
    <form class=run method=post action="{base}/sat">
      <div>
        <label for=formula>Formula (DIMACS CNF, or a generator)</label>
        <textarea id=formula name=formula spellcheck=false>{input}</textarea>
        <div class=buttons>
          <button type=submit>Run</button>
          <button type=button class=cancel hidden>Cancel</button>
        </div>
      </div>
      <div>
        <fieldset>
          <legend>Solver</legend>
          <p class=note>DPLL: unit propagation over two watched literals, pure literals at the root,
            the variable in the most clauses first, chronological backtracking, no clause
            learning.</p>
          <label>Decision budget <input type=number name=budget min=1 max=100000000 value="{shown}"></label>
        </fieldset>
        <fieldset><legend>Examples</legend><ul class=examples>{examples.freeze()}</ul></fieldset>
        <details class=note>
          <summary>Input format</summary>
          <pre>c a comment\n\
            p cnf 3 2           variables, clauses (optional)\n\
            1 -3 0              a clause, ended by 0\n\
            2 3 -1 0\n\
            random 3 60 256 7   random 3-SAT: k, variables,\n                    clauses, seed\n\
            pigeonhole 6 5      pigeons, holes\n\
            sudoku 53..7....6.. 81 cells, row by row</pre>
          <p>At most {satBounds().variables} variables, {satBounds().clauses} clauses and
            {satBounds().literals} literals.</p>
        </details>
      </div>
    </form>
    """
}

fn satResult(input: String, budget: Int, known: String) -> Html {
  if budget < 1 || budget > 100000000 {
    return stopNote("Not run:", "the decision budget is a whole number from 1 to 100,000,000")
  }
  let started = time.nowMicros()
  let formula = match sat.read(input, satBounds()) {
    sat.Read.Ok(formula) => formula
    sat.Read.Invalid(why) => return stopNote("Not run:", why)
  }
  let readMicros = time.nowMicros() - started
  let solving = time.nowMicros()
  let outcome = sat.solve(formula, budget)
  let solveMicros = time.nowMicros() - solving
  let knownNote = if known == "" { "" } else { " Known: {known}." }
  let verdict = match outcome.verdict {
    Verdict.Satisfiable(values) => {
      let left = sat.unsatisfied(formula, values)
      if left == 0 {
        html"""
          <div class=ok data-verdict=sat data-checked=true><strong>Satisfiable.</strong> The
            assignment below satisfies every one of the {grouped(formula.clauses())} clauses,
            checked clause by clause.{knownNote}</div>
          """
      } else {
        html"""
          <div class=stop data-verdict=sat data-checked=false><strong>The solver's assignment
            leaves {left} clause(s) unsatisfied.</strong></div>
          """
      }
    }
    Verdict.Unsatisfiable => html"""
      <div class=ok data-verdict=unsat><strong>Unsatisfiable.</strong> The search tried both
        values of every decision and each ended in a conflict ({grouped(outcome.conflicts)}
        conflicts).{knownNote}</div>
      """
    Verdict.GaveUp => html"""
      <div class="stop limit" data-verdict=unknown data-stop=app><strong>Unknown: the search gave
        up</strong> after its budget of {grouped(budget)} decisions, before an answer. Raise the
        budget, up to what the run's deadline allows.{knownNote}</div>
      """
  }
  var facts = Vector.of()
  facts.push(Fact(
    name: "formula",
    value: html"""
      {formula.origin} · {grouped(formula.variables)} variables · {grouped(formula.clauses())}
        clauses · {grouped(formula.literals.length())} literals (read in {showMicros(readMicros)})
      """,
  ))
  if formula.declaredClauses >= 0 && formula.declaredClauses != formula.clauses() {
    facts.push(Fact(
      name: "note",
      value: html"""
        the problem line says {grouped(formula.declaredClauses)} clauses;
          {grouped(formula.clauses())} were read (tautologies are dropped)
        """,
    ))
  }
  facts.push(Fact(
    name: "search",
    value: html"""
      {showMicros(solveMicros)} · {plural(outcome.decisions, "decision")} ·
        {plural(outcome.conflicts, "conflict")} · {plural(outcome.propagations, "propagation")} ·
        deepest {grouped(outcome.depth)} · {plural(outcome.pure, "pure literal")} at the root
      """,
  ))
  let picture = match outcome.verdict {
    Verdict.Satisfiable(values) => {
      if formula.givens.length() == 81 {
        drawSudoku(formula.givens, values)
      } else {
        drawAssignment(values)
      }
    }
    _ => html""
  }
  html"{verdict}{summary(facts.freeze())}{picture}{satTable(formula, outcome)}"
}

/// The assignment as a grid of squares, variable 1 first: filled for true,
/// hollow for false.
fn drawAssignment(values: Array<Bool>) -> Html {
  let n = values.length()
  if n > 1000 {
    return html"<p class=muted>More than 1,000 variables, so the assignment is not drawn; the table view has it.</p>"
  }
  let columns = 40
  let size = 14.0
  let left = 40.0
  let top = 40.0
  let rows = (n + columns - 1) / columns
  let width = left + columns.toFloat() * size + 16.0
  let height = top + rows.toFloat() * size + 12.0
  var out = Vector.of()
  out.push(html"""
    <g transform="translate(0 0)">
      <rect x="14" y="10" width="11" height="11" fill="{draw.colour(0)}"/>
      {draw.label(32.0, 20.0, "start", "true")}
    </g>
    """)
  out.push(html"""
    <g transform="translate(80 0)">
      <rect x="14.5" y="10.5" width="10" height="10" fill="{draw.surface()}" stroke="{draw.secondary()}"/>
      {draw.label(32.0, 20.0, "start", "false")}
    </g>
    """)
  out.push(draw.note(220.0, 20.0, "start", "variable 1 top left, {columns} a row"))
  var v = 0
  while v < n {
    let x = left + (v % columns).toFloat() * size
    let y = top + (v / columns).toFloat() * size
    if v % columns == 0 {
      out.push(draw.note(left - 6.0, y + 10.0, "end", "{v + 1}"))
    }
    let truth = values.get(v).unwrapOr(false)
    let mark = if truth {
      html"""<rect x="{draw.px(x + 1.0)}" y="{draw.px(y + 1.0)}" width="12" height="12" fill="{draw.colour(0)}">"""
    } else {
      html"""
        <rect x="{draw.px(x + 1.5)}" y="{draw.px(y + 1.5)}" width="11" height="11" fill="{draw.surface()}"
          stroke="{draw.secondary()}">
        """
    }
    out.push(html"{mark}<title>x{v + 1} = {truth}</title></rect>")
    v += 1
  }
  draw.chart(width, height, "the assignment of {n} variables", html"{out.freeze()}")
}

/// A solved sudoku: the givens in bold ink, the digits the solver found in
/// regular weight, the boxes ruled heavier.
fn drawSudoku(givens: Array<Int>, values: Array<Bool>) -> Html {
  let size = 36.0
  let left = 20.0
  let top = 44.0
  let width = left * 2.0 + 9.0 * size
  let height = top + 9.0 * size + 20.0
  var out = Vector.of()
  out.push(html"""<text x="20" y="24" fill="{draw.ink()}" font-weight="700">5</text>{draw.label(34.0, 24.0, "start", "given")}""")
  out.push(html"""<text x="100" y="24" fill="{draw.secondary()}">5</text>{draw.label(114.0, 24.0, "start", "found by the solver")}""")
  var cell = 0
  while cell < 81 {
    let r = cell / 9
    let c = cell % 9
    var digit = 0
    var d = 0
    while d < 9 {
      if values.get(9 * cell + d).unwrapOr(false) {
        digit = d + 1
      }
      d += 1
    }
    let x = left + c.toFloat() * size
    let y = top + r.toFloat() * size
    let given = givens.get(cell).unwrapOr(0) > 0
    let style = if given { html"""fill="{draw.ink()}" font-weight="700"""" } else { html"""fill="{draw.secondary()}"""" }
    out.push(html"""
      <rect x="{draw.px(x)}" y="{draw.px(y)}" width="{draw.px(size)}" height="{draw.px(size)}"
        fill="{draw.surface()}" stroke="{draw.muted()}"/>
      """)
    out.push(html"""
      <text class=cell data-given={given} x="{draw.px(x + size / 2.0)}" y="{draw.px(y + size / 2.0 + 6.0)}"
        text-anchor=middle font-size="18" {style}>{digit}</text>
      """)
    cell += 1
  }
  var k = 0
  while k <= 3 {
    let at = k.toFloat() * 3.0 * size
    out.push(html"""
      <line x1="{draw.px(left + at)}" y1="{draw.px(top)}" x2="{draw.px(left + at)}" y2="{draw.px(top + 9.0 * size)}"
        stroke="{draw.ink()}" stroke-width="2"/>
      """)
    out.push(html"""
      <line x1="{draw.px(left)}" y1="{draw.px(top + at)}" x2="{draw.px(left + 9.0 * size)}" y2="{draw.px(top + at)}"
        stroke="{draw.ink()}" stroke-width="2"/>
      """)
    k += 1
  }
  draw.chart(width, height, "the solved sudoku", html"{out.freeze()}")
}

/// The table view: the assignment as DIMACS's `v` line, and the formula as
/// it was read.
fn satTable(formula: Formula, outcome: Outcome) -> Html {
  let assignment = match outcome.verdict {
    Verdict.Satisfiable(values) => {
      var parts = Vector.of()
      var v = 0
      for truth in values {
        v += 1
        parts.push(if truth { "{v}" } else { "-{v}" })
      }
      html"""
        <details class=table open>
          <summary>Table view: the assignment</summary>
          <pre class=diag>v {" ".join(parts.freeze())} 0</pre>
        </details>
        """
    }
    Verdict.Unsatisfiable => html"<p class=note>s UNSATISFIABLE</p>"
    Verdict.GaveUp => html"<p class=note>s UNKNOWN</p>"
  }
  html"""
    {assignment}
    <details class=table>
      <summary>The formula as read (DIMACS, first 200 clauses)</summary>
      <pre class=diag>{sat.dimacs(formula, 200)}</pre>
    </details>
    """
}
