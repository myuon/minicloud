use std.web

/// Greets whoever `?name=` names, and reaches nothing outside the run.
///
/// `/echo` answers the request body back; `/big?bytes=` answers a body of
/// that many bytes (the response size limit is the host's to enforce);
/// `/spin` loops until the deadline the host grants each request passes.
export fn handle(request: web.Request) -> web.Response {
  if request.path == "/spin" {
    return spin()
  }
  if request.path == "/echo" {
    return web.text(200, request.body)
  }
  if request.path == "/big" {
    let bytes = Int.parse(request.query.get("bytes").unwrapOr("1024")).unwrapOr(0)
    return web.text(200, filler(bytes))
  }
  let name = request.query.get("name").unwrapOr("world")
  web.text(200, "Hello, {name}! ({request.method} {request.path})\n")
}

/// `bytes` bytes of `x`.
fn filler(bytes: Int) -> String {
  var parts = Vector.of()
  var written = 0
  while written < bytes {
    parts.push("x")
    written += 1
  }
  "".join(parts.freeze())
}

/// Counts for as long as the host lets it.
fn spin() -> web.Response {
  var turns = 0
  while turns >= 0 {
    turns += 1
  }
  web.text(200, "{turns}\n")
}
