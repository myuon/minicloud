use stats
use std.html
use std.html.Html

// A trend chart as inline SVG: one metric of one case across runs, one
// series per backend. Pure — the points are handed in.
//
// The rules it keeps:
//
// - **One y-axis**, in the metric's canonical unit, named on the axis. A
//   second metric is a second chart.
// - Series colours in a fixed order (`palette`), assigned by the series'
//   place in the list it is given — the caller keeps that list in one order
//   for every chart, so a backend keeps its colour. Each series also has its
//   own marker shape, so identity is never colour alone, and a legend when
//   there are two or more.
// - 2px lines with round joins, markers of 9px with a 2px ring in the
//   surface colour, whiskers from the least to the most repetition, a
//   hairline grid, and text in neutral ink, never in a series colour.
// - A run that did not measure a series is a **gap**: no marker, and the
//   line is broken there rather than drawn across.
// - Every marker has a `<title>` (the tooltip) and links to its run.

/// One measured point: a median and the range of the repetitions.
export struct Point {
  median: Float
  least: Float
  most: Float
  count: Int
  /// The tooltip.
  tip: String
  /// Where the marker links to.
  href: String
}

/// One series: a point for each x position, `None` where it was not
/// measured.
export struct Series {
  name: String
  points: Array<Option<Point>>
}

/// One x position: a run.
export struct Tick {
  label: String
  sub: String
  id: String
}

/// The categorical colours, in the order they are given out.
export fn palette() -> Array<String> {
  ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#7c5cd6", "#3fb5c9", "#a1693f"]
}

fn colourOf(index: Int) -> String {
  let colours = palette()
  colours.get(index % colours.length()).unwrapOr("#2a78d6")
}

fn surface() -> String {
  "#fcfcfb"
}

fn ink() -> String {
  "#0b0b0b"
}

fn secondary() -> String {
  "#52514e"
}

fn gridColour() -> String {
  "#e1e0d9"
}

fn axisColour() -> String {
  "#c3c2b7"
}

/// A coordinate, to a tenth of a pixel.
fn px(value: Float) -> String {
  value.format(1)
}

/// The value scale: the axis from `low` to `high`, and its ticks.
export struct Scale {
  low: Float
  high: Float
  step: Float
}

/// A scale whose ticks are round numbers (1, 2 or 5 times a power of ten)
/// covering `least` to `most`, about five of them.
export fn scale(least: Float, most: Float) -> Scale {
  var low = least
  var high = most
  if high <= low {
    // One value, or all equal: a band around it.
    let pad = if low == 0.0 { 1.0 } else { low.abs() * 0.1 }
    low = low - pad
    high = high + pad
  }
  let step = niceStep((high - low) / 5.0)
  var start = 0.0
  // The first tick at or below `low`, counted in whole steps from zero.
  match (low / step).toInt() {
    Ok(steps) => {
      start = steps.toFloat() * step
      if start > low {
        start = start - step
      }
    }
    Err(_) => {
      start = low
    }
  }
  var end = start
  while end < high {
    end = end + step
  }
  // A scale of values that cannot be negative does not dip below zero.
  if least >= 0.0 && start < 0.0 {
    start = 0.0
  }
  Scale(low: start, high: end, step: step)
}

/// 1, 2 or 5 times a power of ten, at least `raw`.
fn niceStep(raw: Float) -> Float {
  var power = 1.0
  while power * 10.0 <= raw {
    power = power * 10.0
  }
  while power > raw && power > 0.000000001 {
    power = power / 10.0
  }
  let fraction = raw / power
  if fraction <= 1.0 {
    power
  } else if fraction <= 2.0 {
    power * 2.0
  } else if fraction <= 5.0 {
    power * 5.0
  } else {
    power * 10.0
  }
}

/// The marker of series `index`, centred on `x`, `y`: a circle, a square,
/// a diamond, a triangle, then round again.
fn marker(index: Int, x: Float, y: Float, colour: String) -> Html {
  let ring = html"""stroke="{surface()}" stroke-width="2""""
  let shape = index % 4
  if shape == 0 {
    html"""<circle cx="{px(x)}" cy="{px(y)}" r="4.5" fill="{colour}" {ring}/>"""
  } else if shape == 1 {
    html"""<rect x="{px(x - 4.5)}" y="{px(y - 4.5)}" width="9" height="9" fill="{colour}" {ring}/>"""
  } else if shape == 2 {
    html"""<path d="M{px(x)} {px(y - 5.5)}L{px(x + 5.5)} {px(y)}L{px(x)} {px(y + 5.5)}L{px(x - 5.5)} {px(y)}Z" fill="{colour}" {ring}/>"""
  } else {
    html"""<path d="M{px(x)} {px(y - 5.5)}L{px(x + 5.5)} {px(y + 4.5)}L{px(x - 5.5)} {px(y + 4.5)}Z" fill="{colour}" {ring}/>"""
  }
}

/// How many rows the legend of `series` takes in `width`.
fn legendRows(series: Array<Series>, width: Float) -> Int {
  if series.length() < 2 {
    return 0
  }
  var rows = 1
  var x = 84.0
  for one in series {
    let span = 40.0 + one.name.length().toFloat() * 7.0
    if x + span > width && x > 84.0 {
      rows += 1
      x = 84.0
    }
    x = x + span
  }
  rows
}

/// The legend: each series' marker and line beside its name, in ink,
/// wrapping onto more rows when it does not fit.
fn legend(series: Array<Series>, width: Float) -> Html {
  if series.length() < 2 {
    return html""
  }
  var parts = Vector.of()
  var x = 84.0
  var y = 12.0
  var index = 0
  for one in series {
    let colour = colourOf(index)
    let span = 40.0 + one.name.length().toFloat() * 7.0
    if x + span > width && x > 84.0 {
      x = 84.0
      y = y + 18.0
    }
    parts.push(
      html"""
        <g class=legend data-series="{one.name}">
          <line x1="{px(x)}" y1="{px(y)}" x2="{px(x + 22.0)}" y2="{px(y)}" stroke="{colour}" stroke-width="2" stroke-linecap="round"/>
          {marker(index, x + 11.0, y, colour)}
          <text x="{px(x + 28.0)}" y="{px(y + 4.0)}" fill="{ink()}">{one.name}</text>
        </g>
        """,
    )
    x = x + span
    index += 1
  }
  html"{parts.freeze()}"
}

/// The chart: `ticks` along the bottom, `series` over them, values in
/// `unit` on the one y-axis named `title`.
export fn trend(title: String, unit: String, ticks: Array<Tick>, series: Array<Series>) -> Html {
  let width = 760.0
  let height = 300.0 + 18.0 * legendRows(series, width).toFloat()
  let left = 84.0
  let right = 20.0
  let top = 16.0 + 18.0 * legendRows(series, width).toFloat()
  let bottom = 56.0
  let plotWidth = width - left - right
  let plotHeight = height - top - bottom
  // The range every whisker spans.
  var least = 0.0
  var most = 0.0
  var any = false
  for one in series {
    for slot in one.points {
      match slot {
        Some(point) => {
          if !any {
            least = point.least
            most = point.most
            any = true
          } else {
            least = least.min(point.least)
            most = most.max(point.most)
          }
        }
        None => {}
      }
    }
  }
  let axis = scale(least, most)
  let count = ticks.length()
  let inset = 24.0
  let xAt = fn(index: Int) {
    if count <= 1 {
      left + plotWidth / 2.0
    } else {
      left + inset + index.toFloat() * (plotWidth - 2.0 * inset) / (count - 1).toFloat()
    }
  }
  let yAt = fn(value: Float) {
    top + plotHeight - (value - axis.low) / (axis.high - axis.low) * plotHeight
  }
  var out = Vector.of()
  out.push(
    html"""
      <svg class=chart xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {px(width)} {px(height)}" width="{px(width)}" height="{px(height)}"
        role=img aria-label="{title} in {unit}, by run" font-family="system-ui,sans-serif" font-size="12">
      <rect width="100%" height="100%" fill="{surface()}"/>
      """,
  )
  out.push(legend(series, width))
  // The grid and the y-axis labels.
  var value = axis.low
  var guard = 0
  while value <= axis.high + axis.step / 1000.0 && guard < 50 {
    let y = yAt(value)
    out.push(html"""<line x1="{px(left)}" y1="{px(y)}" x2="{px(width - right)}" y2="{px(y)}" stroke="{gridColour()}" stroke-width="1"/>""")
    out.push(html"""<text x="{px(left - 8.0)}" y="{px(y + 4.0)}" text-anchor=end fill="{secondary()}">{stats.show(value)}</text>""")
    value = value + axis.step
    guard += 1
  }
  out.push(
    html"""<line x1="{px(left)}" y1="{px(top + plotHeight)}" x2="{px(width - right)}" y2="{px(top + plotHeight)}" stroke="{axisColour()}" stroke-width="1"/>""",
  )
  out.push(
    html"""<text transform="translate(14 {px(top + plotHeight / 2.0)}) rotate(-90)" text-anchor=middle fill="{ink()}">{title} ({unit})</text>""",
  )
  // The x labels: every one, or every few when they would collide.
  let every = if count > 12 { (count + 11) / 12 } else { 1 }
  var index = 0
  for tick in ticks {
    if index % every == 0 || index == count - 1 {
      let x = xAt(index)
      out.push(html"""<text x="{px(x)}" y="{px(top + plotHeight + 18.0)}" text-anchor=middle fill="{ink()}">{tick.label}</text>""")
      out.push(
        html"""<text x="{px(x)}" y="{px(top + plotHeight + 33.0)}" text-anchor=middle fill="{secondary()}" font-size="11">{tick.sub}</text>""",
      )
    }
    index += 1
  }
  out.push(
    html"""
      <text x="{px(left + plotWidth / 2.0)}" y="{px(height - 4.0)}" text-anchor=middle fill="{secondary()}" font-size="11">run, oldest measured first (commit, date)</text>
      """,
  )
  // Each series: whiskers, the line in pieces between gaps, the markers.
  var seriesIndex = 0
  for one in series {
    let colour = colourOf(seriesIndex)
    var segments = Vector.of()
    var current: Vector<String> = Vector.of()
    var marks = Vector.of()
    var position = 0
    for slot in one.points {
      match slot {
        Some(point) => {
          let x = xAt(position)
          let y = yAt(point.median)
          let tick = ticks.get(position).unwrapOr(Tick(label: "", sub: "", id: ""))
          current.push("{px(x)} {px(y)}")
          if point.most > point.least {
            marks.push(
              html"""
                <g class=whisker data-series="{one.name}" data-run="{tick.id}" data-least="{point.least}" data-most="{point.most}">
                  <line x1="{px(x)}" y1="{px(yAt(point.least))}" x2="{px(x)}" y2="{px(yAt(point.most))}" stroke="{colour}" stroke-width="1.5"/>
                  <line x1="{px(x - 4.0)}" y1="{px(yAt(point.least))}" x2="{px(x + 4.0)}" y2="{px(yAt(point.least))}" stroke="{colour}" stroke-width="1.5"/>
                  <line x1="{px(x - 4.0)}" y1="{px(yAt(point.most))}" x2="{px(x + 4.0)}" y2="{px(yAt(point.most))}" stroke="{colour}" stroke-width="1.5"/>
                </g>
                """,
            )
          }
          marks.push(
            html"""
              <a href="{point.href}">
                <g class=point data-series="{one.name}" data-run="{tick.id}" data-median="{point.median}">
                  <title>{point.tip}</title>
                  <circle cx="{px(x)}" cy="{px(y)}" r="12" fill="transparent"/>
                  {marker(seriesIndex, x, y, colour)}
                </g>
              </a>
              """,
          )
        }
        None => {
          if current.length() > 0 {
            segments.push(current.toArray())
            let fresh: Vector<String> = Vector.of()
            current = fresh
          }
        }
      }
      position += 1
    }
    if current.length() > 0 {
      segments.push(current.toArray())
    }
    for segment in segments {
      if segment.length() > 1 {
        out.push(
          html"""
            <path class=line data-series="{one.name}" d="M{"L".join(segment)}" fill="none" stroke="{colour}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
            """,
        )
      }
    }
    for mark in marks {
      out.push(mark)
    }
    seriesIndex += 1
  }
  out.push(html"</svg>")
  html"{out.freeze()}"
}
