// Pure text helpers the ledger needs and the standard library does not have:
// form decoding and calendar dates. A copy of the webhook lab's
// (`examples/webhooks/text`), with ISO 8601 times read as well as written and
// without its HTML escaping, which the pages' `html"…"` literals do.

/// Decodes `application/x-www-form-urlencoded` text: `+` is a space and
/// `%XX` a byte, and the bytes are read as UTF-8 (a byte sequence that is not
/// UTF-8 becomes U+FFFD).
export fn urlDecode(text: String) -> String {
  var bytes = Vector.of()
  let end = text.byteLength()
  var at = 0
  while at < end {
    let byte = text.byteAt(at)
    if byte == 43 {
      bytes.push(32)
      at += 1
    } else if byte == 37 && at + 2 < end {
      match Int.parseRadix(text.sliceBytes(at + 1, at + 3).unwrapOr("zz"), 16) {
        Ok(value) => {
          if value >= 0 {
            bytes.push(value)
            at += 3
          } else {
            bytes.push(byte)
            at += 1
          }
        }
        Err(_) => {
          bytes.push(byte)
          at += 1
        }
      }
    } else {
      bytes.push(byte)
      at += 1
    }
  }
  decodeUtf8(bytes.freeze())
}

/// UTF-8 bytes as text; a sequence that is not UTF-8 is U+FFFD.
export fn decodeUtf8(bytes: Array<Int>) -> String {
  var parts = Vector.of()
  let end = bytes.length()
  var at = 0
  while at < end {
    let first = bytes.get(at).unwrapOr(0)
    var need = 0
    var point = 0
    if first < 128 {
      point = first
    } else if first >= 194 && first < 224 {
      need = 1
      point = first - 192
    } else if first >= 224 && first < 240 {
      need = 2
      point = first - 224
    } else if first >= 240 && first < 245 {
      need = 3
      point = first - 240
    } else {
      point = -1
    }
    at += 1
    var taken = 0
    while taken < need && point >= 0 {
      let next = bytes.get(at).unwrapOr(-1)
      if next >= 128 && next < 192 {
        point = point * 64 + (next - 128)
        at += 1
        taken += 1
      } else {
        point = -1
      }
    }
    parts.push(String.fromCodePoint(point).unwrapOr(replacement()))
  }
  "".join(parts.freeze())
}

/// U+FFFD, what a byte sequence that is not UTF-8 decodes to.
fn replacement() -> String {
  String.fromCodePoint(65533).unwrapOr("?")
}

/// A form body (`a=1&b=two+words`) as a map; for a repeated name the last
/// value wins.
export fn parseForm(body: String) -> Map<String, String> {
  var fields: Map<String, String> = Map.of()
  for pair in body.split("&") {
    if pair != "" {
      let parts = pair.split("=")
      let name = urlDecode(parts.get(0).unwrapOr(""))
      let value = urlDecode("=".join(parts.slice(1, parts.length())))
      fields = fields.inserted(name, value)
    }
  }
  fields
}

/// `value` written in decimal with at least `width` digits, zero-padded.
export fn padded(value: Int, width: Int) -> String {
  var text = "{value}"
  while text.length() < width {
    text = "0{text}"
  }
  text
}

/// Milliseconds since the Unix epoch as an ISO 8601 UTC time:
/// `2026-10-05T03:13:54.123Z`.
export fn isoTime(millis: Int) -> String {
  let days = floorDiv(millis, 86400000)
  let ofDay = millis - days * 86400000
  // Howard Hinnant's `civil_from_days`.
  let z = days + 719468
  let era = floorDiv(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let day = doy - (153 * mp + 2) / 5 + 1
  let month = if mp < 10 { mp + 3 } else { mp - 9 }
  let year = yoe + era * 400 + if month <= 2 { 1 } else { 0 }
  let hour = ofDay / 3600000
  let minute = ofDay / 60000 % 60
  let second = ofDay / 1000 % 60
  let milli = ofDay % 1000
  "{padded(year, 4)}-{padded(month, 2)}-{padded(day, 2)}T{padded(hour, 2)}:{padded(minute, 2)}:{padded(second, 2)}.{padded(milli, 3)}Z"
}

/// Division rounding toward negative infinity.
fn floorDiv(value: Int, by: Int) -> Int {
  let quotient = value / by
  if value % by < 0 { quotient - 1 } else { quotient }
}

/// A byte count as people read one: `512 B`, `1.5 KiB`, `2.0 MiB`.
export fn bytes(count: Int) -> String {
  if count < 1024 {
    return "{count} B"
  }
  if count < 1048576 {
    return "{count / 1024}.{count % 1024 * 10 / 1024} KiB"
  }
  "{count / 1048576}.{count % 1048576 * 10 / 1048576} MiB"
}

/// At most the first `limit` bytes of `text`, cut at a character boundary.
export fn truncateBytes(text: String, limit: Int) -> String {
  if text.byteLength() <= limit {
    return text
  }
  var end = limit
  while end > 0 {
    match text.sliceBytes(0, end) {
      Ok(prefix) => return prefix
      Err(_) => {
        end -= 1
      }
    }
  }
  ""
}

/// An ISO 8601 time with a date, a time of day and a zone — `Z` or `+09:00` —
/// as milliseconds since the Unix epoch: `2026-10-05T03:13:54Z`,
/// `2026-10-05T12:13:54.5+09:00`. `None` for anything else, including a time
/// with no zone, which names no one instant.
export fn parseIso(text: String) -> Option<Int> {
  if text.byteLength() < 20 || text.byteLength() > 40 {
    return None
  }
  let year = digitsAt(text, 0, 4)?
  let month = digitsAt(text, 5, 2)?
  let day = digitsAt(text, 8, 2)?
  let hour = digitsAt(text, 11, 2)?
  let minute = digitsAt(text, 14, 2)?
  let second = digitsAt(text, 17, 2)?
  if text.byteAt(4) != 45 || text.byteAt(7) != 45 || text.byteAt(13) != 58 || text.byteAt(16) != 58 {
    return None
  }
  let t = text.byteAt(10)
  if t != 84 && t != 116 && t != 32 {
    return None
  }
  if month < 1 || month > 12 || day < 1 || day > daysIn(year, month) || hour > 23 || minute > 59 || second > 59 {
    return None
  }
  var at = 19
  var millis = 0
  if text.byteAt(at) == 46 {
    at += 1
    var places = 0
    while at < text.byteLength() && isDigitByte(text.byteAt(at)) {
      if places < 3 {
        millis = millis * 10 + (text.byteAt(at) - 48)
      }
      places += 1
      at += 1
    }
    if places == 0 {
      return None
    }
    while places < 3 {
      millis = millis * 10
      places += 1
    }
  }
  let zone = text.sliceBytes(at, text.byteLength()).unwrapOr("?")
  var offset = 0
  if zone == "Z" || zone == "z" {
    offset = 0
  } else if zone.byteLength() == 6 && (zone.byteAt(0) == 43 || zone.byteAt(0) == 45) && zone.byteAt(3) == 58 {
    let hours = digitsAt(zone, 1, 2)?
    let minutes = digitsAt(zone, 4, 2)?
    if hours > 23 || minutes > 59 {
      return None
    }
    offset = (hours * 60 + minutes) * 60000
    if zone.byteAt(0) == 45 {
      offset = -offset
    }
  } else {
    return None
  }
  let days = daysFromCivil(year, month, day)
  Some(days * 86400000 + ((hour * 60 + minute) * 60 + second) * 1000 + millis - offset)
}

/// The `width` decimal digits of `text` at byte `at`, as a number.
fn digitsAt(text: String, at: Int, width: Int) -> Option<Int> {
  if at + width > text.byteLength() {
    return None
  }
  var value = 0
  var place = 0
  while place < width {
    let byte = text.byteAt(at + place)
    if !isDigitByte(byte) {
      return None
    }
    value = value * 10 + (byte - 48)
    place += 1
  }
  Some(value)
}

fn isDigitByte(byte: Int) -> Bool {
  byte >= 48 && byte <= 57
}

/// How many days `month` of `year` has.
fn daysIn(year: Int, month: Int) -> Int {
  if month == 2 {
    let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
    if leap { 29 } else { 28 }
  } else if month == 4 || month == 6 || month == 9 || month == 11 {
    30
  } else {
    31
  }
}

/// Days since 1970-01-01 of a date: Howard Hinnant's `days_from_civil`, the
/// inverse of the walk in `isoTime`.
fn daysFromCivil(year: Int, month: Int, day: Int) -> Int {
  let y = if month <= 2 { year - 1 } else { year }
  let era = floorDiv(y, 400)
  let yoe = y - era * 400
  let mp = if month > 2 { month - 3 } else { month + 9 }
  let doy = (153 * mp + 2) / 5 + day - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

/// `text` with `%`, `:` and `|` written as `%25`, `%3A` and `%7C`, so that
/// it can be one part of a store key whose parts those characters separate.
export fn keyPart(text: String) -> String {
  text.replace("%", "%25").replace(":", "%3A").replace("|", "%7C")
}

/// `text` as a query parameter's value: everything but letters, digits and
/// `-._~` percent-encoded, byte by byte.
export fn urlEncode(text: String) -> String {
  var parts = Vector.of()
  let end = text.byteLength()
  var at = 0
  while at < end {
    let byte = text.byteAt(at)
    let plain = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 45 || byte == 46 || byte == 95 || byte == 126
    if plain {
      parts.push(text.sliceBytes(at, at + 1).unwrapOr(""))
    } else {
      parts.push("%{hexByte(byte)}")
    }
    at += 1
  }
  "".join(parts.freeze())
}

fn hexByte(byte: Int) -> String {
  let digits = "0123456789ABCDEF"
  "{digits.slice(byte / 16, byte / 16 + 1)}{digits.slice(byte % 16, byte % 16 + 1)}"
}
