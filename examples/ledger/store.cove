use kv
use std.json
use std.json.Json
use fields
use schema
use schema.Run
use schema.Measurement
use schema.Problem
use stats
use std.datetime
use text

// The ledger's records in the app's key-value store, as JSON:
//
//   run:<id>                       a run, as `schema.runJson` renders it
//   index:<time>:<id>              its summary, for the run list
//   commit:<repo>|<commit>:<time>:<id>
//                                  the runs of a commit, oldest first
//   metric:<name>                  the dimension a metric has had since it
//                                  was first posted (`duration`, `rate`, …)
//   case:<case>|<input>            a case measured at an input
//   point:<case>|<input>:<time>:<id>:<backend>
//                                  one measurement's medians and spreads, for
//                                  the case's trend over runs
//
// `<time>` is when the run was measured, in milliseconds, zero-padded to
// sixteen digits, so keys sort by it. Text from a poster that is part of a
// key goes through `text.keyPart` (which writes `%`, `:` and `|` as escapes),
// so it can never be read as a separator. A run ID is letters, digits, `.`,
// `_` and `-` (`schema.isName`) and needs no escaping.
//
// `run:<id>` is written last. A post that stops halfway leaves no run, and
// posting it again writes everything again under the same keys.

/// What the run list shows of a run.
struct Summary {
  id: String
  repository: String
  commit: String
  measuredAt: Int
  results: Int
  backends: Array<String>
  /// The least and the most load average taken before any repetition;
  /// both `None` when none was.
  loadLeast: Option<Float>
  loadMost: Option<Float>
  environment: Map<String, String>
  toolchain: Map<String, String>
  conditions: Map<String, String>
  source: String
}

fn time16(millis: Int) -> String {
  text.padded(millis, 16)
}

fn caseKey(case: String, input: String) -> String {
  "{text.keyPart(case)}|{text.keyPart(input)}"
}

fn backendsOf(run: Run) -> Array<String> {
  var names = Vector.of()
  for result in run.results {
    if !names.contains(result.backend) {
      names.push(result.backend)
    }
  }
  names.freeze()
}

fn summaryOf(run: Run) -> Summary {
  var least: Option<Float> = None
  var most: Option<Float> = None
  for result in run.results {
    for load in result.load {
      least = match least {
        Some(now) => Some(now.min(load))
        None => Some(load)
      }
      most = match most {
        Some(now) => Some(now.max(load))
        None => Some(load)
      }
    }
  }
  Summary(
    id: run.id,
    repository: run.repository,
    commit: run.commit,
    measuredAt: run.measuredAt,
    results: run.results.length(),
    backends: backendsOf(run),
    loadLeast: least,
    loadMost: most,
    environment: run.environment,
    toolchain: run.toolchain,
    conditions: run.conditions,
    source: run.source,
  )
}

fn summaryJson(summary: Summary) -> Json {
  var backends = Vector.of()
  for name in summary.backends {
    backends.push(Json.Text(name))
  }
  var fields = Map.of(
    MapEntry(key: "id", value: Json.Text(summary.id)),
    MapEntry(key: "repository", value: Json.Text(summary.repository)),
    MapEntry(key: "commit", value: Json.Text(summary.commit)),
    MapEntry(key: "measuredAt", value: Json.Text(datetime.formatIso(summary.measuredAt))),
    MapEntry(key: "measuredAtMs", value: Json.Number(summary.measuredAt.toFloat())),
    MapEntry(key: "results", value: Json.Number(summary.results.toFloat())),
    MapEntry(key: "backends", value: Json.Items(backends.freeze())),
    MapEntry(key: "environment", value: fields.fromTextMap(summary.environment)),
    MapEntry(key: "toolchain", value: fields.fromTextMap(summary.toolchain)),
    MapEntry(key: "conditions", value: fields.fromTextMap(summary.conditions)),
    MapEntry(key: "source", value: Json.Text(summary.source)),
  )
  match summary.loadLeast {
    Some(least) => {
      fields = fields.inserted("loadLeast", Json.Number(least))
    }
    None => {}
  }
  match summary.loadMost {
    Some(most) => {
      fields = fields.inserted("loadMost", Json.Number(most))
    }
    None => {}
  }
  Json.Fields(fields)
}

fn summaryFrom(value: Json) -> Summary {
  var backends = Vector.of()
  match json.field(value, "backends") {
    Some(Json.Items(items)) => {
      for item in items {
        match item {
          Json.Text(name) => backends.push(name)
          _ => {}
        }
      }
    }
    _ => {}
  }
  Summary(
    id: fields.text(value, "id"),
    repository: fields.text(value, "repository"),
    commit: fields.text(value, "commit"),
    measuredAt: fields.int(value, "measuredAtMs", 0),
    results: fields.int(value, "results", 0),
    backends: backends.freeze(),
    loadLeast: numberField(value, "loadLeast"),
    loadMost: numberField(value, "loadMost"),
    environment: fields.textMap(value, "environment"),
    toolchain: fields.textMap(value, "toolchain"),
    conditions: fields.textMap(value, "conditions"),
    source: fields.text(value, "source"),
  )
}

fn numberField(value: Json, name: String) -> Option<Float> {
  match json.field(value, name) {
    Some(Json.Number(number)) => Some(number)
    _ => None
  }
}

/// One measurement as a point of its case's trend: the run it is from and
/// each metric's spread, in the canonical unit.
fn pointJson(run: Run, result: Measurement) -> Json {
  var metrics: Map<String, Json> = Map.of()
  for one in result.metrics {
    match stats.spread(one.canonical) {
      Some(spread) => {
        metrics = metrics.inserted(
          one.name,
          Json.Fields(
            Map.of(
              MapEntry(key: "unit", value: Json.Text(one.canonicalUnit)),
              MapEntry(key: "median", value: Json.Number(spread.median)),
              MapEntry(key: "least", value: Json.Number(spread.least)),
              MapEntry(key: "most", value: Json.Number(spread.most)),
              MapEntry(key: "count", value: Json.Number(spread.count.toFloat())),
              MapEntry(key: "better", value: Json.Text(one.better)),
            ),
          ),
        )
      }
      None => {}
    }
  }
  Json.Fields(
    Map.of(
      MapEntry(key: "run", value: Json.Text(run.id)),
      MapEntry(key: "commit", value: Json.Text(run.commit)),
      MapEntry(key: "repository", value: Json.Text(run.repository)),
      MapEntry(key: "measuredAtMs", value: Json.Number(run.measuredAt.toFloat())),
      MapEntry(key: "case", value: Json.Text(result.case)),
      MapEntry(key: "input", value: Json.Text(result.input)),
      MapEntry(key: "backend", value: Json.Text(result.backend)),
      MapEntry(key: "conditions", value: fields.fromTextMap(result.conditions)),
      MapEntry(key: "environment", value: fields.fromTextMap(run.environment)),
      MapEntry(key: "metrics", value: Json.Fields(metrics)),
    ),
  )
}

/// The keys a run is kept under, but `run:<id>` itself and the metric
/// dimensions (which outlive it).
fn keysOf(run: Run) -> Array<String> {
  let time = time16(run.measuredAt)
  var keys = Vector.of()
  keys.push("index:{time}:{run.id}")
  keys.push("commit:{text.keyPart(run.repository)}|{text.keyPart(run.commit)}:{time}:{run.id}")
  for result in run.results {
    keys.push("point:{caseKey(result.case, result.input)}:{time}:{run.id}:{text.keyPart(result.backend)}")
  }
  keys.freeze()
}

/// What posting a run came to.
enum Posted {
  /// Stored for the first time.
  Stored(Run)
  /// The same run was already stored under its ID; nothing changed.
  Duplicate(Run)
  /// Another run is stored under its ID: how they differ.
  Conflict(String)
  Invalid(Array<Problem>)
  /// The store refused a write (a quota): why.
  Failed(String)
}

/// Checks and stores a posted body.
fn postRun(body: String) -> Posted {
  let run = match schema.validate(body) {
    Ok(run) => run
    Err(problems) => return Posted.Invalid(problems)
  }
  let rendered = json.render(schema.runJson(run))
  match kv.get("run:{run.id}") {
    Some(stored) => {
      if stored == rendered {
        return Posted.Duplicate(run)
      }
      let before = match json.parse(stored) {
        Ok(value) => schema.runOf(value)
        Err(_) => return Posted.Conflict("the stored run cannot be read")
      }
      return Posted.Conflict(schema.difference(before, run))
    }
    None => {}
  }
  let problems = dimensionProblems(run)
  if problems.length() > 0 {
    return Posted.Invalid(problems)
  }
  match write(run, rendered) {
    Ok(_) => Posted.Stored(run)
    Err(error) => {
      // Take back what was written, so that a failed post leaves no points
      // without a run.
      for key in keysOf(run) {
        kv.delete(key)
      }
      Posted.Failed(error.message)
    }
  }
}

/// A problem for every metric whose dimension is not the one it has had:
/// `p99` posted in `KiB` after runs that sent it in `ms` would put sizes on
/// a chart of times.
fn dimensionProblems(run: Run) -> Array<Problem> {
  var problems = Vector.of()
  var seen: Map<String, String> = Map.of()
  var index = 0
  for result in run.results {
    for one in result.metrics {
      let known = match seen.get(one.name) {
        Some(dimension) => Some(dimension)
        None => kv.get("metric:{one.name}")
      }
      match known {
        Some(dimension) => {
          if dimension != one.dimension {
            problems.push(
              Problem(
                path: "results[{index}].metrics.{one.name}.unit",
                message: "`{one.name}` is a {dimension} (in earlier runs or results), and `{one.unit}` is a {one.dimension} unit; post it under another name",
              ),
            )
          }
        }
        None => {}
      }
      if !seen.contains(one.name) {
        seen = seen.inserted(one.name, one.dimension)
      }
    }
    index += 1
  }
  problems.freeze()
}

fn write(run: Run, rendered: String) -> Result<Unit, Error> {
  let time = time16(run.measuredAt)
  var dimensions: Map<String, String> = Map.of()
  for result in run.results {
    for one in result.metrics {
      dimensions = dimensions.inserted(one.name, one.dimension)
    }
  }
  for entry in dimensions {
    if kv.get("metric:{entry.key}").isNone() {
      kv.put("metric:{entry.key}", entry.value)?
    }
  }
  for result in run.results {
    let key = caseKey(result.case, result.input)
    if kv.get("case:{key}").isNone() {
      kv.put(
        "case:{key}",
        json.render(
          Json.Fields(
            Map.of(
              MapEntry(key: "case", value: Json.Text(result.case)),
              MapEntry(key: "input", value: Json.Text(result.input)),
            ),
          ),
        ),
      )?
    }
    kv.put("point:{key}:{time}:{run.id}:{text.keyPart(result.backend)}", json.render(pointJson(run, result)))?
  }
  kv.put("commit:{text.keyPart(run.repository)}|{text.keyPart(run.commit)}:{time}:{run.id}", run.id)?
  kv.put("index:{time}:{run.id}", json.render(summaryJson(summaryOf(run))))?
  kv.put("run:{run.id}", rendered)?
  Ok(())
}

/// The run `id`, if it is stored.
fn loadRun(id: String) -> Option<Run> {
  if !schema.isName(id) {
    return None
  }
  match kv.get("run:{id}") {
    Some(stored) => match json.parse(stored) {
      Ok(value) => Some(schema.runOf(value))
      Err(_) => None
    }
    None => None
  }
}

/// The run `id` as stored, the JSON text itself.
fn storedRun(id: String) -> Option<String> {
  if !schema.isName(id) {
    return None
  }
  kv.get("run:{id}")
}

/// Deletes the run `id` and everything kept for it; whether it was there.
fn deleteRun(id: String) -> Bool {
  let run = match loadRun(id) {
    Some(run) => run
    None => return false
  }
  for key in keysOf(run) {
    kv.delete(key)
  }
  // A case that no run measures any more goes too.
  for result in run.results {
    let key = caseKey(result.case, result.input)
    if kv.list("point:{key}:", "", 1).length() == 0 {
      kv.delete("case:{key}")
    }
  }
  kv.delete("run:{id}")
}

/// A page of runs, newest measured first: at most `limit`, older than the
/// index key `before` (`""` for the newest).
fn listRuns(before: String, limit: Int) -> Array<Summary> {
  var runs = Vector.of()
  for entry in kv.listDesc("index:", before, limit) {
    match json.parse(entry.value) {
      Ok(value) => runs.push(summaryFrom(value))
      Err(_) => {}
    }
  }
  runs.freeze()
}

/// The index key of a summary: where the page after it starts.
fn indexKey(summary: Summary) -> String {
  "index:{time16(summary.measuredAt)}:{summary.id}"
}

/// The runs of `commit` — every repository's — oldest measured first. A
/// prefix of at least seven characters names a commit, as `git` abbreviates
/// one.
fn runsOfCommit(commit: String) -> Array<Run> {
  var runs = Vector.of()
  if commit.length() < 4 {
    return runs.freeze()
  }
  var before = ""
  var more = true
  while more {
    let page = listRuns(before, 500)
    for summary in page {
      if summary.commit == commit || (commit.length() >= 7 && summary.commit.startsWith(commit)) {
        match loadRun(summary.id) {
          Some(run) => runs.push(run)
          None => {}
        }
      }
      before = indexKey(summary)
    }
    more = page.length() == 500
  }
  runs.freeze().sorted(by: fn(x, y) { x.measuredAt < y.measuredAt })
}

/// Every run's summary, newest measured first.
fn allRuns() -> Array<Summary> {
  var runs = Vector.of()
  var before = ""
  var more = true
  while more {
    let page = listRuns(before, 500)
    for summary in page {
      runs.push(summary)
      before = indexKey(summary)
    }
    more = page.length() == 500
  }
  runs.freeze()
}

/// The names of every metric posted so far, by name.
fn metricNamesStored() -> Array<String> {
  var names = Vector.of()
  var after = ""
  var more = true
  while more {
    let page = kv.list("metric:", after, 500)
    for entry in page {
      names.push(entry.key.slice("metric:".length(), entry.key.length()))
      after = entry.key
    }
    more = page.length() == 500
  }
  names.freeze()
}
