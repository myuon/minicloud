use web
use schema
use schema.Run
use schema.Measurement
use schema.Metric
use stats
use text
use std.html
use std.html.Html

// The HTML. Every page is an `html"…"` literal, and a hole in one is escaped
// unless its type is `Html`: a run ID, a repository, a case, a backend, an
// environment — every value that came from a poster — is a `String`, so it is
// text on the page whatever it holds, and the page's own markup is the only
// markup in it. A part of a page built in one function and put in another is
// an `Html`, which is how the second knows to take it whole.

/// The response headers every page carries: no script, no framing, no
/// sniffing, no referrer to another site.
fn pageHeaders(contentType: String) -> Map<String, String> {
  Map.of(
    MapEntry(key: "content-type", value: contentType),
    MapEntry(
      key: "content-security-policy",
      value: "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
    ),
    MapEntry(key: "x-content-type-options", value: "nosniff"),
    MapEntry(key: "x-frame-options", value: "DENY"),
    MapEntry(key: "referrer-policy", value: "same-origin"),
  )
}

/// A page as the answer. This is the one place a page stops being `Html`
/// and becomes the text of a body.
fn htmlResponse(status: Int, page: Html) -> web.Response {
  web.Response(status: status, headers: pageHeaders("text/html; charset=utf-8"), body: page.render())
}

fn jsonResponse(status: Int, body: String) -> web.Response {
  web.Response(status: status, headers: pageHeaders("application/json"), body: "{body}\n")
}

fn textResponse(status: Int, body: String) -> web.Response {
  web.Response(status: status, headers: pageHeaders("text/plain; charset=utf-8"), body: body)
}

/// The stylesheet. It is CSS rather than markup, and goes into `<style>`
/// through a hole of [`layout`], which escapes it like any `String`: so it
/// holds none of `&`, `<`, `>`, `"` and `'` (a `>` combinator would arrive
/// as `&gt;`).
fn css() -> String {
  "body\{font:14px/1.45 system-ui,sans-serif;margin:0;color:#0b0b0b;background:#fafafa\}header\{background:#24292f;padding:.6em 1.2em\}header a\{color:#fff;text-decoration:none;margin-right:1.2em\}header a.home\{font-weight:600\}main\{padding:1em 1.2em\}h1\{font-size:1.4em;margin:.2em 0 .6em\}h2\{font-size:1.1em;margin:1.4em 0 .4em\}table\{border-collapse:collapse;margin:.4em 0 1.2em;background:#fff\}td,th\{border:1px solid #d0d7de;padding:.25em .6em;text-align:left;vertical-align:top\}th\{background:#f3f4f6;font-weight:600\}td.num,th.num\{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums\}.range\{color:#52514e;font-size:.85em\}.absent\{color:#8c8b87\}.unit\{color:#52514e;font-weight:400;font-size:.85em\}code\{font:12px/1.4 ui-monospace,monospace\}.muted\{color:#52514e\}dl.meta\{display:grid;grid-template-columns:max-content auto;gap:.15em 1em;margin:.4em 0 1em\}dl.meta dt\{color:#52514e\}dl.meta dd\{margin:0\}.pair\{display:flex;gap:1.5em;flex-wrap:wrap\}.better\{color:#1a7f37\}.worse\{color:#b42318\}.warn\{background:#fff8c5\}.bad\{background:#ffebe9\}.note\{color:#52514e;font-size:.9em\}form.pick\{display:flex;flex-wrap:wrap;gap:.6em 1.2em;align-items:center;margin:.4em 0 1em\}form.pick select\{font:inherit;max-width:32em\}details.note ul\{margin:.3em 0\}ul.only\{columns:3;margin:.3em 0\}svg.chart\{max-width:100%;height:auto;display:block;border:1px solid #e1e0d9;border-radius:4px\}section.trend\{margin-bottom:1.6em\}details.table\{margin:.4em 0\}"
}

/// The page around `content`.
fn layout(base: String, title: String, content: Html) -> Html {
  html"""
    <!doctype html>
    <html lang=en>
    <head>
      <meta charset=utf-8>
      <meta name=viewport content="width=device-width">
      <title>{title} · bench ledger</title>
      <style>{css()}</style>
    </head>
    <body>
      <header>
        <a class=home href="{base}/">bench ledger</a>
        <a href="{base}/">Runs</a>
        <a href="{base}/compare">Compare</a>
        <a href="{base}/cases">Cases</a>
      </header>
      <main>{content}</main>
    </body>
    </html>
    """
}

/// `millis` as the pages show a time: `2026-10-05 03:13 UTC`.
fn when(millis: Int) -> String {
  let iso = text.isoTime(millis)
  "{iso.slice(0, 10)} {iso.slice(11, 16)}"
}

/// A load-average range, or `–` when none was taken.
fn loadRange(least: Option<Float>, most: Option<Float>) -> Html {
  match least {
    Some(low) => {
      let high = most.unwrapOr(low)
      if low == high { html"{low.format(1)}" } else { html"{low.format(1)}–{high.format(1)}" }
    }
    None => html"""<span class=absent title="not recorded">–</span>"""
  }
}

/// The run list.
fn runsPage(base: String, runs: Array<Summary>, older: String) -> Html {
  var rows = Vector.of()
  for run in runs {
    rows.push(
      html"""
        <tr>
          <td class=num>{when(run.measuredAt)}</td>
          <td><a href="{base}/runs/{run.id}">{run.id}</a></td>
          <td>{run.repository}</td>
          <td><code>{run.commit}</code></td>
          <td class=num>{run.results}</td>
          <td>{", ".join(run.backends)}</td>
          <td class=num>{loadRange(run.loadLeast, run.loadMost)}</td>
          <td>{machine(run.environment)}</td>
        </tr>
        """,
    )
  }
  let table = if rows.length() == 0 {
    html"""
      <p class=muted>No runs yet. Post one:
      <code>curl -H 'authorization: Bearer $LEDGER_TOKEN' -H 'content-type: application/json' --data @run.json {base}/api/runs</code></p>
      """
  } else {
    html"""
      <table>
        <tr>
          <th>measured (UTC)</th>
          <th>run</th>
          <th>repository</th>
          <th>commit</th>
          <th class=num>results</th>
          <th>backends</th>
          <th class=num>load avg</th>
          <th>machine</th>
        </tr>
        {rows.freeze()}
      </table>
      """
  }
  let more = html.only(older != "", html"""<p><a href="{base}/?before={text.urlEncode(older)}">older →</a></p>""")
  layout(base, "runs", html"<h1>Runs</h1>{table}{more}")
}

/// What a run's environment says about the machine, in one line.
fn machine(environment: Map<String, String>) -> String {
  var parts = Vector.of()
  for name in ["machine", "cpu", "os", "arch"] {
    match environment.get(name) {
      Some(value) => parts.push(value)
      None => {}
    }
  }
  if parts.length() == 0 {
    var all = Vector.of()
    for entry in environment {
      all.push("{entry.key}={entry.value}")
    }
    return ", ".join(all.freeze())
  }
  " · ".join(parts.freeze())
}

/// A map as a two-column table, or a muted `none`.
fn pairs(title: String, entries: Map<String, String>) -> Html {
  if entries.isEmpty() {
    return html"<div><h2>{title}</h2><p class=muted>none recorded</p></div>"
  }
  var rows = Vector.of()
  for entry in entries {
    rows.push(html"<tr><th>{entry.key}</th><td>{entry.value}</td></tr>")
  }
  html"<div><h2>{title}</h2><table>{rows.freeze()}</table></div>"
}

/// The metrics measured anywhere in `results`, the usual ones first:
/// throughput, then latencies from the median out, then the rest by name.
fn metricNames(results: Array<Measurement>) -> Array<String> {
  var names = Vector.of()
  for result in results {
    for one in result.metrics {
      if !names.contains(one.name) {
        names.push(one.name)
      }
    }
  }
  let preferred = ["throughput", "time", "p50", "p90", "p99", "max", "cpu", "cpuPerRequest", "memory"]
  var ordered = Vector.of()
  for name in preferred {
    if names.contains(name) {
      ordered.push(name)
    }
  }
  let rest = names.freeze().sorted(by: fn(a, b) { a < b })
  for name in rest {
    if !preferred.contains(name) {
      ordered.push(name)
    }
  }
  ordered.freeze()
}

/// The canonical unit of metric `name` in `results`, or `""`.
fn unitOf(results: Array<Measurement>, name: String) -> String {
  for result in results {
    match schema.metricOf(result, name) {
      Some(one) => return one.canonicalUnit
      None => {}
    }
  }
  ""
}

/// A metric's cell: the median, the range under it, and what was sent in
/// the tooltip. An unmeasured metric is a dash, never a zero.
fn metricCell(metric: Option<Metric>) -> Html {
  match metric {
    Some(one) => match stats.spread(one.canonical) {
      Some(spread) => {
        var sent = Vector.of()
        for value in one.values {
          sent.push(plain(value))
        }
        let range = html.only(spread.count > 1, html"<br><span class=range>{stats.show(spread.least)}–{stats.show(spread.most)}</span>")
        html"""<td class=num title="median of {spread.count}; sent in {one.unit}: {", ".join(sent.freeze())}">{stats.show(spread.median)}{range}</td>"""
      }
      None => absentCell()
    }
    None => absentCell()
  }
}

fn absentCell() -> Html {
  html"""<td class="num absent" title="not measured">–</td>"""
}

/// One run: what it is, where and how it was measured, and its results.
fn runPage(base: String, run: Run) -> Html {
  let names = metricNames(run.results)
  var head = Vector.of()
  for name in names {
    head.push(html"<th class=num>{name}<br><span class=unit>{unitOf(run.results, name)}</span></th>")
  }
  var rows = Vector.of()
  for result in run.results {
    var cells = Vector.of()
    for name in names {
      cells.push(metricCell(schema.metricOf(result, name)))
    }
    var least: Option<Float> = None
    var most: Option<Float> = None
    for load in result.load {
      least = Some(least.unwrapOr(load).min(load))
      most = Some(most.unwrapOr(load).max(load))
    }
    rows.push(
      html"""
        <tr>
          <td><a href="{trendHref(base, result.case, result.input)}" title="the trend over runs">{result.case}</a></td>
          <td>{result.input}</td>
          <td>{result.backend}</td>
          <td class=num>{repetitions(result)}</td>
          <td class=num>{loadRange(least, most)}</td>
          {cells.freeze()}
        </tr>
        """,
    )
  }
  let note = html.only(run.note != "", html"<p class=note>{run.note}</p>")
  let source = if run.source == "" { html"–" } else { html"<code>{run.source}</code>" }
  let meta = html"""
    <dl class=meta>
      <dt>repository</dt><dd>{run.repository}</dd>
      <dt>commit</dt><dd><code>{run.commit}</code></dd>
      <dt>measured</dt><dd>{text.isoTime(run.measuredAt)}</dd>
      <dt>source</dt><dd>{source}</dd>
      <dt>results</dt>
      <dd>{run.results.length()} · <a href="{base}/runs/{run.id}?format=json">JSON</a> · <a href="{base}/compare?a={text.urlEncode(run.id)}">compare with…</a></dd>
    </dl>
    """
  let context = html"""
    <div class=pair>
      {pairs("environment", run.environment)}
      {pairs("toolchain", run.toolchain)}
      {pairs("conditions", run.conditions)}
    </div>
    """
  let table = html"""
    <h2>Results</h2>
    <p class=note>Medians over the repetitions, in each metric's canonical unit, with the least and the most under them;
    hover a value for what was sent. A dash is a metric that was not measured.</p>
    <table>
      <tr>
        <th>case</th>
        <th>input</th>
        <th>backend</th>
        <th class=num>reps</th>
        <th class=num>load avg</th>
        {head.freeze()}
      </tr>
      {rows.freeze()}
    </table>
    """
  layout(base, run.id, html"<h1>Run <code>{run.id}</code></h1>{note}{meta}{context}{table}")
}

/// How many times `result` was measured: the most repetitions any of its
/// metrics has.
fn repetitions(result: Measurement) -> Int {
  var most = 0
  for one in result.metrics {
    most = most.max(one.values.length())
  }
  most
}

/// `value` as it was most likely written: `850` rather than `850.0`.
fn plain(value: Float) -> String {
  match value.toInt() {
    Ok(whole) => {
      if whole.toFloat() == value { "{whole}" } else { "{value}" }
    }
    Err(_) => "{value}"
  }
}
