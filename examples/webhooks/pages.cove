use web
use std.json
use text
use std.html
use std.html.Html

// The admin pages. Every page is an `html"…"` literal, and a hole in one is
// escaped unless its type is `Html`: an endpoint's name, a request's path,
// query, headers and body, and every setting echoed back are `String`s, so
// each is text on the page whatever it holds, and the page's own markup is
// the only markup in it. A part of a page built in one function and put in
// another is an `Html`, which is how the second knows to take it whole.

/// The response headers every admin page carries: no script but the page's
/// own, no framing, no sniffing, no caching, no referrer to another site.
fn pageHeaders(contentType: String) -> Map<String, String> {
  Map.of(
    MapEntry(key: "content-type", value: contentType),
    MapEntry(
      key: "content-security-policy",
      value: "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
    ),
    MapEntry(key: "x-content-type-options", value: "nosniff"),
    MapEntry(key: "x-frame-options", value: "DENY"),
    MapEntry(key: "referrer-policy", value: "same-origin"),
    MapEntry(key: "cache-control", value: "no-store"),
  )
}

/// An HTML page. This is the one place a page stops being `Html` and becomes
/// the text of a body.
fn htmlResponse(status: Int, page: Html) -> web.Response {
  web.Response(status: status, headers: pageHeaders("text/html; charset=utf-8"), body: page.render())
}

/// A JSON document.
fn jsonResponse(status: Int, body: String) -> web.Response {
  web.Response(status: status, headers: pageHeaders("application/json"), body: "{body}\n")
}

/// Plain text, which a browser shows as text whatever it holds.
fn textResponse(status: Int, body: String) -> web.Response {
  web.Response(status: status, headers: pageHeaders("text/plain; charset=utf-8"), body: body)
}

/// A `303 See Other` to `location`.
fn redirect(location: String) -> web.Response {
  web.Response(
    status: 303,
    headers: Map.of(
      MapEntry(key: "location", value: location),
      MapEntry(key: "cache-control", value: "no-store"),
    ),
    body: "",
  )
}

/// The stylesheet, which goes in the page's `<style>` as written.
fn css() -> Html {
  html"body\{font:14px/1.45 system-ui,sans-serif;margin:0;color:#1d1d1f;background:#fafafa\}header\{background:#24292f;padding:.6em 1.2em\}header a\{color:#fff;text-decoration:none;font-weight:600\}main\{padding:1em 1.2em;max-width:72em\}table\{border-collapse:collapse;margin:.4em 0 1.2em;background:#fff\}td,th\{border:1px solid #d0d7de;padding:.25em .6em;text-align:left;vertical-align:top\}th\{background:#f3f4f6\}code,pre\{font:12px/1.4 ui-monospace,monospace\}pre\{background:#fff;border:1px solid #d0d7de;padding:.6em;white-space:pre-wrap;word-break:break-all;max-height:40em;overflow:auto\}form.inline\{display:inline\}button\{font:inherit;padding:.2em .7em\}.muted\{color:#6e7781\}.danger\{color:#b42318\}input\{font:inherit\}"
}

/// The page around `content`.
fn layout(base: String, title: String, content: Html) -> Html {
  html"""
    <!doctype html>
    <html lang=en>
    <head>
      <meta charset=utf-8>
      <meta name=viewport content="width=device-width">
      <title>{title} · webhook lab</title>
      <style>{css()}</style>
    </head>
    <body>
      <header><a href="{base}/admin">webhook lab</a></header>
      <main>{content}</main>
    </body>
    </html>
    """
}

/// A form that POSTs to `action` with one button. A `confirm` that is not
/// empty is asked first, and it is escaped like any other value: inside the
/// attribute, a `'` in it is `&#39;`, which the browser reads back as a quote
/// before the script sees it.
fn postButton(action: String, label: String, confirm: String) -> Html {
  let check = html.only(confirm != "", html""" onclick="return confirm('{confirm}')"""")
  html"""<form class=inline method=post action="{action}"><button{check}>{label}</button></form>"""
}

/// The list of endpoints, and the form that makes one.
fn endpointsPage(base: String, origin: String, endpoints: Array<Endpoint>) -> Html {
  var rows = Vector.of()
  for endpoint in endpoints {
    let newest = listEvents(endpoint.id, "", 1)
    let last = match newest.get(0) {
      Some(event) => text.isoTime(event.received)
      None => "–"
    }
    rows.push(
      html"""
        <tr>
          <td><a href="{base}/admin/e/{endpoint.id}">{endpoint.name}</a></td>
          <td><code>{receiveUrl(origin, base, endpoint.id)}</code></td>
          <td>{last}</td>
          <td>{endpoint.retention}</td>
          <td>{text.bytes(endpoint.maxBody)}</td>
          <td>{if endpoint.mask { "yes" } else { "no" }}</td>
        </tr>
        """,
    )
  }
  let table = if rows.length() == 0 {
    html"<p class=muted>No endpoints yet.</p>"
  } else {
    html"""
      <table>
        <tr><th>name</th><th>receive URL</th><th>last request</th><th>keeps</th><th>body limit</th><th>masks secrets</th></tr>
        {rows.freeze()}
      </table>
      """
  }
  let form = html"""
    <h2>New endpoint</h2>
    <form method=post action="{base}/admin/endpoints">
      <input type=hidden name=masking value=present>
      <p><label>Name <input name=name required maxlength=100></label></p>
      <p><label>Keep the last <input name=retention type=number value=100 min=1 max={maxRetention()}> requests</label></p>
      <p><label>Store at most <input name=maxBody type=number value=65536 min=0 max={maxBodyLimit()}> bytes of a body</label></p>
      <p><label><input type=checkbox name=mask checked> Mask secret headers (authorization, cookie, …) before storing</label></p>
      <p><button>Create</button></p>
    </form>
    """
  layout(base, "endpoints", html"<h1>Endpoints</h1>{table}{form}")
}

/// An endpoint, and a page of what it received.
fn endpointPage(
  base: String,
  origin: String,
  endpoint: Endpoint,
  reply: Reply,
  events: Array<Summary>,
  pageSize: Int,
) -> Html {
  let at = "{base}/admin/e/{endpoint.id}"
  let url = receiveUrl(origin, base, endpoint.id)
  var rows = Vector.of()
  for event in events {
    rows.push(
      html"""
        <tr>
          <td><a href="{at}/events/{event.id}">{text.isoTime(event.received)}</a></td>
          <td>{event.method}</td>
          <td><code>{event.path}</code></td>
          <td>{event.contentType}</td>
          <td>{text.bytes(event.bytes)}</td>
          <td>{answered(event.answered)}</td>
        </tr>
        """,
    )
  }
  let table = if rows.length() == 0 {
    html"<p class=muted>Nothing received yet. Try <code>curl -d 'hello' {url}</code></p>"
  } else {
    html"""
      <table>
        <tr><th>received (UTC)</th><th>method</th><th>path</th><th>content type</th><th>size</th><th>answered</th></tr>
        {rows.freeze()}
      </table>
      """
  }
  let older = match events.get(pageSize - 1) {
    Some(last) => Some(html"""<p><a href="{at}?before={last.id}">older →</a></p>""")
    None => None
  }
  let settings = html"""
    <p>Receive URL: <code id=url>{url}</code> <button onclick="navigator.clipboard.writeText(document.getElementById('url').textContent)">Copy</button></p>
    <p class=muted>Keeps the last {endpoint.retention} requests · stores at most {text.bytes(endpoint.maxBody)} of a body ·
    {if endpoint.mask { "masks secret headers" } else { "stores every header as sent" }} · created {text.isoTime(endpoint.created)}</p>
    """
  let actions = html"""
    <p>
      {postButton("{at}/clear", "Delete history", "Delete every stored request of this endpoint?")} \
      {postButton("{at}/delete", "Delete endpoint", "Delete this endpoint and its history?")} \
      <a href="{at}?format=json">JSON</a>
    </p>
    """
  layout(
    base,
    endpoint.name,
    html"<h1>{endpoint.name}</h1>{settings}{actions}{settingsForm(at, reply)}<h2>Requests</h2>{table}{older}",
  )
}

/// A two-column table of `entries`, or a note that there are none.
fn pairs(entries: Map<String, String>, none: String) -> Html {
  if entries.isEmpty() {
    return html"<p class=muted>{none}</p>"
  }
  var rows = Vector.of()
  for entry in entries {
    rows.push(html"<tr><th>{entry.key}</th><td><code>{entry.value}</code></td></tr>")
  }
  html"<table>{rows.freeze()}</table>"
}

/// One received request.
fn eventPage(base: String, endpoint: Endpoint, event: Event, attempts: Array<Attempt>) -> Html {
  let at = "{base}/admin/e/{endpoint.id}/events/{event.id}"
  let size = if event.truncated {
    html"{text.bytes(event.bytes)}, <span class=danger>stored truncated to {text.bytes(event.body.byteLength())}</span>"
  } else {
    html"{text.bytes(event.bytes)}"
  }
  let masked = html.only(
    event.masked.length() > 0,
    html"<p class=muted>Masked before storing: {", ".join(event.masked)}</p>",
  )
  let summary = html"""
    <table>
      <tr><th>received</th><td>{text.isoTime(event.received)}</td></tr>
      <tr><th>method</th><td>{event.method}</td></tr>
      <tr><th>path</th><td><code>{event.path}</code></td></tr>
      <tr><th>body</th><td>{size}</td></tr>
    </table>
    """
  // The only JSON here that this app did not write itself: a body some
  // sender posted. `std.json` is strict — an object that names a field twice
  // is refused rather than read with one of the two values — so a body like
  // that falls to the `Err` arm and loses its "As JSON" block. That is the
  // right answer: the raw body is on the page either way, and a pretty print
  // that silently dropped one of the two values would be a prettier lie than
  // showing nothing.
  let formatted = match json.parse(event.body) {
    Ok(value) => {
      if event.body.trim() == "" {
        None
      } else {
        Some(html"<h3>As JSON</h3><pre>{json.renderPretty(value)}</pre>")
      }
    }
    Err(_) => None
  }
  let body = if event.body == "" {
    html"<p class=muted>No body.</p>"
  } else {
    html"""
      <p>
        <button onclick="navigator.clipboard.writeText(document.getElementById('body').textContent)">Copy body</button> \
        <a href="{at}?view=raw">raw</a> · <a href="{at}?view=json">JSON</a>
      </p>
      <pre id=body>{event.body}</pre>
      {formatted}
      """
  }
  let actions = html"""<p><a href="{base}/admin/e/{endpoint.id}">← {endpoint.name}</a> {postButton("{at}/delete", "Delete this request", "")}</p>"""
  layout(
    base,
    "{event.method} {event.path}",
    html"""
      {actions}
      <h1>{event.method} <code>{event.path}</code></h1>
      {summary}
      <h2>Query</h2>
      {pairs(event.query, "No query.")}
      <h2>Headers</h2>
      {masked}
      {pairs(event.headers, "No headers.")}
      <h2>Body</h2>
      {body}
      {resends(at, event, attempts)}
      """,
  )
}

/// The status a request was answered with, as the history shows it.
fn answered(status: Int) -> Html {
  if status == 0 {
    html"–"
  } else if status >= 400 {
    html"<span class=danger>{status}</span>"
  } else {
    html"{status}"
  }
}

/// What the endpoint answers, and the form that changes it.
fn settingsForm(at: String, reply: Reply) -> Html {
  let summary = if reply.errorEvery > 0 {
    "{reply.status} (and {reply.errorStatus} to 1 in every {reply.errorEvery} requests)"
  } else {
    "{reply.status}"
  }
  let delayed = if reply.delayMs > 0 { " after {reply.delayMs} ms" } else { "" }
  let body = if reply.body == "" { "the receipt" } else { text.bytes(reply.body.byteLength()) }
  let customized = reply.status != 200 || reply.delayMs > 0 || reply.errorEvery > 0 ||
    reply.body != "" || !reply.headers.isEmpty()
  let open = html.only(customized, html" open")
  html"""
    <details{open}>
      <summary>Answers {summary}{delayed} with {body}</summary>
      <form method=post action="{at}/settings">
        <p>
          <label>Status <input name=status type=number min=100 max=599 value={reply.status}></label> \
          <label>after <input name=delayMs type=number min=0 max={maxDelayMs()} value={reply.delayMs}> ms</label>
          (waiting parks the request: it holds no worker)</p>
        <p>
          <label>Headers, one <code>Name: value</code> a line<br>
            <textarea name=headers rows=3 cols=70>{headerLines(reply.headers)}</textarea></label>
        </p>
        <p>
          <label>Body (empty: the receipt <code>\{"ok":true,…\}</code>)<br>
            <textarea name=body rows=4 cols=70>{reply.body}</textarea></label>
        </p>
        <p>
          <label>Fail every <input name=errorEvery type=number min=0 value={reply.errorEvery}> requests (0: never)</label> \
          <label>with status <input name=errorStatus type=number min=100 max=599 value={reply.errorStatus}></label>
        </p>
        <p>
          <label>Error body (empty: a line saying so)<br>
            <textarea name=errorBody rows=2 cols=70>{reply.errorBody}</textarea></label>
        </p>
        <p><button>Save</button></p>
      </form>
    </details>
    """
}

/// The resend form, and what earlier resends came to.
fn resends(at: String, event: Event, attempts: Array<Attempt>) -> Html {
  let skipped = html.only(
    event.masked.length() > 0,
    html" Masked headers ({", ".join(event.masked)}) are not sent: only a placeholder was stored.",
  )
  let form = html"""
    <form method=post action="{at}/resend">
      <p>
        <label>URL <input name=url size=60 required value="{lastTarget(attempts)}" placeholder="http://127.0.0.1:8080/webhooks/in/…"></label> \
        <button>Resend</button>
      </p>
    </form>
    <p class=muted>Sends the same method, body and headers (less the connection's own) to a URL
    the app's <code>[fetch] allow</code> admits.{skipped}</p>
    """
  if attempts.length() == 0 {
    return html"<h2 id=resends>Resend</h2>{form}"
  }
  var rows = Vector.of()
  for attempt in attempts {
    let result = if attempt.ok {
      html"<b>{attempt.status}</b>"
    } else {
      html"<span class=danger>{attempt.error}</span>"
    }
    let truncated = if attempt.truncated { ", stored truncated" } else { "" }
    let answer = if attempt.ok {
      html"""
        <details>
          <summary>{text.bytes(attempt.bytes)}{truncated}</summary>
          {pairs(attempt.headers, "No headers.")}
          <pre>{attempt.body}</pre>
        </details>
        """
    } else {
      html"–"
    }
    rows.push(
      html"""
        <tr>
          <td>{text.isoTime(attempt.at)}</td>
          <td><code>{attempt.url}</code></td>
          <td>{result}</td>
          <td>{attempt.millis} ms</td>
          <td>{answer}</td>
        </tr>
        """,
    )
  }
  html"""
    <h2 id=resends>Resend</h2>
    {form}
    <table>
      <tr><th>sent (UTC)</th><th>to</th><th>result</th><th>took</th><th>response</th></tr>
      {rows.freeze()}
    </table>
    <p><a href="{at}?view=resends">JSON</a></p>
    """
}

/// An endpoint's receive URL, as a client outside reaches it.
fn receiveUrl(origin: String, base: String, id: String) -> String {
  "{origin}{base}/in/{id}"
}
