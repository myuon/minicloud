use std.web

fn req(headers: Map<String, String>) -> web.Request {
  web.Request(method: "POST", path: "/", query: Map.of(), headers: headers, body: "")
}

fn withHost(extra: Array<MapEntry<String, String>>) -> web.Request {
  var headers = Map.of(MapEntry(key: "host", value: "app.example"))
  for entry in extra {
    headers = headers.inserted(entry.key, entry.value)
  }
  req(headers)
}

test fn sameOriginTrustsSecFetchSiteAlone() -> Result<Unit, Error> {
  // A form posted from a `no-referrer` page: the browser says `Origin: null`.
  assertEqual(withHost([MapEntry(key: "sec-fetch-site", value: "same-origin"), MapEntry(key: "origin", value: "null")]).sameOrigin(), true)?
  assertEqual(withHost([MapEntry(key: "sec-fetch-site", value: "none")]).sameOrigin(), true)?
  // A matching Origin does not rescue a cross-site request.
  assertEqual(withHost([MapEntry(key: "sec-fetch-site", value: "cross-site"), MapEntry(key: "origin", value: "http://app.example")]).sameOrigin(), false)?
  assertEqual(withHost([MapEntry(key: "sec-fetch-site", value: "same-site")]).sameOrigin(), false)?
  Ok(())
}

test fn sameOriginFallsBackToOrigin() -> Result<Unit, Error> {
  assertEqual(withHost([MapEntry(key: "origin", value: "null")]).sameOrigin(), false)?
  assertEqual(withHost([MapEntry(key: "origin", value: "http://app.example")]).sameOrigin(), true)?
  assertEqual(withHost([MapEntry(key: "origin", value: "http://evil.example")]).sameOrigin(), false)?
  assertEqual(withHost([]).sameOrigin(), true)?
  Ok(())
}
