use std.web
use kv
use log

/// A note per path, in this app's own key-value store.
///
/// - `PUT /<name>` (or `POST`) stores the body as the note `<name>`;
/// - `GET /<name>` answers it, or 404;
/// - `DELETE /<name>` removes it;
/// - `GET /` lists the notes, `?prefix=` narrowing them, `?after=` the last
///   name of the previous page, `?limit=` the page size (default 20), and
///   `?order=desc` newest-named first.
export fn handle(request: web.Request) -> web.Response {
  let name = request.path.slice(1, request.path.length())
  if name == "" {
    return list(request)
  }
  if request.method == "PUT" || request.method == "POST" {
    return match kv.put("note:{name}", request.body) {
      Ok(_) => {
        log.info("stored {name} ({request.body.byteLength()} bytes)")
        web.text(201, "stored {name}\n")
      }
      Err(error) => web.text(413, "{error.message}\n")
    }
  }
  if request.method == "DELETE" {
    if kv.delete("note:{name}") {
      return web.text(200, "deleted {name}\n")
    }
    return web.text(404, "no note named {name}\n")
  }
  match kv.get("note:{name}") {
    Some(body) => web.text(200, body)
    None => web.text(404, "no note named {name}\n")
  }
}

/// One page of note names, one per line.
fn list(request: web.Request) -> web.Response {
  let prefix = "note:{request.query.get("prefix").unwrapOr("")}"
  let after = request.query.get("after").unwrapOr("")
  let from = if after == "" { "" } else { "note:{after}" }
  let limit = Int.parse(request.query.get("limit").unwrapOr("20")).unwrapOr(20)
  if limit < 1 || limit > 1000 {
    return web.text(400, "?limit= must be 1 to 1000\n")
  }
  let entries = if request.query.get("order").unwrapOr("") == "desc" {
    kv.listDesc(prefix, from, limit)
  } else {
    kv.list(prefix, from, limit)
  }
  var lines = Vector.of()
  for entry in entries {
    lines.push("{entry.key.slice(5, entry.key.length())}\n")
  }
  web.text(200, "".join(lines.freeze()))
}
