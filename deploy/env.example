# /home/ioijoi/cove-tools/env — the apps' secrets and the deployment's
# settings, read by systemd (EnvironmentFile=). Keep it mode 0600; install.sh
# creates it from this file the first time, every `change-me` a fresh random
# value. A later release that adds a key gets it appended by install.sh — a
# secret fresh, a setting with the value written here — and every key the
# file already has is left as it is. Generate a secret by hand with:
#
#   openssl rand -hex 32
#
# Changing a value takes a restart: sudo systemctl restart cove-tools

# The webhook lab's admin pages (examples/webhooks), when Cloudflare Access is
# off for it (below): `Authorization: Bearer <token>`, or the password of the
# browser's login prompt (any user name). With Access on it is not accepted.
# The receive URLs need no secret: their unguessable id is the credential.
WEBHOOKS_ADMIN_TOKEN=change-me

# The bench ledger's posting secret (examples/ledger): `POST /ledger/api/runs`
# and `DELETE /ledger/api/runs/<id>` need `Authorization: Bearer <token>`.
LEDGER_TOKEN=change-me

# The admin UI's secret (apps/admin, at covtools-admin.ramda.io), when
# Cloudflare Access is off for it (below): `Authorization: Bearer <token>`, or
# the password of the browser's login prompt (any user name). With Access on
# it is not accepted.
ADMIN_UI_TOKEN=change-me

# Cloudflare Access (issue #23; deploy/cloudflare.md, step 5). The host
# verifies the Access token (`Cf-Access-Jwt-Assertion`) of every request to
# the admin UI and the webhook lab's admin pages against the team's keys and
# the Access application's audience tag, and the apps use the verified email
# instead of a login of their own. Not secrets: they say which Access
# applications to trust. Empty the team (or an AUD) to turn Access off for
# the apps that use it: they then ask for their token above.
#
# The team domain: Zero Trust → Settings → Team name and domain (also the
# host of the Access login page), `<team>.cloudflareaccess.com`.
ACCESS_TEAM_DOMAIN=ioijoi.cloudflareaccess.com
# The AUD tag of the Access application `covtools` (covtools.ramda.io, the
# whole host): the webhook lab's admin pages. Zero Trust → Access →
# Applications → covtools → Overview → Application Audience (AUD) Tag.
COVTOOLS_ACCESS_AUD=a48226d2b0b956230ccb78ac4b9452d5d32dfb94b112d0a8e84712476d42568a
# The AUD tag of the Access application `covtools-admin`
# (covtools-admin.ramda.io): the admin UI.
COVTOOLS_ADMIN_ACCESS_AUD=12a48ba5cc9c31a4411138b999190250ba5dd6df203e7630c45a1a1ed5d9d2bc
# Only these users, even among those Access lets in (commas or spaces).
# Empty: whoever the Access policy allows.
ACCESS_ALLOWED_EMAILS=ioi.joi.koi.loi@gmail.com,ioijoikoiloi@gmail.com

# The watch example's admin (examples/watch): adding a target and asking
# for a check by hand. Reading its dashboard needs nobody.
WATCH_ADMIN_TOKEN=change-me
